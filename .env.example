# Copy this file to .env and fill in real values before deploying.

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on.
PORT=3000

# Set to "true" only for local development/testing, if you need the
# "modernize a site" importer to fetch http://localhost URLs. Leave unset
# (or "false") in any real deployment — it exists solely to bypass the
# SSRF guard that blocks imports from targeting internal/private hosts.
ALLOW_PRIVATE_IMPORT_HOSTS=false

# Free API key from https://www.pexels.com/api/ — powers the "Generate a
# site" feature's real stock photos. Without this, generated sites still
# work, just without a hero image or gallery photos. See README for how
# to get one.
PEXELS_API_KEY=

# Optional second photo source for the editor's photo picker: the "Access Key" of a free app at
# https://unsplash.com/developers (see README). Photographers are credited in the site footer automatically.
UNSPLASH_ACCESS_KEY=

# Optional: email the site owner whenever someone submits the contact form.
# Leave blank to skip (messages still appear on each site's Leads page).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=a Google "app password" (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown as the sender; defaults to SMTP_USER.
SMTP_FROM=

# --- Only needed when you put SiteGen on a real server (see README, "Putting it online") ---
# The hostname you use for the SiteGen dashboard itself, e.g. app.yourcompany.com
APP_DOMAIN=
# Which account may download the full backup. If blank, it's the first account created.
ADMIN_EMAIL=

# Optional: AI-written copy (https://console.anthropic.com). Leave blank to use built-in templates.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional: charge clients for hosting with Stripe (README, "Charging for hosting") ---
STRIPE_SECRET_KEY=
# The recurring price you created in Stripe (looks like price_123...)
STRIPE_PRICE_ID=
# From the webhook endpoint you add in Stripe (looks like whsec_...)
STRIPE_WEBHOOK_SECRET=

# Public address of this server, used for the "stop emailing me" link in follow-up emails and reminders.
PUBLIC_URL=
# Google reviews on sites (Places API (New) key). Leave empty to turn the feature off.
GOOGLE_PLACES_API_KEY=
# Optional: a cheaper/faster model for the website chat assistant.
ANTHROPIC_CHAT_MODEL=

# Publish to Netlify: a personal access token (Netlify > User settings > Applications > New access token).
NETLIFY_AUTH_TOKEN=
