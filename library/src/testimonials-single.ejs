<%# Adapted from HyperUI (MIT) marketing/testimonials: one big featured quote (uses the first review). %>
<section class="sg-lib" data-sg-section="testimonials/single">
  <div class="bg-page">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <% var it = d.items[0]; %>
      <figure class="text-center" data-animate="fade-up">
        <% if (d.heading) { %><p data-sg-head class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.heading %></p><% } %>
        <% if (it.rating) { %><p class="text-primary" aria-label="<%= it.rating %> out of 5 stars"><%= "★".repeat(Math.round(it.rating)) %></p><% } %>
        <blockquote class="mt-4 font-heading text-2xl/relaxed text-balance text-ink sm:text-3xl/relaxed">&ldquo;<%= it.quote %>&rdquo;</blockquote>
        <figcaption class="mt-6 text-sm"><% if (it.photo) { %><img class="mx-auto mb-3 block size-14 rounded-full object-cover" src="<%= it.photo %>" alt="" loading="lazy" decoding="async"><% } %><span class="font-medium text-ink"><%= it.name %></span><% if (it.role) { %><span class="text-muted"> &middot; <%= it.role %></span><% } %></figcaption>
      </figure>
      <% if (d.moreHref) { %><p class="mt-8 text-center"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>"><%= d.moreText || 'Read more reviews' %> &rarr;</a></p><% } %>
    </div>
  </div>
</section>
