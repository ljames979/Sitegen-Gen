<%# Adapted from HyperUI (MIT) marketing/sections/3: photo first, text beside it. %>
<section class="sg-lib" data-sg-section="about/photo-left">
  <div class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="sg-flip grid grid-cols-1 gap-8 md:grid-cols-5 md:items-center md:gap-12">
        <% if (d.image) { %><div class="md:col-span-3" data-animate="fade-up"><img class="aspect-[4/3] w-full rounded-xl object-cover" src="<%= d.image %>" alt="<%= d.imageAlt %>" loading="lazy"></div><% } %>
        <div class="<%= d.image ? 'md:col-span-2' : 'md:col-span-5' %>" data-animate="fade-up">
          <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
          <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
          <p class="mt-4 text-pretty whitespace-pre-line text-muted"><%= d.body %></p>
          <% if (d.moreHref) { %><a class="mt-6 inline-block font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">Learn more about us &rarr;</a><% } %>
        </div>
      </div>
    </div>
  </div>
</section>
