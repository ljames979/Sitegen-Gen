<%# Adapted from HyperUI (MIT) marketing/sections list layouts: a clean price-list style. %>
<section class="sg-lib" data-sg-section="services/list">
  <div class="bg-surface">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <ul class="list-none p-0 mt-8 divide-y divide-line overflow-hidden rounded-xl border border-line bg-page" data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <li>
            <a class="flex items-start justify-between gap-6 p-5 transition-colors hover:bg-surface" href="<%= it.href %>">
              <span class="block">
                <span class="block font-heading text-lg font-semibold text-ink"><%= it.title %></span>
                <% if (it.description) { %><span class="mt-1 block text-sm/relaxed text-pretty text-muted"><%= it.description %></span><% } %>
              </span>
              <span class="shrink-0 text-sm font-medium text-primary"><%= it.price || 'Details' %> &rarr;</span>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>
