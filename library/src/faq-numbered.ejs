<%# Original layout (numbered accordion, drawn from scratch): large numbers, hairline dividers, native <details>. %>
<section class="sg-lib" data-sg-section="faq/numbered">
  <div class="bg-surface">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div data-animate="fade-up"><h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2></div>
      <div class="mt-8 divide-y divide-line border-y border-line" data-animate="stagger">
        <% d.items.forEach(function (it, i) { %>
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center gap-5 text-ink">
              <span class="font-heading text-2xl font-bold text-primary opacity-70"><%= (i + 1 < 10 ? '0' : '') + (i + 1) %></span>
              <span class="flex-1 font-heading text-lg font-medium"><%= it.question %></span>
              <span class="shrink-0 text-primary transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 pl-12 text-pretty text-muted sm:pl-14"><%= it.answer %></p>
          </details>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="mt-8"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">More questions &rarr;</a></p><% } %>
    </div>
  </div>
</section>
