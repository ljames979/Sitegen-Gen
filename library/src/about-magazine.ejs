<%# Original layout (magazine: words in columns with a drop cap, a pull-quote from a real review and a small inset photo) %>
<% var ims = (d.images || []).map(function (x) { return x && typeof x === 'object' ? x.src : x; }).filter(Boolean); if (!ims.length && d.image) ims = [d.image]; var alt = d.imageAlt || ((d.images || [])[0] || {}).alt || ''; %>
<section class="sg-lib" data-sg-section="about/magazine">
  <div class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <% if (d.heading) { %><h2 data-sg-head class="font-heading text-3xl font-semibold text-ink sm:text-4xl" data-animate="fade-up"><%= d.heading %></h2><% } %>
      <div class="sg-flip mt-8 grid grid-cols-1 gap-10 lg:grid-cols-12" data-animate="fade-up">
        <div class="lg:col-span-8">
          <% if (d.bodyFull || d.body) { %><p class="sg-dropcap gap-10 text-lg/relaxed text-pretty whitespace-pre-line text-muted md:columns-2"><%= d.bodyFull || d.body %></p><% } %>
          <% if (d.moreHref) { %><a class="mt-6 inline-block font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">Learn more about us &rarr;</a><% } %>
          <% if (d.buttonText && d.buttonHref) { %><p class="mt-6"><a class="inline-block rounded-md bg-primary px-5 py-3 font-medium text-on-primary shadow-[var(--shadow-sm)] transition-opacity hover:opacity-90" href="<%= d.buttonHref %>"><%= d.buttonText %></a></p><% } %>
        </div>
        <aside class="space-y-6 lg:col-span-4">
          <% if (ims.length) { %><img class="aspect-[4/3] w-full rounded-xl object-cover" src="<%= ims[0] %>" alt="<%= alt %>" loading="lazy"><% } %>
          <% if (d.quote) { %><blockquote class="border-l-4 border-primary pl-5"><p class="font-heading text-xl/snug text-pretty text-ink italic">&ldquo;<%= d.quote.text %>&rdquo;</p><% if (d.quote.name) { %><footer class="mt-2 text-sm text-muted">&mdash; <%= d.quote.name %></footer><% } %></blockquote><% } %>
        </aside>
      </div>
    </div>
  </div>
</section>
