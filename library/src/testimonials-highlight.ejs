<%# Adapted from Meraki UI (MIT) marketing/testimonials "Card": review cards with the reviewer under each quote, the middle card filled with the brand color. %>
<section class="sg-lib" data-sg-section="testimonials/highlight">
  <div class="bg-page">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-3xl font-bold text-ink sm:text-4xl"><%= d.heading %></h2>
        <div class="mt-3 flex gap-1.5" aria-hidden="true"><span class="h-1 w-24 rounded-full bg-primary"></span><span class="h-1 w-3 rounded-full bg-primary"></span><span class="h-1 w-1 rounded-full bg-primary"></span></div>
      </div>
      <% var list = d.items.slice(0, 3), mid = list.length === 3 ? 1 : (list.length === 2 ? 1 : 0); %>
      <div class="mt-10 grid grid-cols-1 gap-6 <%= list.length >= 3 ? 'md:grid-cols-3' : list.length === 2 ? 'md:grid-cols-2' : 'max-w-2xl' %>" data-sg-cards data-animate="stagger">
        <% list.forEach(function (it, i) { var on = i === mid && list.length > 1; %>
          <blockquote class="flex h-full flex-col rounded-xl p-7 <%= on ? 'bg-primary text-on-primary' : 'border border-line bg-page text-muted' %>">
            <% if (it.rating) { %><p class="<%= on ? 'text-on-primary' : 'text-primary' %>" aria-label="<%= it.rating %> out of 5 stars"><%= "★".repeat(Math.round(it.rating)) %></p><% } %>
            <p class="mt-2 flex-1 leading-relaxed text-pretty">&ldquo;<%= it.quote %>&rdquo;</p>
            <footer class="mt-6 flex items-center gap-3">
              <% if (it.photo) { %><img class="size-12 shrink-0 rounded-full object-cover ring-2 <%= on ? 'ring-on-primary/60' : 'ring-primary/30' %>" src="<%= it.photo %>" alt="" loading="lazy"><% } else { %><span class="flex size-12 shrink-0 items-center justify-center rounded-full font-heading font-bold <%= on ? 'bg-on-primary/15 text-on-primary' : 'bg-primary/10 text-primary' %>" aria-hidden="true"><%= String(it.name || '?').trim().charAt(0).toUpperCase() %></span><% } %>
              <span class="text-sm"><span class="block font-semibold <%= on ? 'text-on-primary' : 'text-ink' %>"><%= it.name %></span><% if (it.role) { %><span class="block <%= on ? 'text-on-primary/80' : 'text-muted' %>"><%= it.role %></span><% } %></span>
            </footer>
          </blockquote>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="mt-10"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>"><%= d.moreText || 'Read more reviews' %> &rarr;</a></p><% } %>
    </div>
  </div>
</section>
