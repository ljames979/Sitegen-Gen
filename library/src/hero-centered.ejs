<%# Adapted from HyperUI (MIT) marketing/banners/1. Colors, fonts and corners come from the site theme. %>
<section class="sg-lib" data-sg-section="hero/centered">
  <div class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
      <div class="mx-auto max-w-prose text-center">
        <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl" data-animate="hero"><%- d.headlineHtml %></h1>
        <% if (d.sub) { %><p class="mt-4 text-base text-pretty text-muted sm:text-lg/relaxed" data-animate="hero"><%= d.sub %></p><% } %>
        <div class="mt-4 flex flex-wrap justify-center gap-4 sm:mt-6" data-animate="hero">
          <a class="inline-block rounded-md bg-primary px-5 py-3 font-medium text-on-primary shadow-[var(--shadow-sm)] transition-opacity hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
          <% if (d.phone) { %><a class="inline-block rounded-md border border-line bg-page px-5 py-3 font-medium text-ink shadow-[var(--shadow-sm)] transition-colors hover:bg-surface" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
        </div>
      </div>
      <% if (d.image) { %><img class="mx-auto mt-10 w-full max-w-5xl rounded-xl object-cover shadow-[var(--shadow-md)] sm:mt-14" src="<%= d.image %>" alt="" fetchpriority="high"><% } %>
    </div>
  </div>
</section>
