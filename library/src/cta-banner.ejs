<%# Adapted from HyperUI (MIT) marketing/ctas/1: a full-width brand-color call to action. %>
<section class="sg-lib" data-sg-section="cta/banner">
  <div class="bg-primary">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="mx-auto max-w-2xl text-center" data-animate="fade-up">
        <h2 data-sg-head class="font-heading text-2xl font-bold text-on-primary sm:text-3xl"><%= d.heading %></h2>
        <% if (d.text) { %><p class="mt-3 text-pretty text-on-primary opacity-90"><%= d.text %></p><% } %>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <a class="inline-block rounded-md bg-page px-5 py-3 font-medium text-ink shadow-[var(--shadow-sm)] transition-opacity hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
          <% if (d.phone) { %><a class="inline-block rounded-md border border-on-primary px-5 py-3 font-medium text-on-primary transition-opacity hover:opacity-80" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
        </div>
      </div>
    </div>
  </div>
</section>
