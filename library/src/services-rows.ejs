<%# Original layout (numbered rows with an arrow, drawn from scratch): a calm, text-first list with large numbers. %>
<section class="sg-lib" data-sg-section="services/rows">
  <div class="bg-page">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-2xl" data-animate="fade-up"><h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2></div>
      <ul class="mt-8 list-none divide-y divide-line border-y border-line p-0" data-animate="stagger">
        <% d.items.forEach(function (it, i) { %>
          <li>
            <a class="group grid grid-cols-[auto_1fr_auto] items-center gap-4 py-6 sm:gap-8" href="<%= it.href %>">
              <span class="font-heading text-3xl font-bold text-primary opacity-70 sm:text-4xl"><%= (i + 1 < 10 ? '0' : '') + (i + 1) %></span>
              <span class="block">
                <span class="block font-heading text-xl font-semibold text-ink group-hover:text-primary"><%= it.title %></span>
                <% if (it.description) { %><span class="mt-1 block text-sm/relaxed text-pretty text-muted"><%= it.description %></span><% } %>
              </span>
              <span class="text-right text-sm font-medium text-primary"><% if (it.price) { %><span class="block"><%= it.price %></span><% } %><span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
        <% }) %>
      </ul>
      <% if (d.moreHref) { %><p class="mt-8"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">See all services &rarr;</a></p><% } %>
    </div>
  </div>
</section>
