<%# Original layout (word ticker, drawn from scratch): a band in the brand color where the service names slide past in huge letters, with a small photo of each service between them. It pauses while the mouse is over it or it has keyboard focus; with motion off the names sit still and wrap. %>
<section class="sg-lib" data-sg-section="services/ticker">
  <div class="sg-tk bg-primary text-on-primary">
    <div class="mx-auto max-w-[120rem] py-12 lg:py-16" style="--n:<%= d.items.length %>">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 data-sg-head class="font-heading text-sm font-semibold tracking-widest uppercase opacity-80"><%= d.heading %></h2>
    </div>
    <div class="sg-tk-stage relative mt-6" data-sg-glide>
    <div class="sg-tk-view" role="region" aria-label="<%= d.heading %>">
      <ul class="sg-tk-track m-0 flex list-none items-center p-0">
        <% [0, 1].forEach(function (copy) { d.items.forEach(function (it) { %>
          <li class="sg-tk-item flex shrink-0 items-center"<%- copy ? ' aria-hidden="true"' : '' %>>
            <a class="sg-tk-word font-heading font-bold text-on-primary no-underline" href="<%= it.href %>"<%- copy ? ' tabindex="-1"' : '' %>><%= it.title %></a>
            <% if (it.imageUrl) { %><img class="sg-tk-pic shrink-0 rounded-full object-cover" src="<%= it.imageUrl %>" alt="" loading="lazy" decoding="async"><% } else { %><span class="sg-tk-dot shrink-0 rounded-full bg-on-primary" aria-hidden="true"></span><% } %>
          </li>
        <% }) }) %>
      </ul>
    </div>
    <button type="button" class="sg-tk-pause sg-reel-pause absolute right-4 inline-flex items-center justify-center text-white sm:right-6 lg:right-8" data-sg-glide-pause data-what="service names" aria-pressed="false" aria-label="Pause the moving service names">
      <svg class="sg-sh-i-pause size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
      <svg class="sg-sh-i-play size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
    </button>
    </div>
    <% if (d.moreHref) { %><p class="mx-auto mt-6 max-w-7xl px-4 sm:px-6 lg:px-8"><a class="font-medium text-on-primary underline underline-offset-4" href="<%= d.moreHref %>">See all services &rarr;</a></p><% } %>
    </div>
  </div>
</section>
