<%# Original layout (heading and help panel beside the accordion, drawn from scratch): native <details>, no JavaScript. %>
<section class="sg-lib" data-sg-section="faq/side">
  <div class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="sg-flip grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-16">
        <div class="lg:col-span-1" data-animate="fade-up">
          <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
          <div class="mt-6 rounded-xl border border-line bg-surface p-5">
            <p class="font-heading font-semibold text-ink">Still have a question?</p>
            <p class="mt-1 text-sm text-pretty text-muted">Send us a message<% if (d.phone) { %> or give us a call<% } %>.</p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a class="inline-block rounded-md bg-primary px-4 py-2 text-sm font-medium text-on-primary transition-opacity hover:opacity-90" href="<%= d.ctaHref %>">Contact us</a>
              <% if (d.phone) { %><a class="inline-block rounded-md border border-line bg-page px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-surface" href="tel:<%= d.phoneHref %>"><%= d.phone %></a><% } %>
            </div>
          </div>
        </div>
        <div class="space-y-3 lg:col-span-2" data-animate="stagger">
          <% d.items.forEach(function (it, i) { %>
            <details class="group rounded-xl border border-line bg-surface p-5 open:shadow-[var(--shadow-sm)]" <%= i === 0 ? 'open' : '' %>>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-base font-medium text-ink"><%= it.question %><span class="shrink-0 text-primary transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
              <p class="mt-3 text-pretty text-muted"><%= it.answer %></p>
            </details>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>
