<%# Original layout (card variant): an icon on top of each card instead of a photo. %>
<section class="sg-lib" data-sg-section="services/icons">
  <div class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 <%= d.items.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3' %>" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <a class="group block rounded-xl border border-line bg-surface p-6 shadow-[var(--shadow-sm)] transition-shadow hover:shadow-[var(--shadow-md)]" href="<%= it.href %>">
            <span class="flex size-12 items-center justify-center rounded-lg bg-primary text-on-primary" aria-hidden="true"><svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- it.icon || '<polyline points="20 6 9 17 4 12"></polyline>' %></svg></span>
            <h3 class="mt-4 font-heading text-lg font-semibold text-ink group-hover:text-primary"><%= it.title %></h3>
            <% if (it.description) { %><p class="mt-2 text-sm/relaxed text-pretty text-muted"><%= it.description %></p><% } %>
            <% if (it.price) { %><p class="mt-3 text-sm font-medium text-primary"><%= it.price %></p><% } %>
          </a>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="mt-8 text-center"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">See all services &rarr;</a></p><% } %>
    </div>
  </div>
</section>
