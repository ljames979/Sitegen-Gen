<%# Original layout (full map with a floating card): the map fills the section and the contact details sit on a card over it. No address, no map. %>
<section class="sg-lib" data-sg-section="contact/mapcard">
  <div class="relative bg-surface">
    <div class="sg-dock relative z-10 mx-auto flex max-w-7xl px-4 py-12 sm:px-6 lg:min-h-[32rem] lg:items-center lg:px-8 lg:py-16 <%= d.mapSrc ? '' : 'justify-center' %>">
      <div class="w-full max-w-md rounded-xl border border-line bg-page p-6 shadow-[var(--shadow-md)] sm:p-8" data-animate="fade-up">
          <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
          <dl class="mt-6 space-y-3">
            <% d.items.forEach(function (it) { %>
              <div class="flex gap-3"><dt class="w-16 shrink-0 text-sm font-medium tracking-wide text-muted uppercase"><%= it.label %></dt><dd class="font-medium text-ink"><% if (it.href) { %><a class="text-primary underline-offset-4 hover:underline" href="<%= it.href %>"><%= it.value %></a><% } else { %><%= it.value %><% } %></dd></div>
            <% }) %>
          </dl>
          <% if (d.ctaHref) { %><p class="mt-6"><a class="inline-block rounded-md bg-primary px-5 py-3 font-medium text-on-primary shadow-[var(--shadow-sm)] transition-opacity hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a></p><% } %>
      </div>
    </div>
    <% if (d.mapSrc) { %><iframe class="block h-72 w-full border-0 lg:absolute lg:inset-0 lg:h-full" loading="lazy" title="Map of <%= d.address %>" src="<%= d.mapSrc %>"></iframe><% } %>
  </div>
</section>
