<%# Adapted from HyperUI (MIT) marketing/testimonials. CSS scroll-snap, arrow buttons wired in public/sg-lib.js (works by swiping without JS). %>
<section class="sg-lib" data-sg-section="testimonials/carousel">
  <div class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="relative mt-8" data-sg-carousel>
        <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4" data-sg-track>
          <% d.items.forEach(function (it) { %>
            <blockquote class="flex w-[85%] shrink-0 snap-center flex-col rounded-xl border border-line bg-page p-6 shadow-[var(--shadow-sm)] sm:w-[48%] lg:w-[32%]">
              <% if (it.rating) { %><p class="text-primary" aria-label="<%= it.rating %> out of 5 stars"><%= "★".repeat(Math.round(it.rating)) %></p><% } %>
              <p class="mt-2 flex-1 text-pretty text-ink">&ldquo;<%= it.quote %>&rdquo;</p>
              <footer class="mt-4 flex items-center gap-3 text-sm"><% if (it.photo) { %><img class="size-10 shrink-0 rounded-full object-cover" src="<%= it.photo %>" alt="" loading="lazy" decoding="async"><% } %><span><span class="font-medium text-ink"><%= it.name %></span><% if (it.role) { %><span class="text-muted"> &middot; <%= it.role %></span><% } %></span></footer>
            </blockquote>
          <% }) %>
        </div>
        <div data-sg-arrows hidden><div class="mt-2 flex justify-center gap-3">
          <button type="button" class="size-10 rounded-full border border-line bg-page text-ink transition-colors hover:border-primary" aria-label="Previous review" data-sg-prev>&larr;</button>
          <button type="button" class="size-10 rounded-full border border-line bg-page text-ink transition-colors hover:border-primary" aria-label="Next review" data-sg-next>&rarr;</button>
        </div></div>
      </div>
    </div>
  </div>
</section>
