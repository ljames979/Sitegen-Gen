<%# Original layout (carousel with thumbnails): one big photo with small ones underneath to pick from. Without the script it is a swipeable row. %>
<% var pics = ((d.all && d.all.length ? d.all : d.images) || []).slice(0, 10); %>
<section class="sg-lib" data-sg-section="gallery/carousel">
  <div class="bg-surface">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
      </div>
      <div class="mt-8" data-sg-slides>
        <div class="flex snap-x snap-mandatory overflow-x-auto rounded-xl" data-sg-track>
          <% pics.forEach(function (im) { %><img class="aspect-[16/10] w-full shrink-0 snap-center object-cover" src="<%= im.src %>" alt="<%= im.alt %>" loading="lazy"><% }) %>
        </div>
        <div class="mt-3 flex flex-wrap justify-center gap-2" data-sg-thumbs hidden>
          <% pics.forEach(function (im, i) { %><button type="button" class="size-16 overflow-hidden rounded-md border-2 border-line p-0 opacity-70 transition-opacity hover:opacity-100 sm:size-20" aria-label="Show photo <%= i + 1 %>" data-sg-thumb="<%= i %>"><img class="sg-noshape size-full object-cover" src="<%= im.src %>" alt="" loading="lazy"></button><% }) %>
        </div>
      </div>
      <% if (d.moreHref) { %><p class="mt-8 text-center"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">See the full gallery &rarr;</a></p><% } %>
    </div>
  </div>
</section>
