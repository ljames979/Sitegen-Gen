<%# Original layout (card variant): each service's photo fills its card behind the words; no photo uses the brand color. %>
<section class="sg-lib" data-sg-section="services/bgcards">
  <div class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 <%= d.items.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3' %>" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <a class="group relative flex min-h-80 flex-col justify-end overflow-hidden rounded-xl p-6 shadow-[var(--shadow-md)] <%= it.imageUrl ? 'text-white' : 'bg-primary text-on-primary' %>" href="<%= it.href %>">
            <% if (it.imageUrl) { %><img class="sg-noshape absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105" src="<%= it.imageUrl %>"<% if (it.image2) { %> data-sg-hover="<%= it.image2 %>"<% } %> alt="" loading="lazy" decoding="async"><span class="sg-shade absolute inset-0" aria-hidden="true"></span><% } %>
            <h3 class="relative font-heading text-xl font-semibold"><%= it.title %></h3>
            <% if (it.description) { %><p class="relative mt-2 text-sm/relaxed text-pretty opacity-90"><%= it.description %></p><% } %>
            <% if (it.price) { %><p class="relative mt-3 text-sm font-semibold"><%= it.price %></p><% } %>
          </a>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="mt-8 text-center"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">See all services &rarr;</a></p><% } %>
    </div>
  </div>
</section>
