<%# Original layout (headline beside big numbers, drawn from scratch): uses only numbers the client gave us; falls back to a photo. %>
<section class="sg-lib" data-sg-section="hero/stat">
  <div class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-5 lg:items-center lg:gap-14">
        <div class="lg:col-span-3">
          <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl lg:text-6xl" data-animate="hero"><%- d.headlineHtml %></h1>
          <% if (d.sub) { %><p class="mt-4 max-w-xl text-base text-pretty text-muted sm:text-lg/relaxed" data-animate="hero"><%= d.sub %></p><% } %>
          <div class="mt-6 flex flex-wrap gap-4" data-animate="hero">
            <a class="inline-block rounded-md bg-primary px-5 py-3 font-medium text-on-primary shadow-[var(--shadow-sm)] transition-opacity hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
            <% if (d.phone) { %><a class="inline-block rounded-md border border-line bg-page px-5 py-3 font-medium text-ink shadow-[var(--shadow-sm)] transition-colors hover:bg-surface" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
          </div>
        </div>
        <div class="lg:col-span-2">
          <% if (d.stats.length) { %>
            <dl class="grid grid-cols-1 gap-4" data-animate="stagger">
              <% d.stats.forEach(function (st) { %>
                <div class="flex items-baseline gap-4 rounded-xl border border-line bg-surface p-5">
                  <dd class="font-heading text-4xl font-bold text-primary"><span<%- st.countAttrs || '' %>><%= st.value %></span></dd>
                  <dt class="text-sm text-muted"><%= st.label %></dt>
                </div>
              <% }) %>
            </dl>
          <% } else if (d.image) { %>
            <img class="aspect-[4/3] w-full rounded-xl object-cover shadow-[var(--shadow-md)]" src="<%= d.image %>" alt="" fetchpriority="high" data-animate="scene">
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>
