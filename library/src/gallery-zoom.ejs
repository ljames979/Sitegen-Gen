<%# Original layout (grid zoom, drawn from scratch): a photo collage whose middle photo grows to fill the screen while the others slide away, as the visitor scrolls through it. With motion off it is a still collage. Uses 3, 5 or 7 photos, whole columns only. Optional floating tags show the client's own service names. %>
<% var all = (d.all && d.all.length ? d.all : d.images) || [], pics = all.slice(0, all.length >= 7 ? 7 : all.length >= 5 ? 5 : 3), k = (pics.length - 1) / 2, feat = pics[0], side = pics.slice(1); %>
<section class="sg-lib" data-sg-section="gallery/zoom">
  <div class="bg-page">
  <div class="sg-zoom mx-auto max-w-[120rem] py-0" data-sg-progress="pin" style="--rows:<%= k %>">
    <div class="sg-zoom-pin relative overflow-hidden">
      <div class="sg-zoom-head relative z-10 mx-auto max-w-3xl px-4 pt-12 text-center lg:pt-16" data-animate="fade-up">
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
      </div>
      <div class="sg-zoom-grid relative mx-auto mt-8 grid max-w-6xl grid-cols-3 gap-3 px-4 sm:gap-4 sm:px-6 lg:px-8">
        <% side.forEach(function (im, i) { var left = i < k; %>
          <img class="sg-zoom-side <%= left ? 'sg-zoom-l' : 'sg-zoom-r' %> size-full rounded-xl object-cover" style="grid-column:<%= left ? 1 : 3 %>;grid-row:<%= (left ? i : i - k) + 1 %>" src="<%= im.src %>" alt="<%= im.alt %>" loading="lazy" decoding="async">
        <% }) %>
        <figure class="sg-zoom-feat relative m-0 overflow-hidden rounded-xl" style="grid-column:2;grid-row:1 / span <%= k %>"><img class="block size-full object-cover" src="<%= feat.src %>" alt="<%= feat.alt %>" loading="lazy" decoding="async"></figure>
        <% (d.tags || []).slice(0, 3).forEach(function (t, i) { %><span class="sg-tag sg-tag-<%= i + 1 %>" aria-hidden="true"><%= t %></span><% }) %>
      </div>
      <% if (d.moreHref) { %><p class="sg-zoom-more relative z-10 mt-6 px-4 pb-10 text-center"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">See the full gallery &rarr;</a></p><% } %>
    </div>
  </div>
  </div>
</section>
