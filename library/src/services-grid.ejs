<%# Adapted from HyperUI (MIT) marketing/feature-grids: a numbered, borderless grid with no photos needed. %>
<section class="sg-lib" data-sg-section="services/grid">
  <div class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-left mx-0" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it, i) { %>
          <a class="group flex gap-4" href="<%= it.href %>">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary font-heading font-semibold text-on-primary"><%= i + 1 %></span>
            <span class="block">
              <span class="block font-heading text-lg font-semibold text-ink group-hover:text-primary"><%= it.title %></span>
              <% if (it.description) { %><span class="mt-1 block text-sm/relaxed text-pretty text-muted"><%= it.description %></span><% } %>
              <% if (it.price) { %><span class="mt-2 block text-sm font-medium text-primary"><%= it.price %></span><% } %>
            </span>
          </a>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="mt-10"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">See all services &rarr;</a></p><% } %>
    </div>
  </div>
</section>
