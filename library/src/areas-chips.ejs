<%# Original layout (HyperUI-style spacing): towns the client actually serves, as chips. %>
<section class="sg-lib" data-sg-section="areas/chips">
  <div class="bg-surface">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <ul class="list-none p-0 mt-6 flex flex-wrap justify-center gap-2" data-animate="stagger">
        <% d.items.forEach(function (a) { %>
          <li><% if (a.href) { %><a class="inline-block rounded-full border border-line bg-page px-4 py-2 text-sm text-ink transition-colors hover:border-primary hover:text-primary" href="<%= a.href %>"><%= a.name %></a><% } else { %><span class="inline-block rounded-full border border-line bg-page px-4 py-2 text-sm text-ink"><%= a.name %></span><% } %></li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>
