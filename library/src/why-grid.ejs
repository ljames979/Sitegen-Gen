<%# Adapted from HyperUI (MIT) marketing/feature-grids: reasons to choose us, with a check mark. %>
<section class="sg-lib" data-sg-section="why/grid">
  <div class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 <%= ({ 1: 'lg:grid-cols-1', 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4' })[Math.min(d.items.length, 4)] %>" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <div class="rounded-xl border border-line bg-surface p-6">
            <% if (it.imageUrl) { %><img class="aspect-[3/2] w-full rounded-lg object-cover" src="<%= it.imageUrl %>" alt="" loading="lazy" decoding="async"><% } else { %>
            <span class="flex size-10 items-center justify-center rounded-full bg-primary text-on-primary" aria-hidden="true"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
            <% } %>
            <h3 class="mt-4 font-heading text-lg font-semibold text-ink"><%= it.title %></h3>
            <% if (it.text) { %><p class="mt-2 text-sm/relaxed text-pretty text-muted"><%= it.text %></p><% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>
