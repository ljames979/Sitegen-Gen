<%# Adapted from Meraki UI (MIT) marketing/features "Cards": the heading on the left with one word underlined in the brand color, cards outlined in the brand color with an icon, the words and a round arrow. %>
<section class="sg-lib" data-sg-section="services/outlined">
  <div class="bg-page">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-2xl" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="sg-mk-under font-heading text-3xl font-bold text-ink sm:text-4xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-4 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 <%= d.items.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3' %>" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <a class="group flex flex-col rounded-xl border-2 border-primary/60 bg-page p-7 transition-colors hover:border-primary hover:bg-primary/5" href="<%= it.href %>">
            <span class="inline-flex size-10 items-center justify-center rounded-full bg-primary/10 text-primary" aria-hidden="true"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- it.icon || '<polyline points="20 6 9 17 4 12"></polyline>' %></svg></span>
            <h3 class="mt-4 font-heading text-lg font-semibold text-ink"><%= it.title %></h3>
            <% if (it.description) { %><p class="mt-2 flex-1 text-sm/relaxed text-pretty text-muted"><%= it.description %></p><% } %>
            <% if (it.price) { %><p class="mt-3 text-sm font-semibold text-ink"><%= it.price %></p><% } %>
            <span class="mt-5 inline-flex size-8 items-center justify-center rounded-full bg-primary/10 text-primary transition-transform group-hover:translate-x-1" aria-hidden="true"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="mt-10"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">See all services &rarr;</a></p><% } %>
    </div>
  </div>
</section>
