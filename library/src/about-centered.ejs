<%# Adapted from HyperUI (MIT) marketing/sections/4: a centered statement with a wide photo under it. %>
<section class="sg-lib" data-sg-section="about/centered">
  <div class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-3xl font-semibold text-ink sm:text-4xl"><%= d.heading %></h2>
        <p class="mt-4 text-lg text-pretty whitespace-pre-line text-muted"><%= d.body %></p>
        <% if (d.moreHref) { %><a class="mt-6 inline-block font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">Learn more about us &rarr;</a><% } %>
      </div>
      <% if (d.image) { %><img class="mx-auto mt-10 aspect-[16/7] w-full max-w-5xl rounded-xl object-cover" src="<%= d.image %>" alt="<%= d.imageAlt %>" loading="lazy" data-animate="fade-up"><% } %>
    </div>
  </div>
</section>
