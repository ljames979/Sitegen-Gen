<%# Adapted from HyperUI (MIT) marketing/pricing: only the prices the client gave us; the middle plan is highlighted when there are three. %>
<section class="sg-lib" data-sg-section="pricing/cards">
  <div class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-10 grid grid-cols-1 items-stretch gap-6 <%= ({ 1: 'md:grid-cols-1', 2: 'md:grid-cols-2', 3: 'md:grid-cols-3' })[Math.min(d.items.length, 3)] %>" data-animate="stagger">
        <% d.items.forEach(function (it, i) { var hi = d.items.length === 3 && i === 1; %>
          <div class="flex flex-col rounded-2xl border p-6 sm:p-8 <%= hi ? 'border-primary shadow-[var(--shadow-md)] bg-surface' : 'border-line bg-surface' %>">
            <h3 class="font-heading text-lg font-semibold text-ink"><%= it.title %></h3>
            <p class="mt-3"><strong class="font-heading text-3xl font-bold text-primary sm:text-4xl"><%= it.price %></strong></p>
            <% if (it.description) { %><p class="mt-3 text-sm/relaxed text-pretty text-muted"><%= it.description %></p><% } %>
            <div class="flex-1"></div>
            <a class="mt-6 inline-block rounded-md px-5 py-3 text-center font-medium transition-opacity hover:opacity-90 <%= hi ? 'bg-primary text-on-primary' : 'border border-primary text-primary' %>" href="<%= it.href %>">Get started</a>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>
