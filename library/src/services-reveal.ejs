<%# Original layout (hover-reveal photo cards, drawn from scratch): the description slides up on mouse hover or keyboard focus; on touch screens and with reduced motion it is always visible. %>
<section class="sg-lib" data-sg-section="services/reveal">
  <div class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 <%= d.items.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3' %>" data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <a class="sg-reveal group relative isolate flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-xl border border-line bg-primary p-5 shadow-[var(--shadow-sm)]" href="<%= it.href %>">
            <% if (it.imageUrl) { %><img class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src="<%= it.imageUrl %>"<% if (it.image2) { %> data-sg-hover="<%= it.image2 %>"<% } %> alt="" loading="lazy"><% } %>
            <span class="absolute inset-0 -z-10 bg-linear-to-t from-black/75 via-black/10 to-transparent" aria-hidden="true"></span>
            <span class="block font-heading text-xl font-semibold <%= it.imageUrl ? 'text-white' : 'text-on-primary' %>"><%= it.title %></span>
            <% if (it.description) { %><span class="sg-reveal-desc mt-2 block text-sm/relaxed text-pretty <%= it.imageUrl ? 'text-white/90' : 'text-on-primary' %>"><%= it.description %></span><% } %>
            <% if (it.price) { %><span class="mt-2 block text-sm font-medium <%= it.imageUrl ? 'text-white' : 'text-on-primary' %>"><%= it.price %></span><% } %>
          </a>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="mt-8 text-center"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">See all services &rarr;</a></p><% } %>
    </div>
  </div>
</section>
