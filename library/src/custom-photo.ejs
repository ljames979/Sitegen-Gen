<%# Original layout (your own section, one big photo): full-width photo with an optional heading and words under it. %>
<section class="sg-lib" data-sg-section="custom/photo">
  <div class="bg-page">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <img class="aspect-[16/9] w-full rounded-2xl object-cover shadow-[var(--shadow-md)]" src="<%= d.images[0].src %>" alt="<%= d.images[0].alt %>" loading="lazy" data-animate="fade-up">
      <% if (d.heading || d.body) { %>
        <div class="mx-auto mt-8 max-w-3xl text-center" data-animate="fade-up">
          <% if (d.heading) { %><h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2><% } %>
          <% if (d.body) { %><p class="<%= d.heading ? 'mt-4' : '' %> text-lg/relaxed text-pretty whitespace-pre-line text-muted"><%= d.body %></p><% } %>
          <% if (d.buttonText && d.buttonHref) { %><p class="mt-6"><a class="inline-block rounded-md bg-primary px-5 py-3 font-medium text-on-primary shadow-[var(--shadow-sm)] transition-opacity hover:opacity-90" href="<%= d.buttonHref %>"><%= d.buttonText %></a></p><% } %>
        </div>
      <% } %>
    </div>
  </div>
</section>
