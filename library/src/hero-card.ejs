<%# Original layout using HyperUI (MIT) marketing/banners spacing: a text card over a full-width photo. %>
<section class="sg-lib" data-sg-section="hero/card">
  <div class="relative isolate overflow-hidden <%= d.image ? '' : 'bg-surface' %>">
    <% if (d.image) { %><img class="absolute inset-0 -z-10 h-full w-full object-cover" src="<%= d.image %>" alt="" fetchpriority="high"><% } %>
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-xl rounded-2xl bg-page/95 p-8 text-center shadow-[var(--shadow-md)] sm:p-10" data-animate="hero">
        <h1 class="font-heading text-3xl font-bold text-ink sm:text-4xl"><%- d.headlineHtml %></h1>
        <% if (d.sub) { %><p class="mt-4 text-pretty text-muted"><%= d.sub %></p><% } %>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <a class="inline-block rounded-md bg-primary px-5 py-3 font-medium text-on-primary shadow-[var(--shadow-sm)] transition-opacity hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
          <% if (d.phone) { %><a class="inline-block rounded-md border border-line bg-page px-5 py-3 font-medium text-ink shadow-[var(--shadow-sm)] transition-colors hover:bg-surface" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
        </div>
      </div>
    </div>
  </div>
</section>
