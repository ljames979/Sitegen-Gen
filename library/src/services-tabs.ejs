<%# Adapted from HyperUI (MIT) application/tabs, behavior in public/sg-lib.js (no framework). Without JS every panel shows. %>
<section class="sg-lib" data-sg-section="services/tabs">
  <div class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-8" data-sg-tabs>
        <div class="flex flex-wrap justify-center gap-2" role="tablist" data-sg-tablist>
          <% d.items.forEach(function (it, i) { %>
            <button type="button" role="tab" class="rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-primary" aria-selected="<%= i === 0 ? 'true' : 'false' %>" data-sg-tab="<%= i %>"><%= it.title %></button>
          <% }) %>
        </div>
        <% d.items.forEach(function (it, i) { %>
          <div class="mx-auto mt-6 max-w-4xl rounded-xl border border-line bg-surface p-6 sm:p-8" role="tabpanel" data-sg-panel="<%= i %>">
            <div class="grid gap-6 md:grid-cols-2 md:items-center">
              <div>
                <h3 class="font-heading text-xl font-semibold text-ink"><%= it.title %></h3>
                <% if (it.description) { %><p class="mt-3 text-pretty text-muted"><%= it.description %></p><% } %>
                <% if (it.price) { %><p class="mt-3 font-medium text-primary"><%= it.price %></p><% } %>
                <a class="mt-5 inline-block rounded-md bg-primary px-5 py-3 font-medium text-on-primary transition-opacity hover:opacity-90" href="<%= it.href %>">Learn more</a>
              </div>
              <% if (it.imageUrl) { %><img class="aspect-[3/2] w-full rounded-lg object-cover" src="<%= it.imageUrl %>" alt="" loading="lazy"><% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>
