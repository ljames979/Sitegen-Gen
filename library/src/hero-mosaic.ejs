<%# Original layout (photo-mosaic hero pattern, drawn from scratch): text on the left, up to three staggered photos on the right. %>
<section class="sg-lib" data-sg-section="hero/mosaic">
  <div class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="sg-flip grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
        <div>
          <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl" data-animate="hero"><%- d.headlineHtml %></h1>
          <% if (d.sub) { %><p class="mt-4 text-base text-pretty text-muted sm:text-lg/relaxed" data-animate="hero"><%= d.sub %></p><% } %>
          <div class="mt-6 flex flex-wrap gap-4" data-animate="hero">
            <a class="inline-block rounded-md bg-primary px-5 py-3 font-medium text-on-primary shadow-[var(--shadow-sm)] transition-opacity hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
            <% if (d.phone) { %><a class="inline-block rounded-md border border-line bg-page px-5 py-3 font-medium text-ink shadow-[var(--shadow-sm)] transition-colors hover:bg-surface" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
          </div>
        </div>
        <% if (d.images.length >= 2) { %>
          <div class="grid grid-cols-2 gap-3 sm:gap-4" data-animate="scene">
            <img class="row-span-2 h-full min-h-64 w-full rounded-xl object-cover shadow-[var(--shadow-md)]" src="<%= d.images[0] %>" alt="" fetchpriority="high">
            <img class="aspect-[4/3] w-full rounded-xl object-cover shadow-[var(--shadow-sm)]" src="<%= d.images[1] %>" alt="" loading="lazy">
            <% if (d.images[2]) { %><img class="aspect-[4/3] w-full rounded-xl object-cover shadow-[var(--shadow-sm)]" src="<%= d.images[2] %>" alt="" loading="lazy"><% } %>
          </div>
        <% } else if (d.images.length === 1) { %>
          <img class="aspect-[4/3] w-full rounded-xl object-cover shadow-[var(--shadow-md)]" src="<%= d.images[0] %>" alt="" fetchpriority="high" data-animate="scene">
        <% } %>
      </div>
    </div>
  </div>
</section>
