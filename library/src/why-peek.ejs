<%# Original layout (Leo's link to a pet-guide block, 2026-11-03; our own drawing of the idea): a wide photo stands on a soft brand-tint band (a cut-out photo of pets looks best), and numbered cards with the reasons overlap the band's lower edge. %>
<section class="sg-lib" data-sg-section="why/peek">
  <div class="overflow-hidden bg-page">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="relative">
        <span class="absolute -top-12 bottom-0 left-1/2 w-screen -translate-x-1/2 bg-primary/15 lg:-top-16" aria-hidden="true"></span>
        <div class="relative mx-auto max-w-3xl text-center" data-animate="fade-up">
          <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
          <h2 data-sg-head class="font-heading text-3xl font-bold text-ink sm:text-4xl"><%= d.heading %></h2>
        </div>
        <% if (d.image) { %><img class="sg-noshape relative mx-auto mt-8 block max-h-[26rem] w-full max-w-4xl object-contain object-bottom" src="<%= d.image %>" alt="" loading="lazy" decoding="async"><% } else { %><div class="h-24" aria-hidden="true"></div><% } %>
      </div>
      <div class="relative -mt-16 grid grid-cols-1 gap-5 sm:grid-cols-2 <%= d.items.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4' %>" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it, i) { %>
          <div class="rounded-2xl bg-page p-6 shadow-[var(--shadow-md)]">
            <p class="font-heading text-4xl font-bold text-primary/70" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %></p>
            <% if (it.title) { %><h3 class="mt-3 font-heading text-lg font-semibold text-ink"><%= it.title %></h3><% } %>
            <% if (it.text) { %><p class="mt-2 text-sm/relaxed text-pretty text-muted italic"><%= it.text %></p><% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>
