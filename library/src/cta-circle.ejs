<%# Adapted from Meraki UI (MIT) marketing/cta "Image": a big round photo beside the heading and two buttons side by side, one dark and one in the brand color. %>
<section class="sg-lib" data-sg-section="cta/circle">
  <div class="bg-page">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div class="flex flex-col items-center gap-10 <%= d.image ? 'md:flex-row' : 'text-center' %>" data-animate="fade-up">
        <% if (d.image) { %><img class="size-64 shrink-0 rounded-full object-cover shadow-[var(--shadow-md)] lg:size-80" src="<%= d.image %>" alt="" loading="lazy"><% } %>
        <div class="<%= d.image ? 'text-center md:text-left' : '' %>">
          <h2 data-sg-head class="font-heading text-3xl font-bold text-ink sm:text-4xl"><%= d.heading %></h2>
          <% if (d.text) { %><p class="mt-3 text-pretty text-muted"><%= d.text %></p><% } %>
          <div class="mt-7 flex flex-wrap gap-3 <%= d.image ? 'justify-center md:justify-start' : 'justify-center' %>">
            <a class="inline-flex items-center gap-2 rounded-lg bg-ink px-6 py-3 text-sm font-medium text-page transition-opacity hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
            <% if (d.phone) { %><a class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-medium text-on-primary transition-opacity hover:opacity-90" href="tel:<%= d.phoneHref %>"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>Call <%= d.phone %></a><% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
