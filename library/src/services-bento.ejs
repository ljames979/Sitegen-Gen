<%# Original layout (bento grid pattern, drawn from scratch): one large featured service beside smaller tiles. Shows 3 or 6 services so the grid has no gaps. %>
<section class="sg-lib" data-sg-section="services/bento">
  <div class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <% var list = d.items.length >= 6 ? d.items.slice(0, 6) : d.items.length >= 3 ? d.items.slice(0, 3) : d.items; var bento = list.length >= 3; %>
      <div class="mt-10 grid grid-cols-1 gap-4 <%= bento ? 'md:grid-cols-3 md:grid-rows-[repeat(2,minmax(11rem,auto))]' : 'sm:grid-cols-2' %>" data-animate="stagger">
        <% list.forEach(function (it, i) { var big = bento && i === 0; %>
          <a class="group relative flex flex-col justify-end overflow-hidden rounded-xl border border-line bg-page p-6 shadow-[var(--shadow-sm)] transition-shadow hover:shadow-[var(--shadow-md)] <%= big ? 'md:col-span-2 md:row-span-2 md:p-8 min-h-72' : '' %>" href="<%= it.href %>">
            <% if (big && it.imageUrl) { %><img class="absolute inset-0 -z-0 h-full w-full object-cover" src="<%= it.imageUrl %>"<% if (it.image2) { %> data-sg-hover="<%= it.image2 %>"<% } %> alt="" loading="lazy"><span class="absolute inset-0 bg-overlay" aria-hidden="true"></span><% } %>
            <span class="relative block">
              <span class="block font-heading font-semibold <%= big ? (it.imageUrl ? 'text-3xl text-white' : 'text-3xl text-ink') : 'text-lg text-ink group-hover:text-primary' %>"><%= it.title %></span>
              <% if (it.description) { %><span class="mt-2 block text-sm/relaxed text-pretty <%= big && it.imageUrl ? 'text-white/90' : 'text-muted' %>"><%= it.description %></span><% } %>
              <% if (it.price) { %><span class="mt-3 block text-sm font-medium <%= big && it.imageUrl ? 'text-white' : 'text-primary' %>"><%= it.price %></span><% } %>
            </span>
          </a>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="mt-8 text-center"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">See all services &rarr;</a></p><% } %>
    </div>
  </div>
</section>
