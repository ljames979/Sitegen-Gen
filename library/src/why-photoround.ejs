<%# Adapted from Meraki UI (MIT) marketing/features "Grid list with image": the reasons in two columns, each under a small brand-color square, beside one large photo with a rounded edge. %>
<section class="sg-lib" data-sg-section="why/photoround">
  <div class="bg-page">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div class="grid items-center gap-12 <%= d.image ? 'lg:grid-cols-[3fr_2fr]' : '' %>">
        <div>
          <div data-animate="fade-up">
            <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
            <h2 data-sg-head class="font-heading text-3xl font-bold text-ink sm:text-4xl"><%= d.heading %></h2>
            <div class="mt-3 flex gap-1.5" aria-hidden="true"><span class="h-1 w-24 rounded-full bg-primary"></span><span class="h-1 w-3 rounded-full bg-primary"></span><span class="h-1 w-1 rounded-full bg-primary"></span></div>
          </div>
          <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2" data-sg-cards data-animate="stagger">
            <% d.items.forEach(function (it, i) { %>
              <div>
                <span class="inline-flex size-10 items-center justify-center rounded-lg bg-primary/10 font-heading font-bold text-primary" aria-hidden="true"><%= i + 1 %></span>
                <% if (it.title) { %><h3 class="mt-4 font-heading text-lg font-semibold text-ink"><%= it.title %></h3><% } %>
                <% if (it.text) { %><p class="mt-2 text-sm/relaxed text-pretty text-muted"><%= it.text %></p><% } %>
              </div>
            <% }) %>
          </div>
        </div>
        <% if (d.image) { %><img class="aspect-square w-full rounded-[2.5rem] object-cover lg:rounded-full" src="<%= d.image %>" alt="" loading="lazy" data-animate="fade-up"><% } %>
      </div>
    </div>
  </div>
</section>
