<%# Original layout (spotlight quote with an avatar strip, drawn from scratch): pick a reviewer to read their quote. Without JavaScript every quote shows in turn. Behavior in public/sg-lib.js. %>
<section class="sg-lib" data-sg-section="testimonials/quote">
  <div class="bg-surface">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20" data-sg-quotes>
      <% if (d.heading) { %><p data-sg-head class="text-center text-sm font-medium tracking-wide text-primary uppercase" data-animate="fade-up"><%= d.heading %></p><% } %>
      <% d.items.forEach(function (it, i) { %>
        <figure class="mt-8 text-center" data-sg-quote="<%= i %>">
          <% if (it.rating) { %><p class="text-primary" aria-label="<%= it.rating %> out of 5 stars"><%= "★".repeat(Math.round(it.rating)) %></p><% } %>
          <blockquote class="mt-3 font-heading text-2xl/relaxed text-balance text-ink sm:text-3xl/relaxed">&ldquo;<%= it.quote %>&rdquo;</blockquote>
          <figcaption class="mt-5 text-sm"><% if (it.photo) { %><img class="mx-auto mb-3 block size-14 rounded-full object-cover" src="<%= it.photo %>" alt="" loading="lazy" decoding="async"><% } %><span class="font-medium text-ink"><%= it.name %></span><% if (it.role) { %><span class="text-muted"> &middot; <%= it.role %></span><% } %></figcaption>
        </figure>
      <% }) %>
      <% if (d.items.length > 1) { %>
        <div data-sg-quote-nav hidden><div class="mt-8 flex justify-center gap-3" role="tablist" aria-label="Choose a review">
          <% d.items.forEach(function (it, i) { %>
            <button type="button" role="tab" class="flex size-11 items-center justify-center rounded-full border border-line bg-page font-heading text-sm font-semibold text-ink transition-colors hover:border-primary" aria-label="Review from <%= it.name || 'customer ' + (i + 1) %>" aria-selected="<%= i === 0 ? 'true' : 'false' %>" data-sg-quote-btn="<%= i %>"><%= (it.name || '?').trim().charAt(0).toUpperCase() %></button>
          <% }) %>
        </div></div>
      <% } %>
      <% if (d.moreHref) { %><p class="mt-8 text-center"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>"><%= d.moreText || 'Read more reviews' %> &rarr;</a></p><% } %>
    </div>
  </div>
</section>
