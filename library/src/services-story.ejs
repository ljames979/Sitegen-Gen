<%# Original layout (pinned scroll story, drawn from scratch): the services scroll past on one side while the photo on the other side stays pinned and changes to the service being read (public/sg-fx.js). Without the script the first photo shows; on phones each service shows its own photo. %>
<% var pics = d.items.filter(function (it) { return it.imageUrl; }); %>
<section class="sg-lib" data-sg-section="services/story">
  <div class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-3xl" data-animate="fade-up">
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
      </div>
      <div class="sg-flip mt-6 grid gap-10 <%= pics.length ? 'md:grid-cols-2' : '' %>" data-sg-story>
        <div>
          <% d.items.forEach(function (it, i) { %>
            <article class="sg-story-step flex flex-col justify-center border-l-4 border-line py-8 pl-6 md:min-h-[60vh] <%= i === 0 ? 'on' : '' %>" data-sg-step="<%= i %>">
              <% if (it.imageUrl) { %><img class="mb-5 aspect-[4/3] w-full rounded-xl object-cover md:hidden" src="<%= it.imageUrl %>" alt="" loading="lazy" decoding="async"><% } %>
              <span class="font-heading text-sm font-semibold tracking-widest text-primary"><%= (i + 1 < 10 ? '0' : '') + (i + 1) %></span>
              <h3 class="mt-2 font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= it.title %></h3>
              <% if (it.description) { %><p class="mt-3 max-w-prose text-pretty text-muted"><%= it.description %></p><% } %>
              <% if (it.price) { %><p class="mt-3 font-medium text-primary"><%= it.price %></p><% } %>
              <p class="mt-5"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= it.href %>">More about <%= it.title %> &rarr;</a></p>
            </article>
          <% }) %>
        </div>
        <% if (pics.length) { %>
          <div class="hidden md:block">
            <div class="sticky top-24 aspect-[4/5] overflow-hidden rounded-2xl bg-surface shadow-[var(--shadow-md)]">
              <% d.items.forEach(function (it, i) { if (!it.imageUrl) return; %><img class="sg-story-pic absolute inset-0 size-full object-cover <%= it === pics[0] ? 'on' : '' %>" src="<%= it.imageUrl %>" alt="" loading="lazy" decoding="async" data-sg-pic="<%= i %>"><% }) %>
            </div>
          </div>
        <% } %>
      </div>
      <% if (d.moreHref) { %><p class="mt-8"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">See all services &rarr;</a></p><% } %>
    </div>
  </div>
</section>
