<%# Adapted from HyperUI (MIT) marketing/faqs: native <details> accordion, no JavaScript needed. %>
<section class="sg-lib" data-sg-section="faq/accordion">
  <div class="bg-page">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-8 space-y-3" data-animate="stagger">
        <% d.items.forEach(function (it, i) { %>
          <details class="group rounded-xl border border-line bg-surface p-5 open:shadow-[var(--shadow-sm)]" <%= i === 0 ? 'open' : '' %>>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-base font-medium text-ink">
              <%= it.question %>
              <span class="shrink-0 text-primary transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-pretty text-muted"><%= it.answer %></p>
          </details>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="mt-8 text-center"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>">More questions &rarr;</a></p><% } %>
    </div>
  </div>
</section>
