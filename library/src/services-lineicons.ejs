<%# Adapted from Start Bootstrap Creative (MIT) services: a big line icon in the brand color over each service, a short rule under the heading, no cards. %>
<section class="sg-lib" data-sg-section="services/lineicons">
  <div class="bg-page">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-3xl font-bold text-ink sm:text-4xl"><%= d.heading %></h2>
        <hr class="mx-auto mt-6 h-1 w-14 border-0 bg-primary">
        <% if (d.intro) { %><p class="mt-6 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-12 text-center sm:grid-cols-2 <%= d.items.length === 4 || d.items.length > 6 ? 'lg:grid-cols-4' : 'lg:grid-cols-3' %>" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <a class="group block" href="<%= it.href %>">
            <svg class="mx-auto size-16 text-primary transition-transform duration-300 group-hover:-translate-y-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- it.icon || '<polyline points="20 6 9 17 4 12"></polyline>' %></svg>
            <h3 class="mt-5 font-heading text-xl font-bold text-ink"><%= it.title %></h3>
            <% if (it.description) { %><p class="mt-3 text-pretty text-muted"><%= it.description %></p><% } %>
            <% if (it.price) { %><p class="mt-3 text-sm font-bold text-ink"><%= it.price %></p><% } %>
          </a>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="mt-12 text-center"><a class="inline-block rounded-full bg-primary px-8 py-3 font-bold text-on-primary transition-opacity hover:opacity-90" href="<%= d.moreHref %>">See all services</a></p><% } %>
    </div>
  </div>
</section>
