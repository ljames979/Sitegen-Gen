<%# Adapted from Start Bootstrap Creative (MIT) portfolio: photos edge to edge with no gaps; on hover each one washes over in the brand color, with its caption when the owner wrote one. Clicking opens the photo viewer. %>
<section class="sg-lib" data-sg-section="gallery/tiles">
  <div class="bg-page">
    <div class="mx-auto max-w-none py-0">
      <div class="mx-auto max-w-3xl px-4 pt-16 pb-10 text-center sm:px-6 lg:pt-20" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-3xl font-bold text-ink sm:text-4xl"><%= d.heading %></h2>
        <hr class="mx-auto mt-6 h-1 w-14 border-0 bg-primary">
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3" data-lightbox data-sg-cards>
        <% d.images.forEach(function (im) { %>
          <figure class="group relative cursor-zoom-in overflow-hidden">
            <img class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-105" src="<%= im.src %>" alt="<%= im.alt %>" loading="lazy">
            <figcaption class="pointer-events-none absolute inset-0 flex items-center justify-center bg-primary/90 p-6 text-center font-heading text-xl font-bold text-on-primary opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"><%= im.caption %></figcaption>
          </figure>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="py-10 text-center"><a class="inline-block rounded-full bg-primary px-8 py-3 font-bold text-on-primary transition-opacity hover:opacity-90" href="<%= d.moreHref %>">See the full gallery</a></p><% } %>
    </div>
  </div>
</section>
