<%# Adapted from HyperUI (MIT) marketing/sections/2: a heading on the left, reasons stacked on the right. %>
<section class="sg-lib" data-sg-section="why/split">
  <div class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="sg-flip grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-16">
        <div class="lg:col-span-1" data-animate="fade-up">
          <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
          <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
          <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
        </div>
        <ul class="list-none p-0 space-y-6 lg:col-span-2" data-animate="stagger">
          <% d.items.forEach(function (it) { %>
            <li class="flex gap-4">
              <% if (it.imageUrl) { %><img class="mt-1 size-16 shrink-0 rounded-lg object-cover" src="<%= it.imageUrl %>" alt="" loading="lazy" decoding="async"><% } else { %>
              <span class="mt-1 flex size-6 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary" aria-hidden="true"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
              <% } %>
              <span class="block"><span class="block font-heading text-lg font-semibold text-ink"><%= it.title %></span><% if (it.text) { %><span class="mt-1 block text-pretty text-muted"><%= it.text %></span><% } %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</section>
