<%# Adapted from HyperUI (MIT) marketing/testimonials: quote cards in a grid. %>
<section class="sg-lib" data-sg-section="testimonials/grid">
  <div class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-4 <%= ({ 1: 'md:grid-cols-1', 2: 'md:grid-cols-2', 3: 'md:grid-cols-3' })[Math.min(d.items.length, 3)] %> lg:gap-6" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <blockquote class="flex h-full flex-col rounded-xl border border-line bg-page p-6 shadow-[var(--shadow-sm)]">
            <% if (it.rating) { %><p class="text-primary" aria-label="<%= it.rating %> out of 5 stars"><%= "★".repeat(Math.round(it.rating)) %></p><% } %>
            <p class="mt-2 flex-1 text-pretty text-ink">&ldquo;<%= it.quote %>&rdquo;</p>
            <footer class="mt-4 flex items-center gap-3 text-sm"><% if (it.photo) { %><img class="size-10 shrink-0 rounded-full object-cover" src="<%= it.photo %>" alt="" loading="lazy" decoding="async"><% } %><span><span class="font-medium text-ink"><%= it.name %></span><% if (it.role) { %><span class="text-muted"> &middot; <%= it.role %></span><% } %></span></footer>
          </blockquote>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="mt-8 text-center"><a class="font-medium text-primary underline-offset-4 hover:underline" href="<%= d.moreHref %>"><%= d.moreText || 'Read more reviews' %> &rarr;</a></p><% } %>
    </div>
  </div>
</section>
