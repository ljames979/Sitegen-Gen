<%# Adapted from HyperUI (MIT) marketing/ctas/3: a rounded card floating on the page. %>
<section class="sg-lib" data-sg-section="cta/card">
  <div class="bg-page">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="flex flex-col items-start justify-between gap-6 rounded-2xl border border-line bg-surface p-8 shadow-[var(--shadow-md)] md:flex-row md:items-center sm:p-10" data-animate="fade-up">
        <div class="max-w-xl">
          <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
          <% if (d.text) { %><p class="mt-2 text-pretty text-muted"><%= d.text %></p><% } %>
        </div>
        <div class="flex flex-wrap gap-4">
          <a class="inline-block rounded-md bg-primary px-5 py-3 font-medium text-on-primary shadow-[var(--shadow-sm)] transition-opacity hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
          <% if (d.phone) { %><a class="inline-block rounded-md border border-line bg-page px-5 py-3 font-medium text-ink transition-colors hover:bg-surface" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
        </div>
      </div>
    </div>
  </div>
</section>
