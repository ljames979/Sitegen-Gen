<%# Original layout (zig-zag rows): each reason on its own row, photo and words swapping sides down the page. %>
<section class="sg-lib" data-sg-section="why/zigzag">
  <div class="bg-page">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="mt-10 space-y-10 lg:mt-14 lg:space-y-16">
        <% d.items.forEach(function (it, i) { %>
          <div class="sg-zz grid grid-cols-1 gap-6 md:grid-cols-2 md:items-center md:gap-12" data-animate="fade-up">
            <% if (it.imageUrl) { %><img class="aspect-[4/3] w-full rounded-xl object-cover shadow-[var(--shadow-sm)]" src="<%= it.imageUrl %>" alt="" loading="lazy" decoding="async"><% } else { %>
            <div class="flex aspect-[16/9] items-center justify-center rounded-xl bg-surface font-heading text-7xl font-bold text-primary" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %></div><% } %>
            <div><h3 class="font-heading text-xl font-semibold text-ink sm:text-2xl"><%= it.title %></h3><% if (it.text) { %><p class="mt-3 text-lg/relaxed text-pretty text-muted"><%= it.text %></p><% } %></div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>
