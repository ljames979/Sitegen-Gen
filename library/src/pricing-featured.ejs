<%# Original layout (one featured price beside the rest, drawn from scratch): the first priced service is the feature, on the brand color. %>
<section class="sg-lib" data-sg-section="pricing/featured">
  <div class="bg-page">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <% var first = d.items[0], rest = d.items.slice(1); %>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-5" data-animate="stagger">
        <div class="flex flex-col rounded-2xl bg-primary p-8 shadow-[var(--shadow-md)] <%= rest.length ? 'md:col-span-3' : 'md:col-span-5' %>">
          <h3 class="font-heading text-xl font-semibold text-on-primary"><%= first.title %></h3>
          <p class="mt-4 font-heading text-5xl font-bold text-on-primary"><%= first.price %></p>
          <% if (first.description) { %><p class="mt-4 flex-1 text-pretty text-on-primary opacity-90"><%= first.description %></p><% } %>
          <a class="mt-6 inline-block self-start rounded-md bg-page px-5 py-3 font-medium text-ink transition-opacity hover:opacity-90" href="<%= first.href %>">Get started</a>
        </div>
        <% if (rest.length) { %>
          <ul class="list-none space-y-4 p-0 md:col-span-2">
            <% rest.forEach(function (it) { %>
              <li class="rounded-xl border border-line bg-surface p-5">
                <div class="flex items-baseline justify-between gap-3"><span class="font-heading font-semibold text-ink"><%= it.title %></span><span class="font-heading text-xl font-bold text-primary"><%= it.price %></span></div>
                <% if (it.description) { %><p class="mt-1 text-sm/relaxed text-pretty text-muted"><%= it.description %></p><% } %>
                <a class="mt-2 inline-block text-sm font-medium text-primary underline-offset-4 hover:underline" href="<%= it.href %>">Details &rarr;</a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
</section>
