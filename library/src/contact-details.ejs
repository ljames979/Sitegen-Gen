<%# Adapted from HyperUI (MIT) marketing/sections contact layouts: only details the client gave us. %>
<section class="sg-lib" data-sg-section="contact/details">
  <div class="bg-surface">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="text-sm font-medium tracking-wide text-primary uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="font-heading text-2xl font-semibold text-ink sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="mt-3 text-pretty text-muted"><%= d.intro %></p><% } %>
      </div>
      <dl class="mt-8 grid grid-cols-1 gap-4 text-center <%= ({ 1: 'sm:grid-cols-1', 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-3' })[Math.min(d.items.length, 3)] %>" data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <div class="rounded-xl border border-line bg-page p-6">
            <dt class="text-sm font-medium tracking-wide text-muted uppercase"><%= it.label %></dt>
            <dd class="mt-2 font-heading text-lg font-semibold text-ink"><% if (it.href) { %><a class="text-primary underline-offset-4 hover:underline" href="<%= it.href %>"><%= it.value %></a><% } else { %><%= it.value %><% } %></dd>
          </div>
        <% }) %>
      </dl>
      <% if (d.ctaHref) { %><p class="mt-8 text-center"><a class="inline-block rounded-md bg-primary px-5 py-3 font-medium text-on-primary shadow-[var(--shadow-sm)] transition-opacity hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a></p><% } %>
    </div>
  </div>
</section>
