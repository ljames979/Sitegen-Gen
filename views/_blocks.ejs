    </section>
    <% } else if (_pv) { %>
    <section data-sg-blk="<%= blk._i %>" class="blk blk-bg-<%= bg %> blk-empty" style="padding:2.5rem 1rem;text-align:center;opacity:.7;border:2px dashed currentColor;margin:1rem">Photo banner: add a heading to show it (only you see this)</section>
    <% } %>
  <% } %>
  <% if (blk.type === 'strip') { %>
    <% const pics = (blk.body || '').split('\n').map(u => u.trim()).filter(Boolean).slice(0, 20); %>
    <% if (pics.length) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-strip blk-bg-<%= bg %><%= ec %>">
      <% if (blk.heading) { %><div class="blk-inner"><h2 style="text-align:center;"><%= blk.heading %></h2></div><% } %>
      <div class="strip-wrap">
        <button type="button" class="strip-btn prev" aria-label="Scroll left">&lsaquo;</button>
        <div class="strip" data-lightbox tabindex="0" aria-label="<%= blk.heading || 'Photos' %>">
          <% pics.forEach(u => { %><img src="<%= u %>" alt="<%= blk.heading || site.name %>" loading="lazy" decoding="async"><% }) %>
        </div>
        <button type="button" class="strip-btn next" aria-label="Scroll right">&rsaquo;</button>
      </div>
      <% if (blk.buttonText && blk.buttonUrl) { %><p class="blk-cta"><a class="btn" href="<%= blk.buttonUrl %>"<%- /^https?:/i.test(blk.buttonUrl) ? ' target="_blank" rel="noopener"' : '' %>><%= blk.buttonText %></a></p><% } %>
    </section>
    <% } %>
  <% } else if (blk.type === 'split') { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-bg-<%= bg %><%= ec %>">
      <div class="blk-inner blk-split" data-reveal>
        <div class="split-head"><% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %></div>
        <div class="split-text">
          <% (blk.body || '').split(/\n{2,}/).filter(Boolean).forEach(par => { %><p><%= par %></p><% }) %>
          <% if (blk.buttonText && blk.buttonUrl) { %><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a><% } %>
        </div>
      </div>
    </section>
  <% } %>
<% if (_ht.cls) { %></div><% } %>
<% if (_ix.cls) { %></div><% } %>
<% if (_film.cls) { %></div><% } %>
<% if (_pin.cls) { %></div><% } %>
<% }) %>
