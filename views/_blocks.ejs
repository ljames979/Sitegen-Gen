<%# Content blocks on the home page. Pass `place` ('top' or 'bottom'). %>
<% const _pv = typeof preview !== 'undefined' && !!preview && String(typeof basePath !== 'undefined' ? basePath : '').startsWith('/sites/');   // the owner's own preview, not a link shared with the client
   // in the editor's preview each block names its row (its place in the list), so a click or the ↑ ↓ bar finds it
   // `only` draws one block by its id (a block placed on a Blocks home page); `skipIds` leaves those blocks out.
   // A block hidden in Page sections is never drawn.
   const _hid = (site.layout && site.layout.hidden) || [], _only = typeof only !== 'undefined' ? only : '', _skip = typeof skipIds !== 'undefined' ? skipIds : [];
   const _blocks = ((site.sections.blocks && site.sections.blocks.items) || []).map((b, i) => (_pv ? { ...b, _i: i } : b))
     .filter(b => !(b.id && _hid.includes('blk:' + b.id)))
     .filter(b => _only ? b.id === _only : !(b.id && _skip.includes(b.id)) && (b.place || 'bottom') === place && (b.page || 'home') === (typeof pageKey !== 'undefined' ? pageKey : 'home')); %>
<% let _photoIdx = 0; %>
<% _blocks.forEach(blk => { %>
  <% const _pin = pinFx.attrs(blk.pin); if (_pin.cls) { %><div class="<%= _pin.cls.trim() %>"<% if (_pin.style) { %> style="<%= _pin.style %>"<% } %>><% } %>
  <% const _film = filmFx.attrs(blk.film, site.theme); if (_film.cls) { %><div class="<%= _film.cls.trim() %>" style="<%= _film.style %>"><% } %>
  <% const _ix = imgFx.attrs(blk.imgfx); if (_ix.cls) { %><div class="<%= _ix.cls.trim() %>"><% } %>
  <% const _ht = heightFx.attrs(blk.height); if (_ht.cls) { %><div class="<%= _ht.cls.trim() %>"<% if (_ht.style) { %> style="<%= _ht.style %>"<% } %>><% } %>
  <% // a gallery gradient that blends into the block's own color: the block keeps that plain color, the gradient goes on as a class (gradients.headCss)
     const _gbc = String(blk.bg || '').startsWith('g-') && blk.bgmix ? gradients.blendClass(blk.bg.slice(2), gradients.blockMix(blk), blk.bgink, blk.gx) : '';
     const _gic = String(blk.bg || '').startsWith('g-') && !blk.bgmix ? gradients.inkClass(blk.bg.slice(2), blk.bgink) : '';   // a texture in chosen colors
     // its intensity (turned up or down) and a gradient on the cards inside it (gradients.headCss writes their CSS)
     const _gxc = String(blk.bg || '').startsWith('g-') && !blk.bgmix ? gradients.strengthClass(blk.gx) : '', _cgc = gradients.cardClass(blk.cardbg, blk.cardgx);
     const bg = _gbc ? blk.bgmix : (blk.bg || 'none'); const ec = ((blk.edge === 'wave' || blk.edge === 'scallop') ? ' edge-' + blk.edge : '') + (_gbc ? ' ' + _gbc : '') + (_gic ? ' ' + _gic : '') + (_gxc ? ' ' + _gxc : '') + (_cgc ? ' ' + _cgc : ''); %>
  <% if (blk.type === 'photoText') { %>
    <% const side = blk.side === 'left' || blk.side === 'right' ? blk.side : (_photoIdx % 2 === 0 ? 'right' : 'left'); _photoIdx++; %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-bg-<%= bg %><%= ec %>">
      <div class="blk-inner blk-photo <%= blk.imageUrl ? 'photo-' + side : 'no-photo' %>" data-reveal>
        <% if (blk.imageUrl) { %><div class="blk-img"><img src="<%= blk.imageUrl %>" alt="<%= blk.heading || site.name %>" loading="lazy" decoding="async"></div><% } %>
        <div class="blk-text">
          <% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %>
          <% (blk.body || '').split(/\n{2,}/).filter(Boolean).forEach(par => { %><p><%= par %></p><% }) %>
          <% if (blk.buttonText && blk.buttonUrl) { %><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a><% } %>
        </div>
      </div>
    </section>
  <% } else if (blk.type === 'steps') { %>
    <% const steps = (blk.body || '').split('\n').map(l => l.trim()).filter(Boolean).slice(0, 8).map(l => { const i = l.indexOf('|'); return i > -1 ? { t: l.slice(0, i).trim(), d: l.slice(i + 1).trim() } : { t: l, d: '' }; }); %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-bg-<%= bg === 'none' ? 'tint' : bg %><%= ec %>">
      <div class="blk-inner blk-steps" data-reveal>
        <% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %>
        <% if (blk.side === 'stack') { %>
        <ol class="steps-stack">
          <% steps.forEach((st, i) => { %>
            <li style="--i: <%= i %>"><span class="step-num"><%= i + 1 %></span><div><strong><%= st.t %></strong><% if (st.d) { %><p><%= st.d %></p><% } %></div></li>
          <% }) %>
        </ol>
        <% } else if (blk.side === 'timeline') { %>
        <ol class="steps-timeline">
          <% steps.forEach((st, i) => { %>
            <li><span class="step-num"><%= i + 1 %></span><strong><%= st.t %></strong><% if (st.d) { %><p><%= st.d %></p><% } %></li>
          <% }) %>
        </ol>
        <% } else { %>
        <div class="steps-grid">
          <% steps.forEach((st, i) => { %>
            <div class="step-card"><span class="step-num"><%= i + 1 %></span><div><strong><%= st.t %></strong><% if (st.d) { %><p><%= st.d %></p><% } %></div></div>
          <% }) %>
        </div>
        <% } %>
        <% if (blk.buttonText && blk.buttonUrl) { %><p class="blk-cta"><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a></p><% } %>
      </div>
    </section>
  <% } %>
  <% if (blk.type === 'features') { %>
    <% const feats = (blk.body || '').split('\n').map(l => l.trim()).filter(Boolean).slice(0, 8).map(l => { const i = l.indexOf('|'); return i > -1 ? { t: l.slice(0, i).trim(), d: l.slice(i + 1).trim() } : { t: l, d: '' }; }); %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-bg-<%= bg %><%= ec %>">
      <div class="blk-inner blk-steps" data-reveal>
        <% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %>
        <div class="feat-grid">
          <% feats.forEach(f => { %>
            <div class="feat-card">
              <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- icons.iconPath(f.t, '') %></svg>
              <strong><%= f.t %></strong><% if (f.d) { %><p><%= f.d %></p><% } %>
            </div>
          <% }) %>
        </div>
        <% if (blk.buttonText && blk.buttonUrl) { %><p class="blk-cta"><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a></p><% } %>
      </div>
    </section>
  <% } else if (blk.type === 'cta') { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-cta-band<%= blk.imageUrl ? ' has-photo' : '' %><%= !blk.imageUrl && (bg.startsWith('g-') || (_gbc && bg !== 'none')) ? ' blk-bg-' + bg : '' %><%= ec %>" <% if (blk.imageUrl) { %>style="background-image: linear-gradient(rgba(10,20,35,.62), rgba(10,20,35,.62)), url('<%= blk.imageUrl %>')"<% } %>>
      <div class="blk-inner" data-reveal>
        <% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %>
        <% (blk.body || '').split(/\n{2,}/).filter(Boolean).forEach(par => { %><p><%= par %></p><% }) %>
        <% if (blk.buttonText && blk.buttonUrl) { %><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a><% } %>
      </div>
    </section>
  <% } else if (blk.type === 'chips') { %>
    <% const chips = (blk.body || '').split('\n').map(l => l.trim()).filter(Boolean).slice(0, 40).map(l => { const i = l.indexOf('|'); return i > -1 ? { t: l.slice(0, i).trim(), u: l.slice(i + 1).trim() } : { t: l, u: '' }; }); %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-bg-<%= bg %><%= ec %>">
      <div class="blk-inner blk-steps" data-reveal>
        <% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %>
        <div class="chip-grid">
          <% chips.forEach(ch => { %>
            <% if (ch.u && /^(https?:\/\/|\/)/i.test(ch.u)) { %><a class="chip" href="<%= ch.u %>"><%= ch.t %></a><% } else { %><span class="chip"><%= ch.t %></span><% } %>
          <% }) %>
        </div>
        <% if (blk.buttonText && blk.buttonUrl) { %><p class="blk-cta"><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a></p><% } %>
      </div>
    </section>
  <% } %>
  <% if (blk.type === 'team') { %>
    <% const people = (blk.body || '').split('\n').map(l => l.split('|').map(x => x.trim())).filter(p => p[0]).slice(0, 12); %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-bg-<%= bg %><%= ec %>">
      <div class="blk-inner blk-steps" data-reveal>
        <% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %>
        <div class="team-grid">
          <% people.forEach(pp => { %>
            <div class="team-card">
              <% if (pp[3]) { %><img src="<%= pp[3] %>" alt="<%= pp[0] %>" loading="lazy" decoding="async"><% } else { %><span class="team-initial" aria-hidden="true"><%= pp[0].charAt(0).toUpperCase() %></span><% } %>
              <h3><%= pp[0] %></h3>
              <% if (pp[1]) { %><div class="team-role"><%= pp[1] %></div><% } %>
              <% if (pp[2]) { %><p><%= pp[2] %></p><% } %>
            </div>
          <% }) %>
        </div>
        <% if (blk.buttonText && blk.buttonUrl) { %><p class="blk-cta"><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a></p><% } %>
      </div>
    </section>
  <% } else if (blk.type === 'stats') { %>
    <% const stats = (blk.body || '').split('\n').map(l => { const i = l.indexOf('|'); return i > -1 ? { n: l.slice(0, i).trim(), t: l.slice(i + 1).trim() } : { n: l.trim(), t: '' }; }).filter(x => x.n).slice(0, 6); %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-bg-<%= bg === 'none' ? 'tint' : bg %><%= ec %>">
      <div class="blk-inner blk-steps" data-reveal>
        <% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %>
        <div class="stats-row">
          <% stats.forEach(st => { %><div class="stat"><div class="stat-num"<%- motionLib.countAttrs(st.n) %>><%= st.n %></div><% if (st.t) { %><div class="stat-label"><%= st.t %></div><% } %></div><% }) %>
        </div>
      </div>
    </section>
  <% } else if (blk.type === 'video') { %>
    <% const vi = videoInfo(blk.body); %>
    <% if (vi) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-bg-<%= bg %><%= ec %>">
      <div class="blk-inner blk-video" data-reveal>
        <% if (blk.heading) { %><h2<%- vi.kind === 'file' && videoMask.clean(blk.side) === 'text' ? ' class="vm-sr"' : '' %>><%= blk.heading %></h2><% } %>
        <% const _vm = vi.kind === 'file' ? videoMask.clean(blk.side) : 'auto'; %>
        <% if (_vm === 'text') { %>
          <div class="vm vm-text"><video src="<%= vi.src %>" muted loop playsinline autoplay preload="metadata" aria-hidden="true"></video><p class="vm-words" aria-hidden="true"><%= wordStyle.plain(blk.heading || site.name) %></p></div>
        <% } else if (_vm === 'grow') { %>
          <div class="vm vm-grow"><video src="<%= vi.src %>" muted loop playsinline autoplay preload="metadata"></video></div>
        <% } else if (_vm !== 'auto') { %>
          <div class="vm vm-shape vm-<%= _vm %>" style="clip-path:<%= videoMask.SHAPES[_vm] %>"><video src="<%= vi.src %>" muted loop playsinline autoplay preload="metadata"></video></div>
        <% } else if (vi.kind === 'file') { %>
          <video controls playsinline preload="metadata" src="<%= vi.src %>"></video>
        <% } else { %>
          <div class="video-frame" data-embed="<%= vi.embed %>" style="<%= vi.poster ? "background-image:url('" + vi.poster + "')" : '' %>">
            <button type="button" class="video-play" aria-label="Play video<%= blk.heading ? ': ' + blk.heading : '' %>"><svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button>
          </div>
        <% } %>
        <% if (blk.buttonText && blk.buttonUrl) { %><p class="blk-cta"><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a></p><% } %>
      </div>
    </section>
    <% } %>
  <% } else if (blk.type === 'tabs' || blk.type === 'accordion') { %>
    <% const items = (blk.body || '').split('\n').map(l => { const i = l.indexOf('|'); return i > -1 ? { t: l.slice(0, i).trim(), d: l.slice(i + 1).trim() } : { t: l.trim(), d: '' }; }).filter(x => x.t).slice(0, 8); %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-bg-<%= bg %><%= ec %>">
      <div class="blk-inner blk-steps" data-reveal>
        <% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %>
        <% if (blk.type === 'accordion') { %>
          <div class="acc-list">
            <% items.forEach((it, n) => { %><details class="acc-item"<%= n === 0 ? ' open' : '' %>><summary><%= it.t %></summary><p><%= it.d %></p></details><% }) %>
          </div>
        <% } else { %>
          <div class="tabs-box" data-tabs>
            <div class="tabs-bar" role="tablist"><% items.forEach((it, n) => { %><button type="button" role="tab" class="tab-btn<%= n === 0 ? ' on' : '' %>" aria-selected="<%= n === 0 %>"><%= it.t %></button><% }) %></div>
            <% items.forEach((it, n) => { %><div class="tab-panel" role="tabpanel"<%= n === 0 ? '' : ' data-off' %>><p><%= it.d %></p></div><% }) %>
          </div>
        <% } %>
        <% if (blk.buttonText && blk.buttonUrl) { %><p class="blk-cta"><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a></p><% } %>
      </div>
    </section>
  <% } %>
  <% if (blk.type === 'pricing') { %>
    <% const plans = (blk.body || '').split('\n').map(l => l.trim()).filter(Boolean).slice(0, 6).map(l => {
         const hot = l.startsWith('*'); const parts = (hot ? l.slice(1) : l).split('|').map(x => x.trim());
         return { hot, name: parts[0] || '', price: parts[1] || '', items: (parts.slice(2).join(',') || '').split(',').map(x => x.trim()).filter(Boolean).slice(0, 12) };
       }).filter(p => p.name); %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-bg-<%= bg %><%= ec %>">
      <div class="blk-inner blk-steps" data-reveal>
        <% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %>
        <div class="price-grid n<%= plans.length %>">
          <% plans.forEach(pl => { %>
            <div class="price-card<%= pl.hot ? ' hot' : '' %>">
              <% if (pl.hot) { %><span class="price-flag">Featured</span><% } %>
              <h3><%= pl.name %></h3>
              <% if (pl.price) { %><div class="price-amt"><%= pl.price %></div><% } %>
              <% if (pl.items.length) { %><ul><% pl.items.forEach(it => { %><li><%= it %></li><% }) %></ul><% } %>
              <% if (blk.buttonText && blk.buttonUrl) { %><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a><% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>
  <% if (blk.type === 'wall') { %>
    <% const ws = brandWall.settings(blk.side), wallTiles = brandWall.tiles(site, blk), wallCols = brandWall.columns(wallTiles, 5); %>
    <% if (wallTiles.length) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-wall blk-bg-<%= bg === 'none' ? 'dark' : bg %><%= ec %>">
      <div class="wall wall-<%= ws.size %>" data-sg-wall style="--wall-tilt: <%= ws.deg %>deg; --wall-secs: <%= ws.secs %>s;<%= ws.height ? ' --wall-h: ' + ws.height + 'px;' : '' %> <%= brandWall.styleVars(site.theme) %>">
        <div class="wall-plane" aria-hidden="true">
          <% wallCols.forEach((col, c) => { %>
            <div class="wall-col wall-c<%= c %><%= c % 2 ? ' wall-down' : '' %>"><div class="wall-track">
              <% [0, 1].forEach(() => { col.forEach(w => { %>
                <%- include('_wall-card', { w }) %>
              <% }) }) %>
            </div></div>
          <% }) %>
        </div>
        <% if (blk.heading || (blk.buttonText && blk.buttonUrl)) { %>
          <div class="wall-over">
            <div class="wall-card" data-reveal>
              <% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %>
              <% if (blk.buttonText && blk.buttonUrl) { %><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a><% } %>
            </div>
          </div>
        <% } %>
        <button type="button" class="wall-pause" data-sg-wall-pause aria-pressed="false" aria-label="Pause the moving wall"><svg class="wp-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg><svg class="wp-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg></button>
      </div>
    </section>
    <% } %>
  <% } %>
  <% if (blk.type === 'cascade') { %>
    <% const cs = cardCascade.settings(blk.side), csCards = cardCascade.cards(site, blk), csText = blk.heading || (blk.buttonText && blk.buttonUrl); %>
    <% if (csCards.length) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-cascade blk-bg-<%= bg %><%= ec %>">
      <div class="cascade<%= csText ? ' cascade-split' : '' %>" data-sg-wall style="--cd-secs: <%= cs.secs %>s; --cd-n: <%= csCards.length %>;<%= cs.height ? ' --cd-h: ' + cs.height + 'px;' : '' %> <%= cardCascade.styleVars(site.theme) %>">
        <% if (csText) { %>
          <div class="cascade-text" data-reveal>
            <% if (blk.heading) { %><h2><%= blk.heading %></h2><% } %>
            <% if (blk.buttonText && blk.buttonUrl) { %><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a><% } %>
          </div>
        <% } %>
        <div class="cascade-stage" aria-hidden="true">
          <% csCards.forEach(w => { %><%- include('_wall-card', { w, extra: 'style="--x: ' + w.x + '; --y: ' + w.y + '; --i: ' + w.i + '"' }) %><% }) %>
        </div>
        <button type="button" class="wall-pause" data-sg-wall-pause data-what="card cascade" aria-pressed="false" aria-label="Pause the card cascade"><svg class="wp-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg><svg class="wp-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg></button>
      </div>
    </section>
    <% } %>
  <% } %>
  <% if (blk.type === 'beforeAfter') { %>
    <% const _pairs = ((site.sections.gallery && site.sections.gallery.beforeAfter) || []).slice(0, 6); %>
    <% if (_pairs.length) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-ba blk-bg-<%= bg %><%= ec %>">
      <div class="blk-inner" data-reveal>
        <% if (blk.heading) { %><h2 style="text-align:center;"><%= blk.heading %></h2><% } %>
        <% (blk.body || '').split(/\n{2,}/).filter(Boolean).forEach(par => { %><p style="text-align:center;"><%= par %></p><% }) %>
        <div class="ba-grid">
          <% _pairs.forEach(p => { %>
            <div>
              <div class="ba-slider">
                <img src="<%= p.after %>" alt="After<%= p.caption ? ': ' + p.caption : '' %>" loading="lazy" decoding="async">
                <img class="ba-b" src="<%= p.before %>" alt="Before<%= p.caption ? ': ' + p.caption : '' %>" loading="lazy" decoding="async">
                <span class="ba-tag">Before</span><span class="ba-tag after">After</span>
                <span class="ba-line" aria-hidden="true"></span>
                <input type="range" min="0" max="100" value="50" aria-label="Slide to compare before and after<%= p.caption ? ': ' + p.caption : '' %>">
              </div>
              <% if (p.caption) { %><p class="ba-caption"><%= p.caption %></p><% } %>
            </div>
          <% }) %>
        </div>
        <% if (blk.buttonText && blk.buttonUrl) { %><p style="text-align:center;"><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a></p><% } %>
      </div>
    </section>
    <% } else if (_pv) { %>
    <section data-sg-blk="<%= blk._i %>" class="blk blk-bg-<%= bg %> blk-empty" style="padding:2.5rem 1rem;text-align:center;opacity:.7;border:2px dashed currentColor;margin:1rem">Before / after: add photo pairs under Gallery to show them (only you see this)</section>
    <% } %>
  <% } %>
  <% if (blk.type === 'trail') { %>
    <% const tr = motionBlocks.trail(site, blk, typeof services !== 'undefined' ? services : (site.sections.services || {}).items); %>
    <% if (tr) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-trail blk-bg-<%= bg %><%= ec %>">
      <div class="sg-trail" data-sg-trail data-photos="<%= JSON.stringify(tr.photos) %>">
        <div class="sg-trail-text">
          <% if (blk.heading) { %><h2 class="sg-trail-h"><%- tr.headingHtml %></h2><% } %>
          <% tr.lines.forEach(t => { %><p><%= t %></p><% }) %>
          <% if (blk.buttonText && blk.buttonUrl) { %><p><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a></p><% } %>
        </div>
        <div class="sg-trail-still" aria-hidden="true"><% tr.photos.slice(0, 5).forEach((src, i) => { %><img src="<%= src %>" alt="" loading="lazy" decoding="async" style="--i: <%= i %>"><% }) %></div>
      </div>
    </section>
    <% } else if (_pv) { %>
    <section data-sg-blk="<%= blk._i %>" class="blk blk-bg-<%= bg %> blk-empty" style="padding:2.5rem 1rem;text-align:center;opacity:.7;border:2px dashed currentColor;margin:1rem">Photo trail: it needs 3 photos (yours or the site's) (only you see this)</section>
    <% } %>
  <% } %>
  <% if (blk.type === 'wave') { %>
    <% const wv = motionBlocks.wave(site, blk, typeof services !== 'undefined' ? services : (site.sections.services || {}).items); %>
    <% if (wv) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-wave blk-bg-<%= bg %><%= ec %>">
      <div class="sg-wave" data-sg-wave<% if (wv.shape) { %> data-sg-shape="<%= wv.shape %>"<% } %>>
        <div class="sg-wave-pin">
          <% if (wv.left || wv.right) { %><h2 class="sg-wave-words"><span class="sg-wave-l"><%= wv.left %></span> <span class="sg-wave-r"><%= wv.right %></span></h2><% } %>
          <% if (wv.text || (blk.buttonText && blk.buttonUrl)) { %><div class="sg-wave-text"><% if (wv.text) { %><p><%= wv.text %></p><% } %><% if (blk.buttonText && blk.buttonUrl) { %><p><a class="btn" href="<%= blk.buttonUrl %>"><%= blk.buttonText %></a></p><% } %></div><% } %>
          <div class="sg-wave-stage" aria-hidden="true"><% wv.pics.forEach(src => { %><img class="sg-wave-pic" src="<%= src %>" alt="" loading="lazy" decoding="async"><% }) %></div>
        </div>
      </div>
    </section>
    <% } else if (_pv) { %>
    <section data-sg-blk="<%= blk._i %>" class="blk blk-bg-<%= bg %> blk-empty" style="padding:2.5rem 1rem;text-align:center;opacity:.7;border:2px dashed currentColor;margin:1rem">Photo wave: it needs 4 photos (yours or the site's) (only you see this)</section>
    <% } %>
  <% } %>
  <% if (blk.type === 'bigwords') { %>
    <% const bw = motionBlocks.bigwords(site, blk, typeof services !== 'undefined' ? services : (site.sections.services || {}).items); %>
    <% if (bw) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-bigw blk-bg-<%= bg %><%= ec %>">
      <div class="sg-bigw" data-sg-bigw>
        <% if (bw.caption) { %><p class="sg-bigw-cap"><%= bw.caption %></p><% } %>
        <h2 class="sg-bigw-h" aria-label="<%= bw.label %>"><% bw.rows.forEach(row => { %><span class="sg-bigw-row" aria-hidden="true"><% row.forEach(p => { %><% if (p.photo) { %><span class="sg-bigw-ph" style="--i: <%= p.i %>"><img src="<%= p.photo %>" alt="" decoding="async"></span> <% } else { %><span class="sg-bigw-w" style="--i: <%= p.i %>"><%= p.t %></span> <% } %><% }) %></span><% }) %></h2>
        <% if (bw.button) { %><p class="sg-bigw-cta"><a class="btn" href="<%= bw.button.url %>"><%= bw.button.text %></a></p><% } %>
      </div>
    </section>
    <% } else if (_pv) { %>
    <section data-sg-blk="<%= blk._i %>" class="blk blk-bg-<%= bg %> blk-empty" style="padding:2.5rem 1rem;text-align:center;opacity:.7;border:2px dashed currentColor;margin:1rem">Big words: type a heading or some lines to show it (only you see this)</section>
    <% } %>
  <% } %>
  <% const _mbSvc = typeof services !== 'undefined' ? services : (site.sections.services || {}).items; %>
  <% const _mbEmpty = (what) => _pv ? '<section data-sg-blk="' + blk._i + '" class="blk blk-bg-' + bg + ' blk-empty" style="padding:2.5rem 1rem;text-align:center;opacity:.7;border:2px dashed currentColor;margin:1rem">' + what + ' (only you see this)</section>' : ''; %>
  <% if (blk.type === 'story') { %>
    <% const st = motionBlocks.story(site, blk, _mbSvc); %>
    <% if (st) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-story blk-bg-<%= bg %><%= ec %>">
      <div class="sg-story" data-sg-scrollstory style="--n: <%= st.steps.length %>">
        <div class="sg-story-pin">
          <div class="sg-story-text">
            <% if (blk.heading) { %><h2 class="sg-story-h"><%- st.headingHtml %></h2><% } %>
            <div class="sg-story-bar" aria-hidden="true"><span></span></div>
            <ol class="sg-story-steps">
              <% st.steps.forEach((x, i) => { %><li class="sg-story-step" style="--i: <%= i %>"><span class="sg-story-num"><%= String(i + 1).padStart(2, '0') %></span><h3><%= x.t %></h3><% if (x.d) { %><p><%= x.d %></p><% } %><% if (x.photo) { %><img class="sg-story-ph-m" src="<%= x.photo %>" alt="" loading="lazy" decoding="async"><% } %></li><% }) %>
            </ol>
            <% if (st.button) { %><p class="sg-story-cta"><a class="btn" href="<%= st.button.url %>"><%= st.button.text %></a></p><% } %>
          </div>
          <div class="sg-story-pics" aria-hidden="true"><% st.steps.forEach((x, i) => { if (x.photo) { %><img class="sg-story-pic" style="--i: <%= i %>" src="<%= x.photo %>" alt="" loading="lazy" decoding="async"><% } }) %></div>
        </div>
      </div>
    </section>
    <% } else { %><%- _mbEmpty('Scroll story: type 2 or more steps, one per line (Title | words)') %><% } %>
  <% } %>
  <% if (blk.type === 'path') { %>
    <% const pt = motionBlocks.path(site, blk, _mbSvc); %>
    <% if (pt) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-path blk-bg-<%= bg %><%= ec %>">
      <div class="sg-path" data-sg-path>
        <div class="sg-path-pin">
          <% if (blk.heading) { %><h2 class="sg-path-h"><%- pt.headingHtml %></h2><% } %>
          <div class="sg-path-stage">
            <svg class="sg-path-line" aria-hidden="true" preserveAspectRatio="none"><path d=""></path></svg>
            <% pt.photos.forEach((src, i) => { %><img class="sg-path-pic sg-path-item" src="<%= src %>" alt="" loading="lazy" decoding="async"><% }) %>
            <% pt.lines.forEach(l => { %><span class="sg-path-word sg-path-item"><%= l %></span><% }) %>
          </div>
          <% if (pt.button) { %><p class="sg-path-cta"><a class="btn" href="<%= pt.button.url %>"><%= pt.button.text %></a></p><% } %>
        </div>
      </div>
    </section>
    <% } else { %><%- _mbEmpty('Path travel: it needs 3 photos (yours or the site\'s)') %><% } %>
  <% } %>
  <% if (blk.type === 'zoomword') { %>
    <% const zw = motionBlocks.zoomword(site, blk, _mbSvc); %>
    <% if (zw) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-zoomw blk-bg-<%= bg %><%= ec %>">
      <div class="sg-zw" data-sg-zoomword style="--len: <%= Math.max(4, zw.word.length) %>; --zw-img: url('<%= zw.photo.replace(/'/g, '') %>')">
        <div class="sg-zw-pin">
          <div class="sg-zw-photo" aria-hidden="true"></div>
          <h2 class="sg-zw-word"><%= zw.word %></h2>
          <% if (zw.text || zw.button) { %><div class="sg-zw-text"><% if (zw.text) { %><p><%= zw.text %></p><% } %><% if (zw.button) { %><p><a class="btn" href="<%= zw.button.url %>"><%= zw.button.text %></a></p><% } %></div><% } %>
        </div>
      </div>
    </section>
    <% } else { %><%- _mbEmpty('Zoom through the word: type the word as the heading; it needs a photo (yours or the hero\'s)') %><% } %>
  <% } %>
  <% if (blk.type === 'morph') { %>
    <% const mo = motionBlocks.morph(site, blk, _mbSvc); %>
    <% if (mo) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-morph blk-bg-<%= bg %><%= ec %>">
      <div class="blk-inner sg-morph" data-sg-morph>
        <div class="sg-morph-text">
          <% if (blk.heading) { %><h2><%- mo.headingHtml %></h2><% } %>
          <% mo.paras.forEach(t => { %><p><%= t %></p><% }) %>
          <% if (mo.button) { %><p><a class="btn" href="<%= mo.button.url %>"><%= mo.button.text %></a></p><% } %>
        </div>
        <div class="sg-morph-fig" aria-hidden="true"><img class="sg-morph-img" src="<%= mo.photo %>" alt="" loading="lazy" decoding="async"></div>
      </div>
    </section>
    <% } else { %><%- _mbEmpty('Shape morph: type a heading; it needs a photo (yours, About\'s or the site\'s)') %><% } %>
  <% } %>
  <% if (blk.type === 'nodes') { %>
    <% const nc = nodeCards.view(site, blk, _mbSvc); %>
    <% if (nc) { %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-nodes blk-bg-<%= bg %><%= ec %>">
      <div class="blk-inner sg-nc sg-nc-<%= nc.change === 'slide' ? 'slide' : 'fade' %>" data-sg-nodes data-sg-wall data-change="<%= nc.change %>">
        <% if (blk.heading || nc.sub.length || nc.button) { %><div class="sg-nc-head">
          <% if (blk.heading) { %><h2 class="sg-nc-h"><%- nc.headingHtml %><% if (nc.roll.length) { %> <span class="sg-ps-roll" data-sg-roll aria-hidden="true"><span class="sg-ps-rail"><% nc.roll.forEach(t => { %><span><%= t %></span><% }) %></span></span><span class="sg-ps-sr"><%= nc.roll.join(', ') %></span><% } %></h2><% } %>
          <% if (nc.sub.length) { %><p class="sg-nc-sub"><% nc.sub.forEach((t, i) => { %><%= t %><% if (i < nc.sub.length - 1) { %><br><% } %><% }) %></p><% } %>
          <% if (nc.button) { %><p class="sg-nc-sub sg-nc-cta"><a class="btn" href="<%= nc.button.url %>"><%= nc.button.text %></a></p><% } %>
        </div><% } %>
        <div class="sg-nc-graph" style="--nc-cols: <%= nc.grid %>">
          <svg class="sg-nc-wires" aria-hidden="true" focusable="false"></svg>
          <% nc.cols.forEach((col, ci) => { %><div class="sg-nc-col sg-nc-c<%= ci + 1 %><%= col.big ? ' sg-nc-big' : '' %>">
            <% col.cards.forEach(c => { %><figure class="sg-nc-card<%= c.words ? ' sg-nc-note' : '' %>">
              <% if (c.label || c.tag) { %><figcaption class="sg-nc-lab"><% if (c.label) { %><b><%= c.label %></b><% } %><% if (c.tag) { %><span><%= c.tag %></span><% } %></figcaption><% } %>
              <% if (c.words) { %><div class="sg-nc-frame sg-nc-words"><p><%= c.words %></p></div><% } else { %><div class="sg-nc-frame sg-nc-pics" aria-hidden="true"><% c.pics.forEach((src, i) => { %><img<%- i === 0 ? ' class="sg-on"' : '' %> src="<%= src %>" alt="" loading="lazy" decoding="async"><% }) %></div><% } %>
            </figure><% }) %>
          </div><% }) %>
          <% if (nc.changes || nc.rolls) { %><button type="button" class="wall-pause sg-nc-pause" data-sg-wall-pause data-what="moving words and pictures" aria-pressed="false" aria-label="Pause the moving words and pictures"><svg class="wp-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg><svg class="wp-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg></button><% } %>
        </div>
      </div>
    </section>
    <% } else { %><%- _mbEmpty('Connected photo cards: it needs 3 cards (or 3 services) and photos for at least two of them (yours or the site\'s)') %><% } %>
  <% } %>
  <% if (blk.type === 'stack') { %>
    <% const sk = stackCards.view(site, blk, _mbSvc), skN = sk.cards.length; %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-stack blk-bg-<%= bg %><%= ec %>">
      <div class="sg-sk sg-sk-<%= sk.colors %>" data-sg-stack style="--n: <%= skN %>">
        <div class="sg-sk-pin">
          <div class="blk-inner sg-sk-grid">
            <div class="sg-sk-text">
              <% if (sk.label) { %><p class="sg-sk-label"><%= sk.label %></p><% } %>
              <% if (blk.heading) { %><h2 class="sg-sk-h"><%- sk.headingHtml %></h2><% } %>
              <% if (sk.rating || sk.ratingText) { %><p class="sg-sk-rate"><% if (sk.rating) { %><span class="sg-sk-stars" role="img" aria-label="<%= sk.rating.value %> out of 5 stars"><% for (let i = 0; i < sk.rating.full; i++) { %><span>★</span><% } %><% if (sk.rating.half) { %><span class="half">★</span><% } %><% for (let i = 0; i < sk.rating.empty; i++) { %><span class="off">★</span><% } %></span> <b><%= sk.rating.value %></b><% } %> <%= sk.ratingText %></p><% } %>
              <% if (sk.button) { %><p class="sg-sk-cta"><a class="btn" href="<%= sk.button.url %>"><%= sk.button.text %></a></p><% } %>
              <div class="sg-sk-nav">
                <button type="button" class="sg-sk-arrow" data-sk="prev" aria-label="Previous card"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg></button>
                <button type="button" class="sg-sk-arrow" data-sk="next" aria-label="Next card"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button>
                <span class="sg-sk-count" aria-live="polite"><b>1</b> of <%= skN %></span>
              </div>
            </div>
            <div class="sg-sk-pile">
              <% sk.cards.forEach((c, i) => { %><figure class="sg-sk-card sg-sk-c<%= i % 5 + 1 %><%= c.photo ? ' sg-sk-photo' : '' %><%= c.photo && c.plain ? ' sg-sk-only' : '' %>" data-k="<%= i %>"<%- i ? ' aria-hidden="true"' : '' %>>
                <% if (c.photo) { %><img src="<%= c.photo %>" alt="" loading="lazy" decoding="async"><% } %>
                <% if (c.stars) { %><span class="sg-sk-cstars" role="img" aria-label="<%= c.stars %> out of 5 stars"><%= '★'.repeat(c.stars) %></span><% } %>
                <% if (c.words) { %><blockquote class="sg-sk-words"><p><%= c.words %></p></blockquote><% } %>
                <% if (c.name || c.line) { %><figcaption class="sg-sk-who"><% if (c.name) { %><b><%= c.name %></b><% } %><% if (c.line) { %><span><%= c.line %></span><% } %></figcaption><% } %>
              </figure><% }) %>
            </div>
          </div>
        </div>
      </div>
    </section>
  <% } %>
  <% if (blk.type === 'advice') { %>
    <% const ad = adviceBlock.view(site, blk, _mbSvc); %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-advice blk-bg-<%= bg %><%= ec %>">
      <div class="sg-ad sg-ad-<%= ad.side %>" style="--ad-band: <%= ad.band %>"<%- ad.turns ? ' data-sg-tb-turns' : '' %>>
        <div class="sg-ad-panel">
          <div class="blk-inner sg-ad-grid">
            <% if (ad.photos.length) { %><div class="sg-tb-pic sg-ad-photo" aria-hidden="true"><% ad.photos.forEach((u, i) => { %><img src="<%= u %>" alt="" loading="lazy" decoding="async"<%- i ? '' : ' class="on"' %>><% }) %></div><% } %>
            <div class="sg-ad-words" data-reveal>
              <% if (blk.heading) { %><h2 class="sg-ad-h"><%- ad.headingHtml %></h2><% } %>
              <span class="sg-ad-line" aria-hidden="true"></span>
              <% if (ad.items.length) { %><ul class="sg-ad-items"><% ad.items.forEach(it => { %><li><% if (it.photo) { %><img src="<%= it.photo %>" alt="" loading="lazy" decoding="async"><% } %><p><%= it.text %></p></li><% }) %></ul><% } %>
              <% if (ad.button) { %><p class="sg-ad-cta"><a class="btn" href="<%= ad.button.url %>"><%= ad.button.text %></a></p><% } %>
            </div>
          </div>
        </div>
      </div>
    </section>
  <% } %>
  <% if (blk.type === 'photoblend') { %>
    <% const pb = photoBlend.view(site, blk, _mbSvc); %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-photoblend blk-bg-<%= bg %><%= ec %>">
      <div class="sg-pb sg-pb-<%= pb.side %> sg-pb-<%= pb.blend %>"<% if (pb.style) { %> style="<%= pb.style %>"<% } %><%- pb.match && !pb.ownColor ? ' data-sg-pb-match' : '' %><%- pb.turns ? ' data-sg-tb-turns' : '' %>>
        <div class="sg-pb-words" data-reveal>
          <% if (pb.top) { %><p class="sg-pb-top"><%= pb.top %></p><% } %>
          <% if (blk.heading) { %><h2 class="sg-pb-h"><%- pb.headingHtml %></h2><% } %>
          <% if (pb.badge) { %><p class="sg-pb-badge"><%= pb.badge %></p><% } %>
          <% if (pb.note) { %><p class="sg-pb-note"><%= pb.note %></p><% } %>
          <% if (pb.button) { %><p class="sg-pb-cta"><a class="sg-pb-btn" href="<%= pb.button.url %>"><%= pb.button.text %></a></p><% } %>
        </div>
        <% if (_pv && pb.uncut) { %><p class="sg-pb-cutnote">Only you see this: <%= pb.uncut %> photo<%= pb.uncut > 1 ? 's are' : ' is' %> not cut out yet. Use "Cut out the pets" in the editor.</p><% } %>
        <% if (pb.photos.length) { %><div class="sg-tb-pic sg-pb-photo" aria-hidden="true"><% pb.photos.forEach((u, i) => { %><img src="<%= u %>" alt="" decoding="async"<%- i ? ' loading="lazy"' : ' class="on"' %>><% }) %></div><% } %>
      </div>
    </section>
  <% } %>
  <% if (blk.type === 'patterns') { %>
    <% const gp = patternBlock.view(site, blk); %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-gpat sg-gp-<%= gp.motion %> sg-gp-<%= gp.look %><%= gp.words ? '' : ' sg-gp-bare' %>"<% if (gp.style) { %> style="<%= gp.style %>"<% } %>>
      <div class="sg-gp-bg" aria-hidden="true"><div class="sg-gp-pat" style="background-image: <%= gp.bg %><%= gp.bgPlace %>"></div></div>
      <% if (gp.words) { %>
      <div class="sg-gp-words" data-reveal>
        <% if (blk.heading) { %><h2 class="sg-gp-h"><%- gp.headingHtml %></h2><% } %>
        <% gp.paras.forEach(par => { %><p><%= par %></p><% }) %>
        <% if (gp.button) { %><p class="sg-gp-cta"><a class="btn" href="<%= gp.button.url %>"><%= gp.button.text %></a></p><% } %>
      </div>
      <% } %>
    </section>
  <% } %>
  <% if (blk.type === 'crossband') { %>
    <% const cb = crossBand.view(site, blk, _mbSvc); %>
    <section<%- blk.id ? ' data-sg-bid="' + blk.id + '"' : '' %><%- _pv ? ' data-sg-blk="' + blk._i + '"' : '' %> class="blk blk-crossband blk-bg-<%= bg %><%= ec %>">
      <div class="sg-cb<%= blk.side === 'right' ? ' sg-cb-flip' : '' %>" style="<%= cb.style %>"<%- cb.turns ? ' data-sg-tb-turns' : '' %>>
        <span class="sg-cb-band" aria-hidden="true"></span>
        <div class="blk-inner sg-cb-grid">
          <div class="sg-cb-main">
            <% if (cb.left.length) { %><div class="sg-tb-pic sg-cb-photo" aria-hidden="true"><% cb.left.forEach((u, i) => { %><img src="<%= u %>" alt="" loading="lazy" decoding="async"<%- i ? '' : ' class="on"' %>><% }) %></div><% } %>
            <% if (cb.list || cb.items.length) { %>
            <div class="sg-cb-list" data-reveal>
              <% if (cb.list) { %><p class="sg-cb-listh"><%= cb.list %></p><% } %>
              <% if (cb.items.length) { %><ul><% cb.items.forEach(t => { %><li><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg><span><%= t %></span></li><% }) %></ul><% } %>
            </div>
            <% } %>
          </div>
          <div class="sg-cb-card" data-reveal>
            <% if (blk.heading) { %><h2 class="sg-cb-h"><%- cb.headingHtml %></h2><% } %>
            <% if (cb.text) { %><p class="sg-cb-text"><%= cb.text %></p><% } %>
            <% if (cb.button) { %><a class="sg-cb-btn" href="<%= cb.button.url %>"><%= cb.button.text %></a><% } %>
