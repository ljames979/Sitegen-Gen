      <div class="upload-row">
        <input type="url" name="service_image" value="" placeholder="Photo for the home page card (optional)">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
        <input type="url" name="service_image2" value="" placeholder="Hover photo (optional): shown when the mouse is over the card, e.g. the finished job">
