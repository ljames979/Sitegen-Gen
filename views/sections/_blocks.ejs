<script>
(function () {
  const dataEl = document.getElementById('libData'), sel = document.getElementById('libSelect');
  if (!dataEl || !sel) return;
  let lib = JSON.parse(dataEl.textContent);
  const msg = document.getElementById('libMsg');
  const say = (t) => { msg.textContent = t; };
  const FIELDS = [['type', 'block_type'], ['heading', 'block_heading'], ['body', 'block_body'], ['imageUrl', 'block_image'], ['side', 'block_side'], ['buttonText', 'block_buttonText'], ['buttonUrl', 'block_buttonUrl'], ['edge', 'block_edge'], ['bg', 'block_bg'], ['bgmix', 'block_bgmix'], ['place', 'block_place'], ['page', 'block_page'], ['pin', 'block_pin'], ['film', 'block_film'], ['imgfx', 'block_imgfx'], ['height', 'block_height'], ['bgink', 'block_bgink'], ['gx', 'block_gx'], ['cardbg', 'block_cardbg'], ['cardgx', 'block_cardgx']];
  function refresh() {
    sel.innerHTML = '<option value="">Choose a saved block…</option>' + lib.map(function (l) { const o = document.createElement('option'); o.value = l.id; o.textContent = l.name + ' (' + l.block.type + ')'; return o.outerHTML; }).join('');
  }
  const poke = () => { const f = document.getElementById('editorForm'); if (f) f.dispatchEvent(new Event('input', { bubbles: true })); };
  document.addEventListener('click', async function (e) {
    const btn = e.target.closest('[data-block="save"]');
    if (!btn) return;
    const row = btn.closest('.block-row');
    if (window.syncStrips) window.syncStrips();
    const body = {};
    FIELDS.forEach(function (f) { const el = row.querySelector('[name=' + f[1] + ']'); body[f[1]] = el ? el.value : ''; });
    const name = window.prompt('Name for this saved block:', body.block_heading || '');
    if (!name) return;
    body.name = name;
    try {
      const r = await fetch('/library/blocks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const j = await r.json();
      if (!j.ok) return say(j.error || 'Could not save.');
      lib.push({ id: j.id, name: j.name, block: j.block }); refresh(); say('Saved "' + j.name + '" to your library.');
    } catch (err) { say('Could not save. Check your connection.'); }
  });
  document.getElementById('libInsert').addEventListener('click', function () {
    const item = lib.find(function (l) { return String(l.id) === sel.value; });
    if (!item) return say('Choose a saved block first.');
    const tpl = document.getElementById('tpl-block-' + item.block.type);
    if (!tpl) return say('This block type is not available.');
    const node = tpl.content.cloneNode(true), row = node.querySelector('.block-row');
    if (window.sgLazyFillIn) window.sgLazyFillIn(row);
    FIELDS.forEach(function (f) {
      const el = row.querySelector('[name=' + f[1] + ']');
      if (el && item.block[f[0]] != null && el.type !== 'file') el.value = item.block[f[0]];
    });
    if (window.sgFilmUi) window.sgFilmUi(row);
    if (window.sgDecoFill) window.sgDecoFill(row);   // Decorative card: its boxes from the saved body
    const wallSide = row.querySelector('.wall-side');
    if (wallSide) { const parts = wallSide.value.split(':'); Array.prototype.forEach.call(row.querySelectorAll('.wall-opts select'), function (x, n) { if (parts[n]) x.value = parts[n]; }); }
    const gpSide = row.querySelector('.gp-side');   // Gradient pattern: its pattern, look, motion and version
    if (gpSide) { const parts = gpSide.value.split(':'); Array.prototype.forEach.call(row.querySelectorAll('.gp-pick select'), function (x, n) { if (parts[n]) x.value = parts[n]; }); }
    Array.prototype.forEach.call(row.querySelectorAll('.sg-inkpick'), function (box) {   // the saved colors back into the picker
      if (window.sgInkSet) window.sgInkSet(box, box.querySelector('input[type=hidden]').value);
    });
    const tbBody = row.querySelector('.tb-body');
    if (tbBody) {
      const tl = {}; String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(bold|text|strong|big|left|right):\s?(.*)$/.exec(l.trim()); if (m) tl[m[1]] = m[2]; });
      ['bold', 'text', 'strong', 'big'].forEach(function (k) { const el = row.querySelector('.tb-' + k); if (el) el.value = tl[k] || ''; });
      [['left', '.tb-l-url'], ['right', '.tb-r-url']].forEach(function (p) {
        const urls = String(tl[p[0]] || '').split(/\s+/).filter(Boolean), box = row.querySelector(p[1]).closest('.strip-rows'), first = box.querySelector('.upload-row');
        while (box.children.length < urls.length) box.appendChild(first.cloneNode(true));
        Array.prototype.forEach.call(box.querySelectorAll('.strip-url'), function (i, n) { i.value = urls[n] || ''; });
      });
    }
    const mhBody = row.querySelector('.mh-body');
    if (mhBody) {
      const ml = {}; String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(sub|photos):\s?(.*)$/.exec(l.trim()); if (m) ml[m[1]] = m[2]; });
      row.querySelector('.mh-sub').value = ml.sub || '';
      const urls = String(ml.photos || '').split(/\s+/).filter(Boolean), box = row.querySelector('.mh-url').closest('.strip-rows'), first = box.querySelector('.upload-row');
      while (box.children.length < urls.length) box.appendChild(first.cloneNode(true));
      Array.prototype.forEach.call(box.querySelectorAll('.strip-url'), function (i, n) { i.value = urls[n] || ''; });
    }
    const cbBody = row.querySelector('.cb-body');
    if (cbBody) {
      const cl = { item: [] }; String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(text|list|item|left|right|card|band):\s?(.*)$/.exec(l.trim()); if (!m) return; if (m[1] === 'item') cl.item.push(m[2]); else cl[m[1]] = m[2]; });
      row.querySelector('.cb-text').value = cl.text || ''; row.querySelector('.cb-list').value = cl.list || ''; row.querySelector('.cb-items').value = cl.item.join('\n');
      ['card', 'band'].forEach(function (k) { if (cl[k]) { row.querySelector('.cb-own-' + k).checked = true; row.querySelector('.cb-' + k).value = cl[k]; } });
      [['left', '.cb-l-url'], ['right', '.cb-r-url']].forEach(function (p) {
        const urls = String(cl[p[0]] || '').split(/\s+/).filter(Boolean), box = row.querySelector(p[1]).closest('.strip-rows'), first = box.querySelector('.upload-row');
        while (box.children.length < urls.length) box.appendChild(first.cloneNode(true));
        Array.prototype.forEach.call(box.querySelectorAll('.strip-url'), function (i, n) { i.value = urls[n] || ''; });
      });
    }
    const ptBody = row.querySelector('.pt-body');
    if (ptBody) {
      const pc = []; String(item.block.body || '').split('\n').forEach(function (l) { const m = /^card:\s?(.*)$/.exec(l.trim()); if (m) pc.push(m[1].split('|').map(function (x) { return x.trim(); })); });
      Array.prototype.forEach.call(row.querySelectorAll('.pt-card'), function (f, n) {
        const c = pc[n] || [];
        f.querySelector('.pt-url').value = c[0] || ''; f.querySelector('.pt-title').value = c[2] || ''; f.querySelector('.pt-text').value = c.slice(3).join(' ');
        f.querySelector('.pt-own').checked = !!c[1]; if (c[1]) f.querySelector('.pt-color').value = c[1];
      });
    }
    const ppBody = row.querySelector('.pp-body');
    if (ppBody) {
      const pr = []; let pl = '', pc = '', ps = true;
      String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(label|pair|color|shapes):\s?(.*)$/.exec(l.trim()); if (!m) return; if (m[1] === 'label') pl = m[2]; else if (m[1] === 'color') pc = m[2].trim(); else if (m[1] === 'shapes') ps = m[2].trim() !== 'off'; else pr.push(m[2].split('|').map(function (x) { return x.trim(); })); });
      row.querySelector('.pp-label').value = pl;
      Array.prototype.forEach.call(row.querySelectorAll('.pp-pair'), function (f, n) { const r = pr[n] || []; f.querySelector('.pp-url').value = r[0] || ''; f.querySelector('.pp-title').value = r[1] || ''; f.querySelector('.pp-text').value = r.slice(2).join(' '); });
      row.querySelector('.pp-own-color').checked = !!pc; if (pc) row.querySelector('.pp-color').value = pc;
      row.querySelector('.pp-shapes').checked = ps;
    }
    const abBody = row.querySelector('.ab-body');   // About Us blocks: every field is marked with data-ab and data-abf
    if (abBody) {
      const am = String(item.block.body || '').split('\n').map(function (l) { return /^([a-z]+):\s?(.*)$/.exec(l.trim()); }).filter(Boolean);
      const av = function (k) { return am.filter(function (m) { return m[1] === k; }).map(function (m) { return m[2]; }); };
      const an = {};
      Array.prototype.forEach.call(row.querySelectorAll('.ab-add'), function (btn) {   // lists that grow: as many rows as saved
        const k = btn.getAttribute('data-ab'), want = Math.min(av(k).length, +btn.getAttribute('data-max') || 12);
        let rows = row.querySelectorAll('.ab-row[data-ab="' + k + '"]');
        while (rows.length && rows.length < want) { const c = rows[rows.length - 1].cloneNode(true); rows[rows.length - 1].after(c); rows = row.querySelectorAll('.ab-row[data-ab="' + k + '"]'); }
      });
      Array.prototype.forEach.call(row.querySelectorAll('[data-abf]'), function (el) {
        const k = el.getAttribute('data-ab'), kind = el.getAttribute('data-abf'), v = av(k);
        if (kind === 'line') el.value = v[0] || '';
        else if (kind === 'paras') el.value = v.join('\n');
        else if (kind === 'row') { an[k] = (an[k] || 0) + 1; const parts = String(v[an[k] - 1] || '').split('|'); Array.prototype.forEach.call(el.querySelectorAll('.ab-c'), function (c, n) { c.value = (parts[n] || '').trim(); }); }
        else if (kind === 'color') { el.querySelector('.ab-own').checked = !!v[0]; if (v[0]) el.querySelector('.ab-color').value = v[0].trim(); }
        else if (kind === 'toggle') el.checked = String(v[0] || '').trim() !== 'off';
      });
    }
    const opBody = row.querySelector('.op-body');
    if (opBody) {
      const ov = { label: '', text: [], note: '', shapes: 'on' };
      String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(label|text|note|color|accent|button|bg|shapes):\s?(.*)$/.exec(l.trim()); if (!m) return; if (m[1] === 'text') ov.text.push(m[2]); else ov[m[1]] = m[2].trim(); });
      row.querySelector('.op-label').value = ov.label; row.querySelector('.op-text').value = ov.text.join('\n'); row.querySelector('.op-note').value = ov.note;
      ['color', 'accent', 'button', 'bg'].forEach(function (k) { row.querySelector('.op-own-' + k).checked = !!ov[k]; if (ov[k]) row.querySelector('.op-' + k).value = ov[k]; });
      row.querySelector('.op-shapes').checked = ov.shapes !== 'off';
    }
    const fpBody = row.querySelector('.fp-body');
    if (fpBody) {
      const pv = { text: [], note: '', shapes: 'on' };
      String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(text|note|shapes|color|bg|card):\s?(.*)$/.exec(l.trim()); if (!m) return; if (m[1] === 'text') pv.text.push(m[2]); else pv[m[1]] = m[2].trim(); });
      row.querySelector('.fp-text').value = pv.text.join('\n'); row.querySelector('.fp-note').value = pv.note;
      ['color', 'bg', 'card'].forEach(function (k) { row.querySelector('.fp-own-' + k).checked = !!pv[k]; if (pv[k]) row.querySelector('.fp-' + k).value = pv[k]; });
    }
    const rpBody = row.querySelector('.rp-body');
    if (rpBody) {
      const pv = { text: [], note: '', shapes: 'on' };
      String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(text|note|shapes|color|bg):\s?(.*)$/.exec(l.trim()); if (!m) return; if (m[1] === 'text') pv.text.push(m[2]); else pv[m[1]] = m[2].trim(); });
      row.querySelector('.rp-text').value = pv.text.join('\n'); row.querySelector('.rp-note').value = pv.note;
      ['color', 'bg'].forEach(function (k) { row.querySelector('.rp-own-' + k).checked = !!pv[k]; if (pv[k]) row.querySelector('.rp-' + k).value = pv[k]; });
      row.querySelector('.rp-shapes').checked = pv.shapes !== 'off';
    }
    const sfBody = row.querySelector('.sf-body');
    if (sfBody) {
      const sv = { text: '', color: '', accent: '', panel: '', bg: '', shapes: 'on' };
      String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(text|color|accent|panel|bg|shapes):\s?(.*)$/.exec(l.trim()); if (m) sv[m[1]] = m[2].trim(); });
      row.querySelector('.sf-text').value = sv.text;
      ['color', 'accent', 'panel', 'bg'].forEach(function (k) { row.querySelector('.sf-own-' + k).checked = !!sv[k]; if (sv[k]) row.querySelector('.sf-' + k).value = sv[k]; });
      row.querySelector('.sf-shapes').checked = sv.shapes !== 'off';
    }
    const rgBody = row.querySelector('.rg-body');
    if (rgBody) {
      const rt = []; let rn = '', rcl = '', rb = '', rs = true;
      String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(text|note|color|bg|shapes):\s?(.*)$/.exec(l.trim()); if (!m) return; if (m[1] === 'text') rt.push(m[2]); else if (m[1] === 'note') rn = m[2]; else if (m[1] === 'color') rcl = m[2].trim(); else if (m[1] === 'bg') rb = m[2].trim(); else rs = m[2].trim() !== 'off'; });
      row.querySelector('.rg-text').value = rt.join('\n'); row.querySelector('.rg-note').value = rn;
      row.querySelector('.rg-own-color').checked = !!rcl; if (rcl) row.querySelector('.rg-color').value = rcl;
      row.querySelector('.rg-own-bg').checked = !!rb; if (rb) row.querySelector('.rg-bg').value = rb;
      row.querySelector('.rg-shapes').checked = rs;
    }
    const twBody = row.querySelector('.tw-body');
    if (twBody) {
      const tt = [], tp = [], tl = []; let tc = '', tpn = '';
      String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(text|photo|link|color|panel):\s?(.*)$/.exec(l.trim()); if (!m) return; if (m[1] === 'text') tt.push(m[2]); else if (m[1] === 'photo') tp.push(m[2].trim()); else if (m[1] === 'link') tl.push(m[2].split('|').map(function (x) { return x.trim(); })); else if (m[1] === 'color') tc = m[2].trim(); else tpn = m[2].trim(); });
      row.querySelector('.tw-text').value = tt.join('\n');
      Array.prototype.forEach.call(row.querySelectorAll('.tw-url'), function (i, n) { i.value = tp[n] || ''; });
      Array.prototype.forEach.call(row.querySelectorAll('.tw-link'), function (f, n) { const k = tl[n] || []; f.querySelector('.tw-label').value = k[0] || ''; f.querySelector('.tw-href').value = k[1] || ''; });
      row.querySelector('.tw-own-color').checked = !!tc; if (tc) row.querySelector('.tw-color').value = tc;
      row.querySelector('.tw-own-panel').checked = !!tpn; if (tpn) row.querySelector('.tw-panel').value = tpn;
    }
    const rcBody = row.querySelector('.rc-body');
    if (rcBody) {
      const rr = []; let rbg = '', rcd = '';
      String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(bg|card|review):\s?(.*)$/.exec(l.trim()); if (!m) return; if (m[1] === 'bg') rbg = m[2].trim(); else if (m[1] === 'card') rcd = m[2].trim(); else rr.push(m[2].split('|').map(function (x) { return x.trim(); })); });
      row.querySelector('.rc-own-bg').checked = !!rbg; if (rbg) row.querySelector('.rc-bg').value = rbg;
      row.querySelector('.rc-own-card').checked = !!rcd; if (rcd) row.querySelector('.rc-card').value = rcd;
      Array.prototype.forEach.call(row.querySelectorAll('.rc-review'), function (f, n) {
        const r = rr[n] || [];
        f.querySelector('.rc-url').value = r[0] || ''; f.querySelector('.rc-quote').value = r[1] || ''; f.querySelector('.rc-name').value = r.slice(2).join(' ');
      });
    }
    const adBody = row.querySelector('.ad-body');
    if (adBody) {
      let ap = ''; const ai = [];
      String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(photos|item):\s?(.*)$/.exec(l.trim()); if (!m) return; if (m[1] === 'photos') ap = m[2]; else ai.push(m[2]); });
      const urls = ap.split(/\s+/).filter(Boolean), box = row.querySelector('.ad-url').closest('.strip-rows'), first = box.querySelector('.upload-row');
      while (box.children.length < urls.length) box.appendChild(first.cloneNode(true));
      Array.prototype.forEach.call(box.querySelectorAll('.strip-url'), function (i, n) { i.value = urls[n] || ''; });
      const ius = row.querySelectorAll('.ad-iu'), its = row.querySelectorAll('.ad-it');
      ai.forEach(function (v, n) { if (!ius[n]) return; const k = v.indexOf('|'); ius[n].value = k < 0 ? '' : v.slice(0, k).trim(); its[n].value = (k < 0 ? v : v.slice(k + 1)).trim(); });
    }
    const pbBody = row.querySelector('.pb-body');
    if (pbBody) {
      const pl = {};
      String(item.block.body || '').split('\n').forEach(function (l) { const m = /^(top|badge|note|photos|color|cutouts):\s?(.*)$/.exec(l.trim()); if (m) pl[m[1]] = m[2]; });
      row.querySelector('.pb-cuts').value = pl.cutouts || '';
      ['top', 'badge', 'note'].forEach(function (k) { row.querySelector('.pb-' + k).value = pl[k] || ''; });
      if (pl.color) { row.querySelector('.pb-own').checked = true; row.querySelector('.pb-color').value = pl.color; }
      const urls = String(pl.photos || '').split(/\s+/).filter(Boolean), box = row.querySelector('.pb-url').closest('.strip-rows'), first = box.querySelector('.upload-row');
      while (box.children.length < urls.length) box.appendChild(first.cloneNode(true));
      Array.prototype.forEach.call(box.querySelectorAll('.strip-url'), function (i, n) { i.value = urls[n] || ''; });
    }
    const strips = tbBody || mhBody || cbBody || adBody || pbBody ? null : row.querySelector('.strip-rows');
    if (strips) {
      const isPic = function (l) { return /^(https?:\/\/|\/)\S+$/i.test(l); };
      const all = String(item.block.body || '').split('\n').filter(Boolean), words = row.querySelector('.wall-text');
      const urls = words ? all.filter(isPic) : all;
      if (words) words.value = all.filter(function (l) { return !isPic(l); }).join('\n');
      const first = strips.querySelector('.upload-row');
      while (strips.children.length < urls.length) strips.appendChild(first.cloneNode(true));
      Array.prototype.forEach.call(strips.querySelectorAll('.strip-url'), function (i, n) { i.value = urls[n] || ''; });
    }
    if (window.sgAddBlockRow) window.sgAddBlockRow(row); else document.getElementById('blockList').appendChild(node);
    if (window.syncStrips) window.syncStrips();
    say('Inserted "' + item.name + '". Set which page it shows on in its last row.');
    poke();
  });
  document.getElementById('libDelete').addEventListener('click', async function () {
    const item = lib.find(function (l) { return String(l.id) === sel.value; });
    if (!item) return say('Choose a saved block first.');
    if (!window.confirm('Delete "' + item.name + '" from your library? Copies already on sites stay.')) return;
    const r = await fetch('/library/blocks/' + item.id + '/delete', { method: 'POST' });
    if ((await r.json()).ok) { lib = lib.filter(function (l) { return l.id !== item.id; }); refresh(); say('Deleted.'); }
  });
})();
</script>
<%# The gradient library picker (Leo 2026-11-05): one swatch grid for every "🎨 Gradient library…" button on the blocks %>
<script type="application/json" id="gradLibData"><%- JSON.stringify(gradients.libMenu()).replace(/</g, '\\u003c') %></script>
<dialog id="gradLib" style="width:min(920px, 96vw); max-height:88vh; padding:0; border:0; border-radius:14px; box-shadow:0 20px 60px rgba(0,0,0,.35);">
  <div style="position:sticky; top:0; background:#fff; padding:.9rem 1rem .6rem; border-bottom:1px solid #e5e7eb; z-index:1;">
    <div style="display:flex; gap:.6rem; align-items:center; flex-wrap:wrap;">
      <strong style="font-size:1.05rem; margin-right:auto;">Gradient library</strong>
      <input type="search" id="gradLibQ" placeholder="Search by name, e.g. sky" style="flex:1; min-width:180px; max-width:280px;">
      <button type="button" class="btn btn-secondary btn-sm" id="gradLibClose">Close</button>
    </div>
    <div id="gradLibFam" style="display:flex; gap:.35rem; flex-wrap:wrap; margin-top:.55rem;"></div>
  </div>
  <div id="gradLibGrid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:.7rem; padding:1rem;"></div>
</dialog>
<script>
(function () {
  const dlg = document.getElementById('gradLib'), dataEl = document.getElementById('gradLibData');
  if (!dlg || !dataEl || !dlg.showModal) return;
  document.body.appendChild(dlg);   // out of the blocks panel, so it shows whatever panel is open or folded
  const fams = JSON.parse(dataEl.textContent), grid = document.getElementById('gradLibGrid'), q = document.getElementById('gradLibQ'), famBar = document.getElementById('gradLibFam');
  let target = null, pre = '', fam = '';
  const all = fams.flatMap(function (f) { return f[1].map(function (x) { return { id: x[0], name: x[1], css: x[2], fam: f[0] }; }); });
  const famName = (f) => f.replace(/^Library: /, '');
  famBar.innerHTML = ['<button type="button" class="btn btn-sm" data-fam="">All (' + all.length + ')</button>'].concat(fams.map(function (f) { return '<button type="button" class="btn btn-secondary btn-sm" data-fam="' + f[0] + '">' + famName(f[0]) + ' (' + f[1].length + ')</button>'; })).join('');
  function draw() {
    const words = q.value.trim().toLowerCase(), cur = target ? target.value.replace(/^g-/, '') : '';
    famBar.querySelectorAll('[data-fam]').forEach(function (b) { b.className = 'btn btn-sm' + (b.dataset.fam === fam ? '' : ' btn-secondary'); });
    grid.innerHTML = all.filter(function (x) { return (!fam || x.fam === fam) && (!words || x.name.toLowerCase().includes(words)); }).map(function (x) {
      return '<button type="button" data-gid="' + x.id + '" title="' + x.name + '" style="all:unset; cursor:pointer; display:block; border-radius:10px; overflow:hidden; border:2px solid ' + (x.id === cur ? '#111' : 'transparent') + '; box-shadow:0 1px 3px rgba(0,0,0,.15);"><span style="display:block; height:74px; background:' + x.css + ';"></span><span style="display:block; padding:.35rem .5rem; font-size:.82rem; background:#fff; color:#222;">' + x.name + '</span></button>';
    }).join('') || '<p style="grid-column:1/-1; color:#666;">No gradient by that name.</p>';
  }
  document.addEventListener('click', function (e) {
    const open = e.target.closest('[data-glib]');
    if (open) {
      const row = open.closest('.block-row') || open.parentNode;
      target = row.querySelector('select[name="' + open.dataset.glib + '"]'); pre = open.dataset.glibPre || '';
      if (target && window.sgLazyFill) window.sgLazyFill(target);
      if (!target) return;
      fam = ''; q.value = ''; draw(); dlg.showModal(); q.focus(); return;
    }
    const f = e.target.closest('#gradLibFam [data-fam]'); if (f) { fam = f.dataset.fam; draw(); return; }
    const pick = e.target.closest('#gradLibGrid [data-gid]');
    if (pick && target) {
      const x = all.find(function (y) { return y.id === pick.dataset.gid; }), val = pre + x.id;
      // the block's picker lists only the library gradient already chosen; add this one under "Gradient library"
      if (!Array.from(target.options).some(function (o) { return o.value === val; })) {
        let grp = Array.from(target.querySelectorAll('optgroup')).find(function (g) { return g.dataset.glib === '1'; });
        if (!grp) { grp = document.createElement('optgroup'); grp.label = 'Gradient library'; grp.dataset.glib = '1'; target.appendChild(grp); }
        const o = document.createElement('option'); o.value = val; o.textContent = x.name; grp.appendChild(o);
      }
      target.value = val;
      target.dispatchEvent(new Event('input', { bubbles: true })); target.dispatchEvent(new Event('change', { bubbles: true }));
      dlg.close();
    }
  });
  q.addEventListener('input', draw);
  document.getElementById('gradLibClose').addEventListener('click', function () { dlg.close(); });
  dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
})();
</script>
