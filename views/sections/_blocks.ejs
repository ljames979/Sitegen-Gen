        <% [['', 'Gradient replaces the color'], ['none', 'Blend into the page color'], ['tint', 'Blend into a light tint'], ['brand', 'Blend into the brand color'], ['dark', 'Blend into a dark band']].forEach(o => { %><option value="<%= o[0] %>" <%= (b.bgmix || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <%- include('_ink-pick', { name: 'block_bgink', value: b.bgink || '', theme: typeof site !== 'undefined' ? site.theme : {} }) %>
      <button type="button" class="btn btn-secondary btn-sm" data-glib="block_bg" data-glib-pre="g-" title="Pick the block's background from the gradient library (284 gradients)">🎨 Gradient library…</button>
      <%- include('_gx-pick', { name: 'block_gx', value: b.gx, what: 'Background intensity' }) %>
      <% } %>
      <%- _lzOne('page', 'block_page', b.page || 'home', 'Which page shows this block') %>
      <select name="block_place">
        <% [['bottom','Lower on the page'],['top','Near the top of the page']].forEach(o => { %><option value="<%= o[0] %>" <%= (b.place || 'bottom') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
    </div>
    <div class="upload-row" data-sg-cardbg>
      <%- _lzOne('cardbg', 'block_cardbg', b.cardbg || '', 'A gradient behind each card inside this block (the words take the color that reads on it)', _lzLib(b.cardbg || '')) %>
      <button type="button" class="btn btn-secondary btn-sm" data-glib="block_cardbg" data-glib-pre="" title="Pick the cards' background from the gradient library">🎨 Gradient library…</button>
      <%- include('_gx-pick', { name: 'block_cardgx', value: b.cardgx, what: 'Card intensity' }) %>
    </div>
    <div class="upload-row">
      <%- _lzOne('pin', 'block_pin', b.pin || '', 'Pin this block while the page scrolls, or make its cards stack, pile up or fan out') %>
    </div>
    <div class="upload-row">
      <select name="block_imgfx" title="Put the block's words over its photos, with a movement">
        <% imgFx.OPTIONS.forEach(o => { %><option value="<%= o[0] %>" <%= (b.imgfx || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
