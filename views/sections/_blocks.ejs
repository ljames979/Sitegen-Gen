      <label>Your own photos for the <%= wWhat %> (<%= b.type === 'wall' ? 'up to 12' : b.type === 'cascade' ? 'the cascade shows up to 10 cards' : 'up to 12, then your site\'s photos' %>; they come first)</label>
      <div class="strip-rows">
        <% (wOwn.photos.length ? wOwn.photos : ['']).forEach(u => { %>
