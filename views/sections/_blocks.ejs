          <label style="font-weight: 400; margin: 0;">Up / down <input type="range" class="rc-y" min="-30" max="30" step="1" value="<%= rcSet.y %>" aria-label="Move the photo up or down"> <output data-for="rc-y"><%= rcSet.y %>%</output></label>
          <select class="rc-fit" aria-label="Cut-out photo"><% reviewCard.FITS.forEach(o => { %><option value="<%= o[0] %>" <%= rcSet.fit === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <button type="button" class="btn-secondary" onclick="var w=this.closest('.rc-photo-opts');w.querySelector('.rc-size').value=100;w.querySelector('.rc-x').value=0;w.querySelector('.rc-y').value=0;w.onchange();">Reset</button>
        </div>
      </div>
      <p class="hint">Size makes the big photo smaller or bigger (100% = the panel). The two sliders nudge it left, right, up or down. For a cut-out photo, "Show the whole cut-out" fits all of it on the panel; "Fill the panel" trims it to fill the space.</p>
      <p class="hint">The big photo stands on a panel in your brand color and reaches above the card. A photo with its background cut out (✂ Cut out) stands on the panel like it does in a magazine. The Button boxes below add one button under the reviews (optional). On phones the card goes under the photo.</p>
    <% } else if (b.type === 'phototabs') { %>
      <input type="hidden" name="block_image" value="">
      <label>Which side</label>
      <select name="block_side">
        <% photoTabs.SIDES.forEach(o => { %><option value="<%= o[0] %>" <%= photoTabs.cleanSide(b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <p class="hint">The Button boxes below add one button to every card (optional). On phones the card goes under the photo and the small photos sit in a row under it.</p>
    <% } else if (b.type === 'overlapcard') { %>
