        <select class="rc-ps" aria-label="Which side"><% reviewCard.SIDES.forEach(o => { %><option value="<%= o[0] %>" <%= rcSet.side === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
