      <select name="block_height" title="Make the block shorter or taller (the space above and below its content)">
        <% heightFx.OPTIONS.forEach(o => { %><option value="<%= o[0] %>" <%= (b.height || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
    </div>
    <% const _fp = filmFx.parts(b.film); %>
