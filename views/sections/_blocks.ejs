<% const blockItems = (site.sections.blocks && site.sections.blocks.items) || [];
   // Faster editor (Leo, 2026-11-07): the long background, cards, page and pin menus are written once, in templates
   // below; each block's menu holds only its current choice until it is opened (public/lazyselect.js fills it).
   const _lzTheme = typeof site !== 'undefined' ? site.theme : {};
   const _lzEsc = (v) => String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
   const _lzBgPlain = [['none','Plain background'],['white','Clear white'],['tint','Light tint band'],['brand','Brand color band'],['dark','Dark band']];
   const _lzBgGroups = gradients.menu(_lzTheme, true, false).map(g => ['Gradient: ' + g[0].toLowerCase(), g[1].map(x => ['g-' + x[0], x[1]])]);
   const _lzCardGroups = gradients.menu(_lzTheme, false, false).map(g => ['Cards: ' + g[0].toLowerCase(), g[1].map(x => [x[0], x[1]])]);
   const _lzPages = [['home','On the home page'],['about','On the About page'],['services','On the Services page'],['testimonials','On the Reviews page'],['whyChoose','On the Why Choose Us page'],['gallery','On the Gallery page'],['faq','On the FAQ page'],['blog','On the News & Tips page'],['hours','On the Hours page'],['contact','On the Contact page']];
   const _lzOpts = (list) => list.map(o => `<option value="${_lzEsc(o[0])}">${_lzEsc(o[1])}</option>`).join('');
   const _lzGrp = (groups) => groups.map(g => `<optgroup label="${_lzEsc(g[0])}">${_lzOpts(g[1])}</optgroup>`).join('');
   const _lzAll = { blockbg: _lzOpts(_lzBgPlain) + _lzGrp(_lzBgGroups), cardbg: _lzOpts([['', 'Cards: their own color']]) + _lzGrp(_lzCardGroups), page: _lzOpts(_lzPages), pin: _lzOpts(pinFx.OPTIONS) };
   // one block's menu: its current choice only (a library gradient keeps its own name)
   const _lzOne = (key, name, cur, title, libName) => {
     const flat = key === 'blockbg' ? _lzBgPlain.concat(..._lzBgGroups.map(g => g[1])) : key === 'cardbg' ? [['', 'Cards: their own color']].concat(..._lzCardGroups.map(g => g[1])) : key === 'page' ? _lzPages : pinFx.OPTIONS;
     const hit = flat.find(o => o[0] === cur) || (cur && libName ? [cur, libName] : null) || flat[0];
     return `<select name="${name}" data-sg-lazy="${key}"${title ? ` title="${_lzEsc(title)}"` : ''}><option value="${_lzEsc(hit[0])}" selected>${_lzEsc(hit[1])}</option></select>`;
   };
   const _lzLib = (id) => { const x = gradients.LIB.find(p => p[0] === id); return x ? x[1] : ''; };
   const renderBlock = (b) => { %>
