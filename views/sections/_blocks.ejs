    <% } else { %>
      <label><%= b.type === 'cta' ? 'Background photo (optional)' : b.type === 'photoBanner' ? 'Photo (leave empty to use your hero photo)' : 'Photo' %></label>
      <div class="upload-row">
        <input type="url" name="block_image" value="<%= b.imageUrl || '' %>" placeholder="https://... or upload">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
      <% if (b.type === 'cta') { %><input type="hidden" name="block_side" value="auto"><% } else if (b.type === 'photoBanner') { %>
      <% const pset = photoBanner.settings(b.side); %>
      <input type="hidden" name="block_side" class="wall-side" value="<%= photoBanner.cleanSide(b.side) %>">
      <label>Words side, height and button color</label>
      <div class="upload-row wall-opts" style="flex-wrap: wrap;" onchange="var r=this.closest('.block-row'),v=Array.prototype.map.call(this.querySelectorAll('select'),function(x){return x.value}).join(':');r.querySelector('.wall-side').value=v;">
        <select aria-label="Words side"><% [['left', 'Words on the left'], ['right', 'Words on the right']].forEach(o => { %><option value="<%= o[0] %>" <%= pset.text === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select aria-label="Banner height"><% [['short', 'Short'], ['medium', 'Medium'], ['tall', 'Tall']].forEach(o => { %><option value="<%= o[0] %>" <%= pset.size === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select aria-label="Button color"><% [['brand', 'Button in your brand color'], ['accent', 'Button in your accent color'], ['lime', 'Lime button']].forEach(o => { %><option value="<%= o[0] %>" <%= pset.button === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
      </div>
      <p class="hint">Put [square brackets] around words in the heading to set them in an italic serif, e.g. Now imagine this [creative power] behind your next project. The words sit on a soft fade in your brand's dark tone so they stay readable on any photo.</p>
