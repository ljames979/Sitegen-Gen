      <div class="rc-photo-opts" oninput="this.onchange()" onchange="var q=function(c){return this.querySelector(c)}.bind(this);Array.prototype.forEach.call(this.querySelectorAll('output'),function(o){o.textContent=q('.'+o.dataset.for).value+'%'});this.closest('.block-row').querySelector('.rc-side').value=[q('.rc-ps').value,q('.rc-size').value,q('.rc-x').value,q('.rc-y').value,q('.rc-fit').value].join(':');">
