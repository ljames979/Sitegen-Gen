    <% } else if (b.type === 'wall' || b.type === 'cascade' || b.type === 'trail' || b.type === 'wave' || b.type === 'story' || b.type === 'path') { %>
      <% const wOwn = brandWall.ownContent(b.body), wWhat = b.type === 'wall' ? 'wall' : b.type === 'cascade' ? 'cards' : b.type === 'trail' ? 'trail' : b.type === 'story' ? 'story' : b.type === 'path' ? 'path' : 'wave'; %>
      <% if (b.type === 'story') wOwn.lines = String(b.body || '').split('\n').map(l => l.trim()).filter(l => l && !/^(https?:\/\/|\/)\S+$/i.test(l)); %>
