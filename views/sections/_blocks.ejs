    <% } else if (b.type === 'herocard') { %>
      <% const hcOwn = heroCard.parse(b.body); %>
      <textarea name="block_body" class="hc-body" hidden><%= b.body || '' %></textarea>
      <p class="hint">The heading above is the huge title across the top (a word or two reads best, e.g. your product or service name). Everything below is optional: leave a box empty and it doesn't show.</p>
      <label>Words low on the left</label>
      <textarea class="hc-intro" rows="3" maxlength="400" placeholder="A sentence or two about it"><%= hcOwn.intro %></textarea>
      <label>Price under them (only your real price)</label>
      <div class="upload-row">
        <input type="text" class="hc-price" maxlength="30" value="<%= hcOwn.price %>" placeholder="e.g. $139.00" style="max-width: 10rem;">
        <input type="text" class="hc-pnote" maxlength="90" value="<%= hcOwn.priceNote %>" placeholder="Small words beside it, e.g. or 4 payments">
      </div>
      <label>Detail low on the right</label>
      <div class="upload-row">
        <input type="text" class="hc-detail" maxlength="40" value="<%= hcOwn.detail %>" placeholder="e.g. 100 cm, or 2 hours" style="max-width: 12rem;">
        <input type="text" class="hc-dnote" maxlength="240" value="<%= hcOwn.detailNote %>" placeholder="A line under it">
      </div>
      <label>Two buttons under the detail</label>
      <% for (let i = 0; i < heroCard.MAX_LINKS; i++) { const l = hcOwn.links[i] || {}; %>
      <div class="upload-row">
        <input type="text" class="hc-lt" maxlength="30" value="<%= l.label || '' %>" placeholder="Button <%= i + 1 %> words, e.g. <%= i ? 'View gallery' : 'Size guide' %>" style="max-width: 14rem;">
        <input type="url" class="hc-lu" value="<%= l.url || '' %>" placeholder="Its link, e.g. /site/name/gallery">
      </div>
      <% } %>
      <label>White bar along the bottom: a name, an option with a color dot, and a price on the dark button</label>
      <div class="upload-row">
        <input type="text" class="hc-bname" maxlength="40" value="<%= hcOwn.bar ? hcOwn.bar.name : '' %>" placeholder="Name, e.g. Metro">
        <input type="text" class="hc-bopt" maxlength="40" value="<%= hcOwn.bar ? hcOwn.bar.option : '' %>" placeholder="Option, e.g. Matcha">
        <input type="text" class="hc-bprice" maxlength="30" value="<%= hcOwn.bar ? hcOwn.bar.price : '' %>" placeholder="Price, e.g. $139.00" style="max-width: 9rem;">
      </div>
      <p class="hint">The dark button's words and link are the Button boxes further down (e.g. Add to bag, Book now).</p>
      <label>Card color</label>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="hc-own"<%= hcOwn.color ? ' checked' : '' %>> Use my own color:</label>
        <input type="color" class="hc-color" value="<%= hcOwn.color || '#8fae8b' %>" style="width: 64px; height: 36px; padding: 2px;">
        <span class="hint" style="margin: 0;">Unticked, it's a soft take on your brand color. The words turn light or dark on their own.</span>
      </div>
    <% } else if (b.type === 'stack') { %>
      <% const skOwn = stackCards.parse(b.body), skN = +stackCards.cleanSide(b.side); %>
      <textarea name="block_body" class="sk-body" hidden><%= b.body || '' %></textarea>
      <label>Small label above the heading (optional, e.g. Customer love)</label>
      <input type="text" class="sk-label" maxlength="60" value="<%= skOwn.label %>" placeholder="Customer love">
      <label>Rating line under the heading (optional: only fill this in with your real rating)</label>
      <div class="upload-row">
        <input type="number" class="sk-rating" min="0" max="5" step="0.1" value="<%= skOwn.rating || '' %>" placeholder="Stars, e.g. 4.8" style="max-width: 9rem;">
        <input type="text" class="sk-rtext" maxlength="80" value="<%= skOwn.ratingText %>" placeholder="Words after the stars, e.g. from 120 Google reviews">
      </div>
      <label>How many cards</label>
      <select name="block_side" class="sk-count">
        <% for (let n = stackCards.MIN; n <= stackCards.MAX; n++) { %><option value="<%= n %>" <%= skN === n ? 'selected' : '' %>><%= n %> cards</option><% } %>
      </select>
      <label>Card colors</label>
      <select class="sk-colors">
        <% stackCards.COLORS.forEach(o => { %><option value="<%= o[0] %>" <%= skOwn.colors === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <p class="hint">Each card can have words (a quote or a note), a name with a small line under it, stars and a photo. Leave a card empty and it shows one of your site's photos (or just its color).</p>
      <div class="sk-cards">
        <% for (let i = 0; i < stackCards.MAX; i++) { const c = skOwn.cards[i] || {}; %>
        <fieldset class="sk-card"<%= i >= skN ? ' hidden' : '' %> style="border: 1px solid #d6d9de; border-radius: 10px; padding: .6rem .8rem .8rem; margin: 0 0 .8rem;">
          <legend style="font-size: .85rem; font-weight: 600; padding: 0 .3rem;">Card <%= i + 1 %></legend>
          <textarea class="sk-words" rows="3" maxlength="500" placeholder="Words on the card (optional): a customer's own words, or a note"><%= c.words || '' %></textarea>
          <div class="upload-row">
            <input type="text" class="sk-name" maxlength="60" value="<%= c.name || '' %>" placeholder="Name (optional)">
            <input type="text" class="sk-line" maxlength="90" value="<%= c.line || '' %>" placeholder="Small line under the name (optional)">
            <select class="sk-stars" aria-label="Stars on this card"><option value="">No stars</option><% for (let s = 1; s <= 5; s++) { %><option value="<%= s %>" <%= c.stars === s ? 'selected' : '' %>><%= s %> star<%= s > 1 ? 's' : '' %></option><% } %></select>
          </div>
          <div class="gallery-row upload-row">
            <input type="url" class="strip-url sk-url" value="<%= c.photo || '' %>" placeholder="Photo (optional): https://... or upload">
            <input type="file" accept="image/*" class="file-input" hidden>
            <button type="button" class="btn-secondary upload-btn">Upload</button>
            <button type="button" class="btn-secondary pick-btn">Choose photo</button>
          </div>
        </fieldset>
        <% } %>
      </div>
    <% } else if (b.type === 'nodes') { %>
      <% const ncOwn = nodeCards.parse(b.body); %>
      <textarea name="block_body" class="nc-body" hidden><%= b.body || '' %></textarea>
      <label>Words that take turns on the heading's last line (optional, one per line, up to 6; each rolls up into place). Type the fixed part as the heading, e.g. We make brands</label>
      <textarea class="nc-roll" rows="3" maxlength="200" placeholder="move.&#10;stand out.&#10;unforgettable."><%= ncOwn.roll.join('\n') %></textarea>
      <label>Small words under the big heading (optional, a sentence or two; a new line starts a new line)</label>
      <textarea class="nc-sub" rows="3" maxlength="700" placeholder="A sentence or two about what you do."><%= ncOwn.sub.join('\n') %></textarea>
      <label>Cards, left to right (3 to 6). Leave them all empty to use your services and their photos</label>
      <div class="nc-cards">
        <% (ncOwn.cards.length ? ncOwn.cards : [{}, {}, {}, {}, {}]).forEach(c => { %>
        <fieldset class="nc-card" style="border: 1px solid #d6d9de; border-radius: 10px; padding: .6rem .8rem .8rem; margin: 0 0 .8rem;">
          <legend style="font-size: .85rem; font-weight: 600; padding: 0 .3rem;">Card</legend>
          <div class="upload-row">
            <input type="text" class="nc-label" maxlength="30" value="<%= c.label || '' %>" placeholder="Bold label above the card, e.g. Roofs">
            <input type="text" class="nc-tag" maxlength="40" value="<%= c.tag || '' %>" placeholder="Second label (spaced out), e.g. Since 1998">
          </div>
          <textarea class="nc-words" rows="2" maxlength="300" placeholder="Words on this card instead of photos (optional): a short note that sits between the photos"><%= c.words || '' %></textarea>
          <div class="strip-rows">
            <% ((c.pics && c.pics.length) ? c.pics : ['']).forEach(u => { %>
            <div class="gallery-row upload-row">
              <input type="url" class="strip-url nc-url" value="<%= u %>" placeholder="Photo: https://... or upload">
              <input type="file" accept="image/*" class="file-input" hidden>
              <button type="button" class="btn-secondary upload-btn">Upload</button>
              <button type="button" class="btn-secondary pick-btn">Choose photo</button>
              <button type="button" class="btn-secondary strip-remove">✕</button>
            </div>
            <% }) %>
          </div>
          <button type="button" class="btn-secondary" data-stripadd>+ Add photo</button>
          <button type="button" class="btn-secondary nc-remove">Remove card</button>
        </fieldset>
        <% }) %>
      </div>
      <button type="button" class="btn-secondary" data-ncadd>+ Add card</button>
    <% } else if (b.type === 'photopairs') { %>
      <% const ppOwn = photoPairs.parse(b.body); %>
      <textarea name="block_body" class="pp-body" hidden><%= b.body || '' %></textarea>
      <input type="text" class="pp-label" maxlength="60" value="<%= ppOwn.label %>" placeholder="Small line above the heading (optional), e.g. Puppy school">
      <p class="hint">Up to 4 pairs. Each pair is a photo with a tile of words beside it; the last tile takes your color. Empty photos use your site's photos.</p>
      <% for (let i = 0; i < photoPairs.MAX_PAIRS; i++) { const r = ppOwn.pairs[i] || { photo: '', title: '', text: '' }; %>
      <fieldset class="pp-pair" style="border: 1px solid #e2e8f0; border-radius: 8px; padding: .6rem .8rem; margin: .6rem 0;">
        <legend style="font-size: .85rem; font-weight: 600; padding: 0 .3rem;">Pair <%= i + 1 %><%= i > 1 ? ' (optional)' : '' %></legend>
        <div class="upload-row">
          <input type="url" class="pp-url" value="<%= r.photo %>" placeholder="Photo: https://... or upload (empty = one of your site's photos)">
          <input type="file" accept="image/*" class="file-input" hidden>
          <button type="button" class="btn-secondary upload-btn">Upload</button>
          <button type="button" class="btn-secondary pick-btn">Choose photo</button>
        </div>
        <input type="text" class="pp-title" maxlength="80" value="<%= r.title %>" placeholder="Title, e.g. Puppy manners">
        <textarea class="pp-text" rows="2" maxlength="500" placeholder="A sentence or two"><%= r.text %></textarea>
      </fieldset>
      <% } %>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="pp-own-color"<%= ppOwn.color ? ' checked' : '' %>> Own color for the corners, the last tile and the line (unticked = your brand color):</label>
        <input type="color" class="pp-color" oninput="this.parentNode.querySelector('.pp-own-color').checked = true" value="<%= ppOwn.color || '#12b5c4' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <label style="font-weight: 400;"><input type="checkbox" class="pp-shapes"<%= ppOwn.shapes ? ' checked' : '' %>> Show the slanted color corners behind the tiles</label>
    <% } else if (b.type === 'offsetphoto') { %>
      <% const opOwn = offsetPhoto.parse(b.body); %>
      <textarea name="block_body" class="op-body" hidden><%= b.body || '' %></textarea>
      <input type="text" class="op-label" maxlength="60" value="<%= opOwn.label %>" placeholder="Small spaced line over the heading (optional), e.g. About us">
      <label>Words beside the photo (each line is a paragraph, up to 3)</label>
      <textarea class="op-text" rows="3" maxlength="2100" placeholder="A few words about who you are and how you help."><%= opOwn.text.join('\n') %></textarea>
      <input type="text" class="op-note" maxlength="140" value="<%= opOwn.note %>" placeholder="Small line under the words (optional), e.g. Photo by our team">
      <% [['color', 'Own color for the block at the top of the photo (unticked = soft blue)', '#a9c4e2'], ['accent', 'Own color for the block at the bottom of the photo (unticked = soft pink)', '#f2b0b5'], ['button', 'Own button color (unticked = a deeper shade of the top block)', '#6f98c6'], ['bg', 'Own background color for the block (unticked = the page color)', '#ffffff']].forEach(o => { %>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="op-own-<%= o[0] %>"<%= opOwn[o[0]] ? ' checked' : '' %>> <%= o[1] %>:</label>
        <input type="color" class="op-<%= o[0] %>" oninput="this.parentNode.querySelector('.op-own-<%= o[0] %>').checked = true" value="<%= opOwn[o[0]] || o[2] %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <% }) %>
      <label style="font-weight: 400;"><input type="checkbox" class="op-shapes"<%= opOwn.shapes ? ' checked' : '' %>> Show the two color blocks behind the photo</label>
    <% } else if (aboutBlocks.SPECS[b.type]) { %>
      <% const abSpec = aboutBlocks.SPECS[b.type], abOwn = aboutBlocks.parse(b.type, b.body); %>
      <textarea name="block_body" class="ab-body" hidden><%= b.body || '' %></textarea>
      <% abSpec.fields.forEach(f => { %>
        <% if (f.kind === 'line') { %>
      <input type="text" class="ab-f" data-ab="<%= f.k %>" data-abf="line" maxlength="<%= f.max %>" value="<%= abOwn[f.k] %>" placeholder="<%= f.ph %>">
        <% } else if (f.kind === 'url') { %>
      <input type="url" class="ab-f" data-ab="<%= f.k %>" data-abf="line" maxlength="300" value="<%= abOwn[f.k] %>" placeholder="<%= f.ph %>">
        <% } else if (f.kind === 'hint') { %>
      <p class="hint"><%= f.text %></p>
        <% } else if (f.kind === 'paras') { %>
      <label><%= f.label || ('Words (each line is a paragraph, up to ' + f.max + ')') %></label>
      <textarea class="ab-f" data-ab="<%= f.k %>" data-abf="paras" rows="3" maxlength="<%= 700 * f.max + f.max %>" placeholder="<%= f.ph %>"><%= abOwn[f.k].join('\n') %></textarea>
        <% } else if (f.kind === 'rows') { %>
          <% const abN = f.grow ? Math.max(abOwn[f.k].length, 1) : f.max; for (let i = 0; i < abN; i++) { const r = abOwn[f.k][i] || {}; %>
      <fieldset class="ab-row" data-ab="<%= f.k %>" data-abf="row" style="border: 1px solid #e2e8f0; border-radius: 8px; padding: .6rem .8rem; margin: .6rem 0;">
        <legend style="font-size: .85rem; font-weight: 600; padding: 0 .3rem;"><%= f.label %><%= f.grow ? '' : (f.max > 1 ? ' ' + (i + 1) : '') + ' (optional)' %><% if (f.grow) { %> <button type="button" class="btn-secondary ab-del" style="margin-left: .5rem; padding: .1rem .6rem; font-size: .75rem;">Remove</button><% } %></legend>
            <% f.cols.forEach(c => { %>
              <% if (c.photo) { %>
        <div class="upload-row">
          <input type="url" class="ab-c" value="<%= r[c.k] || '' %>" placeholder="<%= c.ph %>">
          <input type="file" accept="image/*" class="file-input" hidden>
          <button type="button" class="btn-secondary upload-btn">Upload</button>
          <button type="button" class="btn-secondary pick-btn">Choose photo</button>
        </div>
              <% } else if (c.link) { %>
        <input type="text" class="ab-c" maxlength="300" value="<%= r[c.k] || '' %>" placeholder="<%= c.ph %>">
              <% } else if (c.choice) { %>
        <select class="ab-c"><option value="">Choose a network</option><% c.choice.forEach(o => { %><option value="<%= o[0] %>"<%= r[c.k] === o[0] ? ' selected' : '' %>><%= o[1] %></option><% }) %></select>
              <% } else { %>
        <input type="text" class="ab-c" maxlength="<%= c.max %>" value="<%= r[c.k] || '' %>" placeholder="<%= c.ph %>">
              <% } %>
            <% }) %>
      </fieldset>
          <% } %>
          <% if (f.grow) { %><button type="button" class="btn-secondary ab-add" data-ab="<%= f.k %>" data-max="<%= f.max %>">+ Add <%= f.label.toLowerCase() %></button><% } %>
        <% } else if (f.kind === 'color') { %>
      <div class="upload-row" data-ab="<%= f.k %>" data-abf="color" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="ab-own"<%= abOwn[f.k] ? ' checked' : '' %>> <%= f.label %>:</label>
        <input type="color" class="ab-color" oninput="this.parentNode.querySelector('.ab-own').checked = true" value="<%= abOwn[f.k] || f.def %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
        <% } else if (f.kind === 'toggle') { %>
      <label style="font-weight: 400;"><input type="checkbox" class="ab-tog" data-ab="<%= f.k %>" data-abf="toggle"<%= abOwn[f.k] ? ' checked' : '' %>> <%= f.label %></label>
        <% } %>
      <% }) %>
    <% } else if (b.type === 'framedphoto') { %>
      <% const fpOwn = framedPhoto.parse(b.body); %>
      <textarea name="block_body" class="fp-body" hidden><%= b.body || '' %></textarea>
      <label>Words on the card (each line is a paragraph, up to 3)</label>
      <textarea class="fp-text" rows="3" maxlength="2100" placeholder="A few words about what you offer."><%= fpOwn.text.join('\n') %></textarea>
      <input type="text" class="fp-note" maxlength="140" value="<%= fpOwn.note %>" placeholder="Small line under the words (optional), e.g. Photo by our team">
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="fp-own-color"<%= fpOwn.color ? ' checked' : '' %>> Own color for the frame blocks, heading and button (unticked = warm tan):</label>
        <input type="color" class="fp-color" oninput="this.parentNode.querySelector('.fp-own-color').checked = true" value="<%= fpOwn.color || '#b9a383' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="fp-own-bg"<%= fpOwn.bg ? ' checked' : '' %>> Own background color for the band (unticked = charcoal):</label>
        <input type="color" class="fp-bg" oninput="this.parentNode.querySelector('.fp-own-bg').checked = true" value="<%= fpOwn.bg || '#2b2b2b' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="fp-own-card"<%= fpOwn.card ? ' checked' : '' %>> Own card color (unticked = white):</label>
        <input type="color" class="fp-card" oninput="this.parentNode.querySelector('.fp-own-card').checked = true" value="<%= fpOwn.card || '#ffffff' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
    <% } else if (b.type === 'roundphoto') { %>
      <% const rpOwn = roundPhoto.parse(b.body); %>
      <textarea name="block_body" class="rp-body" hidden><%= b.body || '' %></textarea>
      <label>Words on the card (each line is a paragraph, up to 3)</label>
      <textarea class="rp-text" rows="3" maxlength="2100" placeholder="A few words about what you offer."><%= rpOwn.text.join('\n') %></textarea>
      <input type="text" class="rp-note" maxlength="140" value="<%= rpOwn.note %>" placeholder="Small line under the words (optional), e.g. Photo by our team">
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="rp-own-color"<%= rpOwn.color ? ' checked' : '' %>> Own color for the card, the circle, rings and dots (unticked = your brand color):</label>
        <input type="color" class="rp-color" oninput="this.parentNode.querySelector('.rp-own-color').checked = true" value="<%= rpOwn.color || '#2ec4b6' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="rp-own-bg"<%= rpOwn.bg ? ' checked' : '' %>> Own background color for the block (unticked = the page color):</label>
        <input type="color" class="rp-bg" oninput="this.parentNode.querySelector('.rp-own-bg').checked = true" value="<%= rpOwn.bg || '#ffffff' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <label style="font-weight: 400;"><input type="checkbox" class="rp-shapes"<%= rpOwn.shapes ? ' checked' : '' %>> Show the rings and dots around the photo</label>
    <% } else if (b.type === 'shapeform') { %>
      <% const sfOwn = shapeForm.parse(b.body); %>
      <textarea name="block_body" class="sf-body" hidden><%= b.body || '' %></textarea>
      <p class="hint">The card shows your contact form, the same one as on your Contact page (messages go to Leads). Turn on "Take messages" in the Contact section for the form; until then the card shows your phone and email. Type the heading above (e.g. Contact us).</p>
      <input type="text" class="sf-text" maxlength="300" value="<%= sfOwn.text %>" placeholder="Line under the heading (optional), e.g. We answer within a day">
      <% [['color', 'Own main color: heading, button, the block under the card and the stripes (unticked = your brand color)', '#2f3fd0'], ['accent', 'Own color for the round dot (unticked = orange)', '#f08a00'], ['panel', 'Own color for the panel behind the photo (unticked = warm yellow)', '#f5c518'], ['bg', 'Own background color for the block (unticked = light grey)', '#e6e6e6']].forEach(o => { %>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="sf-own-<%= o[0] %>"<%= sfOwn[o[0]] ? ' checked' : '' %>> <%= o[1] %>:</label>
        <input type="color" class="sf-<%= o[0] %>" oninput="this.parentNode.querySelector('.sf-own-<%= o[0] %>').checked = true" value="<%= sfOwn[o[0]] || o[2] %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <% }) %>
      <label style="font-weight: 400;"><input type="checkbox" class="sf-shapes"<%= sfOwn.shapes ? ' checked' : '' %>> Show the round dot, the color block and the stripes</label>
    <% } else if (b.type === 'decocard') { %>
      <% const dcO = decoCard.parse(b.body), dcSt = decoCard.styleOf(dcO.style), dcHid = (k) => dcO.hide.includes(k); %>
      <textarea name="block_body" class="dc-body" hidden><%= b.body ? decoCard.cleanBody(b.body) : decoCard.cleanBody('') %></textarea>
      <div class="dc-panel">
        <input type="hidden" class="dc-style" value="<%= dcO.style %>">
        <label>Card style <span class="muted">(switch any time; your words stay)</span></label>
        <div class="dc-styles" role="radiogroup" aria-label="Card style">
          <% decoCard.STYLES.forEach(s => { %><button type="button" class="dc-style-btn<%= dcO.style === s[0] ? ' on' : '' %>" role="radio" aria-checked="<%= dcO.style === s[0] %>" data-dcpick="<%= s[0] %>" data-thick="<%= s[3] %>" data-radius="<%= s[4] %>" data-op="<%= s[5] %>" title="<%= s[2] %>"><%- decoCard.thumb(s[0]) %><span><%= s[1] %></span></button><% }) %>
        </div>
        <fieldset class="dc-box">
          <legend>What the card says <span class="muted">(top to bottom; untick to hide a part)</span></legend>
          <div class="dc-slot"><label><input type="checkbox" class="dc-show" data-slot="icon"<%= dcHid('icon') ? '' : ' checked' %>> Top icon</label>
            <select class="dc-icon" aria-label="Top icon"><% decoCard.ICONS.forEach(i => { %><option value="<%= i[0] %>" <%= dcO.icon === i[0] ? 'selected' : '' %>><%= i[1] %></option><% }) %></select></div>
          <div class="dc-slot"><label><input type="checkbox" class="dc-show" data-slot="eyebrow"<%= dcHid('eyebrow') ? '' : ' checked' %>> Small line on top</label>
            <input type="text" name="dc_eyebrow" class="dc-eyebrow" maxlength="80" value="<%= dcO.eyebrow %>" placeholder="e.g. By Royal Appointment"></div>
          <div class="dc-slot"><label><input type="checkbox" class="dc-show" data-slot="heading"<%= dcHid('heading') ? '' : ' checked' %>> Heading</label> <span class="muted">Type it in the Heading box above.</span></div>
          <div class="dc-slot"><label><input type="checkbox" class="dc-show" data-slot="tagline"<%= dcHid('tagline') ? '' : ' checked' %>> Tagline (in italics)</label>
            <input type="text" name="dc_tagline" class="dc-tagline" maxlength="160" value="<%= dcO.tagline %>" placeholder="e.g. Purveyors of Fine Dog &amp; Cat Grooming"></div>
          <div class="dc-slot"><label><input type="checkbox" class="dc-show" data-slot="div1"<%= dcHid('div1') ? '' : ' checked' %>> First divider</label></div>
          <div class="dc-slot"><label><input type="checkbox" class="dc-show" data-slot="body"<%= dcHid('body') ? '' : ' checked' %>> Paragraphs</label>
            <textarea name="dc_text" class="dc-text" rows="4" maxlength="3600" placeholder="A few sentences about you. Each line is a paragraph (up to 4)."><%= dcO.text.join('\n') %></textarea></div>
          <div class="dc-slot"><label><input type="checkbox" class="dc-show" data-slot="quote"<%= dcHid('quote') ? '' : ' checked' %>> Closing line (italic, larger)</label>
            <input type="text" name="dc_quote" class="dc-quote" maxlength="300" value="<%= dcO.quote %>" placeholder="e.g. Because to you, they're not just a pet."></div>
          <div class="dc-slot"><label><input type="checkbox" class="dc-show" data-slot="div2"<%= dcHid('div2') ? '' : ' checked' %>> Second divider</label></div>
          <div class="dc-slot"><label><input type="checkbox" class="dc-show" data-slot="details"<%= dcHid('details') ? '' : ' checked' %>> Details row (up to 3 short items)</label>
            <div class="dc-row3"><% [0, 1, 2].forEach(n => { %><input type="text" name="dc_detail" class="dc-detail" maxlength="80" value="<%= dcO.details[n] || '' %>" placeholder="<%= ['Address', 'Phone', 'Hours'][n] %>"><% }) %></div></div>
          <div class="dc-slot"><label><input type="checkbox" class="dc-show" data-slot="button"<%= dcHid('button') ? '' : ' checked' %>> Button</label> <span class="muted">Its words and link are the Button boxes below; it uses your site's button style.</span>
            <div class="upload-row dc-c"><label><input type="checkbox" class="dc-own" data-key="btnc"<%= dcO.btnc ? ' checked' : '' %>> Own button color</label><input type="color" class="dc-col" data-key="btnc" data-sg-cl="full" value="<%= dcO.btnc || '#b8326a' %>"></div></div>
        </fieldset>
        <fieldset class="dc-box">
          <legend>Colors</legend>
          <div class="upload-row dc-c"><label>Border color</label><input type="color" class="dc-col dc-border" data-key="border" data-sg-cl="full" value="<%= dcO.border || '#b8923a' %>"></div>
          <div class="dc-presets" role="group" aria-label="Quick border colors">
            <% decoCard.PRESETS.forEach(p => { %><button type="button" class="dc-preset" data-dcpreset="<%= p[1] %>" title="<%= p[0] %> <%= p[1].toUpperCase() %>"><i style="background: <%= p[1] %>"></i><%= p[0] %></button><% }) %>
          </div>
          <p class="hint">The border color also colors the corner curls, the dividers and the top icon, unless you give them their own color.</p>
          <div class="upload-row dc-c"><label><input type="checkbox" class="dc-own" data-key="orn"<%= dcO.orn ? ' checked' : '' %>> Ornament color (curls, dividers, icon)</label><input type="color" class="dc-col" data-key="orn" data-sg-cl="full" value="<%= dcO.orn || dcO.border || '#b8923a' %>"></div>
          <div class="upload-row dc-c"><label>Card background</label><input type="color" class="dc-col" data-key="card" data-sg-cl="full" value="<%= dcO.card || '#ffffff' %>"></div>
          <div class="upload-row dc-c"><label><input type="checkbox" class="dc-ownnum" data-key="cardop"<%= dcO.cardop != null ? ' checked' : '' %>> Card opacity</label><input type="range" class="dc-num" data-key="cardop" min="0" max="100" step="5" value="<%= dcO.cardop != null ? dcO.cardop : dcSt[5] %>"><output class="dc-out"><%= dcO.cardop != null ? dcO.cardop : dcSt[5] %>%</output></div>
          <label>Behind the card</label>
          <div class="upload-row dc-c">
            <select class="dc-sec" aria-label="Behind the card"><% decoCard.SECS.forEach(o => { %><option value="<%= o[0] %>" <%= dcO.sec === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
            <input type="color" class="dc-col" data-key="sec1" data-sg-cl="full" value="<%= dcO.sec1 || '#fdeef4' %>" aria-label="Background color" title="Background color"<%= dcO.sec ? '' : ' hidden' %>>
            <input type="color" class="dc-col" data-key="sec2" data-sg-cl="full" value="<%= dcO.sec2 || '#c9e4f5' %>" aria-label="Second color: the gradient's other end, or the glow" title="Second color: the gradient's other end, or the glow"<%= dcO.sec === 'gradient' || dcO.sec === 'glow' ? '' : ' hidden' %>>
          </div>
          <% [['headc', 'Heading and closing line'], ['bodyc', 'Body text and details'], ['accc', 'Small line on top and tagline']].forEach(x => { %>
          <div class="upload-row dc-c"><label><input type="checkbox" class="dc-own" data-key="<%= x[0] %>"<%= dcO[x[0]] ? ' checked' : '' %>> Own color: <%= x[1] %></label><input type="color" class="dc-col" data-key="<%= x[0] %>" data-sg-cl="full" value="<%= dcO[x[0]] || '#3a3340' %>"></div>
          <% }) %>
          <p class="hint">Unticked colors come from your site's palette and are darkened where needed so they stay easy to read.</p>
          <div class="dc-warn" role="status" aria-live="polite" hidden></div>
        </fieldset>
        <fieldset class="dc-box">
          <legend>Size and shape</legend>
          <div class="upload-row dc-c"><label><input type="checkbox" class="dc-ownnum" data-key="thick"<%= dcO.thick != null ? ' checked' : '' %>> Border thickness</label><input type="range" class="dc-num" data-key="thick" min="1" max="6" step="1" value="<%= dcO.thick != null ? dcO.thick : dcSt[3] %>"><output class="dc-out"><%= dcO.thick != null ? dcO.thick : dcSt[3] %>px</output></div>
          <div class="upload-row dc-c"><label><input type="checkbox" class="dc-ownnum" data-key="radius"<%= dcO.radius != null ? ' checked' : '' %>> Corner rounding</label><input type="range" class="dc-num" data-key="radius" min="0" max="32" step="1" value="<%= dcO.radius != null ? dcO.radius : dcSt[4] %>"><output class="dc-out"><%= dcO.radius != null ? dcO.radius : dcSt[4] %>px</output></div>
          <div class="upload-row dc-c">
            <select class="dc-pad" aria-label="Space inside the card"><% decoCard.PADS.forEach(o => { %><option value="<%= o[0] %>" <%= dcO.pad === o[0] ? 'selected' : '' %>>Space inside: <%= o[1] %></option><% }) %></select>
            <select class="dc-width" aria-label="Card width"><% decoCard.WIDTHS.forEach(o => { %><option value="<%= o[0] %>" <%= dcO.width === o[0] ? 'selected' : '' %>>Width: <%= o[1] %></option><% }) %></select>
            <select class="dc-shadow" aria-label="Shadow"><% decoCard.SHADOWS.forEach(o => { %><option value="<%= o[0] %>" <%= dcO.shadow === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          </div>
          <p class="hint">Ticked boxes keep your own value; unticked follow the card style. Rounding changes the card's corners; the Art deco steps and the stamp's perforated edge keep their shape.</p>
        </fieldset>
        <fieldset class="dc-box">
          <legend>Wallpaper and ledge</legend>
          <div class="upload-row dc-c">
            <select class="dc-pat" aria-label="Wallpaper behind the card"><% decoCard.PATS.forEach(o => { %><option value="<%= o[0] %>" <%= dcO.pat === o[0] ? 'selected' : '' %>><%= o[0] ? 'Wallpaper: ' + o[1] : o[1] %></option><% }) %></select>
            <span class="dc-patopts"<%= dcO.pat ? '' : ' hidden' %>><input type="color" class="dc-col" data-key="patc" data-sg-cl="full" value="<%= dcO.patc || '#f2a9c6' %>" aria-label="Wallpaper color" title="Wallpaper color">
            <label style="font-weight: 400; margin: 0;">Strength <input type="range" class="dc-patop" min="5" max="100" step="5" value="<%= dcO.patop != null ? dcO.patop : 55 %>"></label><output class="dc-out dc-patout"><%= dcO.patop != null ? dcO.patop : 55 %>%</output></span>
          </div>
          <div class="upload-row dc-c"><label><input type="checkbox" class="dc-own" data-key="ledge"<%= dcO.ledge ? ' checked' : '' %>> A soft band along the bottom (for peeking pets to peek over)</label><input type="color" class="dc-col" data-key="ledge" data-sg-cl="full" value="<%= dcO.ledge || '#fbd9e7' %>"></div>
          <p class="hint">Add the peeking pets with + Add picture in the preview and drag them onto the band.</p>
        </fieldset>
        <fieldset class="dc-box">
          <legend>Invitation Reveal <span class="muted">(the card comes out of an envelope)</span></legend>
          <select class="dc-reveal" aria-label="Invitation Reveal"><% decoCard.REVEALS.forEach(o => { %><option value="<%= o[0] %>" <%= dcO.reveal === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <div class="dc-rvbox"<%= dcO.reveal ? '' : ' hidden' %>>
            <p class="hint">As visitors scroll, the wax seal breaks, the flap opens and the card slides out and grows into place. Visitors can also click the envelope to open it. People who turn motion off see the card open. The preview shows the card open so you can edit it; play the opening here to watch it.</p>
            <div class="dc-rvdemo">
              <button type="button" class="btn-secondary dc-rvplay">&#9654; Play it in the preview</button>
              <label class="dc-rvstep">Step through it <input type="range" class="dc-rvscrub" min="0" max="100" step="1" value="0" aria-label="Step through the opening: sealed at the left, open at the right"></label>
              <button type="button" class="btn-secondary dc-rvstop" hidden>Back to editing</button>
              <p class="dc-rvmsg hint" role="status" aria-live="polite"></p>
            </div>
            <% [['env', 'Envelope'], ['flap', 'Flap'], ['seal', 'Wax seal'], ['liner', 'Inside of the envelope']].forEach(x => { %>
            <div class="upload-row dc-c"><label><%= x[1] %></label><input type="color" class="dc-col" data-key="<%= x[0] %>" data-sg-cl="full" value="<%= dcO[x[0]] || decoCard.RV_DEFAULTS[x[0]] %>"></div>
            <% }) %>
            <div class="upload-row dc-c">
              <select class="dc-sealicon" aria-label="Seal picture"><% decoCard.SEAL_ICONS.forEach(o => { %><option value="<%= o[0] %>" <%= dcO.sealicon === o[0] ? 'selected' : '' %>>Seal: <%= o[1] %></option><% }) %></select>
              <select class="dc-len" aria-label="How much scrolling it takes"><% decoCard.LENS.forEach(o => { %><option value="<%= o[0] %>" <%= dcO.len === o[0] ? 'selected' : '' %>>Speed: <%= o[1] %></option><% }) %></select>
            </div>
            <input type="text" class="dc-hint" maxlength="60" value="<%= dcO.hint %>" placeholder="Words under the envelope (empty = Scroll to open)">
            <label style="font-weight: 400;"><input type="checkbox" class="dc-once"<%= dcO.once ? ' checked' : '' %>> Once it is open, it stays open (scrolling back up doesn't close it)</label>
          </div>
        </fieldset>
        <fieldset class="dc-box">
          <legend>Fonts</legend>
          <div class="upload-row dc-c">
            <% [['hfont', 'Heading font'], ['bfont', 'Body font']].forEach(x => { %>
            <select class="dc-font" data-key="<%= x[0] %>" aria-label="<%= x[1] %>">
              <option value=""><%= x[1] %>: your site's</option>
              <% const _fg = {}; fonts.FONTS.forEach(f => { (_fg[f.group] = _fg[f.group] || []).push(f.name); }); Object.keys(_fg).forEach(g => { %><optgroup label="<%= g %>"><% _fg[g].forEach(n => { %><option value="<%= n %>" <%= dcO[x[0]] === n ? 'selected' : '' %>><%= n %></option><% }) %></optgroup><% }) %>
              <% if (dcO[x[0]] && !fonts.FONTS.some(f => f.name === dcO[x[0]])) { %><option value="<%= dcO[x[0]] %>" selected><%= dcO[x[0]] %></option><% } %>
            </select>
            <% }) %>
          </div>
        </fieldset>
      </div>
    <% } else if (b.type === 'ringcard') { %>
      <% const rgOwn = ringCard.parse(b.body); %>
      <textarea name="block_body" class="rg-body" hidden><%= b.body || '' %></textarea>
      <label>Words on the white panel (each line is a paragraph, up to 3)</label>
      <textarea class="rg-text" rows="3" maxlength="2100" placeholder="A few words about you, your pets or what you do."><%= rgOwn.text.join('\n') %></textarea>
      <input type="text" class="rg-note" maxlength="140" value="<%= rgOwn.note %>" placeholder="Small line under the words (optional), e.g. Photo by our team">
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="rg-own-color"<%= rgOwn.color ? ' checked' : '' %>> Own color for the heading, the shapes and the button (unticked = your brand color):</label>
        <input type="color" class="rg-color" oninput="this.parentNode.querySelector('.rg-own-color').checked = true" value="<%= rgOwn.color || '#d9505e' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="rg-own-bg"<%= rgOwn.bg ? ' checked' : '' %>> Own background color for the block (unticked = a soft tint of the color above):</label>
        <input type="color" class="rg-bg" oninput="this.parentNode.querySelector('.rg-own-bg').checked = true" value="<%= rgOwn.bg || '#fbecec' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <label style="font-weight: 400;"><input type="checkbox" class="rg-shapes"<%= rgOwn.shapes ? ' checked' : '' %>> Show the striped circle and the ring behind the panel and the photo</label>
    <% } else if (b.type === 'twinphotos') { %>
      <% const twOwn = twinPhotos.parse(b.body); %>
      <textarea name="block_body" class="tw-body" hidden><%= b.body || '' %></textarea>
      <label>Words under the heading (each line is a paragraph, up to 3)</label>
      <textarea class="tw-text" rows="3" maxlength="2100" placeholder="A sentence or two about you and the pets you look after."><%= twOwn.text.join('\n') %></textarea>
      <label>Two square photos (empty = your site's photos; ✂ Cut out makes the pet stand on the colored square)</label>
      <% for (let i = 0; i < 2; i++) { %>
      <div class="upload-row">
        <input type="url" class="tw-url" value="<%= twOwn.photos[i] || '' %>" placeholder="Photo <%= i + 1 %>: https://... or upload">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
      <% } %>
      <label>Links on the panel (up to <%= twinPhotos.MAX_LINKS %>; leave the address empty for plain words)</label>
      <% for (let i = 0; i < twinPhotos.MAX_LINKS; i++) { const k = twOwn.links[i] || { label: '', url: '' }; %>
      <div class="upload-row tw-link">
        <input type="text" class="tw-label" maxlength="60" value="<%= k.label %>" placeholder="<%= i ? 'Another link (optional)' : 'e.g. Training tips' %>">
        <input type="text" class="tw-href" maxlength="500" value="<%= k.url %>" placeholder="Address, e.g. /services or https://...">
      </div>
      <% } %>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="tw-own-color"<%= twOwn.color ? ' checked' : '' %>> Own color for the heading and the photo squares (unticked = your brand color):</label>
        <input type="color" class="tw-color" oninput="this.parentNode.querySelector('.tw-own-color').checked = true" value="<%= twOwn.color || '#f2b705' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="tw-own-panel"<%= twOwn.panel ? ' checked' : '' %>> Own color for the tall panel (unticked = light grey):</label>
        <input type="color" class="tw-panel" oninput="this.parentNode.querySelector('.tw-own-panel').checked = true" value="<%= twOwn.panel || '#efefef' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
    <% } else if (b.type === 'reviewcard') { %>
      <% const rcOwn = reviewCard.parse(b.body); %>
      <textarea name="block_body" class="rc-body" hidden><%= b.body || '' %></textarea>
      <p class="hint">Up to 3 reviews on a wide card, each with a small round photo (or the person's first letter when there is no photo), their words and their name. Leave all three empty to show the first 3 from your Reviews section. Type the heading above (e.g. What pet parents say).</p>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="rc-own-bg"<%= rcOwn.bg ? ' checked' : '' %>> Own background color for the block (unticked = a soft tint of your brand color):</label>
        <input type="color" class="rc-bg" oninput="this.parentNode.querySelector('.rc-own-bg').checked = true" value="<%= rcOwn.bg || '#eef2f7' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <div class="upload-row" style="align-items: center;">
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="rc-own-card"<%= rcOwn.card ? ' checked' : '' %>> Own card color (unticked = white; the words turn light on a dark card):</label>
        <input type="color" class="rc-card" oninput="this.parentNode.querySelector('.rc-own-card').checked = true" value="<%= rcOwn.card || '#ffffff' %>" style="width: 64px; height: 36px; padding: 2px;">
      </div>
      <% for (let i = 0; i < reviewCard.MAX_REVIEWS; i++) { const r = rcOwn.reviews[i] || { photo: '', quote: '', name: '' }; %>
      <fieldset class="rc-review" style="border: 1px solid #e2e8f0; border-radius: 8px; padding: .6rem .8rem; margin: .6rem 0;">
        <legend style="font-size: .85rem; font-weight: 600; padding: 0 .3rem;">Review <%= i + 1 %><%= i ? ' (optional)' : '' %></legend>
        <div class="upload-row">
          <input type="url" class="rc-url" value="<%= r.photo %>" placeholder="Small round photo: https://... or upload (optional)">
          <input type="file" accept="image/*" class="file-input" hidden>
          <button type="button" class="btn-secondary upload-btn">Upload</button>
          <button type="button" class="btn-secondary pick-btn">Choose photo</button>
        </div>
        <textarea class="rc-quote" rows="2" maxlength="400" placeholder="What they said, in their words"><%= r.quote %></textarea>
        <input type="text" class="rc-name" maxlength="80" value="<%= r.name %>" placeholder="Their name, e.g. Sam, Max's owner">
      </fieldset>
      <% } %>
    <% } else if (b.type === 'phototabs') { %>
      <% const ptOwn = photoTabs.parse(b.body); %>
      <textarea name="block_body" class="pt-body" hidden><%= b.body || '' %></textarea>
      <p class="hint">Up to 4 cards. Each card is a photo with its own words and color: visitors pick a small photo under the big one, and the big photo, the words in the box at the front and the color all change to that card's. With one card it is a plain photo with a card. The heading above titles the first card if you leave its title empty.</p>
      <% for (let i = 0; i < photoTabs.MAX_CARDS; i++) { const c = ptOwn.cards[i] || { photo: '', color: '', title: '', text: '' }; %>
      <fieldset class="pt-card" style="border: 1px solid #e2e8f0; border-radius: 8px; padding: .6rem .8rem; margin: .6rem 0;">
        <legend style="font-size: .85rem; font-weight: 600; padding: 0 .3rem;">Card <%= i + 1 %><%= i ? ' (optional)' : '' %></legend>
        <div class="upload-row">
          <input type="url" class="pt-url" value="<%= c.photo %>" placeholder="Photo: https://... or upload (empty = one of your site's photos)">
          <input type="file" accept="image/*" class="file-input" hidden>
          <button type="button" class="btn-secondary upload-btn">Upload</button>
          <button type="button" class="btn-secondary pick-btn">Choose photo</button>
        </div>
        <input type="text" class="pt-title" maxlength="80" value="<%= c.title %>" placeholder="Title in the box, e.g. Puppy classes">
        <textarea class="pt-text" rows="2" maxlength="600" placeholder="A sentence or two for this photo"><%= c.text %></textarea>
        <div class="upload-row" style="align-items: center;">
          <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="pt-own"<%= c.color ? ' checked' : '' %>> Own color for this card (border, button and the block behind the photo; unticked = your brand color):</label>
          <input type="color" class="pt-color" oninput="this.parentNode.querySelector('.pt-own').checked = true" value="<%= c.color || '#1d6fa5' %>" style="width: 64px; height: 36px; padding: 2px;">
        </div>
      </fieldset>
      <% } %>
    <% } else if (b.type === 'overlapcard') { %>
      <label>Words on the card (each line is a paragraph, up to 4)</label>
      <textarea name="block_body" rows="4" maxlength="4000" placeholder="A few words about you, your pets or what you do.&#10;~ Photo by Jane Smith"><%= b.body || '' %></textarea>
      <p class="hint">Type the heading above (e.g. Why do we love pets?). A line that starts with ~ shows small and in italics under the words, e.g. a photo credit. The Button boxes below add the dark rounded button (optional).</p>
    <% } else if (b.type === 'patterns') { %>
      <label>Words under the heading (optional; a blank line starts a new paragraph. Leave the heading and words empty for just the pattern)</label>
      <textarea name="block_body" rows="3" maxlength="600" placeholder="A line or two about what you do."><%= b.body || '' %></textarea>
    <% } else if (b.type === 'zoomword' || b.type === 'morph') { %>
      <label><%= b.type === 'zoomword' ? 'Words that come up after the zoom (optional, a sentence or two)' : 'Text beside the photo (a new line starts a new paragraph)' %></label>
      <textarea name="block_body" rows="4" maxlength="1600"><%= b.body || '' %></textarea>
    <% } else if (b.type === 'bigwords') { %>
      <label>Big words, one row per line (up to 4). Put [photo] where the photo goes</label>
      <textarea name="block_body" rows="4" maxlength="600" placeholder="Building&#10;tomorrow&#10;for [photo] today"><%= b.body || '' %></textarea>
      <p class="hint">Leave it empty to use the heading as the big words. With rows typed, the heading shows as a small line above them.</p>
    <% } else if (b.type === 'collage') { %>
      <label>Words that slide through the photo card (one per line; add " | photo link" to give a line its own photo)</label>
      <textarea name="block_body" rows="5" maxlength="4000" placeholder="Roof repair | https://...&#10;New roofs&#10;Gutters"><%= b.body || '' %></textarea>
      <p class="hint">Leave it empty to use your service names, each with its own photo. Lines without a photo, and the photos scattered around the card, use your site's photos (hero, services, About and gallery). It needs 3 lines and 3 photos. Put [square brackets] around heading words to color them.</p>
    <% } else { %>
        <label><%= b.type === 'photoBanner' ? 'Words under the heading (optional, a sentence or two)' : b.type === 'steps' ? 'Steps (one per line: Title | short description)' : b.type === 'features' ? 'Cards (one per line: Title | short description)' : b.type === 'team' ? 'People (one per line: Name | Role | Short bio | Photo link). Photo link is optional; upload photos in the Gallery section and paste the link.' : b.type === 'stats' ? 'Numbers (one per line: Number | Label). They count up when scrolled into view.' : b.type === 'beforeAfter' ? 'Words under the heading (optional)' : b.type === 'video' ? 'Video link (YouTube or Vimeo page link, or a direct .mp4 / .webm file link)' : (b.type === 'tabs' || b.type === 'accordion') ? 'Items (one per line: Title | text)' : b.type === 'pricing' ? 'Plans (one per line: Name | Price | what is included, separated by commas). Start a line with * to highlight that plan.' : b.type === 'chips' ? 'Places (one per line, e.g. Kissimmee, FL — add | /link to make one clickable)' : b.type === 'wall' ? 'Extra short lines for the wall (optional, one per line, e.g. a motto). The wall already uses the name or logo, headline, services, photos, short reviews, trust numbers and badges, and your colors.' : 'Text (a blank line starts a new paragraph)' %></label>
    <textarea name="block_body" rows="5" maxlength="2000" placeholder="<%= b.type === 'photoBanner' ? 'A sentence or two about what you do. Let\'s talk.' : b.type === 'steps' ? 'Book online | Pick a time that works for you' : b.type === 'features' ? 'Local team | Describe this point' : b.type === 'team' ? 'Jordan Lee | Lead groomer | Short bio goes here | https://...' : b.type === 'stats' ? '12 | Years in business\n1,500+ | Pets groomed' : b.type === 'beforeAfter' ? 'Drag the line to see the difference.' : b.type === 'video' ? 'https://www.youtube.com/watch?v=...' : b.type === 'tabs' ? 'Dogs | What we offer for dogs\nCats | What we offer for cats' : b.type === 'accordion' ? 'How long does it take? | Most visits take about two hours.' : b.type === 'pricing' ? 'Bath | from $40 | Wash and dry, Brush out, Ear cleaning\n* Full groom | from $70 | Bath, Haircut, Nail trim' : b.type === 'chips' ? 'Kissimmee, FL' : b.type === 'wall' ? 'Built to last\nNo job too small' : '' %>"><%= b.body || '' %></textarea>
    <% } %>
    <% if (b.type === 'steps') { %>
      <input type="hidden" name="block_image" value="">
      <label>Look</label>
      <select name="block_side"><option value="auto"<%= !['timeline', 'stack'].includes(b.side) ? ' selected' : '' %>>Cards in a grid</option><option value="timeline"<%= b.side === 'timeline' ? ' selected' : '' %>>Timeline (a line draws itself as visitors scroll)</option><option value="stack"<%= b.side === 'stack' ? ' selected' : '' %>>Stacking cards (each step slides over the last as visitors scroll)</option></select>
    <% } else if (b.type === 'wall') { %>
      <% const wset = brandWall.settings(b.side); %>
      <input type="hidden" name="block_image" value=""><input type="hidden" name="block_side" class="wall-side" value="<%= brandWall.cleanSide(b.side) %>">
      <label>Wall size, tilt, speed and what it shows</label>
      <div class="upload-row wall-opts" style="flex-wrap: wrap;" onchange="var r=this.closest('.block-row'),v=Array.prototype.map.call(this.querySelectorAll('select'),function(x){return x.value}).join(':');r.querySelector('.wall-side').value=v;">
        <select aria-label="Wall height"><% [['short', 'Short'], ['medium', 'Medium'], ['tall', 'Tall'], ['screen', 'Full screen']].forEach(o => { %><option value="<%= o[0] %>" <%= wset.size === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select aria-label="Wall tilt"><% [['none', 'Straight'], ['gentle', 'Gentle tilt'], ['strong', 'Strong tilt']].forEach(o => { %><option value="<%= o[0] %>" <%= wset.tilt === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select aria-label="Wall speed"><% [['slow', 'Slow'], ['normal', 'Normal speed'], ['fast', 'Fast']].forEach(o => { %><option value="<%= o[0] %>" <%= wset.speed === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select aria-label="What the wall shows" style="flex: 1 1 100%;"><% [['all', 'Your photos and lines plus the site\'s content'], ['mine', 'Only your photos and lines (with the name and colors)']].forEach(o => { %><option value="<%= o[0] %>" <%= wset.content === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
      </div>
      <p class="hint">The heading and button (optional) sit on a card in the middle of the wall. Leave both empty for the wall alone. "Plain background" shows a dark wall; pick a band below for light or brand-colored. Visitors can pause it, and it holds still for anyone who turns motion off.</p>
    <% } else if (b.type === 'cascade') { %>
      <% const cset = cardCascade.settings(b.side); %>
      <input type="hidden" name="block_image" value=""><input type="hidden" name="block_side" class="wall-side" value="<%= cardCascade.cleanSide(b.side) %>">
      <label>Size, speed and what the cards show</label>
      <div class="upload-row wall-opts" style="flex-wrap: wrap;" onchange="var r=this.closest('.block-row'),v=Array.prototype.map.call(this.querySelectorAll('select'),function(x){return x.value}).join(':');r.querySelector('.wall-side').value=v;">
        <select aria-label="Cascade height"><% [['short', 'Short'], ['medium', 'Medium'], ['tall', 'Tall'], ['screen', 'Full screen']].forEach(o => { %><option value="<%= o[0] %>" <%= cset.size === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select aria-label="Cascade speed"><% [['slow', 'Slow'], ['normal', 'Normal speed'], ['fast', 'Fast']].forEach(o => { %><option value="<%= o[0] %>" <%= cset.speed === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select aria-label="What the cards show" style="flex: 1 1 100%;"><% [['all', 'Your photos and lines plus the site\'s content'], ['mine', 'Only your photos and lines (with the name and colors)']].forEach(o => { %><option value="<%= o[0] %>" <%= cset.content === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
      </div>
      <p class="hint">The cards deal in one after another into an overlapping stack, hold, then clear and deal again. With a heading or button (optional) they sit beside the cards; leave both empty for the cards alone. Pick a band below for a tinted, brand-colored or dark background. Visitors can pause it, and it shows the finished stack, still, for anyone who turns motion off.</p>
    <% } else if (b.type === 'video') { %>
      <input type="hidden" name="block_image" value="">
      <label>Look</label>
      <select name="block_side"><% videoMask.LOOKS.forEach(o => { %><option value="<%= o[0] %>" <%= videoMask.clean(b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
      <p class="hint">The shapes and "through the letters" need a video file link (.mp4 or .webm, e.g. one you uploaded); a YouTube or Vimeo link stays a plain player. A shaped video plays silently on a loop, like a moving picture. "Through the letters" uses the heading as the letters, so keep it to a word or two.</p>
    <% } else if (b.type === 'wave') { %>
      <input type="hidden" name="block_image" value="">
      <label>Word the photos spell first (optional, e.g. your name or "Art"; up to 12 letters)</label>
      <input type="text" name="block_side" maxlength="12" value="<%= motionBlocks.cleanShape(b.side) %>" placeholder="Leave empty for the wave">
      <p class="hint">With a word here, the photo cards line up to spell it (short words read best, 1 to 6 letters), then scatter as visitors scroll and settle around your words. Empty: the photos make a wave between the two words of the heading (written like Tracing ~ Art). With motion off it shows your words with the photos under them.</p>
    <% } else if (b.type === 'story' || b.type === 'path') { %>
      <input type="hidden" name="block_image" value=""><input type="hidden" name="block_side" value="auto">
      <p class="hint"><%= b.type === 'story' ? 'The block holds still while the steps play one after another as visitors scroll, each with its photo (your photos first, then your site\'s), and a bar fills as the story goes. On phones, and with motion off, it shows the steps as a list.' : 'The photos (yours first, then your site\'s) and your lines travel along a curve across the block as visitors scroll. With motion off they sit in a row.' %></p>
    <% } else if (b.type === 'zoomword' || b.type === 'morph') { %>
      <label><%= b.type === 'zoomword' ? 'Photo inside the word (leave empty to use your hero photo)' : 'Photo (leave empty to use your About photo)' %></label>
      <div class="upload-row">
        <input type="url" name="block_image" value="<%= b.imageUrl || '' %>" placeholder="https://... or upload">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
      <input type="hidden" name="block_side" value="auto">
      <p class="hint"><%= b.type === 'zoomword' ? 'Type the word as the heading (one or two short words read best). It shows huge, filled with the photo; scrolling zooms through its letters into the photo, then your words come up.' : 'The photo sits in a soft shape that changes, pebble to circle to arch to leaf, as visitors scroll past.' %></p>
    <% } else if (b.type === 'trail') { %>
      <input type="hidden" name="block_image" value=""><input type="hidden" name="block_side" value="auto">
      <p class="hint"><%= b.type === 'trail' ? 'Photos pop out along the mouse as it moves across this block, overlapping like steps, then fade. On phones a trail runs across by itself. With motion off it shows the photos as a still staircase.' : 'Write the heading as two words with a ~ between them, e.g. Tracing ~ Art: the photos make a wave between them. As visitors scroll, the photos scatter, then settle around your words. With motion off it shows your words with the photos under them.' %></p>
    <% } else if (b.type === 'bigwords') { %>
      <label>Photo inside the words (leave empty to use your first site photo)</label>
      <div class="upload-row">
        <input type="url" name="block_image" value="<%= b.imageUrl || '' %>" placeholder="https://... or upload">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
      <input type="hidden" name="block_side" value="auto">
      <p class="hint">The words stretch into place one after another as the block comes into view, and the photo opens up inside the line.</p>
    <% } else if (b.type === 'collage') { %>
      <input type="hidden" name="block_image" value="">
      <label>How the words move</label>
      <select name="block_side">
        <option value="auto"<%= b.side !== 'banner' ? ' selected' : '' %>>Step by step: the next line slides onto the card every few seconds</option>
        <option value="banner"<%= b.side === 'banner' ? ' selected' : '' %>>Banner: the words run across the page nonstop, and the card's photo changes as each line passes it</option>
      </select>
      <p class="hint">The heading's words rise in one at a time. Each time a line reaches the card, its photo wipes in and two of the scattered photos swap; pointing at a photo grows it, and pointing at a line stops the banner. It holds still for anyone who turns motion off.</p>
    <% } else if (b.type === 'shapes') { %>
      <input type="hidden" name="block_image" value="">
      <label>Shape rims</label>
      <select name="block_side">
        <% shapeBlock.RIMS.forEach(o => { %><option value="<%= o[0] %>" <%= shapeBlock.cleanSide(b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <p class="hint">The heading shows big and bold on the left; type its fixed part as the heading (e.g. We make brands), and the words above take turns on its last line, in your brand color. Your small words sit on the right. Three soft rounded shapes run along the bottom, each showing a different one of your photos; while visitors can see the block, the photos move round the shapes like a carousel. With no photos it uses your site's. Put [square brackets] around heading words to color them. Visitors can pause it, and it holds still for anyone who turns motion off.</p>
    <% } else if (b.type === 'patterns') { %>
      <input type="hidden" name="block_image" value="">
      <% const gpSet = patternBlock.settings(b.side); %>
      <input type="hidden" name="block_side" class="gp-side" value="<%= patternBlock.cleanSide(b.side) %>">
      <label>Pattern, words and motion</label>
      <div class="upload-row gp-pick" style="flex-wrap: wrap;" onchange="var r=this.closest('.block-row');r.querySelector('.gp-side').value=Array.prototype.map.call(this.querySelectorAll('select'),function(x){return x.value}).join(':');">
        <select aria-label="Pattern"><% patternBlock.PATTERNS.forEach(o => { %><option value="<%= o[0] %>" <%= gpSet.pattern === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select aria-label="Words look"><% patternBlock.LOOKS.forEach(o => { %><option value="<%= o[0] %>" <%= gpSet.look === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select aria-label="Motion"><% patternBlock.MOTIONS.forEach(o => { %><option value="<%= o[0] %>" <%= gpSet.motion === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select aria-label="Version"><% for (let v = 1; v <= patternBlock.VERSIONS; v++) { %><option value="<%= v %>" <%= gpSet.version === v ? 'selected' : '' %>>Version <%= v %> of <%= patternBlock.VERSIONS %></option><% } %></select>
        <button type="button" class="btn-secondary" title="Try another version of this pattern" onclick="var s=this.previousElementSibling,n=s.options.length,v;do{v=1+Math.floor(Math.random()*n)}while(String(v)===s.value&&n>1);s.value=String(v);s.dispatchEvent(new Event('change',{bubbles:true}));">Shuffle</button>
      </div>
      <label>Pattern colors</label>
      <%- include('_ink-pick', { name: 'block_bgink', value: b.bgink || '', theme: typeof site !== 'undefined' ? site.theme : {}, kind: 'pattern' }) %>
      <p class="hint">The whole block is a pattern drawn only with color (no photos, so it loads instantly). Each pattern has 12 versions with different angles and bands; Shuffle tries another. Colors: your brand and accent colors unless you pick others, or a rainbow. When a visitor points at it, the pattern slowly zooms in a little and the words card lifts; on phones it breathes in and out slowly. It holds still for anyone who turns motion off.</p>
    <% } else if (b.type === 'photoblend') { %>
      <input type="hidden" name="block_image" value="">
      <% const pbSide = photoBlend.cleanSide(b.side).split(':'); %>
      <input type="hidden" name="block_side" class="pb-side" value="<%= pbSide.join(':') %>">
      <label>Photo side and how it blends in</label>
      <div class="upload-row pb-sidepick" style="flex-wrap: wrap;" onchange="var r=this.closest('.block-row');r.querySelector('.pb-side').value=Array.prototype.map.call(this.querySelectorAll('select'),function(x){return x.value}).join(':');">
        <select><% photoBlend.SIDES.forEach(o => { %><option value="<%= o[0] %>" <%= pbSide[0] === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select><% photoBlend.BLENDS.forEach(o => { %><option value="<%= o[0] %>" <%= pbSide[1] === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
      </div>
      <p class="hint">Match: the block takes the color along the photo's edge, so a photo shot on a plain backdrop looks like it stands right in the block (with photos that take turns, the color follows each photo). Fade: the photo's edge next to the words fades softly into the block's color. Pets cut out: use "Cut out the pets" above; the pets stand on the block's color with no edge. On phones the photo sits on top and fades into the words under it.</p>
    <% } else if (b.type === 'advice') { %>
      <input type="hidden" name="block_image" value="">
      <label>Which side</label>
      <select name="block_side">
        <% adviceBlock.SIDES.forEach(o => { %><option value="<%= o[0] %>" <%= adviceBlock.cleanSide(b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <p class="hint">A soft band in a light take on your brand color runs along the top and bottom, and the big photo reaches up into it. With 2 to 4 big photos they fade from one to the next every few seconds (still for anyone who turns motion off). On phones the words go under the photo.</p>
    <% } else if (b.type === 'crossband') { %>
      <input type="hidden" name="block_image" value="">
      <label>Which side</label>
      <select name="block_side">
        <option value="auto"<%= b.side !== 'right' ? ' selected' : '' %>>Band, photo and checklist on the left; card on the right</option>
        <option value="right"<%= b.side === 'right' ? ' selected' : '' %>>Mirrored: band, photo and checklist on the right</option>
      </select>
      <p class="hint">A wide color band runs in from the page edge behind the tall photo and the card. With more than one photo in a spot they fade from one to the next every few seconds (still for anyone who turns motion off). On phones it all stacks.</p>
    <% } else if (b.type === 'mosaic') { %>
      <input type="hidden" name="block_image" value="">
      <label>Menu bar</label>
      <select name="block_side">
        <% mosaicHero.MENUS.forEach(o => { %><option value="<%= o[0] %>" <%= mosaicHero.cleanSide(b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <p class="hint">Put this block first on the page to use it as the hero. The menu bar shows your name or logo, your page links and a Call Now button (when you have a phone number); on phones the links fold into a menu button. If you use it, you may want to tick "Hide the menu links" in Look and feel so the links don't show twice.</p>
    <% } else if (b.type === 'thirds') { %>
      <input type="hidden" name="block_image" value="">
      <label>Big box colors</label>
      <select name="block_side">
        <% thirdsBlock.BOXES.forEach(o => { %><option value="<%= o[0] %>" <%= thirdsBlock.cleanSide(b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <p class="hint">Three columns side by side: a tall photo, your words on a light panel, and a photo over the big box. The big box's words grow to fill it: one letter or word shows huge, a few words share the box. With more than one photo in a spot they fade from one to the next every few seconds (they hold still for anyone who turns motion off). On phones the columns stack.</p>
    <% } else if (b.type === 'photopairs') { %>
      <input type="hidden" name="block_image" value="">
      <input type="hidden" name="block_side" value="center">
      <p class="hint">Type the heading above (e.g. Train with us). The Button boxes below add one button under the tiles (optional). On phones each photo sits above its words.</p>
    <% } else if (b.type === 'offsetphoto') { %>
      <label>Photo (leave empty to use your About photo, or another of your site's photos)</label>
      <div class="upload-row">
        <input type="url" name="block_image" value="<%= b.imageUrl || '' %>" placeholder="https://... or upload">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
      <label>Which side</label>
      <select name="block_side">
        <% offsetPhoto.SIDES.forEach(o => { %><option value="<%= o[0] %>" <%= offsetPhoto.cleanSide(b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <p class="hint">The photo sits on two offset blocks of color. A photo with its background cut out (✂ Cut out) stands on a soft square of the top color. On phones the words go under the photo. Type the heading above. The Button boxes below add the button (optional).</p>
    <% } else if (aboutBlocks.SPECS[b.type]) { %>
      <% const abS = aboutBlocks.SPECS[b.type]; %>
      <% if (abS.photoLabel) { %>
      <label><%= abS.photoLabel %></label>
      <div class="upload-row">
        <input type="url" name="block_image" value="<%= b.imageUrl || '' %>" placeholder="https://... or upload">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
      <% } else { %><input type="hidden" name="block_image" value=""><% } %>
      <% if (abS.sides.length > 1) { %>
      <label>Which side</label>
      <select name="block_side">
        <% abS.sides.forEach(o => { %><option value="<%= o[0] %>" <%= aboutBlocks.cleanSide(b.type, b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <% } else { %><input type="hidden" name="block_side" value="<%= abS.sides[0][0] %>"><% } %>
      <p class="hint"><%= abS.hint %> A photo with its background cut out (✂ Cut out) stands on a soft square of your color. The Button boxes below add the button (optional).</p>
    <% } else if (b.type === 'framedphoto') { %>
      <label>Photo (leave empty to use your About photo, or another of your site's photos)</label>
      <div class="upload-row">
        <input type="url" name="block_image" value="<%= b.imageUrl || '' %>" placeholder="https://... or upload">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
      <label>Which side</label>
      <select name="block_side">
        <% framedPhoto.SIDES.forEach(o => { %><option value="<%= o[0] %>" <%= framedPhoto.cleanSide(b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <p class="hint">The photo sits between two blocks of color that peek out at opposite corners, and the card overlaps its lower corner. A photo with its background cut out (✂ Cut out) stands on a soft square of the frame color. On phones the card goes under the photo. Type the heading above. The Button boxes below add the button (optional).</p>
    <% } else if (b.type === 'roundphoto') { %>
      <label>Photo (leave empty to use your About photo, or another of your site's photos)</label>
      <div class="upload-row">
        <input type="url" name="block_image" value="<%= b.imageUrl || '' %>" placeholder="https://... or upload">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
      <label>Which side</label>
      <select name="block_side">
        <% roundPhoto.SIDES.forEach(o => { %><option value="<%= o[0] %>" <%= roundPhoto.cleanSide(b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <p class="hint">The photo is cut into a big circle on a soft circle of your color, and the color card overlaps its lower corner. A photo with its background cut out (✂ Cut out) stands in the circle. On phones the card goes under the photo. Type the heading above. The Button boxes below add the button (optional).</p>
    <% } else if (b.type === 'shapeform') { %>
      <label>Photo (a person or pet with the background cut out looks best; empty = your About photo)</label>
      <div class="upload-row">
        <input type="url" name="block_image" value="<%= b.imageUrl || '' %>" placeholder="https://... or upload">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
      <label>Which side</label>
      <select name="block_side">
        <% shapeForm.SIDES.forEach(o => { %><option value="<%= o[0] %>" <%= shapeForm.cleanSide(b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
      <p class="hint">On phones the photo goes on top and the form card under it.</p>
    <% } else if (b.type === 'decocard') { %>
      <input type="hidden" name="block_image" value="">
      <input type="hidden" name="block_side" value="auto">
      <p class="hint">Click any words on the page preview to type them there. On phones the card gets less padding, smaller curls, and the details row stacks.</p>
    <% } else if (b.type === 'ringcard') { %>
      <label>Photo (leave empty to use your About photo, or another of your site's photos)</label>
      <div class="upload-row">
        <input type="url" name="block_image" value="<%= b.imageUrl || '' %>" placeholder="https://... or upload">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
      <label>Which side</label>
      <select name="block_side">
        <% ringCard.SIDES.forEach(o => { %><option value="<%= o[0] %>" <%= ringCard.cleanSide(b.side) === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
