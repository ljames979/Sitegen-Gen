<script>
// Color film: the strength, brand/own and color controls write one hidden "color:strength" field
(function () {
  function sync(row) {
    var s = row.querySelector('[data-film="s"]'), m = row.querySelector('[data-film="m"]'), c = row.querySelector('[data-film="c"]'), h = row.querySelector('[name="block_film"]');
    if (!s || !h) return;
    m.hidden = !s.value; c.hidden = !s.value || m.value !== 'own';
    h.value = s.value ? (m.value === 'own' ? c.value : 'brand') + ':' + s.value : '';
  }
  // the controls shown from the hidden field (a block inserted from the library)
  window.sgFilmUi = function (row) {
    var h = row.querySelector('[name="block_film"]'); if (!h) return;
    var p = /^(brand|#[0-9a-fA-F]{6}):(\d+)$/.exec(h.value || '');
    row.querySelector('[data-film="s"]').value = p ? p[2] : '';
    row.querySelector('[data-film="m"]').value = p && p[1] !== 'brand' ? 'own' : 'brand';
    if (p && p[1] !== 'brand') row.querySelector('[data-film="c"]').value = p[1];
    sync(row);
  };
  ['input', 'change'].forEach(function (t) {
    document.addEventListener(t, function (e) { var f = e.target.closest && e.target.closest('[data-film]'); if (f) sync(f.closest('.film-row')); }, true);
  });
})();
</script>
