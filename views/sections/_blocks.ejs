        <button type="button" class="btn-secondary" data-block="dup">Duplicate</button>
        <button type="button" class="btn-secondary" data-block="save" title="Save this block to your library so you can reuse it on any site">Save to library</button>
        <button type="button" class="btn-secondary" data-block="del">Delete</button>
      </span>
