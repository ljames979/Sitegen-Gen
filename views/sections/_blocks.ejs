    <input type="text" name="block_heading" maxlength="120" value="<%= b.heading || '' %>">
    <% const lineType = ['steps', 'features', 'chips', 'pricing', 'team', 'stats', 'tabs', 'accordion'].includes(b.type); %>
<% if (b.type === 'strip') { %>
