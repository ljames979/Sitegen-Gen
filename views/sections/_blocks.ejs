        <input type="url" name="block_image" value="<%= b.imageUrl || '' %>" placeholder="https://... or upload">
        <input type="file" accept="image/*" class="file-input" hidden>
        <button type="button" class="btn-secondary upload-btn">Upload</button>
        <button type="button" class="btn-secondary pick-btn">Choose photo</button>
      </div>
      <input type="hidden" name="block_side" class="oc-side" value="<%= overlapCard.cleanSide(b.side) %>">
      <label>Pattern, band, photo side and card color</label>
      <% const ocOwn = /^#/.test(ocSet.card) ? ocSet.card : '', ocBand = /^#/.test(ocSet.band) ? ocSet.band : ''; %>
      <div class="upload-row oc-opts" style="flex-wrap: wrap; align-items: center;" oninput="this.onchange()" onchange="var r=this.closest('.block-row'),q=function(c){return this.querySelector(c)}.bind(this),k=q('.oc-card').value,bd=q('.oc-band').value;q('.oc-color').hidden=k!=='own';q('.oc-bandc').hidden=bd!=='own';q('.oc-under').hidden=!q('.oc-own-under').checked;q('.oc-patc').hidden=!q('.oc-own-pat').checked;q('.oc-pfill').hidden=q('.oc-pfin').hidden=!q('.oc-own-pfill').checked;r.querySelector('.oc-side').value=[q('.oc-pat').value,bd==='own'?q('.oc-bandc').value.toLowerCase():bd,q('.oc-ps').value,k==='own'?q('.oc-color').value.toLowerCase():k,q('.oc-fin').value,q('.oc-own-under').checked?q('.oc-under').value.toLowerCase():'',q('.oc-own-pat').checked?q('.oc-patc').value.toLowerCase():'',q('.oc-own-pfill').checked?q('.oc-pfill').value.toLowerCase():'',q('.oc-pfin').value].join(':');">
        <select class="oc-pat" aria-label="Pattern"><% overlapCard.PATTERNS.forEach(o => { %><option value="<%= o[0] %>" <%= ocSet.pattern === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="oc-own-pat"<%= ocSet.patColor ? ' checked' : '' %>> Own pattern color</label>
        <input type="color" class="oc-patc" aria-label="Pattern color (stripes, dots or grid)" value="<%= ocSet.patColor || '#111111' %>" style="width: 64px; height: 36px; padding: 2px;"<%= ocSet.patColor ? '' : ' hidden' %>>
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="oc-own-pfill"<%= ocSet.patFill ? ' checked' : '' %>> Own color behind the photo</label>
        <input type="color" class="oc-pfill" aria-label="Color of the shape behind the photo" value="<%= ocSet.patFill || '#ffd6e0' %>" style="width: 64px; height: 36px; padding: 2px;"<%= ocSet.patFill ? '' : ' hidden' %>>
        <select class="oc-pfin" aria-label="Shape behind the photo: flat or gradient"<%= ocSet.patFill ? '' : ' hidden' %>><option value="flat" <%= ocSet.patFinish !== 'gradient' ? 'selected' : '' %>>Flat color</option><option value="gradient" <%= ocSet.patFinish === 'gradient' ? 'selected' : '' %>>Gradient</option></select>
        <select class="oc-band" aria-label="Top band"><% overlapCard.BANDS.forEach(o => { %><option value="<%= o[0] %>" <%= (o[0] === 'own' ? !!ocBand : ocSet.band === o[0]) ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <input type="color" class="oc-bandc" aria-label="Top band color" value="<%= ocBand || '#eeeeee' %>" style="width: 64px; height: 36px; padding: 2px;"<%= ocBand ? '' : ' hidden' %>>
        <label style="font-weight: 400; margin: 0;"><input type="checkbox" class="oc-own-under"<%= ocSet.bottom ? ' checked' : '' %>> Own bottom color</label>
        <input type="color" class="oc-under" aria-label="Bottom section color" value="<%= ocSet.bottom || '#ffffff' %>" style="width: 64px; height: 36px; padding: 2px;"<%= ocSet.bottom ? '' : ' hidden' %>>
        <select class="oc-ps" aria-label="Photo side"><% overlapCard.SIDES.forEach(o => { %><option value="<%= o[0] %>" <%= ocSet.side === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <select class="oc-card" aria-label="Card color"><% overlapCard.CARDS.forEach(o => { %><option value="<%= o[0] %>" <%= (o[0] === 'own' ? !!ocOwn : ocSet.card === o[0]) ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
        <input type="color" class="oc-color" aria-label="My own card color" value="<%= ocOwn || '#1d6fa5' %>" style="width: 64px; height: 36px; padding: 2px;"<%= ocOwn ? '' : ' hidden' %>>
        <select class="oc-fin" aria-label="Card finish"><% overlapCard.FINISHES.forEach(o => { %><option value="<%= o[0] %>" <%= ocSet.finish === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
      </div>
      <p class="hint">The photo sits on a patterned shape and overlaps a card (white, your brand color or a color you pick) that sits a little lower, with a light band across the top of the block. Gradient card shades the card through its color; the words and button switch to white or dark so they stay easy to read. With a gradient chosen under Background below, a colored card makes the gradient fade into the card color. "Top band in a color I pick" colors the top section (the light grey by default), "Own bottom color" the rest of the block (it replaces the Background below), "Own pattern color" colors the stripes, dots or grid, and "Own color behind the photo" fills that shape (flat or as a gradient) with the dots still showing on top. A photo with its background cut out (✂ Cut out) stands nicely on the band. On phones the card goes under the photo.</p>
    <% } else if (b.type === 'aboutphone') { %>
      <% const abSet = aboutBlob.settings(b.side); %>
