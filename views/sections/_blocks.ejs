      </select>
      <select data-film="m" aria-label="Film color" <%- _fp.on ? '' : 'hidden' %>>
        <option value="brand" <%= _fp.color ? '' : 'selected' %>>In the brand color (from the logo)</option>
        <option value="own" <%= _fp.color ? 'selected' : '' %>>In a color I pick</option>
      </select>
      <input type="color" data-film="c" aria-label="Pick the film color" value="<%= _fp.color || site.theme.primaryColor || '#2563eb' %>" <%- _fp.color ? '' : 'hidden' %>>
    </div>
  </div>
<% }; %>
<p class="muted" style="font-size:13px; margin-top:0;">Pick a design below to add it. Each block then gets its own entry under Page sections, with a small picture of its layout and a colored tag for its group, where you edit it, move it and hide it. On a Blocks home page it is also a block on the Blocks screen. Pick the page it shows on in the last row of each block (home page by default). Blocks are never filled in automatically.</p>
<% const _bcGroups = blockCatalog.groups(); %>
<div class="blkpick" id="blkPick">
  <div class="blkpick-head">
    <strong>Add a content block</strong>
    <input type="search" class="blkpick-find" id="blkPickFind" placeholder="Find a design, e.g. photo, steps, price, scroll" aria-label="Find a block design" autocomplete="off">
  </div>
  <div class="blkpick-tabs" role="group" aria-label="Show block designs by group">
    <button type="button" class="blkpick-tab on" data-pickgroup="" aria-pressed="true">All <span><%= blockCatalog.LIST.length %></span></button>
    <% _bcGroups.forEach(g => { %><button type="button" class="blkpick-tab" data-pickgroup="<%= g.id %>" aria-pressed="false" style="--g:<%= g.color %>" title="<%= g.label %>"><i></i><%= g.short %> <span><%= g.items.length %></span></button><% }) %>
  </div>
  <% _bcGroups.forEach(g => { %>
  <div class="blkpick-group" data-group="<%= g.id %>" style="--g:<%= g.color %>">
    <div class="blkpick-gtitle"><i></i><%= g.label %></div>
    <div class="blkpick-grid">
      <% g.items.forEach(it => { %><% if (it.styles) { it.styles.forEach(st => { %><button type="button" class="blkpick-card" data-newblock="<%= it.type %>" data-dcstyle="<%= st.id %>"<% if (st.reveal) { %> data-dcreveal="<%= st.reveal %>"<% } %> data-find="<%= (it.name + ' ' + st.name + ' ' + st.desc + ' ' + it.desc).toLowerCase() %>" title="Add a <%= it.name %> in the <%= st.name %> style"><%- st.pic %><span class="blkpick-txt"><span class="blkpick-name"><%= it.name %>: <%= st.name %></span><span class="blkpick-desc"><%= st.desc %></span></span><span class="blkpick-plus" aria-hidden="true">+</span></button><% }); return; } %><button type="button" class="blkpick-card" data-newblock="<%= it.type %>" data-find="<%= (it.name + ' ' + it.desc).toLowerCase() %>" title="Add a <%= it.name %> block"><%- it.pic %><span class="blkpick-txt"><span class="blkpick-name"><%= it.name %></span><span class="blkpick-desc"><%= it.desc %></span></span><span class="blkpick-plus" aria-hidden="true">+</span></button><% }) %>
    </div>
  </div>
  <% }) %>
  <p class="muted blkpick-none" id="blkPickNone" hidden>No design matches that. Try a simpler word, like "photo" or "cards".</p>
</div>
<script>
// the picker: group buttons and the find box narrow the cards; a card adds that block (the shared [data-newblock] click)
(function () {
  var box = document.getElementById('blkPick'); if (!box) return;
  var find = document.getElementById('blkPickFind'), group = '';
  function show() {
    var q = find.value.trim().toLowerCase(), any = false;
    box.querySelectorAll('.blkpick-group').forEach(function (g) {
      var n = 0;
      g.querySelectorAll('.blkpick-card').forEach(function (c) {
        var ok = (!group || g.dataset.group === group) && (!q || q.split(/\s+/).every(function (w) { return c.dataset.find.indexOf(w) > -1; }));
        c.hidden = !ok; if (ok) n++;
      });
      g.hidden = !n; if (n) any = true;
    });
    document.getElementById('blkPickNone').hidden = any;
  }
  box.addEventListener('click', function (e) {
    var t = e.target.closest('[data-pickgroup]'); if (!t) return;
    group = t.dataset.pickgroup;
    box.querySelectorAll('[data-pickgroup]').forEach(function (b) { var on = b === t; b.classList.toggle('on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
    show();
  });
  find.addEventListener('input', show);
  // Enter in the find box should not send the whole form
  find.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); var c = box.querySelector('.blkpick-card:not([hidden])'); if (c && find.value.trim()) c.click(); } });
})();
</script>
<style>
  .blkpick { margin: 10px 0 14px; }
  .blkpick-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 10px; }
  .blkpick-head strong { font-size: 15px; }
  .blkpick-find { flex: 1 1 220px; min-width: 0; margin: 0; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font: inherit; font-size: 13.5px; background: #fff; }
  .blkpick-find:focus { outline: 2px solid #93c5fd; outline-offset: 1px; border-color: #60a5fa; }
  .blkpick-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .blkpick-tab { display: inline-flex; align-items: center; gap: 6px; background: #fff; color: #334155; border: 1px solid #e2e8f0; border-radius: 999px; padding: 5px 11px; font-size: 12.5px; font-weight: 600; min-height: 32px; cursor: pointer; }
  .blkpick-tab i, .blkpick-gtitle i { width: 9px; height: 9px; border-radius: 50%; background: var(--g, #64748b); display: inline-block; flex: none; }
  .blkpick-tab span { color: #94a3b8; font-weight: 500; }
  .blkpick-tab:hover { border-color: #cbd5e1; background: #f8fafc; }
  .blkpick-tab.on { background: #0f172a; border-color: #0f172a; color: #fff; }
  .blkpick-tab.on span { color: #cbd5e1; }
  .blkpick-group { margin-bottom: 14px; }
  .blkpick-group[hidden] { display: none; }
  .blkpick-gtitle { display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #475569; margin: 0 0 7px; }
  .blkpick-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 8px; }
  .blkpick-card { display: flex; align-items: center; gap: 10px; text-align: left; background: #fff; color: #0f172a; border: 1px solid #e2e8f0; border-left: 3px solid var(--g, #94a3b8); border-radius: 10px; padding: 8px 10px; min-height: 64px; cursor: pointer; font: inherit; transition: border-color .15s, box-shadow .15s, transform .15s; }
  .blkpick-card[hidden] { display: none; }
  .blkpick-card:hover, .blkpick-card:focus-visible { border-color: var(--g, #94a3b8); box-shadow: 0 4px 14px -6px color-mix(in srgb, var(--g, #64748b) 55%, transparent); transform: translateY(-1px); }
  .blkpick-card .blk-pic { flex: none; width: 66px; height: 44px; border-radius: 6px; box-shadow: 0 0 0 1px #e2e8f0; }
  .blkpick-txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .blkpick-name { font-weight: 650; font-size: 13.5px; line-height: 1.25; }
  .blkpick-desc { font-size: 12px; line-height: 1.35; color: #64748b; }
  .blkpick-plus { flex: none; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 16px; line-height: 1; color: var(--g, #475569); background: color-mix(in srgb, var(--g, #64748b) 12%, #fff); }
  .blkpick-none { font-size: 13px; }
  @media (prefers-reduced-motion: reduce) { .blkpick-card { transition: none; } .blkpick-card:hover { transform: none; } }
</style>
