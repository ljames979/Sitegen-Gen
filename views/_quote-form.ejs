<%# Shared by the Contact page (full, with photo upload) and each service page (compact).
    Expects: site, basePath, preview, services, selected (service title or ''), compact (bool) %>
<% const cform = formsLib.normalize(site.sections.contact.form); %>
<% if (cform.mode === 'custom') { %>
  <%- include('_custom-form', { site, basePath, preview, services, selected, compact, cform, netlifyForms: (typeof netlifyForms !== 'undefined' && netlifyForms) }) %>
<% } else { %>
<% const nl = typeof netlifyForms !== 'undefined' && netlifyForms; %>
<form method="POST" action="<%= nl ? 'thank-you.html' : basePath + '/contact' %>" enctype="multipart/form-data" class="contact-form" <%- nl ? 'name="contact" data-netlify="true" netlify-honeypot="website"' : '' %> <%= preview ? 'onsubmit="return false;"' : '' %>>
  <% if (nl) { %><input type="hidden" name="form-name" value="contact"><% } %>
  <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off">
  <label>Name</label>
  <input type="text" name="name" placeholder="Full name" maxlength="100">
  <label>Phone</label>
  <input type="text" name="phone" placeholder="Phone number" maxlength="40">
  <label>Email</label>
  <input type="email" name="email" placeholder="Email address" maxlength="254">
  <% if (services.length) { %>
    <label>Service needed</label>
    <select name="service">
      <option value="">Select a service</option>
      <% services.forEach(sv => { %>
        <option value="<%= sv.title %>" <%= selected === sv.title ? 'selected' : '' %>><%= sv.title %></option>
      <% }) %>
    </select>
  <% } %>
  <label>Message</label>
  <textarea name="message" maxlength="2000" placeholder="Tell us a little about what you need"></textarea>
  <% if (!compact) { %>
    <label>Photo (optional)</label>
    <input type="file" name="photo" accept="image/*">
  <% } %>
  <button type="submit" class="btn" style="width:100%; margin-top:16px;"><%= services.length ? 'Request a Quote' : 'Send' %></button>
</form>
<% } %>
