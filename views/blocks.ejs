<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blocks: <%= site.name %> — SiteGen</title>
  <%# Like the Style Library page, this page has its own small stylesheet so the admin's rules don't reach the previews %>
  <style>
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body { margin: 0; font: 15px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #0f172a; background: #eef1f5; display: flex; flex-direction: column; }
    .sl-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 10px 16px; background: #fff; border-bottom: 1px solid #e2e8f0; }
    .sl-bar h1 { font-size: 16px; margin: 0; } .sl-bar .sp { flex: 1; }
    .sl-bar a.back { color: #64748b; text-decoration: none; }
    .status { font-size: 13px; color: #64748b; }
    .status.ok { color: #166534; } .status.err { color: #b91c1c; }
    .ui-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 36px; padding: 7px 13px; border-radius: 8px; border: 1px solid #cbd5e1; background: #fff; color: #0f172a; font: 600 13.5px/1.2 inherit; font-family: inherit; cursor: pointer; text-decoration: none; }
    .ui-btn:hover { border-color: #0f172a; }
    .ui-btn.primary { background: #0f172a; border-color: #0f172a; color: #fff; }
    .ui-btn[disabled] { opacity: .45; cursor: default; }
    .ui-btn.sm { min-height: 30px; padding: 4px 10px; font-size: 12.5px; }
    .seg { display: inline-flex; } .seg button { border: 1px solid #cbd5e1; background: #fff; padding: 7px 12px; font: 600 13px inherit; font-family: inherit; cursor: pointer; margin-left: -1px; min-height: 36px; }
    .seg button:first-child { border-radius: 8px 0 0 8px; margin-left: 0; } .seg button:last-child { border-radius: 0 8px 8px 0; }
    .seg button[aria-pressed=true] { background: #0f172a; color: #fff; border-color: #0f172a; }
    .wrap { flex: 1; min-height: 0; display: grid; grid-template-columns: 310px minmax(0, 1fr) 380px; }
    .pane { min-height: 0; overflow-y: auto; background: #fff; }
    .pane h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: #64748b; margin: 0; padding: 14px 14px 8px; }
    .pane .note { font-size: 12.5px; color: #64748b; margin: 0; padding: 0 14px 10px; }
    #left { border-right: 1px solid #e2e8f0; }
    #right { border-left: 1px solid #e2e8f0; display: flex; flex-direction: column; overflow: hidden; }
    /* the page's blocks */
    .blist { list-style: none; margin: 0; padding: 0 8px 8px; counter-reset: b; }
    .blk { display: grid; grid-template-columns: 22px 1fr auto; align-items: center; gap: 4px 8px; padding: 8px; border: 2px solid transparent; border-radius: 10px; cursor: pointer; counter-increment: b; }
    .blk::before { content: counter(b); font: 700 12px system-ui; color: #94a3b8; text-align: center; }
    .blk:hover { background: #f8fafc; }
    .blk.on { border-color: #2563eb; background: #eff6ff; }
    .blk.dragging { opacity: .4; } .blk.drop-above { box-shadow: inset 0 3px 0 #2563eb; } .blk.drop-below { box-shadow: inset 0 -3px 0 #2563eb; }
    .blk .t { min-width: 0; } .blk .t b { display: block; font-size: 14px; font-weight: 600; line-height: 1.3; }
    .blk .t small { display: block; color: #64748b; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .blk .ctl { display: flex; gap: 2px; }
    .blk .ctl button { width: 30px; height: 30px; border: 0; border-radius: 6px; background: transparent; color: #475569; cursor: pointer; font-size: 14px; }
    .blk .ctl button:hover { background: #e2e8f0; color: #0f172a; }
    .blk .own { grid-column: 2 / 4; font-size: 12px; color: #475569; display: flex; gap: 6px; align-items: center; }
    .blk .pin select { font: inherit; font-size: 12px; padding: 2px 4px; max-width: 210px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; }
    .blk .film { flex-wrap: wrap; }
    .blk .film input[type=color] { width: 32px; height: 24px; padding: 0 2px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; }
    .blk .fx { grid-column: 2 / 4; font-size: 12px; color: #475569; }
    .blk .fx summary { cursor: pointer; display: inline-flex; gap: 6px; align-items: center; padding: 3px 9px; border: 1px solid #cbd5e1; border-radius: 999px; background: #fff; font-weight: 600; list-style: none; }
    .blk .fx summary::-webkit-details-marker { display: none; }
    .blk .fx summary::after { content: '\25BE'; font-size: 10px; }
    .blk .fx[open] summary::after { content: '\25B4'; }
    .blk .fx summary b { font-weight: 600; color: #0f766e; }
    .blk .fx > .own { margin-top: 6px; white-space: nowrap; }
    .blk .fx > .own select { flex: 1; min-width: 0; }
    .blk .fx > .xfx { display: grid; gap: 4px; margin-top: 8px; white-space: normal; }
    .blk .fx > .xfx .xfx-h { font-weight: 600; color: #0f172a; }
    .blk .fx > .xfx label { display: grid; grid-template-columns: auto 1fr; column-gap: 6px; align-items: start; cursor: pointer; }
    .blk .fx > .xfx input { margin: 2px 0 0; }
    .blk .fx > .xfx i { font-style: normal; color: #64748b; }
    .blk .fx > .xfx small { grid-column: 2; color: #64748b; font-size: 11px; line-height: 1.35; }
    .blk .sz { flex-wrap: wrap; } .blk .sz b { font-weight: 600; color: #0f172a; }
    .blk .sz input[type=range] { flex: 1; min-width: 90px; accent-color: #2563eb; cursor: ew-resize; }
    .blk .sz output { min-width: 62px; font-variant-numeric: tabular-nums; color: #0f172a; }
    .blk .sz .ui-btn.sm { min-height: 26px; padding: 2px 8px; }
    .blk .warn { grid-column: 2 / 4; font-size: 12px; color: #92400e; }
    .tools { display: flex; flex-wrap: wrap; gap: 6px; padding: 4px 14px 14px; }
    .tools.looks { padding-bottom: 4px; }
    .tools.looks select { font: inherit; font-size: 13px; padding: 4px 8px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; flex: 1; min-width: 0; }
    .saved { list-style: none; margin: 0; padding: 0 8px 16px; }
    .saved li { display: flex; align-items: center; gap: 6px; padding: 6px 8px; border-radius: 8px; font-size: 13.5px; }
    .saved li:hover { background: #f8fafc; }
    .saved li span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .saved li small { color: #64748b; }
    .empty-note { padding: 6px 14px 14px; font-size: 13px; color: #64748b; margin: 0; }
    /* live preview */
    .stage { min-height: 0; display: grid; padding: 14px; overflow: hidden; }
    .stage iframe { grid-area: 1 / 1; width: 100%; max-width: 1440px; height: 100%; justify-self: center; border: 0; border-radius: 10px; background: #fff; box-shadow: 0 10px 30px rgba(15,23,42,.18); }
    /* desktop: the page is drawn 1280 wide and scaled to fit, so it looks the way visitors on a computer see it */
    .stage.fit iframe { width: 1280px; max-width: none; height: calc(100% / var(--z)); justify-self: start; transform: scale(var(--z)); transform-origin: 0 0; border-radius: 0; }
    .stage.phone iframe { max-width: 390px; }
    .stage iframe.next { visibility: hidden; }
    /* the library */
    .lib-head { padding: 0 14px 10px; display: flex; flex-direction: column; gap: 8px; border-bottom: 1px solid #e2e8f0; }
    .chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .chips button { border: 1px solid #cbd5e1; background: #fff; border-radius: 999px; padding: 4px 10px; font: 600 12.5px inherit; font-family: inherit; cursor: pointer; min-height: 30px; }
    .chips button[aria-pressed=true] { background: #0f172a; color: #fff; border-color: #0f172a; }
    .chips button small { font-weight: 500; opacity: .7; }
    .lib-head select { padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 8px; font: 13px inherit; font-family: inherit; }
    .lib-head label { font-size: 12.5px; color: #475569; display: flex; gap: 6px; align-items: center; }
    .grid { flex: 1; overflow-y: auto; padding: 12px 14px 20px; display: flex; flex-direction: column; gap: 14px; }
    .card { flex: none; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; background: #fff; }
    .card[hidden] { display: none; }
    .thumb { position: relative; height: 190px; overflow: hidden; background: #f1f5f9; }
    .thumb iframe { position: absolute; left: 0; top: 0; width: 1280px; height: 704px; border: 0; transform: scale(var(--s, .275)); transform-origin: 0 0; pointer-events: none; }
    .thumb .ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 12.5px; }
    .card .m { padding: 9px 11px 11px; display: flex; flex-direction: column; gap: 6px; }
    .card .m b { font-size: 14px; }
    .card .m .row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .tag { font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 999px; background: #f1f5f9; color: #475569; }
    .tag.sl { background: #ede9fe; color: #5b21b6; } .tag.at { background: #0f172a; color: #fff; } .tag.need { background: #fef3c7; color: #92400e; }
    .card .hint { font-size: 12px; color: #64748b; }
    .card .acts { display: flex; gap: 6px; margin-left: auto; }
    /* Arrange panel */
    .arr { border-bottom: 1px solid #e2e8f0; padding-bottom: 12px; background: #f8fafc; }
    .arr .note { padding-top: 2px; }
    .arr .what { padding: 0 14px 8px; font-size: 14px; } .arr .what small { color: #64748b; }
    .arr .row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; padding: 4px 14px; font-size: 13px; }
    .arr .row > span:first-child { width: 78px; color: #475569; }
    .arr .row output { min-width: 52px; text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; }
    .arr .row select { padding: 5px 6px; border: 1px solid #cbd5e1; border-radius: 8px; font: 13px inherit; font-family: inherit; }
    .arr .ui-btn.sm { min-width: 30px; }
    .arr .ui-btn[aria-pressed=true] { background: #0f172a; color: #fff; border-color: #0f172a; }
    .arr .sub { font-size: 12px; color: #64748b; padding: 0 14px; margin: 2px 0 0; }
    .arr hr { border: 0; border-top: 1px solid #e2e8f0; margin: 8px 14px; }
    @media (max-width: 1100px) {
      body { height: auto; display: block; }
      .wrap { display: flex; flex-direction: column; }
      .pane { overflow: visible; } #right { overflow: visible; border-left: 0; }
      .stage { height: 75vh; padding: 10px; }
      .grid { overflow: visible; }
    }
  </style>
</head>
<body>
  <div class="sl-bar">
    <a class="back" href="/sites/<%= site.id %>/edit#design">&larr; Editor</a>
    <h1>Blocks</h1>
    <span class="status" id="status" role="status"><%= live ? 'The home page uses these blocks.' : 'Starting from the current home page. Nothing changes on the site until you save.' %></span>
    <span class="sp"></span>
    <button type="button" class="ui-btn" id="undoBtn" disabled title="Undo (Ctrl+Z)">Undo</button>
    <span class="seg" id="devSeg" role="group" aria-label="Screen"><button type="button" data-v="desktop" aria-pressed="true">Desktop</button><button type="button" data-v="phone" aria-pressed="false">Phone</button></span>
    <span class="seg" id="modeSeg" role="group" aria-label="What a click in the preview does"><button type="button" data-v="pick" aria-pressed="true" title="Click a section to pick it">Pick</button><button type="button" data-v="arrange" aria-pressed="false" title="Click anything to size and move it">Arrange</button><button type="button" data-v="edit" aria-pressed="false" title="Click words to type on them, or a photo to change it">Edit</button></span>
    <button type="button" class="ui-btn" id="openBtn">Open full page</button>
    <button type="button" class="ui-btn primary" id="saveBtn">Use on the home page</button>
  </div>

  <div class="wrap">
    <section class="pane" id="left" aria-labelledby="pageHead">
      <div id="arrPanel" class="arr" hidden></div>
      <h2 id="pageHead">This home page</h2>
      <p class="note">Click a block to select it, here or in the preview. Drag to reorder. Words, photos and numbers always come from this site: switch to <b>Edit</b> at the top to type on the words or change a photo right in the preview.</p>
      <div class="tools looks">
        <select id="packSel" aria-label="Look pack" title="Give every block a matching set of effects (pins, color film, photo words, heights). Undo puts it back.">
          <option value="">Look packs…</option>
          <% lookPacks.PACKS.forEach(pk => { %><option value="<%= pk.id %>" title="<%= pk.hint %>"><%= pk.name %></option><% }) %>
        </select>
        <button type="button" class="ui-btn sm" id="surpriseBtn" title="Random effects that still go together. Press again for another mix; Undo goes back.">Surprise me</button>
      </div>
      <ol class="blist" id="blist"></ol>
      <div class="tools">
        <button type="button" class="ui-btn sm" id="saveRecipeBtn">Save page as a recipe</button>
        <button type="button" class="ui-btn sm" id="saveBlockBtn" title="Saves the block with its effects">Save selected block</button>
        <button type="button" class="ui-btn sm" id="resetBtn">Start over</button>
      </div>
      <h2>Saved blocks and recipes</h2>
      <ul class="saved" id="saved"></ul>
      <p class="empty-note" id="savedEmpty">Nothing saved yet. Saved blocks and recipes work on every site.</p>
    </section>

    <div class="stage" id="stage"><iframe id="frame" name="pv0" title="Home page preview"></iframe></div>

    <section class="pane" id="right" aria-labelledby="libHead">
      <h2 id="libHead">Add a block</h2>
      <div class="lib-head">
        <div class="chips" id="typeChips" role="group" aria-label="Kind of section"></div>
        <div class="row" style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
          <select id="srcSel" aria-label="Where the design comes from">
            <option value="">Every source</option><option value="lib">Section library (your style)</option><option value="sl">Style Library</option><option value="at">Signature pieces</option>
          </select>
          <label><input type="checkbox" id="showEmpty"> Show designs this site has no content for</label>
        </div>
      </div>
      <div class="grid" id="grid"></div>
    </section>
  </div>

  <script>
  (function () {
    var siteId = <%= site.id %>, MAX = <%= max %>;
    var D = <%- JSON.stringify({ blocks, catalog, types, saved, photos }).replace(/</g, '\\u003c') %>;
    var SRC = { lib: 'Library', sl: 'Styles', at: 'Signature', blk: 'Content block' };
    var CAT = {}; D.catalog.forEach(function (c) { CAT[c.k + '|' + c.f + '|' + c.v] = c; });
    var key = function (b) { return b.k + '|' + b.f + '|' + b.v; };
    var info = function (b) { return CAT[key(b)] || { label: b.v, type: '', source: '', empty: false }; };
    var strip = function (b) { var o = { k: b.k, f: b.f, v: b.v }; if (b.k === 'sl' && b.own) o.own = true; if (b.pin) o.pin = b.pin; if (b.film) o.film = b.film; if (b.imgfx) o.imgfx = b.imgfx; if (b.height) o.height = b.height; if (b.glass) o.glass = b.glass; if (b.bg) o.bg = JSON.parse(JSON.stringify(b.bg)); if (b.xfx && b.xfx.length) o.xfx = b.xfx.slice(); if (b.lay) o.lay = JSON.parse(JSON.stringify(b.lay)); return o; };
    var PINS = <%- JSON.stringify(pinOptions) %>, FILMS = <%- JSON.stringify(filmStrengths) %>, IMGS = <%- JSON.stringify(imgOptions) %>, HTS = <%- JSON.stringify(heightOptions) %>, XFX = <%- JSON.stringify(extraFx.blockMenu()) %>, XFX_SITE = <%- JSON.stringify(extraFx.list(site.theme)) %>, BRAND = <%- JSON.stringify(site.theme.primaryColor || '#2563eb') %>, GRADS = <%- JSON.stringify(gradients.menu(site.theme, true, true)).replace(/</g, '\\u003c') %>, GSTYLES = <%- JSON.stringify(Object.entries(gradients.STYLES)) %>, GLASS = <%- JSON.stringify(glassFx.OPTIONS) %>, INKS = <%- JSON.stringify(gradients.textures.INK_MODES) %>, ACCENT = <%- JSON.stringify(site.theme.accentColor || '#f59e0b') %>;
    // a see-through color layer over the block: "brand:30" or "#1b2a4a:30"
    // a block's effects (pin, color film, photo words, height) fold under one Effects button; the count says how many are on
    var fxOpen = {};
    function fxBox(b, i) {
      var on = ['pin', 'film', 'imgfx', 'height', 'bg', 'glass'].filter(function (k) { return b[k]; }).length + ((b.xfx || []).length);
      return '<details class="fx" data-fx="' + i + '"' + (fxOpen[i] ? ' open' : '') + '><summary>Effects' + (on ? ' <b>' + on + ' on</b>' : '') + '</summary>' +
        '<label class="own pin">Pin and cards <select data-a="pin">' + PINS.map(function (o) { return '<option value="' + o[0] + '"' + ((b.pin || '') === o[0] ? ' selected' : '') + '>' + esc(o[1]) + '</option>'; }).join('') + '</select></label>' + filmRow(b) +
        '<label class="own pin">Photo words <select data-a="imgfx">' + IMGS.map(function (o) { return '<option value="' + o[0] + '"' + ((b.imgfx || '') === o[0] ? ' selected' : '') + '>' + esc(o[1]) + '</option>'; }).join('') + '</select></label>' +
        '<label class="own pin" title="Its words and cards sit on a pane of glass. Looks best over a photo or gradient background.">Glass panel <select data-a="glass">' + GLASS.map(function (o) { return '<option value="' + o[0] + '"' + ((b.glass || '') === o[0] ? ' selected' : '') + '>' + esc(o[1]) + '</option>'; }).join('') + '</select></label>' +
        gradRow(b) + xfxRows(b) +
        '<span class="own fxcp"><button type="button" class="ui-btn sm" data-a="fx-copy" title="Remember these effects, to give them to other blocks (on any site)">Copy effects</button>' +
        (fxClip() ? '<button type="button" class="ui-btn sm" data-a="fx-paste" title="Give this block the effects you copied">Paste</button><button type="button" class="ui-btn sm" data-a="fx-all" title="Give every block on the page the effects you copied (the hero is left out of pins)">Paste to all</button>' : '') + '</span>' +
        '</details>';
    }
    // a gradient background from the gallery (library sections; content blocks pick theirs in the editor)
    function gradRow(b) {
      if (b.k !== 'lib') return '';
      var g = b.bg || {}, css = '';
      var opts = '<option value="">Normal background</option>' + GRADS.map(function (grp) { return '<optgroup label="' + esc(grp[0]) + '">' + grp[1].map(function (x) { if (x[0] === g.g) css = x[2]; return '<option value="' + x[0] + '"' + (x[0] === g.g ? ' selected' : '') + '>' + esc(x[1]) + '</option>'; }).join('') + '</optgroup>'; }).join('');
      return '<div class="own grad"><label class="own pin">Gradient background <select data-a="gbg-g">' + opts + '</select></label>' +
        '<span class="gsw" aria-hidden="true" style="display:inline-block;width:42px;height:22px;border-radius:6px;vertical-align:middle;border:1px solid #ccd;background:' + (css || 'transparent') + '"></span>' +
        (g.g ? '<label class="own pin">Style <select data-a="gbg-s"><option value="">Automatic</option>' + GSTYLES.map(function (o) { return '<option value="' + o[0] + '"' + (g.s === o[0] ? ' selected' : '') + '>' + esc(o[1]) + '</option>'; }).join('') + '</select></label>' +
          '<label class="own pin">Angle <input type="number" data-a="gbg-a" min="0" max="359" step="5" placeholder="135" style="width:70px" value="' + (g.a != null ? g.a : '') + '"></label>' +
          '<label class="own"><input type="checkbox" data-a="gbg-m"' + (g.m ? ' checked' : '') + '> Slowly drifting</label> <label class="own"><input type="checkbox" data-a="gbg-n"' + (g.n ? ' checked' : '') + '> Grain</label> <label class="own"><input type="checkbox" data-a="gbg-b"' + (g.b ? ' checked' : '') + '> Blend into the section\'s own color</label>' + inkRow(g) : '') +
        '</div>';
    }
    // a texture's colors: as drawn, brand, one to three colors of the owner's, or a rainbow (gradients' textures.cleanInk)
    function inkRow(g) {
      if (!/^txb?-/.test(g.g || '')) return '';
      var v = g.c || '', cs = v.charAt(0) === '#' ? v.split(',') : [], mode = cs.length ? ['one', 'two', 'three'][cs.length - 1] : v, def = [BRAND, ACCENT, '#ec4899'];
      return ' <label class="own pin">Texture colors <select data-a="gbg-cm">' + INKS.map(function (o) { return '<option value="' + o[0] + '"' + (mode === o[0] ? ' selected' : '') + '>' + esc(o[1]) + '</option>'; }).join('') + '</select></label>' +
        [0, 1, 2].map(function (i) { return '<input type="color" data-a="gbg-cc" aria-label="Texture color ' + (i + 1) + '" value="' + esc(cs[i] || def[i]) + '" style="width:40px;height:26px;padding:1px;vertical-align:middle;' + (i < cs.length ? '' : 'display:none') + '">'; }).join('');
    }
    // More effects for this block alone; one already on for the whole site (editor, Design) shows ticked and greyed
    function xfxRows(b) {
      var mine = b.xfx || [];
      return '<div class="own xfx"><span class="xfx-h">More effects</span>' + XFX.filter(function (o) { return o[0] !== 'zoom' || b.f === 'hero'; }).map(function (o) {
        var site = XFX_SITE.indexOf(o[0]) >= 0;
        return '<label title="' + esc(o[2]) + '"><input type="checkbox" data-a="xfx" value="' + o[0] + '"' + (site || mine.indexOf(o[0]) >= 0 ? ' checked' : '') + (site ? ' disabled' : '') + '> ' + esc(o[1]) + (site ? ' <i>(whole site)</i>' : '') + '<small>' + esc(o[2]) + '</small></label>';
      }).join('') + '</div>';
    }
    // copied effects are kept in this browser, so they can be pasted on another site too
    var FX_KEYS = ['pin', 'film', 'imgfx', 'height', 'glass', 'xfx'];
    function fxClip() { try { return JSON.parse(localStorage.getItem('sg-fx-clip') || 'null'); } catch (e) { return null; } }
    function fxGive(b, c) {
      FX_KEYS.forEach(function (k) { if (c[k] && !(k === 'pin' && b.f === 'hero')) b[k] = k === 'xfx' ? c[k].filter(function (id) { return id !== 'zoom' || b.f === 'hero'; }) : c[k]; else delete b[k]; });
      if (b.xfx && !b.xfx.length) delete b.xfx;
    }
    function filmRow(b) {
      var m = /^(brand|#[0-9a-f]{6}):(\d+)$/i.exec(b.film || ''), own = m && m[1] !== 'brand';
      return '<label class="own pin film">Color film <select data-a="film-s"><option value="">None</option>' + FILMS.map(function (n) { return '<option value="' + n + '"' + (m && m[2] === String(n) ? ' selected' : '') + '>' + n + '% strong</option>'; }).join('') + '</select>' +
