        var n = wordsEl(e.target);
        if (n) return startWords(doc, e, n, m);
        say('That part has no words or photo of its own to change here.', '');
      };
      E.attach = function (doc) {
        var st = doc.createElement('style'); st.textContent = css; doc.head.appendChild(st);
        if (E.on) doc.body.classList.add('sg-edmode');
        var last = null;
        doc.addEventListener('mouseover', function (e) {
          if (!E.on || cur) return;
          if (last) last.classList.remove('sg-ed-hover');
          last = e.target.closest('img') || wordsEl(e.target); if (last) last.classList.add('sg-ed-hover');
        });
        doc.addEventListener('mouseout', function () { if (last) last.classList.remove('sg-ed-hover'); last = null; });
      };
      E.set = function (on) {
        E.on = on; if (!on) { endWords(true); closeBar(); }
        try { frame.contentDocument.body.classList.toggle('sg-edmode', on); } catch (e) {}
        if (on) say('Edit: click words to type on them, or a photo to change it. Changes save to the site right away.', '');
      };
      document.getElementById('modeSeg').addEventListener('click', function (ev) { var b = ev.target.closest('button'); if (b) E.set(b.dataset.v === 'edit'); });
      return E;
    })();

    // ---- library ----
    var grid = document.getElementById('grid'), chips = document.getElementById('typeChips'), srcSel = document.getElementById('srcSel'), showEmpty = document.getElementById('showEmpty');
    var curType = (blocks[sel] && info(blocks[sel]).type) || 'hero';
    var counts = {}; D.catalog.forEach(function (c) { if (!c.empty) counts[c.type] = (counts[c.type] || 0) + 1; });
    chips.innerHTML = Object.keys(D.types).map(function (t) { return '<button type="button" data-t="' + t + '" aria-pressed="false">' + esc(D.types[t]) + ' <small>' + (counts[t] || 0) + '</small></button>'; }).join('');
    chips.addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) setType(b.dataset.t); });
    srcSel.addEventListener('change', drawGrid); showEmpty.addEventListener('change', drawGrid);
    function setType(t) { if (t === curType && grid.childElementCount) return; curType = t; drawGrid(); }
    function drawGrid() {
      chips.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', String(x.dataset.t === curType)); });
      var src = srcSel.value, shown = D.catalog.filter(function (c) { return c.type === curType && (!src || c.k === src) && (showEmpty.checked || !c.empty); });
      grid.scrollTop = 0;
      queue = []; busy = 0; gen++;   // thumbnails still loading in the old list never finish
      grid.innerHTML = shown.length ? shown.map(function (c) {
        return '<article class="card" data-key="' + esc(key(c)) + '">' +
          '<div class="thumb"><span class="ph">Loading preview…</span></div>' +
          '<div class="m"><b>' + esc(c.label) + '</b><div class="row"><span class="tag ' + c.k + '">' + esc(c.source) + '</span>' + (c.empty ? '<span class="tag need">Needs content</span>' : '') +
          '<span class="acts"><button type="button" class="ui-btn sm" data-a="swap">Swap in</button><button type="button" class="ui-btn sm primary" data-a="add">Add below</button></span></div>' +
          (c.hint ? '<span class="hint">' + esc(c.hint) + '</span>' : '') + '</div></article>';
      }).join('') : curType === 'own' ? '<p class="empty-note">No content blocks yet. Add one in the <a href="/sites/' + siteId + '/edit">editor</a> (Content tab, Content blocks, set to the home page) and it shows up here.</p>'
        : '<p class="empty-note">No designs of this kind from this source have content to show on this site yet.</p>';
      grid.querySelectorAll('.thumb').forEach(function (t) { io.observe(t); });
      syncButtons();
    }
    function syncButtons() {
      grid.querySelectorAll('[data-a=swap]').forEach(function (b) { b.disabled = sel < 0; b.title = sel < 0 ? 'Select a block on the page first' : 'Replace the selected block'; });
      grid.querySelectorAll('[data-a=add]').forEach(function (b) { b.disabled = blocks.length >= MAX; });
    }
    grid.addEventListener('click', function (e) {
      var a = e.target.closest('[data-a]'); if (!a) return;
      var p = a.closest('.card').dataset.key.split('|'), b = { k: p[0], f: p[1], v: p[2] };
      // a content block is on the page once: adding it again selects it
      var already = b.k === 'blk' ? blocks.findIndex(function (x) { return x.k === 'blk' && x.v === b.v; }) : -1;
      if (already >= 0) { select(already, true); say('That block is already on the page (selected).'); return; }
      if (a.dataset.a === 'add' && blocks.length < MAX) change(function () { var at = sel < 0 ? blocks.length : sel + 1; blocks.splice(at, 0, b); sel = at; });
      if (a.dataset.a === 'swap' && sel >= 0) change(function () { if (blocks[sel].own && b.k === 'sl') b.own = true; blocks[sel] = b; });
      setTimeout(function () { mark(true); }, 900);
    });
    // thumbnails load as they scroll into view, three at a time
    var queue = [], busy = 0, gen = 0;
    function pump() {
      while (busy < 3 && queue.length) {
        var t = queue.shift(); if (!t.isConnected) continue;
        busy++;
        var p = t.parentNode.dataset.key.split('|'), f = document.createElement('iframe');
        f.setAttribute('tabindex', '-1'); f.setAttribute('aria-hidden', 'true'); f.title = '';
        f.style.setProperty('--s', String(t.clientWidth / 1280));
        var g = gen, once = false;
        var done = function () { if (once) return; once = true; if (g === gen) { busy--; pump(); } };
        f.addEventListener('load', function () { var ph = t.querySelector('.ph'); if (ph) ph.remove(); done(); });
        setTimeout(done, 8000);
        f.src = url([{ k: p[0], f: p[1], v: p[2] }], true);
        t.appendChild(f);
      }
    }
    var io = new IntersectionObserver(function (es) { es.forEach(function (en) { if (en.isIntersecting) { io.unobserve(en.target); queue.push(en.target); } }); pump(); }, { root: null, rootMargin: '300px' });

    // ---- save ----
    function post(path, body) {
      return fetch('/sites/' + siteId + path, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body || {}) })
        .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'Something went wrong.' }; }); });
    }
    document.getElementById('saveBtn').addEventListener('click', function () {
      if (!blocks.length) return say('Add at least one block first.', 'err');
      var btn = this; btn.disabled = true; say('Saving…');
      post('/blocks/save', { blocks: blocks }).then(function (d) {
        btn.disabled = false;
        if (!d.ok) return say(d.error || 'Not saved.', 'err');
        savedState = JSON.stringify(blocks);
        say('Saved. The home page now uses these ' + d.count + ' blocks. The design before is in Version history.', 'ok');
      }, function () { btn.disabled = false; say('Not saved: the connection dropped. Try again.', 'err'); });
    });
    window.addEventListener('beforeunload', function (e) { if (savedState !== null ? dirty() : hist.length) { e.preventDefault(); e.returnValue = ''; } });
    document.getElementById('resetBtn').addEventListener('click', function () {
      if (JSON.stringify(blocks) === first) return;
      change(function () { blocks = JSON.parse(first); sel = blocks.length ? 0 : -1; }, false);
    });

    // ---- saved blocks and recipes ----
    var savedEl = document.getElementById('saved');
    function drawSaved() {
      document.getElementById('savedEmpty').hidden = !!D.saved.length;
      savedEl.innerHTML = D.saved.map(function (r) {
        return '<li data-id="' + r.id + '"><span title="' + esc(r.blocks.map(function (b) { return info(b).label; }).join(', ')) + '">' + esc(r.name) + ' <small>' + r.blocks.length + (r.blocks.length === 1 ? ' block' : ' blocks') + '</small></span>' +
          '<button type="button" class="ui-btn sm" data-a="add">Add</button>' + (r.blocks.length > 1 ? '<button type="button" class="ui-btn sm" data-a="use">Use</button>' : '') +
          '<button type="button" class="ui-btn sm" data-a="del" aria-label="Delete ' + esc(r.name) + '">&times;</button></li>';
      }).join('');
    }
    savedEl.addEventListener('click', function (e) {
      var a = e.target.closest('[data-a]'); if (!a) return;
      var id = +a.closest('li').dataset.id, r = D.saved.filter(function (x) { return x.id === id; })[0]; if (!r) return;
      var bl = r.blocks.map(strip);
      if (a.dataset.a === 'add') change(function () { var at = sel < 0 ? blocks.length : sel + 1; bl = bl.slice(0, MAX - blocks.length); blocks.splice.apply(blocks, [at, 0].concat(bl)); sel = at; });
      if (a.dataset.a === 'use') change(function () { blocks = bl; sel = 0; }, false);
      if (a.dataset.a === 'del') post('/blocks/recipes/' + id + '/delete').then(function () { D.saved = D.saved.filter(function (x) { return x.id !== id; }); drawSaved(); });
    });
    function saveRecipe(bl, dflt) {
      if (!bl.length) return say('Nothing to save yet.', 'err');
      var name = prompt('Name it', dflt); if (name === null) return;
      post('/blocks/recipes', { blocks: bl, name: name }).then(function (d) {
        if (!d.ok) return say(d.error || 'Not saved.', 'err');
        D.saved.unshift({ id: d.id, name: d.name, blocks: bl }); drawSaved(); say('Saved "' + d.name + '". It is available on every site.', 'ok');
      });
    }
    document.getElementById('saveRecipeBtn').addEventListener('click', function () { saveRecipe(blocks, '<%= site.name.replace(/[\\'"<>]/g, '') %> home'); });
    document.getElementById('saveBlockBtn').addEventListener('click', function () { if (sel >= 0) saveRecipe([blocks[sel]], info(blocks[sel]).label); });

    // ---- look packs and Surprise me (lookpacks.js): they only change the blocks' effects ----
    var PACKS = <%- JSON.stringify(lookPacks.PACKS) %>;
    var applyPack = <%- lookPacks.applyPack.toString() %>;
    var surprise = <%- lookPacks.surprise.toString() %>;
    document.getElementById('packSel').addEventListener('change', function () {
      var pk = PACKS.filter(function (x) { return x.id === this.value; }, this)[0]; this.value = ''; if (!pk || !blocks.length) return;
      change(function () { blocks = applyPack(blocks, pk); }, true);
      say('Applied "' + pk.name + '": ' + pk.hint + '. Undo puts it back.', 'ok');
    });
    document.getElementById('surpriseBtn').addEventListener('click', function () {
      if (!blocks.length) return;
      change(function () { blocks = surprise(blocks, Math.random); }, true);
      say('A new mix of effects. Press again for another, or Undo.', 'ok');
    });

    drawList(); drawSaved(); drawGrid();
  })();
  </script>
<script src="/colorlabel.js" defer></script>
</body>
</html>
