<!DOCTYPE html>
<html>
<head>
  <title>Pitch: <%= site.name %> — SiteGen</title>
  <%- include('partials-head') %>
  <style>
    html, body { height: 100%; }
    body { background: #0b0f17; color: #e5e7eb; overflow: hidden; }
    .pt-bar { position: fixed; z-index: 10; top: 0; left: 0; right: 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 10px 14px; background: rgba(11,15,23,.92); border-bottom: 1px solid rgba(255,255,255,.08); transition: transform .35s, opacity .35s; }
    body.touring.idle .pt-bar { transform: translateY(-100%); opacity: 0; }
    .pt-bar a { color: #cbd5e1; }
    .pt-bar strong { color: #fff; margin-right: 6px; }
    .pt-bar .sp { flex: 1; }
    .pt-bar select { width: auto; padding: 7px 10px; background: #111827; color: #e5e7eb; border-color: #374151; }
    .pt-bar .btn-secondary { background: #1f2937; color: #e5e7eb; }
    .pt-bar .btn-secondary.on { background: #e5e7eb; color: #0b0f17; }
    .pt-bar button, .pt-bar .btn { padding: 8px 14px; min-height: 40px; }
    .pt-seg { display: inline-flex; } .pt-seg button { border-radius: 0; } .pt-seg button:first-child { border-radius: 8px 0 0 8px; } .pt-seg button:last-child { border-radius: 0 8px 8px 0; }
    #startBtn { background: #f59e0b; color: #1c1300; }
    .pt-stage { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; padding-top: 62px; }
    body.touring .pt-stage { padding-top: 0; }
    .pt-frame { position: relative; width: 100%; height: 100%; background: #fff; overflow: hidden; }
    .pt-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #fff; }
    body.phone .pt-frame { width: 390px; height: 844px; flex: none; border-radius: 46px; border: 12px solid #1f2937; box-shadow: 0 0 0 2px #374151, 0 40px 80px rgba(0,0,0,.6); transform-origin: center; }
    .pt-old { position: absolute; inset: 0; background: #f1f5f9 top center / cover no-repeat; display: none; }
    body.oldnew .pt-old { display: block; }
    body.oldnew .pt-frame iframe { clip-path: inset(0 0 0 var(--cut, 50%)); }
    .pt-handle { display: none; position: absolute; top: 0; bottom: 0; left: var(--cut, 50%); width: 0; z-index: 3; }
    body.oldnew .pt-handle { display: block; }
    .pt-handle::before { content: ""; position: absolute; top: 0; bottom: 0; left: -2px; width: 4px; background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.25), 0 0 24px rgba(0,0,0,.35); }
    .pt-knob { position: absolute; top: 50%; left: -26px; width: 52px; height: 52px; margin-top: -26px; border-radius: 50%; background: #fff; color: #0b0f17; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; box-shadow: 0 6px 20px rgba(0,0,0,.35); cursor: ew-resize; touch-action: none; }
    .pt-tag { position: absolute; top: 16px; z-index: 3; display: none; background: rgba(11,15,23,.8); color: #fff; font-size: 13px; font-weight: 700; padding: 6px 12px; border-radius: 999px; letter-spacing: .02em; }
    body.oldnew .pt-tag { display: block; }
    .pt-tag.old { left: 16px; } .pt-tag.new { right: 16px; }
    .pt-drag { position: absolute; inset: 0; z-index: 2; display: none; cursor: ew-resize; }
    body.dragging .pt-drag { display: block; }
    .pt-end { position: fixed; inset: 0; z-index: 20; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; text-align: center; padding: 24px; background: radial-gradient(circle at 50% 40%, rgba(31,41,55,.94), rgba(11,15,23,.98)); opacity: 0; pointer-events: none; transition: opacity .6s; }
    .pt-end.on { opacity: 1; pointer-events: auto; }
    .pt-end h1 { font-size: clamp(2rem, 6vw, 4rem); margin: 0; color: #fff; letter-spacing: -.02em; }
    .pt-end p { margin: 0; font-size: clamp(1.1rem, 2.6vw, 1.6rem); color: #cbd5e1; }
    .pt-end .row { margin-top: 18px; }
    .pt-hint { position: fixed; z-index: 9; bottom: 14px; left: 50%; transform: translateX(-50%); font-size: 12.5px; color: #94a3b8; background: rgba(11,15,23,.8); padding: 6px 12px; border-radius: 999px; transition: opacity .4s; }
    body.touring.idle .pt-hint { opacity: 0; }
    body.oldnew .pt-hint { display: none; }
    .pt-share { position: fixed; z-index: 15; top: 66px; right: 14px; width: min(420px, calc(100% - 28px)); background: #fff; color: #0f172a; border-radius: 14px; padding: 16px; box-shadow: 0 20px 50px rgba(0,0,0,.45); display: none; }
    .pt-share.on { display: block; }
    .pt-share h3 { margin: 0 0 6px; } .pt-share p { font-size: 13.5px; color: #475569; margin: 0 0 10px; }
    .pt-share input { margin-bottom: 8px; }
    .pt-share .row { flex-wrap: wrap; gap: 6px; }
    .pt-pk { position: fixed; inset: 0; z-index: 25; display: none; overflow: auto; padding: 70px 18px 30px; background: rgba(11,15,23,.94); }
    .pt-pk.on { display: block; }
    .pt-pk h2 { text-align: center; color: #fff; margin: 0 0 6px; font-size: clamp(1.5rem, 3.5vw, 2.4rem); }
    .pt-pk .sub { text-align: center; color: #94a3b8; margin: 0 0 22px; }
    .pt-pk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; max-width: 1080px; margin: 0 auto; }
    .pt-pk-card { background: #fff; color: #0f172a; border-radius: 18px; padding: 22px; position: relative; display: flex; flex-direction: column; gap: 10px; border: 3px solid transparent; }
    .pt-pk-card.best { border-color: #f59e0b; box-shadow: 0 24px 60px rgba(245,158,11,.25); }
    .pt-pk-card .tag { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: #f59e0b; color: #1c1300; font-size: 12px; font-weight: 800; padding: 4px 12px; border-radius: 999px; white-space: nowrap; }
    .pt-pk-card h3 { margin: 0; font-size: 1.3rem; }
    .pt-pk-card .price { font-size: 1.6rem; font-weight: 800; letter-spacing: -.01em; }
    .pt-pk-card .price.ph { color: #94a3b8; font-size: 1.1rem; font-weight: 600; }
    .pt-pk-card ul { margin: 0; padding-left: 20px; display: grid; gap: 6px; font-size: 14.5px; }
    .pt-pk-note { text-align: center; color: #cbd5e1; margin: 20px 0 0; }
    .pt-pk-foot { text-align: center; margin-top: 18px; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
    .pt-pk-foot a { color: #93c5fd; }
    .pt-pk-x { position: fixed; top: 14px; right: 14px; z-index: 26; }
    @media (prefers-reduced-motion: reduce) { .pt-end, .pt-bar { transition: none; } }
  </style>
</head>
<body>
  <% const pitch = site.sections.pitch || {}; const phone = site.sections.contact.phone; %>
  <div class="pt-bar" id="ptBar">
    <a href="/sites/<%= site.id %>/edit">&larr; Editor</a>
    <strong><%= site.name %></strong>
    <label class="muted" for="motionSel" style="margin:0; color:#94a3b8; font-weight:400;">Motion</label>
    <select id="motionSel"><% motions.forEach(m => { %><option value="<%= m.q %>"><%= m.label %></option><% }) %></select>
    <span class="pt-seg" role="group" aria-label="Screen">
      <button type="button" class="btn-secondary on" data-dev="desktop" aria-pressed="true">Desktop</button><button type="button" class="btn-secondary" data-dev="phone" aria-pressed="false">Phone</button>
    </span>
    <% if (pitch.oldShot) { %><button type="button" class="btn-secondary" id="oldNewBtn" aria-pressed="false">Old site vs new</button><% } %>
    <span class="sp"></span>
    <% if (demos.length) { %><select id="demoSel" aria-label="Show a demo site" style="max-width:150px;"><option value="">Demo sites…</option><% demos.forEach(d => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select><% } %>
    <button type="button" class="btn-secondary" id="pkBtn" aria-expanded="false">Packages</button>
    <button type="button" class="btn-secondary" id="shareBtn" aria-expanded="false">Share link</button>
    <button type="button" class="btn-secondary" id="fsBtn">Full screen</button>
    <button type="button" id="startBtn">&#9654; Start the show</button>
  </div>

  <div class="pt-share" id="sharePanel" role="dialog" aria-label="Share a preview link">
    <h3>Private preview link</h3>
    <p>Anyone with this link can look at the site (not edit it), even before it is published. Search engines are told to skip it. Replace or turn it off at any time.</p>
    <input type="text" id="shareUrl" readonly value="<%= shareLink %>" placeholder="No link yet">
    <p id="shareInfo"><%= share ? 'Opened ' + share.views + ' time' + (share.views === 1 ? '' : 's') + (share.last_viewed_at ? ', last on ' + share.last_viewed_at + ' (UTC)' : '') + '.' : '' %></p>
    <div class="row">
      <button type="button" id="shareCopy" <%= share ? '' : 'hidden' %>>Copy link</button>
      <button type="button" class="btn-secondary" id="shareMake"><%= share ? 'Replace link' : 'Create link' %></button>
      <button type="button" class="btn-danger" id="shareOff" <%= share ? '' : 'hidden' %>>Turn off</button>
    </div>
  </div>

  <div class="pt-pk" id="pkPanel" role="dialog" aria-modal="true" aria-label="Packages">
    <button type="button" class="btn-secondary pt-pk-x" id="pkClose">Close</button>
    <h2>Pick what suits <%= site.name %></h2>
    <p class="sub">Every package is built around this site.</p>
    <div class="pt-pk-grid">
      <% sales.tiers.forEach(t => { %>
      <div class="pt-pk-card<%= t.best ? ' best' : '' %>">
        <% if (t.best) { %><span class="tag">Most popular</span><% } %>
        <h3><%= t.name %></h3>
        <div class="price<%= t.price ? '' : ' ph' %>"><%= t.price || placeholder %></div>
        <ul><% t.items.forEach(x => { %><li><%= x %></li><% }) %></ul>
      </div>
      <% }) %>
    </div>
    <% if (sales.note) { %><p class="pt-pk-note"><%= sales.note %></p><% } %>
    <div class="pt-pk-foot"><a href="/packages?back=/sites/<%= site.id %>/pitch">Change the packages and prices</a></div>
  </div>

  <div class="pt-stage" id="stage">
    <div class="pt-frame" id="frameBox">
      <% if (pitch.oldShot) { %><div class="pt-old" style="background-image:url('<%= pitch.oldShot.replace(/'/g, '%27') %>')" role="img" aria-label="Screenshot of the current website"></div>
      <span class="pt-tag old"><%= pitch.oldUrl ? 'Now: ' + pitch.oldUrl : 'Their website now' %></span><span class="pt-tag new">The new site</span><% } %>
      <iframe id="pf" title="Site preview" src="/sites/<%= site.id %>/preview?bar=0&amp;<%= motions[0].q %>"></iframe>
      <div class="pt-drag" id="dragLayer"></div>
      <div class="pt-handle" id="handle"><div class="pt-knob" id="knob" role="slider" tabindex="0" aria-label="Compare old and new site" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">&#8596;</div></div>
    </div>
  </div>

  <div class="pt-end" id="endCard" aria-live="polite">
    <h1><%= site.name %></h1>
    <% if (phone) { %><p><%= phone %></p><% } %>
    <div class="row">
      <button type="button" id="replayBtn">&#8635; Watch again</button>
      <button type="button" class="btn-secondary" id="endClose">Look around</button>
    </div>
  </div>
  <div class="pt-hint" id="hint">Space pauses, arrow keys move between sections, Esc stops, F is full screen</div>

  <script>
  (function () {
    var siteId = <%= site.id %>;
    var body = document.body, pf = document.getElementById('pf'), box = document.getElementById('frameBox');
    var endCard = document.getElementById('endCard'), startBtn = document.getElementById('startBtn');
    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    var tour = null;

    // ---- device size ----
    function fit() {
      if (!body.classList.contains('phone')) { box.style.transform = ''; return; }
      var top = body.classList.contains('touring') ? 0 : 62;
      var s = Math.min(1, (innerHeight - top - 24) / 868, (innerWidth - 24) / 414);
      box.style.transform = 'scale(' + s + ')';
    }
    addEventListener('resize', fit);
    document.querySelectorAll('[data-dev]').forEach(function (b) {
      b.addEventListener('click', function () {
        body.classList.toggle('phone', b.dataset.dev === 'phone');
        document.querySelectorAll('[data-dev]').forEach(function (x) { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
        fit();
      });
    });

    // ---- packages, and showing one of the demo sites ----
    var pk = document.getElementById('pkPanel'), pkBtn = document.getElementById('pkBtn');
    function pkShow(on) { if (on) stopTour(); pk.classList.toggle('on', on); pkBtn.setAttribute('aria-expanded', String(on)); if (on) document.getElementById('pkClose').focus(); else pkBtn.focus(); }
    pkBtn.addEventListener('click', function () { pkShow(!pk.classList.contains('on')); });
    document.getElementById('pkClose').addEventListener('click', function () { pkShow(false); });
    pk.addEventListener('keydown', function (e) { if (e.key === 'Escape') { e.stopPropagation(); pkShow(false); } });
    var demoSel = document.getElementById('demoSel');
    if (demoSel) demoSel.addEventListener('change', function () {
      stopTour();
      var id = demoSel.value || siteId, m = document.getElementById('motionSel').value;
      pf.src = '/sites/' + id + '/preview?bar=0' + (m ? '&' + m : '');
    });

    // ---- motion choice reloads the preview ----
    document.getElementById('motionSel').addEventListener('change', function (e) {
      stopTour(); pf.src = '/sites/' + siteId + '/preview?bar=0' + (e.target.value ? '&' + e.target.value : '');
    });

    // ---- the show: scroll section by section, then the closing card ----
    function stops() {
      var doc = pf.contentDocument, win = pf.contentWindow; if (!doc) return [0];
      var ys = [0];
      Array.prototype.forEach.call(doc.querySelectorAll('section, footer'), function (el) {
        if (el.parentElement && el.parentElement.closest('section')) return;
        if (el.offsetHeight < 140 || getComputedStyle(el).display === 'none') return;
        var y = Math.round(el.getBoundingClientRect().top + win.scrollY) - 8;
        if (y - ys[ys.length - 1] > 220) ys.push(y);
      });
      var max = doc.documentElement.scrollHeight - win.innerHeight;
      ys = ys.map(function (y) { return Math.max(0, Math.min(max, y)); }).filter(function (y, i, a) { return i === 0 || y - a[i - 1] > 120; });
      return ys;
    }
    function glide(to, done) {
      var win = pf.contentWindow, from = win.scrollY, dist = to - from;
      if (reduce || !dist) { win.scrollTo(0, to); return done(); }
      var dur = Math.min(1700, Math.max(700, Math.abs(dist) * 0.9)), t0 = null, id = tour.gid = (tour.gid || 0) + 1;
      function step(t) {
        if (!tour || tour.gid !== id) return;
        if (tour.paused) { tour.resume = function () { requestAnimationFrame(step); }; return; }
        if (t0 === null) t0 = t;
        var k = Math.min(1, (t - t0) / dur), e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
        win.scrollTo(0, from + dist * e);
        if (k < 1) requestAnimationFrame(step); else done();
      }
      requestAnimationFrame(step);
    }
    function go(i) {
      if (!tour) return;
      clearTimeout(tour.timer);
      if (i >= tour.ys.length) return finish();
      tour.i = Math.max(0, i);
      glide(tour.ys[tour.i], function () {
        if (!tour) return;
        tour.timer = setTimeout(function () { if (tour && !tour.paused) go(tour.i + 1); }, tour.i === 0 ? 3600 : 2900);
      });
    }
    function startTour() {
      endCard.classList.remove('on');
      stopTour();
      var doc = pf.contentDocument; if (!doc) return;
      doc.documentElement.style.scrollBehavior = 'auto';
      body.classList.add('touring'); fit();
      pf.contentWindow.scrollTo(0, 0);
      // replay the page's entrance animation from the top
      var again = function () {
        tour = { ys: stops(), i: 0, paused: false, timer: null };
        go(0);
      };
      if (pf.contentWindow.SiteGenMotion && pf.contentWindow.SiteGenMotion.init) { try { pf.contentWindow.SiteGenMotion.init(doc.body.getAttribute('data-motion') || 'subtle'); } catch (e) { /* keep going without it */ } }
      setTimeout(again, 300);
      startBtn.textContent = '❚❚ Pause';
      idleSoon();
    }
    function stopTour() {
      if (tour) clearTimeout(tour.timer);
      tour = null; body.classList.remove('touring', 'idle'); fit();
      startBtn.innerHTML = '&#9654; Start the show';
    }
    function finish() {
      var t = tour; stopTour(); if (!t) return;
      endCard.classList.add('on');
    }
    function pause(p) {
      if (!tour) return;
      tour.paused = p; startBtn.textContent = p ? '▶ Resume' : '❚❚ Pause';
      if (!p) { if (tour.resume) { var r = tour.resume; tour.resume = null; r(); } else go(tour.i + 1); }
      else clearTimeout(tour.timer);
    }
    startBtn.addEventListener('click', function () { if (!tour) startTour(); else pause(!tour.paused); });
    document.getElementById('replayBtn').addEventListener('click', startTour);
    document.getElementById('endClose').addEventListener('click', function () { endCard.classList.remove('on'); });

    // the controls hide while the show runs and come back when the mouse moves
    var idleT = null;
    function idleSoon() { body.classList.remove('idle'); clearTimeout(idleT); idleT = setTimeout(function () { if (tour) body.classList.add('idle'); }, 2200); }
    addEventListener('mousemove', idleSoon);
    function keys(e) {
      if (e.target && /INPUT|SELECT|TEXTAREA/.test(e.target.tagName)) return;
      if (e.key === ' ') { e.preventDefault(); if (!tour) startTour(); else pause(!tour.paused); }
      else if ((e.key === 'ArrowRight' || e.key === 'ArrowDown') && tour) { e.preventDefault(); tour.paused = false; go(tour.i + 1); }
      else if ((e.key === 'ArrowLeft' || e.key === 'ArrowUp') && tour) { e.preventDefault(); tour.paused = false; go(tour.i - 1); }
      else if (e.key === 'Escape') { stopTour(); endCard.classList.remove('on'); }
      else if (e.key === 'f' || e.key === 'F') toggleFs();
    }
    addEventListener('keydown', keys);
    pf.addEventListener('load', function () {
      try { pf.contentWindow.addEventListener('keydown', keys); pf.contentWindow.addEventListener('mousemove', idleSoon); } catch (e) { /* same site, so this works */ }
    });

    function toggleFs() {
      if (document.fullscreenElement) document.exitFullscreen();
      else if (document.documentElement.requestFullscreen) document.documentElement.requestFullscreen().catch(function () {});
    }
    document.getElementById('fsBtn').addEventListener('click', toggleFs);

    // ---- old site vs new: drag the line ----
    var oldBtn = document.getElementById('oldNewBtn');
    if (oldBtn) {
      var cut = 50;
      function setCut(v) { cut = Math.max(0, Math.min(100, v)); box.style.setProperty('--cut', cut + '%'); document.getElementById('knob').setAttribute('aria-valuenow', String(Math.round(cut))); }
      oldBtn.addEventListener('click', function () {
        var on = !body.classList.contains('oldnew');
        stopTour();
        body.classList.toggle('oldnew', on); oldBtn.classList.toggle('on', on); oldBtn.setAttribute('aria-pressed', String(on));
        startBtn.disabled = on;
        if (on) {
          try { pf.contentWindow.scrollTo(0, 0); } catch (e) { /* ignore */ }
          if (reduce) return setCut(50);
          // open on the old site, then sweep across to reveal the new one
          var t0 = null; setCut(100);
          requestAnimationFrame(function sweep(t) { if (t0 === null) t0 = t; var k = Math.min(1, (t - t0) / 1600); setCut(100 - 50 * (1 - Math.pow(1 - k, 3))); if (k < 1) requestAnimationFrame(sweep); });
        }
      });
      var knob = document.getElementById('knob'), layer = document.getElementById('dragLayer');
      function at(e) { var r = box.getBoundingClientRect(); setCut((e.clientX - r.left) / r.width * 100); }
      knob.addEventListener('pointerdown', function (e) { e.preventDefault(); body.classList.add('dragging'); });
      layer.addEventListener('pointermove', at);
      addEventListener('pointerup', function () { body.classList.remove('dragging'); });
      knob.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); e.stopPropagation(); setCut(cut - 5); }
        if (e.key === 'ArrowRight') { e.preventDefault(); e.stopPropagation(); setCut(cut + 5); }
      });
      setCut(50);
    }

    // ---- share link ----
    var panel = document.getElementById('sharePanel'), shareBtn = document.getElementById('shareBtn');
    function showShare(on) { panel.classList.toggle('on', on); shareBtn.setAttribute('aria-expanded', String(on)); }
    shareBtn.addEventListener('click', function () { showShare(!panel.classList.contains('on')); });
    if (location.hash === '#share') showShare(true);
    var urlIn = document.getElementById('shareUrl'), copyB = document.getElementById('shareCopy'), makeB = document.getElementById('shareMake'), offB = document.getElementById('shareOff'), info = document.getElementById('shareInfo');
    makeB.addEventListener('click', function () {
      if (urlIn.value && !confirm('Make a new link? The old one stops working.')) return;
      fetch('/sites/' + siteId + '/share', { method: 'POST', headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (d) {
        if (!d.ok) return;
        urlIn.value = d.url; copyB.hidden = false; offB.hidden = false; makeB.textContent = 'Replace link'; info.textContent = 'New link, not opened yet.';
      });
    });
    offB.addEventListener('click', function () {
      if (!confirm('Turn off the link? Anyone using it will see "not found".')) return;
      fetch('/sites/' + siteId + '/share/revoke', { method: 'POST', headers: { Accept: 'application/json' } }).then(function () {
        urlIn.value = ''; copyB.hidden = true; offB.hidden = true; makeB.textContent = 'Create link'; info.textContent = 'Link turned off.';
      });
    });
    copyB.addEventListener('click', function () {
      urlIn.select();
      (navigator.clipboard ? navigator.clipboard.writeText(urlIn.value) : Promise.reject()).then(function () { copyB.textContent = 'Copied'; }, function () { document.execCommand('copy'); copyB.textContent = 'Copied'; });
      setTimeout(function () { copyB.textContent = 'Copy link'; }, 1600);
    });
    fit();
  })();
  </script>
</body>
</html>
