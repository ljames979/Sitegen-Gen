<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  :root {
    --primary: #2563eb;
    --bg: #f8fafc;
    --card: #ffffff;
    --border: #e2e8f0;
    --text: #0f172a;
    --muted: #64748b;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    margin: 0;
    line-height: 1.5;
  }
  a { color: var(--primary); text-decoration: none; }
  .container { max-width: 960px; margin: 0 auto; padding: 24px; }
  .narrow { max-width: 420px; margin: 60px auto; padding: 24px; }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
  }
  h1, h2, h3 { margin-top: 0; }
  label { display: block; font-weight: 600; margin: 14px 0 6px; font-size: 14px; }
  input[type=text], input[type=number], input[type=date], input[type=email], input[type=password], input[type=url], textarea, select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
  }
  textarea { resize: vertical; min-height: 80px; }
  button, .btn {
    display: inline-block;
    background: var(--primary);
    color: white;
    border: none;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
  }
  .btn-secondary { background: #e2e8f0; color: var(--text); }
  .btn-danger { background: #dc2626; }
  .row { display: flex; gap: 12px; align-items: center; }
  .between { justify-content: space-between; }
  .muted { color: var(--muted); }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
  }
  .site-list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 12px;
  }
  .badge {
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 999px;
    background: #dcfce7;
    color: #166534;
  }
  .badge.draft { background: #f1f5f9; color: var(--muted); }
  .section-block {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px;
    margin-bottom: 18px;
  }
  .service-row, .gallery-row {
    display: flex;
    gap: 8px;
    margin-bottom: 8px;
    align-items: flex-start;
  }
  .service-row input, .gallery-row input { flex: 1; }
  .gallery-row { flex-wrap: wrap; }
  .gallery-row .alt-input { flex: 1 1 100%; order: 5; }
  .lib-box { border: 1px dashed var(--border); border-radius: 10px; padding: 10px 12px; margin: 0 0 12px; background: #f8fafc; }
  .lib-box select { margin: 0; flex: 1; }
  .rd-row select { flex: 0 0 150px; margin: 0; width: auto; }
  .seo-page-row { border: 1px solid var(--border); border-radius: 10px; padding: 8px 12px; margin-bottom: 8px; background: #fff; }
  .seo-page-row summary { cursor: pointer; }
  .cf-row { flex-wrap: wrap; padding: 10px; border: 1px solid var(--border); border-radius: 10px; background: #f8fafc; margin-bottom: 10px; }
  .cf-row input[name=cf_label] { order: 1; } .cf-row select.cf-type { order: 2; } .cf-row select[name=cf_step] { order: 3; }
  .cf-row select[name=cf_required] { order: 4; } .cf-row .btn-secondary { order: 5; } .cf-row .cf-options { order: 6; }
  .cf-row input[name=cf_label] { flex: 1 1 100%; }
  .cf-row .cf-options { flex: 1 1 100%; }
  .cf-row select { margin: 0; width: auto; min-width: 0; }
  .cf-row select.cf-type { flex: 1 1 170px; }
  .cf-row select[name=cf_step] { flex: 0 0 92px; }
  .cf-row select[name=cf_required] { flex: 0 0 112px; }
  .cf-row .btn-secondary { flex: 0 0 auto; padding-left: 12px; padding-right: 12px; }
  /* rows that carry a long text box (service page text, blog posts, extra pages): box goes on its own line */
  .service-row:has(textarea[name=service_detail], textarea[name=blog_body], textarea[name=extra_body]) { flex-wrap: wrap; }
  .service-row textarea[name=service_detail], .service-row textarea[name=blog_body], .service-row textarea[name=extra_body] { flex: 1 1 100%; order: 5; margin: 0; }
  .service-row:has(textarea[name=service_detail], textarea[name=blog_body], textarea[name=extra_body]) .remove-row { order: 4; }
  .service-row .svc-extra { flex: 1 1 100%; order: 6; display: grid; gap: 8px; }
  .service-row .svc-extra select { margin: 0; }
  .service-row .svc-extra .upload-row { margin: 0; }
  .service-row:has(.svc-extra) { flex-wrap: wrap; }
  .service-row input[name=loc_name], .service-row input[name=loc_address] { min-width: 150px; }
  .service-row input[name=extra_title], .service-row input[name=blog_title] { min-width: 180px; }
  .flash {
    background: #dcfce7;
    color: #166534;
    padding: 10px 14px;
    border-radius: 8px;
    margin-bottom: 16px;
    font-size: 14px;
  }
  .error {
    background: #fee2e2;
    color: #991b1b;
    padding: 10px 14px;
    border-radius: 8px;
    margin-bottom: 16px;
    font-size: 14px;
  }
</style>

<style>
  .block-row { border: 1px solid var(--border, #e2e8f0); border-radius: 10px; padding: 12px; margin: 10px 0; background: #fff; }
  .block-bar { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
  .block-actions { display: flex; gap: 4px; flex-wrap: wrap; }
  .block-actions .btn-secondary { padding: 3px 8px; font-size: 12px; }
</style>

<style>
  .style-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 10px; }
  .focal-pick { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 10px; }
  .focal-box { position: relative; width: 240px; height: 150px; border-radius: 10px; border: 1px solid var(--border, #e2e8f0); background-size: cover; background-repeat: no-repeat; cursor: crosshair; }
  .focal-dot { position: absolute; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 0 0 2px var(--primary, #2563eb), 0 2px 8px rgba(0,0,0,.4); pointer-events: none; }
  .palette-box { margin: 8px 0 4px; }
  .palette-box summary { cursor: pointer; font-weight: 600; font-size: 14px; }
  .pal-base { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .pal-base input[type=color] { width: 46px; height: 36px; padding: 2px; margin: 0; border: 1px solid var(--border, #e2e8f0); border-radius: 8px; background: #fff; cursor: pointer; }
  .pal-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 8px; margin-bottom: 10px; }
  .pal-sw { display: flex; flex-direction: column; align-items: center; gap: 6px; border: 1px solid var(--border, #e2e8f0); background: #fff; border-radius: 10px; padding: 8px 6px; cursor: pointer; font-size: 12.5px; color: inherit; }
  .pal-sw:hover { border-color: var(--primary, #2563eb); }
  .pal-dots { display: flex; } .pal-dots i { width: 34px; height: 34px; display: block; } .pal-dots i:first-child { border-radius: 17px 0 0 17px; } .pal-dots i:last-child { border-radius: 0 17px 17px 0; }
  .pal-issue { font-size: 13px; border-radius: 8px; padding: 8px 10px; margin: 6px 0; } .pal-issue button { margin-left: 6px; padding: 3px 10px; font-size: 12.5px; }
  .pal-issue.warn { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; } .pal-issue.bad { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
  .chip-btn { border: 1px solid var(--border, #e2e8f0); background: #fff; border-radius: 999px; padding: 5px 12px; font-size: 13px; cursor: pointer; }
  .chip-btn.on { background: var(--primary, #2563eb); color: #fff; border-color: transparent; }
</style>
