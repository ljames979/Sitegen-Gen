<%# The public members page: log in / sign up, or the members-only pages. Locals: site, basePath, preview, memberView %>
<% const mv = memberView || { mode: 'login' }; const cfg = mv.cfg || membersLib.clean(site.sections.members); const mb = basePath + '/members'; %>
<style>
  .mem-card { max-width: 520px; margin: 0 auto; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius, 12px); padding: 24px; }
  .mem-card.wide { max-width: 820px; }
  .mem-card label { display: block; font-weight: 600; font-size: 14px; margin: 12px 0 4px; }
  .mem-card input[type=text], .mem-card input[type=email], .mem-card input[type=password] { width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm, 8px); font: inherit; background: var(--page-bg); color: var(--ink); }
  .mem-card button.btn { margin-top: 16px; min-height: 44px; cursor: pointer; border: 0; }
  .mem-tabs { display: flex; gap: 8px; margin-bottom: 8px; }
  .mem-tabs a { flex: 1; text-align: center; padding: 10px; min-height: 44px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border); border-radius: var(--radius-sm, 8px); font-weight: 600; }
  .mem-tabs a.on { background: var(--primary); color: var(--on-primary); border-color: var(--primary); }
  .mem-note { background: color-mix(in srgb, var(--primary) 10%, var(--page-bg)); border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; font-size: 14.5px; }
  .mem-err { background: #fef2f2; color: #991b1b; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; font-size: 14.5px; }
  .mem-page { border-top: 1px solid var(--border); padding: 18px 0; } .mem-page:first-of-type { border-top: 0; }
  .mem-page h3 { margin: 0 0 8px; } .mem-page p { margin: 0 0 10px; white-space: pre-line; }
  .mem-bar { display: flex; justify-content: space-between; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 6px; }
  .mem-link { background: none; border: 0; color: var(--primary); text-decoration: underline; cursor: pointer; font: inherit; min-height: 44px; padding: 0 4px; }
  .mem-hp { position: absolute; left: -9999px; height: 0; overflow: hidden; }
</style>
<section class="block" id="members">
  <div class="wrap">
    <div class="section-head">
      <div class="rule"></div>
      <h2><%= cfg.title %></h2>
      <% if (mv.mode !== 'area' && cfg.intro) { %><p class="section-sub"><%= cfg.intro %></p><% } %>
    </div>
    <% if (preview) { %><div class="mem-card" style="margin-bottom:16px;"><div class="mem-note" style="margin:0;">Preview. Visitors see the log-in form here, and the pages below once they are signed in. Members can only sign up on the live site.</div></div><% } %>

    <% if (mv.mode === 'area') { %>
      <div class="mem-card wide">
        <div class="mem-bar"><strong>Signed in as <%= mv.member.name || mv.member.email %></strong>
          <form method="POST" action="<%= mb %>/logout"><button type="submit" class="mem-link">Log out</button></form></div>
        <% if (mv.notice) { %><div class="mem-note"><%= mv.notice %></div><% } %>
        <% if (!cfg.pages.length) { %><p>There is nothing here yet. Check back soon.</p><% } %>
        <% cfg.pages.forEach(p => { %>
          <div class="mem-page">
            <% if (p.title) { %><h3><%= p.title %></h3><% } %>
            <% if (p.body) { %><p><%= p.body %></p><% } %>
            <% if (p.linkUrl) { %><a class="btn" href="<%= p.linkUrl %>" target="_blank" rel="noopener"><%= p.linkLabel || 'Open' %></a><% } %>
          </div>
        <% }) %>
      </div>

    <% } else if (mv.mode === 'reset-bad') { %>
      <div class="mem-card"><div class="mem-err">That link has expired or was already used.</div><a class="btn" href="<%= mb %>">Back to log in</a></div>

    <% } else if (mv.mode === 'reset') { %>
      <div class="mem-card">
        <% if (mv.error) { %><div class="mem-err"><%= mv.error %></div><% } %>
        <form method="POST" action="<%= mb %>/reset">
          <input type="hidden" name="t" value="<%= mv.token %>">
          <label for="mp1">New password (at least 8 characters)</label><input id="mp1" type="password" name="password" autocomplete="new-password" required minlength="8">
          <label for="mp2">Type it again</label><input id="mp2" type="password" name="password2" autocomplete="new-password" required minlength="8">
          <button type="submit" class="btn">Save new password</button>
        </form>
      </div>

    <% } else { %>
      <div class="mem-card">
        <% if (mv.notice) { %><div class="mem-note"><%= mv.notice %></div><% } %>
        <% if (mv.error) { %><div class="mem-err"><%= mv.error %></div><% } %>
        <% if (cfg.signup !== 'invite') { %>
          <div class="mem-tabs"><a href="<%= mb %>" class="<%= mv.tab !== 'signup' ? 'on' : '' %>">Log in</a><a href="<%= mb %>?tab=signup" class="<%= mv.tab === 'signup' ? 'on' : '' %>">Sign up</a></div>
        <% } %>
        <% if (mv.tab === 'signup' && cfg.signup !== 'invite') { %>
          <% if (cfg.signup === 'approval') { %><p class="muted" style="margin:0 0 4px;font-size:14px;">New accounts are checked by <%= site.name %> before they can log in.</p><% } %>
          <form method="POST" action="<%= mb %>/signup">
            <div class="mem-hp" aria-hidden="true"><label>Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
            <label for="sn">Your name</label><input id="sn" type="text" name="name" value="<%= mv.name || '' %>" autocomplete="name" required maxlength="80">
            <label for="se">Email</label><input id="se" type="email" name="email" value="<%= mv.email || '' %>" autocomplete="email" required>
            <label for="sp1">Password (at least 8 characters)</label><input id="sp1" type="password" name="password" autocomplete="new-password" required minlength="8">
            <label for="sp2">Type it again</label><input id="sp2" type="password" name="password2" autocomplete="new-password" required minlength="8">
            <button type="submit" class="btn">Create account</button>
          </form>
        <% } else { %>
          <form method="POST" action="<%= mb %>/login">
            <label for="le">Email</label><input id="le" type="email" name="email" value="<%= mv.email || '' %>" autocomplete="email" required>
            <label for="lp">Password</label><input id="lp" type="password" name="password" autocomplete="current-password" required>
            <button type="submit" class="btn">Log in</button>
          </form>
          <details style="margin-top:14px;">
            <summary style="min-height:44px;display:flex;align-items:center;cursor:pointer;">Forgot your password?</summary>
            <form method="POST" action="<%= mb %>/forgot">
              <label for="fe">Your email</label><input id="fe" type="email" name="email" autocomplete="email" required>
              <button type="submit" class="btn">Send me a link</button>
            </form>
          </details>
          <% if (cfg.signup === 'invite') { %><p class="muted" style="font-size:14px;margin-top:14px;">Accounts are created by <%= site.name %>. Contact us if you need one.</p><% } %>
        <% } %>
      </div>
    <% } %>
  </div>
</section>
