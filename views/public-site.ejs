    function star(x, y, s, a) { ctx.beginPath(); for (var i = 0; i < 8; i++) { var rr = i % 2 ? s * 0.28 : s, an = i * Math.PI / 4 - Math.PI / 2; ctx.lineTo(x + Math.cos(an) * rr, y + Math.sin(an) * rr); } ctx.closePath(); ctx.globalAlpha = a; ctx.fill(); }
