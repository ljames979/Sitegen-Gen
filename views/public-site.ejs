  <script>
    (function () {
      // announcement bar: stays closed once dismissed (until the owner changes the message)
      var bar = document.getElementById('annBar');
      if (bar) {
        var k = 'ann-' + bar.dataset.key;
        try { if (localStorage.getItem(k)) bar.hidden = true; } catch (e) {}
        var x = document.getElementById('annClose');
        if (x) x.addEventListener('click', function () { bar.hidden = true; try { localStorage.setItem(k, '1'); } catch (e) {} });
      }
      // photo lightbox for any [data-lightbox] group
      var groups = document.querySelectorAll('[data-lightbox]'); if (!groups.length) return;
      var box = document.createElement('div'); box.className = 'lb'; box.hidden = true; box.setAttribute('role', 'dialog'); box.setAttribute('aria-modal', 'true'); box.setAttribute('aria-label', 'Photo viewer');
      box.innerHTML = '<button type="button" class="lb-close" aria-label="Close">&times;</button><button type="button" class="lb-prev" aria-label="Previous photo">&lsaquo;</button><img alt=""><button type="button" class="lb-next" aria-label="Next photo">&rsaquo;</button><div class="lb-count"></div>';
      document.body.appendChild(box);
      var img = box.querySelector('img'), count = box.querySelector('.lb-count'), list = [], at = 0, opener = null;
      function show(i) { at = (i + list.length) % list.length; img.src = list[at].src; img.alt = list[at].alt; count.textContent = list.length > 1 ? (at + 1) + ' / ' + list.length : ''; }
      function open(group, i, from) { list = Array.prototype.slice.call(group.querySelectorAll('img')); opener = from; show(i); box.hidden = false; document.body.style.overflow = 'hidden'; box.querySelector('.lb-close').focus(); }
      function close() { box.hidden = true; document.body.style.overflow = ''; img.removeAttribute('src'); if (opener) opener.focus(); }
      groups.forEach(function (g) {
        g.addEventListener('click', function (e) {
          var t = e.target.closest('img'); if (!t || !g.contains(t) || e.target.closest('a')) return;
          var all = Array.prototype.slice.call(g.querySelectorAll('img')); open(g, all.indexOf(t), t);
        });
      });
      box.addEventListener('click', function (e) {
        if (e.target.closest('.lb-close') || e.target === box) return close();
        if (e.target.closest('.lb-prev')) return show(at - 1);
        if (e.target.closest('.lb-next')) return show(at + 1);
      });
      document.addEventListener('keydown', function (e) {
        if (box.hidden) return;
        if (e.key === 'Escape') close(); else if (e.key === 'ArrowLeft') show(at - 1); else if (e.key === 'ArrowRight') show(at + 1);
      });
      var sx = 0; box.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; }, { passive: true });
      box.addEventListener('touchend', function (e) { var dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 50) show(at + (dx < 0 ? 1 : -1)); });
    })();
  </script>

