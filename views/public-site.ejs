            <% if (service.detail) { %>
              <div class="service-body">
                <% service.detail.split(/\n{2,}/).forEach(para => { %><p><%= para %></p><% }) %>
              </div>
            <% } %>
            <% const buyCents = (typeof payOn !== 'undefined' && payOn && !(typeof staticExport !== 'undefined' && staticExport)) ? payLib.toCents(service.pay) : 0; %>
            <% if (buyCents) { %>
              <form method="POST" action="<%= basePath %>/buy" class="buy-form" style="margin:22px 0 0;" <%= preview ? 'onsubmit="return false;"' : '' %>>
