          <% site.sections.gallery.images.slice(0, layoutName === 'photos' ? 6 : 2).forEach(img => { %>
            <div class="featured-frame"><img src="<%= img %>" alt="<%= site.name %>" loading="lazy" decoding="async"></div>
          <% }) %>
        </div>
      </section>
    <% } %>
    <% } %>
    <% customTail.forEach(i => { %><%- include('_lib-section', { item: i }) %>
    <% }) %>

    <% const hmAreas = (site.sections.trust && site.sections.trust.serviceAreas) || []; %>
    <% if (site.sections.contact.homeMap && (site.sections.contact.address || hmAreas.length)) { %>
      <section class="home-location" id="where-we-work">
        <div class="loc-grid">
          <div class="loc-text" data-animate="fade-up">
            <div class="section-head left"><div class="rule"></div><h2>Where We Work</h2></div>
            <% if (locationLine) { %><p><%= locationLine %></p><% } %>
            <% if (site.sections.contact.address) { %><p><%= site.sections.contact.address %></p><% } %>
