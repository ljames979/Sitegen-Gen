        </div>
        <% if (rowsLayout) { %>
          <div class="svc-rows">
            <% services.forEach((sv, i) => { %>
              <div class="svc-row<%= i % 2 ? ' flip' : '' %>" data-animate="fade-up">
                <a class="pic" href="<%= basePath %>/services/<%= sv.slug %>" aria-hidden="true" tabindex="-1">
                  <% if (sv.imageUrl) { %><img src="<%= sv.imageUrl %>" alt="" loading="lazy" decoding="async"><% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><%- icons.iconPath(sv.title, sv.icon) %></svg><% } %>
                </a>
                <div class="txt"><h3><%= sv.title %></h3><p><%= sv.description %></p><a class="more" href="<%= basePath %>/services/<%= sv.slug %>">Read more &rarr;</a></div>
              </div>
            <% }) %>
          </div>
        <% } else if (layoutName === 'tiles') { %>
          <div class="svc-tiles n<%= Math.min(services.length, 6) %>">
            <% services.forEach(sv => { %>
              <a class="svc-tile" href="<%= basePath %>/services/<%= sv.slug %>" data-animate="fade-up">
                <% if (sv.imageUrl) { %><img src="<%= sv.imageUrl %>" alt="" loading="lazy" decoding="async"><% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><%- icons.iconPath(sv.title, sv.icon) %></svg><% } %>
                <span class="cap"><strong><%= sv.title %></strong><em><%= sv.description %></em></span>
              </a>
            <% }) %>
          </div>
        <% } else if (layoutName === 'list') { %>
          <ol class="svc-list">
            <% services.forEach((sv, i) => { %>
              <li data-animate="fade-up"><a href="<%= basePath %>/services/<%= sv.slug %>"><span class="n"><%= String(i + 1).padStart(2, '0') %></span><span class="t"><strong><%= sv.title %></strong><em><%= sv.description %></em></span><span class="go" aria-hidden="true">&rarr;</span></a></li>
            <% }) %>
          </ol>
        <% } else { %>
        <div class="grid" data-sg-cards="services">
          <% services.forEach(item => { %>
            <div class="card" data-animate="fade-up">
              <div class="badge-circle">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <h3><%= item.title %></h3>
              <p><%= item.description %></p>
              <a class="card-link" href="<%= basePath %>/services/<%= item.slug %>">Learn more &rarr;</a>
