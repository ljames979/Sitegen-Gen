    try { navigator.sendBeacon(<%- JSON.stringify(hostedStats + '/v') %>, new URLSearchParams({ p: <%- JSON.stringify(page === 'service' && service ? 'services/' + service.slug : page === 'area' && area ? 'areas/' + area.slug : page === 'post' && post ? 'blog/' + post.slug : page === 'extra' && extra ? 'p/' + extra.slug : page).replace(/</g, '\\u003c') %> })); } catch (err) { /* counting is optional */ }
  </script>
  <% } %>
  <script>
    // count what visitors do (taps on phone, email, text, contact/book buttons) without cookies;
    // also tells Google Analytics / Meta Ads when those are set up
    document.addEventListener('click', (e) => {
      const a = e.target.closest && e.target.closest('a[href]');
      if (!a) return;
      const href = a.getAttribute('href') || '';
      let ev = '';
      if (/^tel:/i.test(href)) ev = 'call';
      else if (/^mailto:/i.test(href)) ev = 'email';
      else if (/^sms:|^https?:\/\/(wa\.me|api\.whatsapp\.com)\//i.test(href)) ev = 'text';
      else if (/maps\.google\.|google\.com\/maps|maps\.apple\.com/i.test(href)) ev = 'directions';
      else if (a.matches('.btn, .btn-outline, .nav-cta, .mobile-bar a, .float-contact') && /(^|\/)(contact|book)(\/|$|\?|#)/.test(href)) ev = 'cta';
      if (!ev) return;
      if (ev === 'call') { if (window.gtag) gtag('event', 'click_to_call'); if (window.fbq) fbq('track', 'Contact'); }
      else if (ev === 'email') { if (window.gtag) gtag('event', 'click_email'); if (window.fbq) fbq('track', 'Contact'); }
      else if (ev === 'text') { if (window.gtag) gtag('event', 'click_text'); if (window.fbq) fbq('track', 'Contact'); }
      <% if (!preview && typeof hostedStats !== 'undefined' && hostedStats) { %>
      try { navigator.sendBeacon(<%- JSON.stringify(hostedStats + '/e') %>, new URLSearchParams({ e: ev, p: <%- JSON.stringify(page === 'service' && service ? 'services/' + service.slug : page).replace(/</g, '\\u003c') %> })); } catch (err) { /* counting is optional */ }
      <% } %>
      <% if (!preview && !(typeof staticExport !== 'undefined' && staticExport)) { %>
      try { navigator.sendBeacon('<%= basePath %>/e', new URLSearchParams({ e: ev, p: <%- JSON.stringify(page === 'service' && service ? 'services/' + service.slug : page).replace(/</g, '\\u003c') %> })); } catch (err) { /* counting is optional */ }
      <% } %>
    });
    // links like /contact?service=Roof%20Repair preselect that service in the quote form
    (function () {
      const want = new URLSearchParams(location.search).get('service');
      const sel = document.querySelector('select[name=service]');
      if (!want || !sel) return;
      for (const o of sel.options) if (o.value === want) sel.value = want;
    })();

    // sticky nav shadow on scroll
    const nav = document.getElementById('siteNav');
    const navScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8);
    (window.sgOnScroll || function (f) { addEventListener('scroll', f, { passive: true }); addEventListener('resize', f); })(navScroll);
    navScroll();

    // menu bar styles with a menu button (full-screen menu, side drawer: menustyles.js): open, close, Esc, link clicks
    (function () {
      var btn = document.getElementById('sgMnuBtn'), panel = document.getElementById('sgMnuPanel');
      if (!btn || !panel) return;
      var set = function (open) {
        if (open) { panel.hidden = false; requestAnimationFrame(function () { document.body.classList.add('sg-mnu-open'); }); }
        else { document.body.classList.remove('sg-mnu-open'); setTimeout(function () { if (!document.body.classList.contains('sg-mnu-open')) panel.hidden = true; }, 400); }
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) { var f = panel.querySelector('a'); if (f) setTimeout(function () { f.focus(); }, 60); } else btn.focus();
      };
      btn.addEventListener('click', function () { set(btn.getAttribute('aria-expanded') !== 'true'); });
      panel.querySelector('.sg-mnu-close').addEventListener('click', function () { set(false); });
      panel.addEventListener('click', function (e) { if (e.target === panel || e.target.closest('a')) set(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') set(false); });
    })();

    // custom contact form: step-by-step wizard + friendly checks (the server checks again)
    document.querySelectorAll('form.cform').forEach(function (form) {
      const steps = Array.prototype.slice.call(form.querySelectorAll('.cf-step'));
      const back = form.querySelector('.cf-back'), next = form.querySelector('.cf-next'), submit = form.querySelector('.cf-submit');
      const bar = form.querySelector('.cf-bar'), count = form.querySelector('.cf-count');
      let cur = 0;
      form.classList.add('cf-js');
      form.noValidate = true;
      function show(n) {
        cur = n;
        steps.forEach(function (s, i) { s.hidden = steps.length > 1 && i !== n; });
        if (back) back.hidden = n === 0;
        if (next) next.hidden = n === steps.length - 1;
        if (submit) submit.hidden = steps.length > 1 && n !== steps.length - 1;
        if (bar) bar.style.width = Math.round((n + 1) / steps.length * 100) + '%';
        if (count) count.textContent = 'Step ' + (n + 1) + ' of ' + steps.length;
      }
      function check(step) {
        let firstBad = null;
        step.querySelectorAll('.cf-field').forEach(function (f) {
          const t = f.dataset.type, err = f.querySelector('.cf-error');
          let msg = '';
          const inputs = f.querySelectorAll('input:not([type=hidden]), select, textarea');
          let val = '';
          if (t === 'radio' || t === 'checkbox') val = f.querySelector('input:checked') ? 'x' : '';
          else if (t === 'photo') val = inputs[0].files && inputs[0].files.length ? 'x' : '';
          else val = (inputs[0].value || '').trim();
          if (f.dataset.required === '1' && !val) msg = t === 'radio' || t === 'checkbox' || t === 'select' || t === 'service' ? 'Please choose an option.' : 'This one is needed.';
          else if (t === 'email' && val && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) msg = 'That email address does not look right.';
          f.classList.toggle('bad', !!msg);
          err.hidden = !msg; err.textContent = msg;
          if (msg && !firstBad) firstBad = f;
        });
        if (firstBad) { const i = firstBad.querySelector('input, select, textarea'); if (i) i.focus({ preventScroll: true }); firstBad.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
        return !firstBad;
      }
      if (next) next.addEventListener('click', function () { if (check(steps[cur])) show(cur + 1); });
      if (back) back.addEventListener('click', function () { show(cur - 1); });
      form.addEventListener('submit', function (e) {
        for (let i = 0; i < steps.length; i++) {
          if (!check(steps[i])) { e.preventDefault(); show(i); check(steps[i]); return; }
        }
      });
      form.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && next && !next.hidden && e.target.tagName !== 'TEXTAREA') { e.preventDefault(); next.click(); }
      });
      show(0);
    });

    // highlight today's row in the hours section
    const dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    const today = dayNames[new Date().getDay()];
    document.querySelectorAll('.hours-row').forEach(row => {
      if (row.dataset.day && row.dataset.day.toLowerCase() === today.toLowerCase()) row.classList.add('today');
    });

    // Self-healing hero: stock-photo links occasionally go dead. If the hero
    // photo fails to load, fall back to the themed pattern background
    // instead of leaving a bare gray box.
    const heroBg = document.getElementById('heroBg');
    if (heroBg && heroBg.dataset.heroPhoto) {
      const probe = new Image();
      probe.onerror = () => {
        heroBg.classList.add('pattern');
        heroBg.style.removeProperty('--hero-photo');
      };
      probe.src = heroBg.dataset.heroPhoto;
    }

    // Hero slideshow (only when extra hero photos exist): fades between the photos,
    // pauses on hover, and does not auto-advance for people who prefer reduced motion.
    (function () {
      const heroEl = document.getElementById('hero');
      const slides = heroEl ? Array.prototype.slice.call(heroEl.querySelectorAll('.hero-slide')) : [];
      if (!slides.length) return;
      const base = document.getElementById('heroBg');
      const urls = [base && base.dataset.heroPhoto].concat(slides.map(function (s) { return s.dataset.photo; })).filter(Boolean);
      if (urls.length < 2) return;
      let i = 0, timer = null, hover = false;
      function load(el) { if (el && !el.dataset.loaded) { el.style.setProperty('--hero-photo', "url('" + el.dataset.photo + "')"); el.dataset.loaded = '1'; } }
      function show(n) {
        i = (n + urls.length) % urls.length;
        slides.forEach(function (s, k) { s.classList.toggle('on', k === i - 1); });
        load(slides[i % urls.length]); // warm up the next one
      }
      load(slides[0]);
      const next = function () { show(i + 1); }, prev = function () { show(i - 1); };
      heroEl.querySelector('.hero-next').onclick = function () { next(); restart(); };
      heroEl.querySelector('.hero-prev').onclick = function () { prev(); restart(); };
      heroEl.addEventListener('mouseenter', function () { hover = true; });
      heroEl.addEventListener('mouseleave', function () { hover = false; });
      function restart() { clearInterval(timer); if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return; timer = setInterval(function () { if (!hover) next(); }, 6000); }
      slides.forEach(function (s, k) { if (k <= 1) load(s); });
      restart();
    })();

    // Same safety net for the About section's photo, if it has one: drop the
    // broken image and collapse back to the single-column text layout.
    document.querySelectorAll('img[data-fallback-hide]').forEach(img => {
      img.addEventListener('error', () => {
        const wrap = img.closest('[data-img-wrap]');
        const split = wrap?.closest('.about-split');
        wrap?.remove();
        split?.classList.add('no-photo');
      }, { once: true });
    });
  </script>

  <script>
