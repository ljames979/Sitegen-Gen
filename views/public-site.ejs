    document.querySelectorAll('.strip-wrap').forEach(function (w) {
      var strip = w.querySelector('.strip');
      w.querySelector('.strip-btn.prev').addEventListener('click', function () { strip.scrollBy({ left: -strip.clientWidth * 0.8 }); });
      w.querySelector('.strip-btn.next').addEventListener('click', function () { strip.scrollBy({ left: strip.clientWidth * 0.8 }); });
    });
  </script>

  <% if (page === 'book' && (!bookingView || bookingView.mode === 'form')) { %>
  <script>
    (function () {
      var form = document.getElementById('bookForm'); if (!form) return;
      var dateEl = document.getElementById('bookDate'), slotsEl = document.getElementById('bookSlots'), timeEl = document.getElementById('bookTime');
      var url = form.dataset.slots, wantTime = form.dataset.pickTime || '';
      function chosenService() { var r = form.querySelector('input[name=service]:checked'); return r ? r.value : ''; }
      function chosenAddons() { return Array.prototype.map.call(form.querySelectorAll('input[name=addon]:checked'), function (c) { return c.value; }); }
      var seq = 0;
      function load() {
        timeEl.value = wantTime; var svc = chosenService(), date = dateEl.value;
        if (!svc || !date) { slotsEl.innerHTML = '<p class="book-hint">Choose a service and a date to see open times.</p>'; return; }
        var my = ++seq; slotsEl.innerHTML = '<p class="book-hint">Checking open times…</p>';
        fetch(url + '?service=' + encodeURIComponent(svc) + '&date=' + encodeURIComponent(date) + '&addons=' + encodeURIComponent(chosenAddons().join('|')), { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
          .then(function (r) { return r.json(); }).then(function (d) {
            if (my !== seq) return; slotsEl.innerHTML = '';
            if (!d.slots || !d.slots.length) { slotsEl.innerHTML = '<p class="book-hint">No open times that day. Please try another date.</p>'; timeEl.value = ''; wantTime = ''; return; }
            d.slots.forEach(function (s) {
              var b = document.createElement('button'); b.type = 'button'; b.textContent = s.label; b.dataset.time = s.time;
              if (s.time === timeEl.value) b.className = 'on';
              b.addEventListener('click', function () {
                Array.prototype.forEach.call(slotsEl.children, function (x) { x.className = ''; });
                b.className = 'on'; timeEl.value = s.time; wantTime = s.time;
              });
              slotsEl.appendChild(b);
            });
            if (timeEl.value && !slotsEl.querySelector('.on')) { timeEl.value = ''; wantTime = ''; }
          }).catch(function () { if (my === seq) slotsEl.innerHTML = '<p class="book-hint">Could not load times. Please refresh and try again.</p>'; });
      }
      form.addEventListener('change', function (e) { if (e.target.name === 'service' || e.target.name === 'addon' || e.target.name === 'date') { if (e.target.name !== 'addon' || true) { wantTime = e.target.name === 'date' ? '' : wantTime; load(); } } });
      form.addEventListener('submit', function (e) { if (!timeEl.value) { e.preventDefault(); slotsEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); if (!slotsEl.querySelector('.err')) slotsEl.insertAdjacentHTML('afterbegin', '<p class="book-hint err" style="color:#dc2626;width:100%;">Please pick a time.</p>'); } });
      if (chosenService() && dateEl.value) load();
    })();
  </script>
  <% } %>

  <% { const ch = site.sections.chat || {};
       if (ch.enabled && !preview && !(typeof staticExport !== 'undefined' && staticExport) && !isThankYou) {
         const greet = ch.greeting || ('Hi! Ask a question about ' + site.name + '.'); %>
    <button type="button" class="chat-fab" id="chatFab" aria-expanded="false" aria-controls="chatPanel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>Chat</button>
    <div class="chat-panel" id="chatPanel" role="dialog" aria-label="Chat with <%= site.name %>" hidden>
      <div class="chat-head"><span>Ask <%= site.name %></span><button type="button" id="chatClose" aria-label="Close chat">&times;</button></div>
      <div class="chat-log" id="chatLog" aria-live="polite"><div class="chat-msg bot"><%= greet %></div></div>
      <div class="chat-note">Automated assistant: answers can be wrong. Please confirm important details with us.</div>
      <form class="chat-form" id="chatForm"><input type="text" id="chatInput" maxlength="500" placeholder="Type your question" aria-label="Your question" autocomplete="off"><button type="submit">Send</button></form>
      <button type="button" class="chat-link" id="chatLeadToggle">Rather have us contact you?</button>
      <form class="chat-lead" id="chatLead" hidden>
        <input type="text" name="name" placeholder="Your name" maxlength="100" autocomplete="name">
        <input type="text" name="phone" placeholder="Phone" maxlength="40" autocomplete="tel">
        <input type="email" name="email" placeholder="Email" maxlength="254" autocomplete="email">
        <textarea name="message" rows="2" maxlength="1000" placeholder="How can we help?"></textarea>
        <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute; left:-9999px;" aria-hidden="true">
        <button type="submit">Send to <%= site.name %></button>
      </form>
    </div>
    <script>
      (function () {
        var base = <%- JSON.stringify(basePath || '') %>;
        var fab = document.getElementById('chatFab'), panel = document.getElementById('chatPanel'), log = document.getElementById('chatLog');
        var form = document.getElementById('chatForm'), input = document.getElementById('chatInput'), lead = document.getElementById('chatLead');
        var hist = [], busy = false;
        function add(cls, text) { var d = document.createElement('div'); d.className = 'chat-msg ' + cls; d.textContent = text; log.appendChild(d); log.scrollTop = log.scrollHeight; return d; }
        function open(o) { panel.hidden = !o; fab.hidden = o; fab.setAttribute('aria-expanded', o); if (o) input.focus(); else fab.focus(); }
        fab.onclick = function () { open(true); };
        document.getElementById('chatClose').onclick = function () { open(false); };
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !panel.hidden) open(false); });
        document.getElementById('chatLeadToggle').onclick = function () { lead.hidden = !lead.hidden; if (!lead.hidden) lead.querySelector('input').focus(); };
        form.addEventListener('submit', function (e) {
          e.preventDefault(); var q = input.value.trim(); if (!q || busy) return;
          input.value = ''; add('me', q); hist.push({ role: 'user', content: q }); busy = true;
          var wait = add('bot', '…');
          fetch(base + '/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: hist }) })
            .then(function (r) { return r.json(); })
            .then(function (j) { var t = (j && j.reply) || 'Sorry, something went wrong. Please use the contact form.'; wait.textContent = t; hist.push({ role: 'assistant', content: t }); if (/leave your contact|contact information below|get back to you/i.test(t)) lead.hidden = false; })
            .catch(function () { wait.textContent = 'Sorry, something went wrong. Please use the contact form.'; })
            .then(function () { busy = false; log.scrollTop = log.scrollHeight; });
        });
        lead.addEventListener('submit', function (e) {
          e.preventDefault();
          var fd = new FormData(lead), body = { transcript: hist };
          fd.forEach(function (v, k) { body[k] = v; });
          fetch(base + '/chat/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
            .then(function (r) { return r.json(); })
            .then(function (j) { if (j && j.ok) { lead.hidden = true; lead.reset(); add('bot', 'Thank you. We received your details and will be in touch.'); } else add('bot', (j && j.error) || 'Please add a phone number or email.'); })
            .catch(function () { add('bot', 'Sorry, that did not send. Please try the contact form.'); });
        });
      })();
    </script>
  <% } } %>

