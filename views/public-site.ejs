  <% } else if (page === 'extra' && extra) { %>
    <section class="block" id="extra">
      <div class="wrap prose-wrap">
        <div class="crumbs"><a href="<%= homeHref %>">Home</a> &rsaquo; <%= extra.title %></div>
        <h1><%= extra.title %></h1>
        <div class="prose"><% extra.body.split(/\n{2,}/).forEach(para => { %><p><%= para %></p><% }) %></div>
      </div>
    </section>

  <% } else if (page === 'members') { %>
    <%- include('_members', { site, basePath, preview, memberView: (typeof memberView !== 'undefined' ? memberView : null) }) %>
  <% } else if (page === 'book') { %>
    <%- include('_book', { site, basePath, preview, bookingView: (typeof bookingView !== 'undefined' ? bookingView : null), homeHref }) %>

  <% } else if (page === 'review') { %>
    <section class="block" id="review">
      <div class="wrap">
        <div class="section-head" data-animate="fade-up">
          <div class="rule"></div>
          <h2>Leave a review</h2>
          <p class="section-sub">Your feedback helps <%= site.name %> and the neighbors who read it.</p>
        </div>
        <div class="contact-card review-form-card">
          <% const gUrl = site.sections.trust && site.sections.trust.googleReviewsUrl; %>
          <% if (reviewThanks) { %>
            <div class="form-flash success">Thank you! Your review was received<%= preview ? '' : ' and will appear on this site once it has been approved' %>.</div>
            <% if (gUrl) { %>
              <p style="text-align:center; margin:20px 0 0;">Want to share it on Google too?<br><a class="btn-google" href="<%= gUrl %>" target="_blank" rel="noopener" style="display:inline-block; margin-top:12px;">&#9733; Review us on Google</a></p>
            <% } %>
          <% } else { %>
            <% if (reviewError) { %><div class="form-flash error">Please choose a star rating and write at least a sentence.</div><% } %>
            <form method="POST" action="<%= basePath %>/review" class="contact-form" <%= preview ? 'onsubmit="return false;"' : '' %>>
              <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off">
              <label>Your rating</label>
              <div class="star-pick">
                <% [5,4,3,2,1].forEach(n => { %>
                  <input type="radio" name="rating" id="rate<%= n %>" value="<%= n %>" <%= n === 5 ? 'checked' : '' %>><label for="rate<%= n %>" title="<%= n %> star<%= n === 1 ? '' : 's' %>">&#9733;</label>
                <% }) %>
              </div>
              <label>Your name</label>
              <input type="text" name="name" maxlength="80" placeholder="First name and last initial is fine">
              <label>Your review</label>
              <textarea name="quote" maxlength="800" placeholder="What was your experience like?"></textarea>
              <button type="submit" class="btn" style="width:100%; margin-top:16px;">Submit review</button>
            </form>
          <% } %>
        </div>
      </div>
    </section>

  <% } else if (page === 'notfound') { %>
    <% const nfc = (site.sections.seo && site.sections.seo.notFound) || {}; %>
    <section class="block" id="not-found">
      <div class="wrap">
        <div class="thanks">
          <div class="check nf-code" aria-hidden="true">404</div>
          <h1><%= nfc.heading || 'We can\'t find that page' %></h1>
          <p><%= nfc.text || 'The link may be old or mistyped. Here are some places to go instead.' %></p>
          <div class="actions">
            <a class="btn" href="<%= homeHref %>">Back to home</a>
            <% navPages.filter(p => p.key !== 'contact').slice(0, 3).forEach(p => { %><a class="btn-outline" href="<%= p.href %>"><%= p.label %></a><% }) %>
            <% if (site.sections.contact.phone) { %><a class="btn-outline" href="tel:<%= site.sections.contact.phone.replace(/[^0-9+]/g, '') %>">Call <%= site.sections.contact.phone %></a><% } %>
          </div>
        </div>
      </div>
    </section>
  <% } else if (isCalcPage) { %>
    <section class="block calc-page" id="estimate">
      <div class="wrap">
        <div class="section-head" data-animate="fade-up"><div class="rule"></div><h1 style="margin:0;"><%= calcCfg.heading %></h1></div>
        <% if (calcCfg.intro) { %><p class="calc-intro"><%= calcCfg.intro %></p><% } %>
        <% if (estimateError) { %><p class="calc-err" role="alert"><%= estimateError %></p><% } %>
        <form method="POST" action="<%= basePath %>/estimate" class="calc-form" id="calcForm">
          <% calcCfg.fields.forEach((f, i) => { %>
            <div class="calc-q">
              <% if (f.type === 'select') { %>
                <label for="ce_<%= i %>"><%= f.label %><%= f.required ? ' *' : '' %></label>
                <select id="ce_<%= i %>" name="ce_<%= i %>" <%= f.required ? 'required' : '' %>><option value="">Choose...</option><% f.options.forEach((o, j) => { %><option value="<%= j %>"><%= o.label %></option><% }) %></select>
              <% } else if (f.type === 'radio') { %>
                <fieldset><legend><%= f.label %><%= f.required ? ' *' : '' %></legend>
                  <% f.options.forEach((o, j) => { %><label class="calc-opt"><input type="radio" name="ce_<%= i %>" value="<%= j %>" <%= f.required && j === 0 ? 'required' : '' %>> <%= o.label %></label><% }) %>
                </fieldset>
              <% } else if (f.type === 'number') { %>
                <label for="ce_<%= i %>"><%= f.label %><%= f.required ? ' *' : '' %></label>
                <input type="number" id="ce_<%= i %>" name="ce_<%= i %>" min="<%= f.min %>" max="<%= f.max %>" step="1" inputmode="numeric" <%= f.required ? 'required' : '' %>>
              <% } else { %>
                <label class="calc-opt"><input type="checkbox" name="ce_<%= i %>" value="1"> <%= f.label %></label>
              <% } %>
            </div>
          <% }) %>
          <% if (calcCfg.showPrice) { %>
            <div class="calc-result" id="calcResult" aria-live="polite" hidden><span class="calc-label">Estimated price</span><strong id="calcTotal"></strong></div>
            <p class="calc-note"><%= calcCfg.note || ('This is a rough estimate based on the options you chose, not a firm quote. ' + site.name + ' confirms the final price.') %></p>
          <% } else if (calcCfg.note) { %><p class="calc-note"><%= calcCfg.note %></p><% } %>
          <h3 class="calc-h">Where should we send it?</h3>
          <div class="calc-contact">
            <input type="text" name="name" placeholder="Your name" maxlength="100" autocomplete="name">
            <input type="email" name="email" placeholder="Email" maxlength="254" autocomplete="email">
            <input type="tel" name="phone" placeholder="Phone" maxlength="40" autocomplete="tel">
          </div>
          <textarea name="message" rows="3" maxlength="1000" placeholder="Anything else we should know? (optional)"></textarea>
          <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute; left:-9999px;" aria-hidden="true">
          <button type="submit" class="btn"><%= calcCfg.buttonText %></button>
        </form>
      </div>
    </section>
    <script>
      (function () {
        var cfg = <%- JSON.stringify({ base: calcCfg.basePrice, min: calcCfg.minimum, spread: calcCfg.spread, show: calcCfg.showPrice, fields: calcCfg.fields.map(function (f) { return { t: f.type, p: f.price, mn: f.min, mx: f.max, o: f.options.map(function (o) { return o.price; }) }; }) }).replace(/</g, '\u003c') %>;
        if (!cfg.show) return;
        var form = document.getElementById('calcForm'), box = document.getElementById('calcResult'), out = document.getElementById('calcTotal');
        function money(n) { return '$' + (Math.round(n) === n ? n.toLocaleString('en-US') : n.toFixed(2)); }
        function calc() {
          var total = cfg.base, any = false;
          cfg.fields.forEach(function (f, i) {
            var el = form.elements['ce_' + i]; if (!el) return;
            if (f.t === 'select') { var v = el.value; if (v !== '') { total += f.o[+v] || 0; any = true; } }
            else if (f.t === 'radio') { var r = form.querySelector('input[name="ce_' + i + '"]:checked'); if (r) { total += f.o[+r.value] || 0; any = true; } }
            else if (f.t === 'number') { var n = parseFloat(el.value); if (isFinite(n)) { n = Math.min(f.mx, Math.max(f.mn, n)); total += n * f.p; any = true; } }
            else if (el.checked) { total += f.p; any = true; }
          });
          if (!any) { box.hidden = true; return; }
          total = Math.max(total, cfg.min); total = Math.round(total * 100) / 100;
          var hi = cfg.spread ? Math.round(total * (1 + cfg.spread / 100) * 100) / 100 : total;
          out.textContent = hi > total ? money(total) + ' to ' + money(hi) : money(total);
          box.hidden = total <= 0;
        }
        form.addEventListener('input', calc); form.addEventListener('change', calc); calc();
      })();
    </script>
  <% } else if (isLegalPage) { %>
