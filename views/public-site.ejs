        <h1><%= post.title %></h1>
        <% if (post.date) { %><p class="post-date"><%= post.date %></p><% } %>
        <div class="prose"><% post.body.split(/\n{2,}/).forEach(para => { %><p><%= para %></p><% }) %></div>
        <% const otherPosts = posts.filter(x => x.slug !== post.slug).slice(0, 3); %>
        <% if (otherPosts.length) { %>
          <h3 style="margin: 36px 0 4px;">More from <%= site.sections.blog.heading %></h3>
          <div class="service-links">
            <% otherPosts.forEach(x => { %><a href="<%= basePath %>/blog/<%= x.slug %>"><%= x.title %></a><% }) %>
          </div>
        <% } %>
      </div>
