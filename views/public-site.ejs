  <% } else if (page === 'testimonials') { %>
    <section class="block" id="<%= page %>">
      <div class="wrap">
        <div class="section-head" data-animate="fade-up">
          <div class="rule"></div>
          <%- eb('testimonials') %><h2><%= site.sections.testimonials.heading %></h2>
        </div>
        <%- include('_google-reviews') %>
        <% const tWall = site.sections.testimonials.display === 'wall' && site.sections.testimonials.items.length >= 4; %>
        <% if (tWall) { %><%- include('_review-wall', { items: site.sections.testimonials.items.slice(0, 20) }) %><% } else { %>
        <% const tCar = site.sections.testimonials.display === 'carousel'; %>
        <% if (tCar) { %><div class="strip-wrap"><button type="button" class="strip-btn prev" aria-label="Previous reviews">&lsaquo;</button><% } %>
        <div class="<%= tCar ? 'strip t-carousel' : 'grid' %>"<%- tCar ? '' : ' data-sg-cards="testimonials"' %><%- tCar ? ' tabindex="0"' : '' %>>
          <% site.sections.testimonials.items.forEach(item => { %>
            <div class="card testimonial-card" data-animate="fade-up">
              <span class="quotemark">&ldquo;</span>
              <% if (item.rating) { %>
                <div class="stars"><%= '★'.repeat(item.rating) %><span class="stars-empty"><%= '★'.repeat(5 - item.rating) %></span></div>
