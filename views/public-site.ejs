                  <% if (item.title) { %><h3><%= item.title %></h3><% } %>
                  <% if (item.text) { %><p><%= item.text %></p><% } %>
                </div>
              <% }) %>
            </div>
          </section>
        <% } %>
        <% const lpFaq = ((site.sections.faq || {}).items || []).filter(f => f.question && f.answer).slice(0, 5); %>
        <% if (visible('faq') && lpFaq.length) { %>
          <section class="lp-faq">
            <div class="section-head" data-animate="fade-up"><div class="rule"></div><%- eb('faq') %><h2><%= site.sections.faq.heading %></h2></div>
            <div class="faq-list">
              <% lpFaq.forEach((item, i) => { %><details class="faq-item" data-animate="fade-up"><summary><%= item.question %></summary><p><%= item.answer %></p></details><% }) %>
            </div>
          </section>
        <% } %>
        <% const lpAreas = (site.sections.trust && site.sections.trust.serviceAreas) || []; %>
        <% if (lpAreas.length) { %>
          <section class="lp-areas">
            <div class="section-head" data-animate="fade-up"><div class="rule"></div><h2>Areas we serve</h2></div>
            <div class="area-chips" style="justify-content:center;"><% lpAreas.slice(0, 30).forEach(a => { %><span class="area-chip"><%= a %></span><% }) %></div>
          </section>
        <% } %>
        <% if (!(typeof staticExport !== 'undefined' && staticExport) && site.sections.contact.acceptSubmissions) { %>
          <section class="lp-quote">
            <div class="section-head" data-animate="fade-up"><div class="rule"></div><h2>Get a free quote</h2></div>
            <%- include('_quote-card', { site, basePath, preview, services, visible, subject: 'Home page', selected: '', staticExport: false }) %>
          </section>
        <% } %>
      <% } %>
    <% } %>
    <% if (site.sections.gallery.images.length >= 1) { %>
      <section class="featured-row<%= layoutName === 'photos' ? ' featured-big' : '' %>">
