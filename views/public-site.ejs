            <% if (navPages.some(p => p.key === 'testimonials')) { %><a class="btn" href="<%= basePath %>/testimonials">View all reviews</a><% } %>
            <% if (site.sections.trust && site.sections.trust.googleReviewsUrl) { %> <a class="btn-google" href="<%= site.sections.trust.googleReviewsUrl %>" target="_blank" rel="noopener">&#9733; Read more on Google</a><% } %>
          </p>
        </section>
      <% } %>
      <% if (layoutName === 'localpro') { %>
