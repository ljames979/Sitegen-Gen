                <% otherAreas.forEach(a => { %>
                  <% if (a.text) { %><a class="area-chip" href="<%= basePath %>/areas/<%= a.slug %>"><%= a.name %></a><% } else { %><span class="area-chip"><%= a.name %></span><% } %>
                <% }) %>
              </div>
            <% } %>
          </div>
          <%- include('_quote-card', { site, basePath, preview, services, visible, subject: area.name, selected: '', staticExport: (typeof staticExport !== 'undefined' && staticExport) }) %>
