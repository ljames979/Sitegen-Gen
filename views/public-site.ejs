              <div class="score"><%= avg.toFixed(1) %> out of 5 stars</div>
              <div class="count"><%= rated.length %> review<%= rated.length === 1 ? '' : 's' %> shown on this site</div>
              <% if (!(typeof staticExport !== 'undefined' && staticExport)) { %><a class="btn" href="<%= basePath %>/review">Write a review</a><% } %>
            </div>
          <% } %>
          <% const hWall = site.sections.testimonials.display === 'wall' && revs.length >= 4; %>
          <% if (hWall) { %><%- include('_review-wall', { items: revs.slice(0, 16) }) %><% } else { %>
          <% const hCar = site.sections.testimonials.display === 'carousel'; %>
