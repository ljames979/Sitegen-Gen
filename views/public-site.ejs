        <a class="nav-cta" href="<%= basePath %>/book">Book Now</a>
      <% } else if (visible('contact')) { %>
        <% if (site.sections.contact.phone) { %><a class="nav-cta" href="tel:<%= site.sections.contact.phone.replace(/[^0-9+]/g, '') %>">Call Now</a>
        <% } else { %><a class="nav-cta" href="<%= basePath %>/contact">Contact</a><% } %>
      <% } %>
    </div>
    <% if (menuStyles.usesPanel(site.theme.menuStyle) && navPages.length && !site.theme.hideMenu) { %>
    <button type="button" class="sg-mnu-btn" id="sgMnuBtn" aria-expanded="false" aria-controls="sgMnuPanel" aria-label="Open the menu"><span></span><span></span><span></span></button>
    <div class="sg-mnu-panel" id="sgMnuPanel" hidden>
      <button type="button" class="sg-mnu-close" aria-label="Close the menu">&times;</button>
      <nav class="sg-mnu-links" aria-label="Menu"><% navPages.forEach(p => { %><a href="<%= p.href %>"<%- page === p.key ? ' aria-current="page"' : '' %>><%= p.label %></a><% }) %></nav>
    </div>
    <% } %>
  </nav>

  <main id="main">
  <% const blkPage = ['about', 'services', 'testimonials', 'whyChoose', 'gallery', 'faq', 'blog', 'hours', 'contact'].includes(page) ? page : ''; %>
  <% if (blkPage) { %><%- include('_blocks', { site, place: 'top', pageKey: blkPage }) %><% } %>
  <% if (page === 'home' && mixHome) { %>
    <%# the owner's own sections sit right after the block they chose ("Where it goes"), and blocks set near the top
        sit right under the first block (the top banner); the rest follow at the end %>
    <% const _mixFamsOn = mixHome.items.map(it => it.f);
       const _csAt = i => i.family === 'custom' ? (i.after === 'top' ? 0 : _mixFamsOn.indexOf(i.after)) : -1;
       const _csEnd = customTail.filter(i => i.family !== 'custom' || i.after === 'end' || _csAt(i) < 0);
       // content blocks that are blocks of this page are drawn in their spot, not again at the top or bottom
       const _mixBlk = ((site.theme && site.theme.mix) || []).filter(m => m && m.k === 'blk').map(m => m.v); %>
    <% mixHome.items.forEach((it, n) => { const _pin = pinFx.attrs(it.pin), _film = filmFx.attrs(it.film, site.theme), _ix = imgFx.attrs(it.imgfx), _ht = heightFx.attrs(it.height), _gl = glassFx.attrs(it.glass), _sc = sceneDecor.attrs(it.scene); %><div class="sg-mix<%= _pin.cls %><%= _film.cls %><%= _ix.cls %><%= _ht.cls %><%= _gl.cls %><%= _sc.cls %>"<% if (it.a) { %> id="<%= it.a %>"<% } %> data-mix-i="<%= it.i %>" data-mix-f="<%= it.f %>"<% if (it.xfx) { %> data-xfx="<%= it.xfx.join(' ') %>"<% } %><% if (_pin.style || _film.style || _ht.style || _sc.style) { %> style="<%= [_pin.style, _film.style, _ht.style, _sc.style].filter(Boolean).join(' ') %>"<% } %>><% if (it.lib) { %><%- include('_lib-section', { item: it.lib }) %><% } else if (it.blk) { %><%- include('_blocks', { site, only: it.blk }) %><% } else { %><%- it.html %><% } %><%- sceneDecor.html(it.scene) %></div>
    <% if (n === 0) { %><%- include('_blocks', { site, place: 'top', skipIds: _mixBlk }) %><% } %>
    <% customTail.filter(i => i.after !== 'end' && _csAt(i) === n).forEach(i => { %><%- include('_lib-section', { item: i }) %>
    <% }) %>
    <% }) %>
    <% if (!mixHome.items.length && !_blkFirst && typeof preview !== 'undefined' && preview) { %><section class="sg-mix-empty" style="padding:4rem 1rem;text-align:center;opacity:.7">This block has nothing to show yet: add the content it needs in the editor.</section><% } %>
    <% if (!mixHome.items.length) { %><%- include('_blocks', { site, place: 'top', skipIds: _mixBlk }) %><% } %>
    <% _csEnd.forEach(i => { %><%- include('_lib-section', { item: i }) %>
    <% }) %>
    <%- include('_blocks', { site, place: 'bottom', skipIds: _mixBlk }) %>
  <% } else if (page === 'home' && sigHome) { %>
    <%- sigHome.html %>
    <%- include('_blocks', { site, place: 'top' }) %>
    <% customTail.forEach(i => { %><%- include('_lib-section', { item: i }) %>
    <% }) %>
    <%- include('_blocks', { site, place: 'bottom' }) %>
  <% } else if (page === 'home') { %>
    <% const hv = site.sections.hero.videoUrl ? videoInfo(site.sections.hero.videoUrl) : null; const hvOn = !!(hv && hv.kind === 'file' && site.sections.hero.imageUrl); const hOv = parseInt(site.sections.hero.overlay, 10) || 0; %>
    <% if (bpHero) { %><%- include('_lib-section', { item: bpHero }) %><% } else { %>
    <div class="hero<%= site.sections.hero.edge === 'wave' || site.sections.hero.edge === 'scallop' ? ' edge-' + site.sections.hero.edge : '' %>" id="hero" style="--fx: <%= +site.sections.hero.focalX >= 0 ? +site.sections.hero.focalX : 50 %>%; --fy: <%= +site.sections.hero.focalY >= 0 ? +site.sections.hero.focalY : 50 %>%;<% if (hOv) { %> --ov-b: <%= (hOv / 100).toFixed(2) %>; --ov-t: <%= (hOv / 200).toFixed(2) %>;<% } %>">
      <% if (site.sections.hero.imageUrl) { %>
        <div class="hero-bg" id="heroBg" data-animate="scene" style="--hero-photo: url('<%= site.sections.hero.imageUrl %>')" data-hero-photo="<%= site.sections.hero.imageUrl %>"></div>
        <% const heroSlides = (site.sections.hero.slides || []).filter(Boolean); %>
        <% if (heroSlides.length) { %>
          <% heroSlides.forEach(u => { %><div class="hero-bg hero-slide" data-photo="<%= u %>" aria-hidden="true"></div><% }) %>
          <div class="hero-controls">
            <button type="button" class="hero-prev" aria-label="Previous photo">&lsaquo;</button>
            <button type="button" class="hero-next" aria-label="Next photo">&rsaquo;</button>
          </div>
        <% } %>
      <% } else { %>
        <div class="hero-bg pattern"></div>
      <% } %>
      <% if (hvOn) { %><video class="hero-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1" src="<%= hv.src %>"></video><div class="hero-vov"></div><% } %>
      <% if (heroFx) { %><canvas class="hero-fx" aria-hidden="true" data-fx="<%= heroFx %>" data-emoji="<%= accEmoji || '✨' %>" data-colors="#ffffff,<%= site.theme.primaryColor %>,<%= site.theme.accentColor %>"></canvas><% } %>
      <div class="hero-inner">
        <% if (mIcons[0]) { %><div data-animate="fade-up"><span class="sg-lottie" data-lottie="<%= mIcons[0] %>" aria-hidden="true"></span></div><% } %>
        <% if (locationLine) { %><div class="hero-eyebrow" data-animate="fade-up"><%= locationLine %></div><% } %>
        <h1 data-animate="hero"><%- hlHtml(site.sections.hero.headline) %></h1>
        <p data-animate="fade-up" data-delay="0.15"><%= site.sections.hero.subheadline %></p>
        <% if (site.sections.hero.ctaText) { %>
          <a class="btn" data-animate="fade-up" data-delay="0.25" href="<%= site.sections.hero.ctaLink && site.sections.hero.ctaLink !== '#contact' ? site.sections.hero.ctaLink : (basePath + '/contact') %>"><%= site.sections.hero.ctaText %></a>
        <% } %>
        <% const trustItems = (site.sections.hero.trustText || '').split('•').map(s => s.trim()).filter(Boolean); %>
        <% if (trustItems.length) { %>
          <ul class="hero-trust" data-animate="fade-up" data-delay="0.35">
            <% trustItems.forEach(item => { %>
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg><%= item %></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
      <%- include('_stickers', { list: site.sections.hero.stickers }) %>
    </div>
    <% } %>
    <% if (page === 'home' && site.sections.hero.quickLinks) {
         const qlStatic = typeof staticExport !== 'undefined' && staticExport;
         const qlItems = [];
         const navHref = (k) => { const p = navPages.find(x => x.key === k); return p ? p.href : ''; };
         if (site.sections.booking && site.sections.booking.enabled && !qlStatic) qlItems.push(['Book', basePath + '/book']);
         if (navHref('services')) qlItems.push(['Services', navHref('services')]);
         if (navHref('about')) qlItems.push(['About', navHref('about')]);
         if (navHref('testimonials')) qlItems.push(['Reviews', navHref('testimonials')]);
         if (site.sections.contact.homeMap && (site.sections.contact.address || (site.sections.trust && site.sections.trust.serviceAreas && site.sections.trust.serviceAreas.length))) qlItems.push(['Location', '#where-we-work']);
         if (navHref('contact')) qlItems.push(['Contact', navHref('contact')]);
         if (qlItems.length) { %>
      <nav class="quick-links" aria-label="Jump to"><% qlItems.slice(0, 6).forEach(q => { %><a href="<%= q[1] %>"><%= q[0] %></a><% }) %></nav>
    <% } } %>
    <% const heroCards = (bpHero && bpHero.variant === 'scrim') ? [] : (site.sections.hero.cards || []).filter(c => c.title); %>
    <% if (heroCards.length) { %>
      <section class="hero-cards-wrap">
        <div class="hero-cards n<%= heroCards.length %>">
          <% heroCards.forEach(c => { %>
            <div class="hero-card">
              <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- icons.iconPath(c.title, '') %></svg>
              <strong><%= c.title %></strong>
              <% if (c.text) { %><p><%= c.text %></p><% } %>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>
    <% if (layoutName === 'full' && visible('services') && services.length) { %>
      <nav class="home-tiles" aria-label="Services">
        <% services.slice(0, 8).forEach((sv, i, arr) => { %>
          <a class="home-tile" style="--t: <%= arr.length > 1 ? (i / (arr.length - 1)).toFixed(2) : 0 %>" href="<%= basePath %>/services/<%= sv.slug %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- icons.iconPath(sv.title, sv.icon) %></svg>
            <span><%= sv.title %></span>
          </a>
        <% }) %>
      </nav>
    <% } %>
    <%- include('_blocks', { site, place: 'top' }) %>
    <% if (bp) { %>
      <% bp.items.filter(i => i.family !== 'hero').forEach(i => { %><%- include('_lib-section', { item: i, icon: i.family === 'services' ? (mIcons[1] || '') : '' }) %>
      <% }) %>
    <% } else { %>
    <% const T = site.sections.trust || { badges: [], stats: [], serviceAreas: [], googleReviewsUrl: '' }; %>
    <% if (T.badges.length || T.stats.length || T.googleReviewsUrl) { %>
      <section class="trust-strip">
        <div class="trust-strip-inner" data-animate="stagger">
          <% T.stats.forEach(st => { %>
            <div class="trust-stat"><strong<%- motionLib.countAttrs(st.value) %>><%= st.value %></strong><span><%= st.label %></span></div>
          <% }) %>
          <% if (T.badges.length) { %>
            <div class="trust-badges">
              <% T.badges.forEach(bd => { %>
                <span class="trust-badge"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg><%= bd %></span>
              <% }) %>
            </div>
          <% } %>
          <% if (T.googleReviewsUrl) { %>
            <a class="btn-google" href="<%= T.googleReviewsUrl %>" target="_blank" rel="noopener">&#9733; Read our Google reviews</a>
