        <div class="logo-row" data-animate="fade-up">
          <% logoList.forEach(l => { %><img src="<%= l.imageUrl %>" alt="<%= l.label || 'Logo' %>" loading="lazy" decoding="async"><% }) %>
        </div>
      </section>
    <% } %>
    <% if (homeFull) { %>
      <% const aboutText = (site.sections.about.body || '').trim(); %>
      <% if (visible('about') && aboutText && !['servicesfirst', 'photos'].includes(layoutName)) { %>
        <section class="home-intro<%= withPhotoIntro && site.sections.about.imageUrl ? ' with-photo' : '' %>">
          <% if (withPhotoIntro && site.sections.about.imageUrl) { %><div class="intro-photo" data-animate="fade-up"><img src="<%= site.sections.about.imageUrl %>" alt="<%= site.sections.about.imageAlt || site.name %>" loading="lazy" decoding="async"></div><% } %>
          <div class="intro-text">
          <div class="section-head" data-animate="fade-up"><div class="rule"></div><%- eb('about') %><h2><%= site.sections.about.heading %></h2></div>
          <p data-animate="fade-up"><%= aboutText.length > 480 ? aboutText.slice(0, 480).replace(/\s+\S*$/, '') + '…' : aboutText %></p>
          <% if (navPages.some(p => p.key === 'about')) { %><p class="more"><a href="<%= basePath %>/about">Learn more about us &rarr;</a></p><% } %>
          </div>
        </section>
      <% } %>
      <% if (visible('services') && services.length) { %>
        <section class="home-services">
          <div class="section-head" data-animate="fade-up"><% if (mIcons[1]) { %><span class="sg-lottie sm" data-lottie="<%= mIcons[1] %>" aria-hidden="true"></span><% } %><div class="rule"></div><%- eb('services') %><h2><%= site.sections.services.heading %></h2></div>
          <% if (rowsLayout) { %>
          <div class="svc-rows">
            <% services.slice(0, 6).forEach((sv, i) => { %>
              <div class="svc-row<%= i % 2 ? ' flip' : '' %>" data-animate="fade-up">
                <a class="pic" href="<%= basePath %>/services/<%= sv.slug %>" aria-hidden="true" tabindex="-1">
                  <% if (sv.imageUrl) { %><img src="<%= sv.imageUrl %>" alt="" loading="lazy" decoding="async"><% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><%- icons.iconPath(sv.title, sv.icon) %></svg><% } %>
                </a>
                <div class="txt"><h3><%= sv.title %></h3><p><%= sv.description %></p><a class="more" href="<%= basePath %>/services/<%= sv.slug %>">Read more &rarr;</a></div>
              </div>
            <% }) %>
          </div>
          <% } else if (tilesLayout) { %>
          <div class="svc-tiles n<%= Math.min(services.length, 6) %>">
            <% services.slice(0, 6).forEach(sv => { %>
              <a class="svc-tile" href="<%= basePath %>/services/<%= sv.slug %>" data-animate="fade-up">
                <% if (sv.imageUrl) { %><img src="<%= sv.imageUrl %>" alt="" loading="lazy" decoding="async"><% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><%- icons.iconPath(sv.title, sv.icon) %></svg><% } %>
                <span class="cap"><strong><%= sv.title %></strong><em><%= sv.description %></em></span>
              </a>
            <% }) %>
          </div>
          <% } else if (listLayout) { %>
          <ol class="svc-list">
            <% services.slice(0, 8).forEach((sv, i) => { %>
              <li data-animate="fade-up"><a href="<%= basePath %>/services/<%= sv.slug %>"><span class="n"><%= String(i + 1).padStart(2, '0') %></span><span class="t"><strong><%= sv.title %></strong><em><%= sv.description %></em></span><span class="go" aria-hidden="true">&rarr;</span></a></li>
            <% }) %>
          </ol>
          <% } else { %>
          <div class="home-svc-grid" data-sg-cards="services">
            <% services.slice(0, 6).forEach(sv => { %>
              <div class="home-svc" data-animate="fade-up">
                <a class="pic" href="<%= basePath %>/services/<%= sv.slug %>" aria-hidden="true" tabindex="-1">
                  <% if (sv.imageUrl) { %><img src="<%= sv.imageUrl %>" alt="" loading="lazy" decoding="async"><% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><%- icons.iconPath(sv.title, sv.icon) %></svg><% } %>
                </a>
                <h3><%= sv.title %></h3>
                <p><%= sv.description %></p>
                <a class="more" href="<%= basePath %>/services/<%= sv.slug %>">Read more</a>
              </div>
            <% }) %>
          </div>
          <% } %>
        </section>
      <% } %>
      <% const revs = (site.sections.testimonials.items || []).filter(r => r.quote); %>
      <% const gHome = (typeof googleData !== 'undefined' && googleData); %>
      <% if (visible('testimonials') && (revs.length || (gHome && gHome.showReviews))) { %>
        <% const rated = revs.filter(r => r.rating); const avg = rated.length ? rated.reduce((a, r) => a + r.rating, 0) / rated.length : 0; %>
        <section class="home-reviews">
          <div class="section-head" data-animate="fade-up"><div class="rule"></div><%- eb('testimonials') %><h2><%= site.sections.testimonials.heading %></h2></div>
