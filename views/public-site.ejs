      raf = 0; if (!visible) return;
      ctx.clearRect(0, 0, W, H);
      for (var i = 0; i < ps.length; i++) {
        var p = ps[i]; p.t += 0.02; p.r += p.vr; p.y -= p.vy;
        var x = p.x + Math.sin(p.t + p.ph) * (kind === 'sparkles' ? 0 : p.sw);
        var edge = Math.min(1, Math.max(0, kind === 'confetti' ? Math.min(p.y + 20, H - p.y) / 60 : Math.min(H - p.y, p.y) / 90));
        if (kind === 'emoji') { ctx.globalAlpha = 0.85 * edge; ctx.font = p.s + 'px serif'; ctx.textBaseline = 'middle'; ctx.textAlign = 'center'; ctx.fillText(p.e, x, p.y); }
        else if (kind === 'bubbles') { ctx.globalAlpha = 0.9 * edge; ctx.beginPath(); ctx.arc(x, p.y, p.s, 0, 6.283); ctx.fillStyle = 'rgba(255,255,255,0.10)'; ctx.fill(); ctx.strokeStyle = 'rgba(255,255,255,0.55)'; ctx.lineWidth = 1.4; ctx.stroke(); ctx.beginPath(); ctx.arc(x - p.s * 0.35, p.y - p.s * 0.35, p.s * 0.16, 0, 6.283); ctx.fillStyle = 'rgba(255,255,255,0.7)'; ctx.fill(); }
        else if (kind === 'confetti') { ctx.save(); ctx.translate(x, p.y); ctx.rotate(p.r * 3); ctx.globalAlpha = 0.9 * edge; ctx.fillStyle = p.c; ctx.fillRect(-p.s / 2, -p.s / 4, p.s, p.s / 2); ctx.restore(); }
        else { ctx.fillStyle = p.c; star(p.x, p.y, p.s * (0.6 + 0.4 * Math.sin(p.t * 1.6 + p.ph)), 0.35 + 0.55 * Math.abs(Math.sin(p.t * 0.9 + p.ph))); }
        if (kind === 'confetti' ? p.y > H + 20 : (kind !== 'sparkles' && p.y < -40)) ps[i] = make(false);
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    }
    function start() { if (!raf && visible) raf = requestAnimationFrame(frame); }
    init(); start();
    var rt; window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(init, 200); });
    if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { visible = es[0].isIntersecting; if (visible) start(); }).observe(cv);
  })();
  </script>
  <% } %>
  <% if (openWeek) { %>
  <script>
  (function () {
    var b = document.getElementById('sgOpen'); if (!b) return;
    var w = JSON.parse(b.getAttribute('data-week')), tz = b.getAttribute('data-tz') || undefined;
    var DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    function fmt(m) { m = m % 1440; var h = Math.floor(m / 60), mm = m % 60; return (h % 12 || 12) + (mm ? ':' + (mm < 10 ? '0' : '') + mm : '') + (h < 12 ? ' AM' : ' PM'); }
    function update() {
      var p = {};
      try { new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; }); } catch (e) { return; }
      var d = DAYS.indexOf(p.weekday), m = (+p.hour % 24) * 60 + +p.minute; if (d < 0 || isNaN(m)) return;
      var until = null, allDay = false, next = null;
      (w[d] || []).forEach(function (r) { if (m >= r[0] && m < r[1]) { until = r[1]; allDay = r[0] === 0 && r[1] >= 1440; } else if (r[0] > m && (next === null || r[0] < next)) next = r[0]; });
      (w[(d + 6) % 7] || []).forEach(function (r) { if (r[1] > 1440 && m < r[1] - 1440) until = r[1] - 1440; });
      b.className = 'open-badge ' + (until !== null ? 'is-open' : 'is-closed');
      b.textContent = '';
      b.appendChild(document.createElement('i'));
      b.appendChild(document.createTextNode(until !== null ? 'Open now' : 'Closed now'));
      var more = until !== null ? (allDay ? '' : until === 1440 ? 'until midnight' : 'until ' + fmt(until)) : (next !== null ? 'opens ' + fmt(next) : '');
      if (more) { var s = document.createElement('small'); s.textContent = more; b.appendChild(s); }
      b.hidden = false;
    }
    update(); setInterval(update, 60000);
  })();
  </script>
  <% } %>
  <script>
  (function () {
    var sliders = document.querySelectorAll('.ba-slider'); if (!sliders.length) return;
    var still = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    sliders.forEach(function (s) {
      var r = s.querySelector('input');
      r.addEventListener('input', function () { s.style.setProperty('--pos', r.value + '%'); });
      if (still || !('IntersectionObserver' in window)) return;
      // a short sweep the first time it comes into view, so visitors see it can be dragged
      var io = new IntersectionObserver(function (es) {
        if (!es[0].isIntersecting) return; io.disconnect();
        var t0 = null;
        requestAnimationFrame(function step(t) {
          if (t0 === null) t0 = t; var k = Math.min(1, (t - t0) / 1400);
          var v = 50 + 22 * Math.sin(k * Math.PI * 2) * (1 - k);
          if (document.activeElement !== r) { s.style.setProperty('--pos', v + '%'); r.value = Math.round(v); }
          if (k < 1) requestAnimationFrame(step);
        });
      }, { threshold: 0.6 });
      io.observe(s);
    });
  })();
  </script>
  <% const _exp = typeof staticExport !== 'undefined' && staticExport; const _prev = typeof preview !== 'undefined' && preview; %>
  <% if (motionLevel !== 'none' || _prev) { %>
  <% if (mTier === 'standard') { %>
  <script src="<%= _exp ? '' : '/' %>sg-motion-lite.js" defer></script>
  <% } else { %>
  <script src="<%= _exp ? '' : '/' %>vendor/motion.js" defer></script>
  <script src="<%= _exp ? '' : '/' %>sitegen-motion.js" defer></script>
  <script src="<%= _exp ? '' : '/' %>sg-premium.js" defer></script>
  <% if (mTier === 'showcase') { %><script src="<%= _exp ? '' : '/' %>sg-shader.js" defer></script><% } %>
  <% } %>
  <% } %>
  <% if (bp || bpHero || customTail.length || (mixHome && mixHome.needs.lib) || _clBlk) { %><script src="<%= _exp ? '' : '/' %>sg-lib.js" defer></script><% } %>
  <% const _txPage = textBoxes.pageId(pageKey, { service: typeof service !== 'undefined' ? service : null, area: typeof area !== 'undefined' ? area : null, post: typeof post !== 'undefined' ? post : null, extra: typeof extra !== 'undefined' ? extra : null }), _tx = textBoxes.forPage(site, _txPage), _txFont = textBoxes.fontLink(_tx); %>
  <% if (_txFont) { %><link rel="stylesheet" href="<%= _txFont %>" data-sg-txfonts><% } %>
  <div class="sg-tx-src" data-sg-txpage="<%= _txPage %>" hidden><% _tx.forEach(t => { %><div class="sg-tx" data-sg-tx="<%= t.id %>" data-at="<%= t.at %>" style="<%= textBoxes.style(t) %>"><%= t.text %></div><% }) %><% picBoxes.forPage(site, _txPage).forEach(p => { %><%- picBoxes.html(p) %><% }) %></div>
  <script src="<%= _exp ? '' : '/' %>sg-fx.js" defer></script>
  <% const _smooth = smoothScroll.script(site.theme); if (_smooth) { %><script data-sg-smooth><%- _smooth.replace(/<\//g, '<\\/') %></script><% } %>
  <% if (((site.sections.blocks && site.sections.blocks.items) || []).some(b => b.type === 'video' && videoMask.masked(b.side))) { %><style data-sg-vm><%- videoMask.CSS %></style><%- videoMask.BLOB_SVG %><script data-sg-vm><%- videoMask.SCRIPT %></script><% } %>
  <% if (mixHome && mixHome.items.some(it => it.scene)) { %><style data-sg-scene><%- sceneDecor.CSS %></style><% } %>
  <% if (mixHome && mixHome.items.some(it => it.glass)) { %><style data-sg-glass><%- glassFx.CSS %></style><script data-sg-glass><%- glassFx.SCRIPT %></script><% } %>
  <% if (((site.sections.blocks && site.sections.blocks.items) || []).some(b => b.imgfx) || (mixHome && mixHome.items.some(it => it.imgfx))) { %><style data-sg-ix><%- imgFx.CSS %></style><script data-sg-ix><%- imgFx.SCRIPT %></script><% } %>
  <% if (((site.sections.blocks && site.sections.blocks.items) || []).some(b => b.height) || (mixHome && mixHome.items.some(it => it.height))) { %><style data-sg-ht><%- heightFx.CSS %></style><% } %>
  <% if (((site.sections.blocks && site.sections.blocks.items) || []).some(b => b.film) || (mixHome && mixHome.items.some(it => it.film))) { %><style data-sg-film><%- filmFx.CSS %></style><% } %>
  <% if (((site.sections.blocks && site.sections.blocks.items) || []).some(b => b && b.type === 'decocard' && decoCard.parse(b.body).reveal)) { %><script data-sg-rv><%- decoCard.REVEAL_SCRIPT.replace(/<\//g, '<\\/') %></script><% } %>
  <% if (((site.sections.blocks && site.sections.blocks.items) || []).some(b => b.pin) || (mixHome && mixHome.items.some(it => it.pin))) { %><style data-sg-pin><%- pinFx.CSS %></style><script data-sg-pin><%- pinFx.SCRIPT %></script><% } %>
  <% const _sfx = scrollFx.script(site.theme); if (_sfx) { %><style data-sg-sfx><%- scrollFx.css(site.theme) %></style><script data-sg-sfx><%- _sfx.replace(/<\//g, '<\\/') %></script><% } %>
  <% if (extraFx.list(site.theme).length || _mixXfx.length) { %><style data-sg-xfx><%- extraFx.CSS %></style><script type="application/json" id="sg-xfx"><%- extraFx.data(site, page, _mixXfx) %></script><script data-sg-xfx><%- extraFx.SCRIPT.replace(/<\//g, '<\\/') %></script><% } %>
  <% const _split = splitText.script(site.theme); if (_split) { %><style data-sg-split><%- splitText.CSS %></style><script data-sg-split><%- _split.replace(/<\//g, '<\\/') %></script><% } %>
  <% if (_prev && !_exp && page === 'home' && !(typeof hideMotionBar !== 'undefined' && hideMotionBar)) { %>
  <div class="sg-motion-bar" role="group" aria-label="Motion style preview">
    <div class="sg-mb-label">Motion<small>Preview only</small></div>
    <div class="sg-mb-seg" aria-label="Motion level">
      <% motionLib.LEVELS.forEach(l => { %><button type="button" data-sg-tier="<%= l.id %>" aria-pressed="<%= l.id === mTier %>" title="<%= l.hint %>"><%= l.label %></button><% }) %>
    </div>
    <div class="sg-mb-seg">
      <% motionLib.PRESETS.forEach(pr => { %><button type="button" data-sg-preset="<%= pr.id %>" aria-pressed="<%= pr.id === motionLevel %>" title="<%= pr.hint %>"><%= pr.label %></button><% }) %>
    </div>
    <button type="button" class="sg-mb-replay" id="sgReplay">&#8635; Replay</button>
    <% if (site.id) { %><form method="POST" action="/sites/<%= site.id %>/motion" class="sg-mb-save"><input type="hidden" name="motionStyle" id="sgMotionPick" value="<%= motionLevel %>"><input type="hidden" name="motionLevel" id="sgTierPick" value="<%= mTier %>"><button type="submit" id="sgMotionSave" disabled>Use this</button></form><% } %>
  </div>
  <style>
    .sg-motion-bar { position: fixed; z-index: 2147483000; left: 50%; transform: translateX(-50%); bottom: 16px; max-width: calc(100% - 24px); background: #12302c; color: #e9f2ef; border-radius: 16px; padding: 10px 12px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; box-shadow: 0 18px 40px -16px rgba(0,0,0,.5); font: 13px/1.3 system-ui, sans-serif; }
    .sg-mb-label { font-weight: 700; padding: 0 6px; } .sg-mb-label small { display: block; font-weight: 400; color: #93ada7; font-size: 11px; }
    .sg-mb-seg { display: inline-flex; background: rgba(255,255,255,.12); border-radius: 10px; padding: 3px; }
    .sg-motion-bar button { font: inherit; font-weight: 700; border: 0; border-radius: 8px; padding: 9px 14px; min-height: 44px; cursor: pointer; background: transparent; color: inherit; }
    .sg-mb-seg button[aria-pressed="true"] { background: #f2b134; color: #1d1503; }
    .sg-mb-replay, .sg-mb-save button { border: 1px solid rgba(255,255,255,.35) !important; }
    .sg-mb-save button:not(:disabled) { background: #f2b134; color: #1d1503; border-color: #f2b134 !important; } .sg-mb-save button:disabled { opacity: .5; cursor: default; }
    .sg-mb-save { margin: 0; }
  </style>
  <script>
  (function () {
    var cur = document.body.getAttribute('data-motion') || 'none', start = cur;
    function startTierSame() { return '<%= mTier %>' === '<%= motionLib.resolveLevel(site.theme, site.sections.hero) %>'; }
    var btns = document.querySelectorAll('[data-sg-preset]');
    function apply(level, top) {
      cur = level; document.body.setAttribute('data-motion', level);
      btns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-sg-preset') === level)); });
      var pick = document.getElementById('sgMotionPick'), save = document.getElementById('sgMotionSave');
      if (pick) pick.value = level; if (save) save.disabled = (level === start && startTierSame());
      if (top) window.scrollTo({ top: 0, behavior: 'instant' });
      requestAnimationFrame(function () { if (window.SiteGenMotion) window.SiteGenMotion.init(level); });
    }
    btns.forEach(function (b) { b.addEventListener('click', function () { apply(b.getAttribute('data-sg-preset'), true); }); });
    // the level changes which scripts the page loads, so switching reloads the preview with ?tier=
    var startTier = '<%= mTier %>', savedTier = '<%= motionLib.resolveLevel(site.theme, site.sections.hero) %>';
    document.querySelectorAll('[data-sg-tier]').forEach(function (b) {
      b.addEventListener('click', function () {
        var u = new URL(location.href); u.searchParams.set('tier', b.getAttribute('data-sg-tier')); location.href = u.toString();
      });
    });
    (function () { var save = document.getElementById('sgMotionSave'); if (save && startTier !== savedTier) save.disabled = false; })();
    document.getElementById('sgReplay').addEventListener('click', function () { apply(cur, true); });
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) { var sm = document.querySelector('.sg-mb-label small'); if (sm) sm.textContent = 'This device has reduce-motion on, so nothing animates here'; }
  })();
  </script>
  <% } %>
  <%- include('_lookfeel-foot', { site }) %>
<% if (site.theme.pageGrad && site.theme.pageGradScroll) { %><script><%- gradients.SCROLL_JS %></script><% } %>
