<!DOCTYPE html>
<html>
<head>
  <title>First email — <%= p.name %> — SiteGen</title>
  <%- include('partials-head') %>
</head>
<body>
  <nav><div class="row"><a href="/prospects#p-<%= p.id %>" class="muted">&larr; Find new clients</a><strong>First email to <%= p.name %></strong></div></nav>
  <div class="container" style="max-width:760px;">
    <div class="card">
      <p class="muted" style="margin-top:0; font-size:14px;">A short first email to copy into your own email or a message. It only says what SiteGen actually found<%= p.website ? ' on their website' : '' %>. Change anything you like before you send it.<% if (!hasLink) { %> <strong>Make the demo and create its preview link first</strong> (Pitch &gt; Share), then come back: the link goes in by itself.<% } %></p>
      <% if (!p.email) { %><p class="muted" style="font-size:13px;">No email address is listed for them<%= p.phone ? `; you could call ${p.phone} or send this as a text or a Facebook message` : '' %>.</p><% } %>
      <textarea id="prMail" rows="16" style="width:100%; font: inherit;"><%= text %></textarea>
      <div class="row" style="gap:10px; margin-top:10px;">
        <button type="button" id="prCopy">Copy</button>
        <% if (p.email) { %><a class="btn btn-secondary" href="mailto:<%= p.email %>?subject=<%= encodeURIComponent('A new website for ' + p.name) %>">Open in my email</a><% } %>
      </div>
    </div>
  </div>
  <script>
    document.getElementById('prCopy').addEventListener('click', function () {
      var t = document.getElementById('prMail'); t.select();
      (navigator.clipboard ? navigator.clipboard.writeText(t.value) : Promise.reject()).then(function () {}, function () { document.execCommand('copy'); });
      this.textContent = 'Copied';
    });
  </script>
</body>
</html>
