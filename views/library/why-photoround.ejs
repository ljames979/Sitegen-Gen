<%# Adapted from Meraki UI (MIT) marketing/features "Grid list with image": the reasons in two columns, each under a small brand-color square, beside one large photo with a rounded edge. %>
<section class="sg-lib" data-sg-section="why/photoround">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-6xl tw:px-4 tw:py-14 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="tw:grid tw:items-center tw:gap-12 <%= d.image ? 'tw:lg:grid-cols-[3fr_2fr]' : '' %>">
        <div>
          <div data-animate="fade-up">
            <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
            <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-bold tw:text-ink tw:sm:text-4xl"><%= d.heading %></h2>
            <div class="tw:mt-3 tw:flex tw:gap-1.5" aria-hidden="true"><span class="tw:h-1 tw:w-24 tw:rounded-full tw:bg-primary"></span><span class="tw:h-1 tw:w-3 tw:rounded-full tw:bg-primary"></span><span class="tw:h-1 tw:w-1 tw:rounded-full tw:bg-primary"></span></div>
          </div>
          <div class="tw:mt-10 tw:grid tw:gap-x-8 tw:gap-y-10 tw:sm:grid-cols-2" data-sg-cards data-animate="stagger">
            <% d.items.forEach(function (it, i) { %>
              <div>
                <span class="tw:inline-flex tw:size-10 tw:items-center tw:justify-center tw:rounded-lg tw:bg-primary/10 tw:font-heading tw:font-bold tw:text-primary" aria-hidden="true"><%= i + 1 %></span>
                <% if (it.title) { %><h3 class="tw:mt-4 tw:font-heading tw:text-lg tw:font-semibold tw:text-ink"><%= it.title %></h3><% } %>
                <% if (it.text) { %><p class="tw:mt-2 tw:text-sm/relaxed tw:text-pretty tw:text-muted"><%= it.text %></p><% } %>
              </div>
            <% }) %>
          </div>
        </div>
        <% if (d.image) { %><img class="tw:aspect-square tw:w-full tw:rounded-[2.5rem] tw:object-cover tw:lg:rounded-full" src="<%= d.image %>" alt="" loading="lazy" data-animate="fade-up"><% } %>
      </div>
    </div>
  </div>
</section>
