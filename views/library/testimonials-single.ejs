<%# Adapted from HyperUI (MIT) marketing/testimonials: one big featured quote (uses the first review). %>
<section class="sg-lib" data-sg-section="testimonials/single">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-4xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <% var it = d.items[0]; %>
      <figure class="tw:text-center" data-animate="fade-up">
        <% if (d.heading) { %><p data-sg-head class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.heading %></p><% } %>
        <% if (it.rating) { %><p class="tw:text-primary" aria-label="<%= it.rating %> out of 5 stars"><%= "★".repeat(Math.round(it.rating)) %></p><% } %>
        <blockquote class="tw:mt-4 tw:font-heading tw:text-2xl/relaxed tw:text-balance tw:text-ink tw:sm:text-3xl/relaxed">&ldquo;<%= it.quote %>&rdquo;</blockquote>
        <figcaption class="tw:mt-6 tw:text-sm"><% if (it.photo) { %><img class="tw:mx-auto tw:mb-3 tw:block tw:size-14 tw:rounded-full tw:object-cover" src="<%= it.photo %>" alt="" loading="lazy" decoding="async"><% } %><span class="tw:font-medium tw:text-ink"><%= it.name %></span><% if (it.role) { %><span class="tw:text-muted"> &middot; <%= it.role %></span><% } %></figcaption>
      </figure>
      <% if (d.moreHref) { %><p class="tw:mt-8 tw:text-center"><a class="tw:font-medium tw:text-primary tw:underline-offset-4 tw:hover:underline" href="<%= d.moreHref %>"><%= d.moreText || 'Read more reviews' %> &rarr;</a></p><% } %>
    </div>
  </div>
</section>
