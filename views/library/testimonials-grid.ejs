<%# Adapted from HyperUI (MIT) marketing/testimonials: quote cards in a grid. %>
<section class="sg-lib" data-sg-section="testimonials/grid">
  <div class="tw:bg-surface">
    <div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="tw:mx-auto tw:max-w-3xl tw:text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-semibold tw:text-ink tw:sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="tw:mt-3 tw:text-pretty tw:text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="tw:mt-8 tw:grid tw:grid-cols-1 tw:gap-4 <%= ({ 1: 'tw:md:grid-cols-1', 2: 'tw:md:grid-cols-2', 3: 'tw:md:grid-cols-3' })[Math.min(d.items.length, 3)] %> tw:lg:gap-6" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <blockquote class="tw:flex tw:h-full tw:flex-col tw:rounded-xl tw:border tw:border-line tw:bg-page tw:p-6 tw:shadow-[var(--shadow-sm)]">
            <% if (it.rating) { %><p class="tw:text-primary" aria-label="<%= it.rating %> out of 5 stars"><%= "★".repeat(Math.round(it.rating)) %></p><% } %>
            <p class="tw:mt-2 tw:flex-1 tw:text-pretty tw:text-ink">&ldquo;<%= it.quote %>&rdquo;</p>
            <footer class="tw:mt-4 tw:flex tw:items-center tw:gap-3 tw:text-sm"><% if (it.photo) { %><img class="tw:size-10 tw:shrink-0 tw:rounded-full tw:object-cover" src="<%= it.photo %>" alt="" loading="lazy" decoding="async"><% } %><span><span class="tw:font-medium tw:text-ink"><%= it.name %></span><% if (it.role) { %><span class="tw:text-muted"> &middot; <%= it.role %></span><% } %></span></footer>
          </blockquote>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="tw:mt-8 tw:text-center"><a class="tw:font-medium tw:text-primary tw:underline-offset-4 tw:hover:underline" href="<%= d.moreHref %>"><%= d.moreText || 'Read more reviews' %> &rarr;</a></p><% } %>
    </div>
  </div>
</section>
