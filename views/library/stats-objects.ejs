<%# Original layout (number cards with moving objects, drawn from scratch): soft cards, each with a big number, its label and a small object drawn in the brand colors that loops in the corner. The object is picked from the label: a ticking clock for years, a turning gear for jobs, popping stars for reviews, a bouncing pin for towns, a house whose light comes on for homes, a soft pulse for anything else. Still for visitors who turn motion off. %>
<section class="sg-lib" data-sg-section="stats/objects">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-6xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-16">
      <dl class="tw:m-0 tw:grid tw:grid-cols-1 tw:gap-4 tw:sm:grid-cols-2 <%= d.items.length === 3 ? 'tw:lg:grid-cols-3' : '' %>" data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <div class="sg-ob-card tw:relative tw:overflow-hidden tw:rounded-2xl tw:border tw:border-line tw:bg-surface tw:p-7 tw:sm:p-8">
            <dd class="tw:m-0 tw:font-heading tw:text-5xl tw:font-bold tw:text-ink tw:sm:text-6xl"><span<%- it.countAttrs || '' %>><%= it.value %></span></dd>
            <dt class="sg-ob-label tw:mt-3 tw:text-pretty tw:text-muted"><%= it.label %></dt>
            <svg class="sg-ob sg-ob-<%= it.kind %>" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
              <% if (it.kind === 'clock') { %>
                <circle class="sg-ob-soft" cx="60" cy="60" r="54"></circle><circle class="sg-ob-face" cx="60" cy="60" r="42"></circle>
                <line class="sg-ob-hand sg-ob-hr" x1="60" y1="60" x2="60" y2="38"></line><line class="sg-ob-hand sg-ob-mn" x1="60" y1="60" x2="60" y2="26"></line><circle class="sg-ob-p" cx="60" cy="60" r="4"></circle>
              <% } else if (it.kind === 'gear') { %>
                <g class="sg-ob-spin"><circle class="sg-ob-teeth" cx="60" cy="60" r="43"></circle><circle class="sg-ob-p" cx="60" cy="60" r="38"></circle><circle class="sg-ob-soft" cx="60" cy="60" r="22"></circle><circle class="sg-ob-face" cx="60" cy="60" r="10"></circle></g>
              <% } else if (it.kind === 'stars') { %>
                <% [[38, 70, 1], [78, 46, 2], [86, 90, 3]].forEach(function (s) { %><g transform="translate(<%= s[0] %> <%= s[1] %>)"><polygon class="sg-ob-star sg-ob-s<%= s[2] %>" points="0,-18 5.3,-7.3 17.1,-5.6 8.6,2.8 10.6,14.6 0,9 -10.6,14.6 -8.6,2.8 -17.1,-5.6 -5.3,-7.3"></polygon></g><% }) %>
              <% } else if (it.kind === 'pin') { %>
                <ellipse class="sg-ob-soft sg-ob-shadow" cx="60" cy="106" rx="20" ry="5"></ellipse>
                <g class="sg-ob-bob"><path class="sg-ob-p" d="M60 14c-17 0-30 13-30 30 0 22 30 52 30 52s30-30 30-52c0-17-13-30-30-30z"></path><circle class="sg-ob-face" cx="60" cy="44" r="11"></circle></g>
              <% } else if (it.kind === 'house') { %>
                <polygon class="sg-ob-p" points="14,60 60,20 106,60 96,60 60,30 24,60"></polygon><rect class="sg-ob-soft" x="28" y="56" width="64" height="50" rx="3"></rect>
                <rect class="sg-ob-face sg-ob-win" x="38" y="66" width="18" height="16" rx="2"></rect><rect class="sg-ob-p" x="66" y="74" width="16" height="32" rx="2"></rect>
              <% } else { %>
                <circle class="sg-ob-ring" cx="60" cy="60" r="24"></circle><circle class="sg-ob-ring sg-ob-ring2" cx="60" cy="60" r="24"></circle><circle class="sg-ob-p" cx="60" cy="60" r="24"></circle>
              <% } %>
            </svg>
          </div>
        <% }) %>
      </dl>
    </div>
  </div>
</section>
