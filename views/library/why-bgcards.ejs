<%# Original layout (card variant): the reason's photo fills the card behind the words; cards without a photo use the brand color. %>
<section class="sg-lib" data-sg-section="why/bgcards">
  <div class="tw:bg-surface">
    <div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="tw:mx-auto tw:max-w-3xl tw:text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-semibold tw:text-ink tw:sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="tw:mt-3 tw:text-pretty tw:text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="tw:mt-8 tw:grid tw:grid-cols-1 tw:gap-5 tw:sm:grid-cols-2 <%= d.items.length === 3 ? 'tw:lg:grid-cols-3' : 'tw:lg:grid-cols-4' %>" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <div class="tw:relative tw:flex tw:min-h-72 tw:flex-col tw:justify-end tw:overflow-hidden tw:rounded-xl tw:p-6 tw:shadow-[var(--shadow-md)] <%= it.imageUrl ? 'tw:text-white' : 'tw:bg-primary tw:text-on-primary' %>">
            <% if (it.imageUrl) { %><img class="sg-noshape tw:absolute tw:inset-0 tw:size-full tw:object-cover" src="<%= it.imageUrl %>" alt="" loading="lazy" decoding="async"><span class="sg-shade tw:absolute tw:inset-0" aria-hidden="true"></span><% } %>
            <h3 class="tw:relative tw:font-heading tw:text-xl tw:font-semibold"><%= it.title %></h3><% if (it.text) { %><p class="tw:relative tw:mt-2 tw:text-sm/relaxed tw:text-pretty tw:opacity-90"><%= it.text %></p><% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>
