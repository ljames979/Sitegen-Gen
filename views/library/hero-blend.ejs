<%# Original layout ("Photo with the header blended in"): the owner's hero photo fills the top of the page and the header (name or logo and menu) sits right on it, see-through. A dark fade on the left keeps the words readable on any photo. A small letter-spaced label sits over a big headline whose [bracketed] words turn to an italic serif, then the subheadline and a round pill button. With no photo, a deep gradient in the brand colors takes its place. %>
<section class="sg-lib" data-sg-section="hero/blend">
  <% var trust = d.trust || []; %>
  <div class="sg-blend tw:relative tw:isolate tw:flex tw:items-end tw:overflow-hidden" style="<%= d.scrimVars || '' %>; --blend-focal: <%= d.focal || '50% 50%' %>; <%= d.pillVars || '' %>">
    <% if (d.image) { %>
      <img class="sg-blend-ph tw:absolute tw:inset-0 tw:-z-20 tw:size-full tw:object-cover" src="<%= d.image %>" alt="" fetchpriority="high" decoding="async">
    <% } else { %>
      <div class="sg-blend-sky tw:absolute tw:inset-0 tw:-z-20" aria-hidden="true"></div>
    <% } %>
    <div class="sg-blend-fade tw:absolute tw:inset-0 tw:-z-10" aria-hidden="true"></div>
    <div class="tw:mx-auto tw:w-full tw:max-w-7xl tw:px-4 tw:pt-40 tw:pb-20 tw:sm:px-6 tw:lg:px-8 tw:lg:pb-24">
      <div class="sg-blend-text tw:max-w-3xl tw:min-w-0 tw:text-white">
        <% if (d.eyebrow) { %><p class="sg-blend-eyebrow tw:m-0 tw:text-sm tw:text-white" data-animate="hero"><%= d.eyebrow %></p><% } %>
        <h1 class="sg-blend-h1 tw:mt-5 tw:font-heading tw:text-balance tw:text-white" data-animate="hero"><%- d.headlineHtml %></h1>
        <% if (d.sub) { %><p class="tw:mt-6 tw:max-w-xl tw:text-base tw:text-pretty tw:text-white tw:sm:text-lg/relaxed" data-animate="hero"><%= d.sub %></p><% } %>
        <div class="tw:mt-9 tw:flex tw:flex-wrap tw:items-center tw:gap-4" data-animate="hero">
          <a class="sg-blend-pill tw:inline-block tw:rounded-full tw:px-7 tw:py-4 tw:font-semibold" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
          <% if (d.phone) { %><a class="tw:inline-block tw:rounded-full tw:border tw:border-white/60 tw:px-6 tw:py-3.5 tw:font-medium tw:text-white tw:transition-colors tw:hover:bg-white/10" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
        </div>
        <% if (trust.length) { %>
          <ul class="tw:mt-8 tw:flex tw:list-none tw:flex-wrap tw:gap-x-6 tw:gap-y-2 tw:p-0 tw:text-sm tw:text-white" data-animate="hero">
            <% trust.forEach(function (t) { %><li class="tw:flex tw:items-center tw:gap-2"><svg class="tw:size-4 tw:shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><%= t %></li><% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
</section>
