<%# Adapted from Meraki UI (MIT) marketing/cta "Image": a big round photo beside the heading and two buttons side by side, one dark and one in the brand color. %>
<section class="sg-lib" data-sg-section="cta/circle">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-5xl tw:px-4 tw:py-14 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="tw:flex tw:flex-col tw:items-center tw:gap-10 <%= d.image ? 'tw:md:flex-row' : 'tw:text-center' %>" data-animate="fade-up">
        <% if (d.image) { %><img class="tw:size-64 tw:shrink-0 tw:rounded-full tw:object-cover tw:shadow-[var(--shadow-md)] tw:lg:size-80" src="<%= d.image %>" alt="" loading="lazy"><% } %>
        <div class="<%= d.image ? 'tw:text-center tw:md:text-left' : '' %>">
          <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-bold tw:text-ink tw:sm:text-4xl"><%= d.heading %></h2>
          <% if (d.text) { %><p class="tw:mt-3 tw:text-pretty tw:text-muted"><%= d.text %></p><% } %>
          <div class="tw:mt-7 tw:flex tw:flex-wrap tw:gap-3 <%= d.image ? 'tw:justify-center tw:md:justify-start' : 'tw:justify-center' %>">
            <a class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:bg-ink tw:px-6 tw:py-3 tw:text-sm tw:font-medium tw:text-page tw:transition-opacity tw:hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
            <% if (d.phone) { %><a class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:bg-primary tw:px-6 tw:py-3 tw:text-sm tw:font-medium tw:text-on-primary tw:transition-opacity tw:hover:opacity-90" href="tel:<%= d.phoneHref %>"><svg class="tw:size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>Call <%= d.phone %></a><% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
