<%# Adapted from Start Bootstrap Grayscale (MIT) contact cards: a brand-color icon, a small uppercase label, a short rule and the detail, on cards with a strong brand-color bottom edge. Only what the client gave us. %>
<section class="sg-lib" data-sg-section="contact/trio">
  <div class="tw:bg-surface">
    <div class="tw:mx-auto tw:max-w-6xl tw:px-4 tw:py-16 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="tw:mx-auto tw:max-w-3xl tw:text-center" data-animate="fade-up">
        <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-bold tw:tracking-[.12em] tw:text-ink tw:uppercase tw:sm:text-4xl"><%= d.heading %></h2>
      </div>
      <div class="tw:mt-10 tw:grid tw:grid-cols-1 tw:gap-6 tw:sm:grid-cols-2 <%= d.items.length >= 4 ? 'tw:lg:grid-cols-4' : d.items.length === 3 ? 'tw:lg:grid-cols-3' : '' %>" data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <a class="tw:block tw:rounded-md tw:border-b-4 tw:border-primary tw:bg-page tw:px-6 tw:py-8 tw:text-center tw:shadow-[var(--shadow-sm)] tw:transition-shadow tw:hover:shadow-[var(--shadow-md)]" href="<%= it.href %>"<%- it.kind === 'visit' ? ' target="_blank" rel="noopener"' : '' %>>
            <svg class="tw:mx-auto tw:size-8 tw:text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><% if (it.kind === "call") { %><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/><% } else if (it.kind === "text") { %><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><% } else if (it.kind === "email") { %><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/><% } else { %><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/><% } %></svg>
            <span class="tw:mt-4 tw:block tw:text-sm tw:font-bold tw:tracking-[.15em] tw:text-ink tw:uppercase"><%= it.label %></span>
            <hr class="tw:mx-auto tw:my-4 tw:h-0.5 tw:w-8 tw:border-0 tw:bg-primary">
            <span class="tw:block tw:text-sm tw:break-words tw:text-muted"><%= it.value %></span>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
</section>
