<%# Original layout (full map with a floating card): the map fills the section and the contact details sit on a card over it. No address, no map. %>
<section class="sg-lib" data-sg-section="contact/mapcard">
  <div class="tw:relative tw:bg-surface">
    <div class="sg-dock tw:relative tw:z-10 tw:mx-auto tw:flex tw:max-w-7xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:min-h-[32rem] tw:lg:items-center tw:lg:px-8 tw:lg:py-16 <%= d.mapSrc ? '' : 'tw:justify-center' %>">
      <div class="tw:w-full tw:max-w-md tw:rounded-xl tw:border tw:border-line tw:bg-page tw:p-6 tw:shadow-[var(--shadow-md)] tw:sm:p-8" data-animate="fade-up">
          <h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-semibold tw:text-ink tw:sm:text-3xl"><%= d.heading %></h2>
          <dl class="tw:mt-6 tw:space-y-3">
            <% d.items.forEach(function (it) { %>
              <div class="tw:flex tw:gap-3"><dt class="tw:w-16 tw:shrink-0 tw:text-sm tw:font-medium tw:tracking-wide tw:text-muted tw:uppercase"><%= it.label %></dt><dd class="tw:font-medium tw:text-ink"><% if (it.href) { %><a class="tw:text-primary tw:underline-offset-4 tw:hover:underline" href="<%= it.href %>"><%= it.value %></a><% } else { %><%= it.value %><% } %></dd></div>
            <% }) %>
          </dl>
          <% if (d.ctaHref) { %><p class="tw:mt-6"><a class="tw:inline-block tw:rounded-md tw:bg-primary tw:px-5 tw:py-3 tw:font-medium tw:text-on-primary tw:shadow-[var(--shadow-sm)] tw:transition-opacity tw:hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a></p><% } %>
      </div>
    </div>
    <% if (d.mapSrc) { %><iframe class="tw:block tw:h-72 tw:w-full tw:border-0 tw:lg:absolute tw:lg:inset-0 tw:lg:h-full" loading="lazy" title="Map of <%= d.address %>" src="<%= d.mapSrc %>"></iframe><% } %>
  </div>
</section>
