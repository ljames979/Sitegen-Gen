<%# Adapted from HyperUI (MIT) marketing/stats: a band of real numbers (only ones the client gave us). %>
<section class="sg-lib" data-sg-section="stats/band">
  <div class="tw:bg-primary">
    <div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-10 tw:sm:px-6 tw:lg:px-8 tw:lg:py-14">
      <dl class="tw:grid tw:grid-cols-2 tw:gap-6 tw:text-center <%= ({ 1: 'tw:lg:grid-cols-1', 2: 'tw:lg:grid-cols-2', 3: 'tw:lg:grid-cols-3', 4: 'tw:lg:grid-cols-4' })[Math.min(d.items.length, 4)] %>" data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <div>
            <dd class="tw:font-heading tw:text-3xl tw:font-bold tw:text-on-primary tw:sm:text-4xl"><span<%- it.countAttrs || '' %>><%= it.value %></span></dd>
            <dt class="tw:mt-1 tw:text-sm tw:text-on-primary tw:opacity-90"><%= it.label %></dt>
          </div>
        <% }) %>
      </dl>
    </div>
  </div>
</section>
