<%# Adapted from HyperUI (MIT) marketing/ctas/3: a rounded card floating on the page. %>
<section class="sg-lib" data-sg-section="cta/card">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-5xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-16">
      <div class="tw:flex tw:flex-col tw:items-start tw:justify-between tw:gap-6 tw:rounded-2xl tw:border tw:border-line tw:bg-surface tw:p-8 tw:shadow-[var(--shadow-md)] tw:md:flex-row tw:md:items-center tw:sm:p-10" data-animate="fade-up">
        <div class="tw:max-w-xl">
          <h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-semibold tw:text-ink tw:sm:text-3xl"><%= d.heading %></h2>
          <% if (d.text) { %><p class="tw:mt-2 tw:text-pretty tw:text-muted"><%= d.text %></p><% } %>
        </div>
        <div class="tw:flex tw:flex-wrap tw:gap-4">
          <a class="tw:inline-block tw:rounded-md tw:bg-primary tw:px-5 tw:py-3 tw:font-medium tw:text-on-primary tw:shadow-[var(--shadow-sm)] tw:transition-opacity tw:hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
          <% if (d.phone) { %><a class="tw:inline-block tw:rounded-md tw:border tw:border-line tw:bg-page tw:px-5 tw:py-3 tw:font-medium tw:text-ink tw:transition-colors tw:hover:bg-surface" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
        </div>
      </div>
    </div>
  </div>
</section>
