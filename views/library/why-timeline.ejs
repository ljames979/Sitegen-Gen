<%# Adapted from Start Bootstrap Agency (MIT) about timeline: each reason hangs off a center line in a big circle (its photo, or its number), the words swapping sides. On phones the line runs down the left. %>
<section class="sg-lib" data-sg-section="why/timeline">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-5xl tw:px-4 tw:py-16 tw:sm:px-6 tw:lg:px-8 tw:lg:py-24">
      <div class="tw:mx-auto tw:max-w-3xl tw:text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-bold tw:tracking-wide tw:text-ink tw:uppercase tw:sm:text-4xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="tw:mt-3 tw:text-lg tw:text-pretty tw:italic tw:text-muted"><%= d.intro %></p><% } %>
      </div>
      <ol class="sg-tl tw:mt-14" data-animate="stagger">
        <% d.items.forEach(function (it, i) { %>
          <li class="sg-tl-item">
            <span class="sg-tl-dot tw:font-heading tw:text-3xl tw:font-bold" aria-hidden="true"><% if (it.imageUrl) { %><img class="tw:h-full tw:w-full tw:object-cover" src="<%= it.imageUrl %>" alt="" loading="lazy"><% } else { %><%= i + 1 %><% } %></span>
            <div class="sg-tl-panel">
              <% if (it.title) { %><h3 class="tw:font-heading tw:text-xl tw:font-bold tw:text-ink"><%= it.title %></h3><% } %>
              <% if (it.text) { %><p class="tw:mt-2 tw:text-pretty tw:text-muted"><%= it.text %></p><% } %>
            </div>
          </li>
        <% }) %>
      </ol>
    </div>
  </div>
</section>
