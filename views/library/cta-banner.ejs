<%# Adapted from HyperUI (MIT) marketing/ctas/1: a full-width brand-color call to action. %>
<section class="sg-lib" data-sg-section="cta/banner">
  <div class="tw:bg-primary">
    <div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-16">
      <div class="tw:mx-auto tw:max-w-2xl tw:text-center" data-animate="fade-up">
        <h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-bold tw:text-on-primary tw:sm:text-3xl"><%= d.heading %></h2>
        <% if (d.text) { %><p class="tw:mt-3 tw:text-pretty tw:text-on-primary tw:opacity-90"><%= d.text %></p><% } %>
        <div class="tw:mt-6 tw:flex tw:flex-wrap tw:justify-center tw:gap-4">
          <a class="tw:inline-block tw:rounded-md tw:bg-page tw:px-5 tw:py-3 tw:font-medium tw:text-ink tw:shadow-[var(--shadow-sm)] tw:transition-opacity tw:hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
          <% if (d.phone) { %><a class="tw:inline-block tw:rounded-md tw:border tw:border-on-primary tw:px-5 tw:py-3 tw:font-medium tw:text-on-primary tw:transition-opacity tw:hover:opacity-80" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
        </div>
      </div>
    </div>
  </div>
</section>
