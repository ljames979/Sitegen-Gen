<%# Original layout (split call to action, drawn from scratch): brand panel with the phone number beside a quote card. %>
<section class="sg-lib" data-sg-section="cta/split">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-6xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-16">
      <div class="sg-flip tw:grid tw:grid-cols-1 tw:overflow-hidden tw:rounded-2xl tw:border tw:border-line tw:shadow-[var(--shadow-md)] tw:md:grid-cols-2" data-animate="fade-up">
        <div class="tw:bg-primary tw:p-8 tw:sm:p-10">
          <h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-bold tw:text-on-primary tw:sm:text-3xl"><%= d.heading %></h2>
          <% if (d.text) { %><p class="tw:mt-3 tw:text-pretty tw:text-on-primary tw:opacity-90"><%= d.text %></p><% } %>
          <% if (d.phone) { %><p class="tw:mt-6 tw:text-sm tw:text-on-primary tw:opacity-80">Prefer to talk?</p><a class="tw:font-heading tw:text-2xl tw:font-bold tw:text-on-primary tw:underline-offset-4 tw:hover:underline" href="tel:<%= d.phoneHref %>"><%= d.phone %></a><% } %>
        </div>
        <div class="tw:flex tw:flex-col tw:items-start tw:justify-center tw:gap-4 tw:bg-surface tw:p-8 tw:sm:p-10">
          <p class="tw:font-heading tw:text-lg tw:font-semibold tw:text-ink">Tell us what you need</p>
          <p class="tw:text-sm tw:text-pretty tw:text-muted">A few details is enough. We will get back to you.</p>
          <a class="tw:inline-block tw:rounded-md tw:bg-primary tw:px-5 tw:py-3 tw:font-medium tw:text-on-primary tw:shadow-[var(--shadow-sm)] tw:transition-opacity tw:hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
        </div>
      </div>
    </div>
  </div>
</section>
