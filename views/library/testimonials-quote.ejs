<%# Original layout (spotlight quote with an avatar strip, drawn from scratch): pick a reviewer to read their quote. Without JavaScript every quote shows in turn. Behavior in public/sg-lib.js. %>
<section class="sg-lib" data-sg-section="testimonials/quote">
  <div class="tw:bg-surface">
    <div class="tw:mx-auto tw:max-w-4xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20" data-sg-quotes>
      <% if (d.heading) { %><p data-sg-head class="tw:text-center tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase" data-animate="fade-up"><%= d.heading %></p><% } %>
      <% d.items.forEach(function (it, i) { %>
        <figure class="tw:mt-8 tw:text-center" data-sg-quote="<%= i %>">
          <% if (it.rating) { %><p class="tw:text-primary" aria-label="<%= it.rating %> out of 5 stars"><%= "★".repeat(Math.round(it.rating)) %></p><% } %>
          <blockquote class="tw:mt-3 tw:font-heading tw:text-2xl/relaxed tw:text-balance tw:text-ink tw:sm:text-3xl/relaxed">&ldquo;<%= it.quote %>&rdquo;</blockquote>
          <figcaption class="tw:mt-5 tw:text-sm"><% if (it.photo) { %><img class="tw:mx-auto tw:mb-3 tw:block tw:size-14 tw:rounded-full tw:object-cover" src="<%= it.photo %>" alt="" loading="lazy" decoding="async"><% } %><span class="tw:font-medium tw:text-ink"><%= it.name %></span><% if (it.role) { %><span class="tw:text-muted"> &middot; <%= it.role %></span><% } %></figcaption>
        </figure>
      <% }) %>
      <% if (d.items.length > 1) { %>
        <div data-sg-quote-nav hidden><div class="tw:mt-8 tw:flex tw:justify-center tw:gap-3" role="tablist" aria-label="Choose a review">
          <% d.items.forEach(function (it, i) { %>
            <button type="button" role="tab" class="tw:flex tw:size-11 tw:items-center tw:justify-center tw:rounded-full tw:border tw:border-line tw:bg-page tw:font-heading tw:text-sm tw:font-semibold tw:text-ink tw:transition-colors tw:hover:border-primary" aria-label="Review from <%= it.name || 'customer ' + (i + 1) %>" aria-selected="<%= i === 0 ? 'true' : 'false' %>" data-sg-quote-btn="<%= i %>"><%= (it.name || '?').trim().charAt(0).toUpperCase() %></button>
          <% }) %>
        </div></div>
      <% } %>
      <% if (d.moreHref) { %><p class="tw:mt-8 tw:text-center"><a class="tw:font-medium tw:text-primary tw:underline-offset-4 tw:hover:underline" href="<%= d.moreHref %>"><%= d.moreText || 'Read more reviews' %> &rarr;</a></p><% } %>
    </div>
  </div>
</section>
