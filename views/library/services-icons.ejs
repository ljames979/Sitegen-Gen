<%# Original layout (card variant): an icon on top of each card instead of a photo. %>
<section class="sg-lib" data-sg-section="services/icons">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="tw:mx-auto tw:max-w-3xl tw:text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-semibold tw:text-ink tw:sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="tw:mt-3 tw:text-pretty tw:text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="tw:mt-8 tw:grid tw:grid-cols-1 tw:gap-5 tw:sm:grid-cols-2 <%= d.items.length === 4 ? 'tw:lg:grid-cols-4' : 'tw:lg:grid-cols-3' %>" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <a class="tw:group tw:block tw:rounded-xl tw:border tw:border-line tw:bg-surface tw:p-6 tw:shadow-[var(--shadow-sm)] tw:transition-shadow tw:hover:shadow-[var(--shadow-md)]" href="<%= it.href %>">
            <span class="tw:flex tw:size-12 tw:items-center tw:justify-center tw:rounded-lg tw:bg-primary tw:text-on-primary" aria-hidden="true"><svg class="tw:size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- it.icon || '<polyline points="20 6 9 17 4 12"></polyline>' %></svg></span>
            <h3 class="tw:mt-4 tw:font-heading tw:text-lg tw:font-semibold tw:text-ink tw:group-hover:text-primary"><%= it.title %></h3>
            <% if (it.description) { %><p class="tw:mt-2 tw:text-sm/relaxed tw:text-pretty tw:text-muted"><%= it.description %></p><% } %>
            <% if (it.price) { %><p class="tw:mt-3 tw:text-sm tw:font-medium tw:text-primary"><%= it.price %></p><% } %>
          </a>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="tw:mt-8 tw:text-center"><a class="tw:font-medium tw:text-primary tw:underline-offset-4 tw:hover:underline" href="<%= d.moreHref %>">See all services &rarr;</a></p><% } %>
    </div>
  </div>
</section>
