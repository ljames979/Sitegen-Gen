<%# Original layout (fanned price cards, drawn from scratch): the priced services as cards laid out like a hand of cards, the middle one raised on the brand color and the side ones tilted. They fan out as the section scrolls into view; on phones they stack straight. %>
<% var n = d.items.length, mid = (n - 1) / 2; %>
<section class="sg-lib" data-sg-section="pricing/fan">
  <div class="tw:bg-page tw:overflow-hidden">
    <div class="tw:mx-auto tw:max-w-6xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="tw:mx-auto tw:max-w-3xl tw:text-center" data-animate="fade-up">
        <h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-semibold tw:text-ink tw:sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="tw:mt-3 tw:text-pretty tw:text-muted"><%= d.intro %></p><% } %>
      </div>
      <ul class="sg-pfan tw:m-0 tw:mt-12 tw:grid tw:list-none tw:grid-cols-1 tw:gap-6 tw:p-0 tw:md:gap-0 <%= n === 3 ? 'tw:md:grid-cols-3' : 'tw:md:grid-cols-2' %>" data-sg-progress>
        <% d.items.forEach(function (it, i) { var o = i - mid, top = n === 3 && i === 1; %>
          <li class="sg-pfan-card tw:flex tw:flex-col tw:rounded-2xl tw:p-8 <%= top ? 'sg-pfan-top tw:bg-primary tw:text-on-primary tw:shadow-[var(--shadow-md)]' : 'tw:border tw:border-line tw:bg-surface tw:text-ink tw:shadow-[var(--shadow-md)]' %>" style="--o:<%= o %>">
            <h3 class="tw:font-heading tw:text-xl tw:font-semibold"><%= it.title %></h3>
            <p class="tw:mt-4 tw:font-heading tw:text-4xl tw:font-bold <%= top ? '' : 'tw:text-primary' %>"><%= it.price %></p>
            <% if (it.description) { %><p class="tw:mt-4 tw:flex-1 tw:text-pretty <%= top ? 'tw:opacity-90' : 'tw:text-muted' %>"><%= it.description %></p><% } else { %><span class="tw:flex-1"></span><% } %>
            <a class="tw:mt-6 tw:inline-block tw:self-start tw:rounded-md tw:px-5 tw:py-3 tw:font-medium tw:transition-opacity tw:hover:opacity-90 <%= top ? 'tw:bg-page tw:text-ink' : 'tw:bg-primary tw:text-on-primary' %>" href="<%= it.href %>">Get started</a>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>
