<%# Adapted from Start Bootstrap Creative (MIT) masthead: a tall photo under a warm dark wash, a bold centered headline, a short brand-color rule, light words and a round button. %>
<section class="sg-lib" data-sg-section="hero/divider">
  <div class="tw:relative tw:isolate tw:flex tw:min-h-[min(100svh,58rem)] tw:items-center tw:overflow-hidden <%= d.image ? 'tw:bg-black' : 'tw:bg-primary' %>">
    <div class="tw:mx-auto tw:w-full tw:max-w-4xl tw:px-4 tw:py-24 tw:text-center tw:sm:px-6 tw:lg:px-8">
      <h1 class="tw:font-heading tw:text-4xl/tight tw:font-bold tw:sm:text-5xl/tight tw:lg:text-6xl/tight <%= d.image ? 'tw:text-white' : 'tw:text-on-primary' %>" data-animate="hero"><%- d.headlineHtml %></h1>
      <hr class="tw:mx-auto tw:mt-7 tw:h-1 tw:w-14 tw:border-0 <%= d.image ? 'tw:bg-primary' : 'tw:bg-on-primary' %>" data-animate="hero">
      <% if (d.sub) { %><p class="tw:mx-auto tw:mt-7 tw:max-w-2xl tw:text-lg tw:text-pretty tw:sm:text-xl/relaxed <%= d.image ? 'tw:text-white/75' : 'tw:text-on-primary' %>" data-animate="hero"><%= d.sub %></p><% } %>
      <div class="tw:mt-9 tw:flex tw:flex-wrap tw:justify-center tw:gap-4" data-animate="hero">
        <a class="tw:inline-block tw:rounded-full tw:px-9 tw:py-4 tw:font-bold tw:transition-opacity tw:hover:opacity-90 <%= d.image ? 'tw:bg-primary tw:text-on-primary' : 'tw:bg-page tw:text-ink' %>" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
        <% if (d.phone) { %><a class="tw:inline-block tw:rounded-full tw:border-2 tw:px-9 tw:py-4 tw:font-bold tw:transition-colors tw:hover:bg-white/10 <%= d.image ? 'tw:border-white/70 tw:text-white' : 'tw:border-current tw:text-on-primary' %>" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
      </div>
    </div>
    <% if (d.image) { %><img class="tw:absolute tw:inset-0 tw:-z-10 tw:h-full tw:w-full tw:object-cover" src="<%= d.image %>" alt="" fetchpriority="high" style="object-position: <%= d.focal %>"><div class="sg-cr-wash tw:absolute tw:inset-0 tw:-z-10"></div><% } %>
  </div>
</section>
