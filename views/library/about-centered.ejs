<%# Adapted from HyperUI (MIT) marketing/sections/4: a centered statement with a wide photo under it. %>
<section class="sg-lib" data-sg-section="about/centered">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="tw:mx-auto tw:max-w-3xl tw:text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-semibold tw:text-ink tw:sm:text-4xl"><%= d.heading %></h2>
        <p class="tw:mt-4 tw:text-lg tw:text-pretty tw:whitespace-pre-line tw:text-muted"><%= d.body %></p>
        <% if (d.moreHref) { %><a class="tw:mt-6 tw:inline-block tw:font-medium tw:text-primary tw:underline-offset-4 tw:hover:underline" href="<%= d.moreHref %>">Learn more about us &rarr;</a><% } %>
      </div>
      <% if (d.image) { %><img class="tw:mx-auto tw:mt-10 tw:aspect-[16/7] tw:w-full tw:max-w-5xl tw:rounded-xl tw:object-cover" src="<%= d.image %>" alt="<%= d.imageAlt %>" loading="lazy" data-animate="fade-up"><% } %>
    </div>
  </div>
</section>
