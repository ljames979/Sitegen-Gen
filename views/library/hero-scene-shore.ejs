      <div class="tw:mt-8 tw:flex tw:flex-wrap tw:justify-center tw:gap-4" data-animate="hero">
        <a class="tw:inline-block tw:rounded-md tw:bg-page tw:px-5 tw:py-3 tw:font-medium tw:text-ink tw:shadow-[var(--shadow-sm)] tw:transition-opacity tw:hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
        <% if (d.phone) { %><a class="tw:inline-block tw:rounded-md tw:border tw:border-white/70 tw:px-5 tw:py-3 tw:font-medium tw:text-white tw:transition-colors tw:hover:bg-white/10" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
