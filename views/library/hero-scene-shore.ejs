    <div class="tw:relative tw:mx-auto tw:flex tw:min-h-[34rem] tw:max-w-7xl tw:flex-col tw:items-center tw:px-4 tw:pt-16 tw:pb-48 tw:text-center tw:sm:px-6 tw:sm:pt-24 tw:sm:pb-56 tw:lg:px-8 tw:lg:pt-28 tw:lg:pb-64">
      <h1 class="tw:max-w-3xl tw:font-heading tw:text-4xl tw:font-bold tw:text-balance tw:text-white tw:sm:text-6xl" data-animate="hero"><%- d.headlineHtml %></h1>
