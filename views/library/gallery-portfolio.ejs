<%# Adapted from Start Bootstrap Agency (MIT) portfolio grid: photo cards that wash over in the brand color with a plus on hover, a caption under each (only when the owner wrote one). Clicking opens the photo viewer. %>
<section class="sg-lib" data-sg-section="gallery/portfolio">
  <div class="tw:bg-surface">
    <div class="tw:mx-auto tw:max-w-6xl tw:px-4 tw:py-16 tw:sm:px-6 tw:lg:px-8 tw:lg:py-24">
      <div class="tw:mx-auto tw:max-w-3xl tw:text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-bold tw:tracking-wide tw:text-ink tw:uppercase tw:sm:text-4xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="tw:mt-3 tw:text-lg tw:text-pretty tw:italic tw:text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="tw:mt-12 tw:grid tw:grid-cols-1 tw:gap-6 tw:sm:grid-cols-2 tw:lg:grid-cols-3" data-lightbox data-sg-cards data-animate="stagger">
        <% d.images.forEach(function (im) { %>
          <figure class="tw:group tw:overflow-hidden tw:rounded-md tw:bg-page tw:shadow-[var(--shadow-sm)]">
            <div class="tw:relative tw:cursor-zoom-in tw:overflow-hidden">
              <img class="tw:aspect-[4/3] tw:w-full tw:object-cover" src="<%= im.src %>" alt="<%= im.alt %>" loading="lazy">
              <div class="tw:pointer-events-none tw:absolute tw:inset-0 tw:flex tw:items-center tw:justify-center tw:bg-primary/90 tw:text-on-primary tw:opacity-0 tw:transition-opacity tw:duration-300 tw:group-hover:opacity-100" aria-hidden="true"><svg class="tw:size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></div>
            </div>
            <% if (im.caption) { %><figcaption class="tw:px-5 tw:py-5 tw:text-center tw:font-heading tw:text-lg tw:font-bold tw:text-ink"><%= im.caption %></figcaption><% } %>
          </figure>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="tw:mt-12 tw:text-center"><a class="tw:inline-block tw:rounded-md tw:bg-primary tw:px-6 tw:py-3 tw:text-sm tw:font-bold tw:tracking-wider tw:text-on-primary tw:uppercase tw:transition-opacity tw:hover:opacity-90" href="<%= d.moreHref %>">See the full gallery</a></p><% } %>
    </div>
  </div>
</section>
