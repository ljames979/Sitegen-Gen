<%# Adapted from Start Bootstrap Grayscale (MIT) masthead: a full-screen photo fading to black, a huge widely spaced uppercase headline that fades out at the bottom, quiet words and an uppercase button. %>
<section class="sg-lib" data-sg-section="hero/fade">
  <div class="tw:relative tw:isolate tw:flex tw:min-h-[min(100svh,64rem)] tw:items-center tw:overflow-hidden tw:bg-black">
    <div class="tw:mx-auto tw:w-full tw:max-w-5xl tw:px-4 tw:py-28 tw:text-center tw:sm:px-6 tw:lg:px-8">
      <h1 class="sg-gs-h1 tw:font-heading tw:font-bold tw:uppercase" data-animate="hero"><%- d.headlineHtml %></h1>
      <% if (d.sub) { %><p class="tw:mx-auto tw:mt-6 tw:max-w-2xl tw:text-lg tw:text-pretty tw:text-white/60 tw:sm:text-xl/relaxed" data-animate="hero"><%= d.sub %></p><% } %>
      <div class="tw:mt-10 tw:flex tw:flex-wrap tw:justify-center tw:gap-4" data-animate="hero">
        <a class="tw:inline-block tw:rounded-md tw:bg-primary tw:px-8 tw:py-4 tw:text-sm tw:font-bold tw:tracking-[.15em] tw:text-on-primary tw:uppercase tw:transition-opacity tw:hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
        <% if (d.phone) { %><a class="tw:inline-block tw:rounded-md tw:border tw:border-white/40 tw:px-8 tw:py-4 tw:text-sm tw:font-bold tw:tracking-[.15em] tw:text-white tw:uppercase tw:transition-colors tw:hover:bg-white/10" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
      </div>
    </div>
    <% if (d.image) { %><img class="tw:absolute tw:inset-0 tw:-z-10 tw:h-full tw:w-full tw:object-cover" src="<%= d.image %>" alt="" fetchpriority="high" style="object-position: <%= d.focal %>"><% } %>
    <div class="sg-gs-fade tw:absolute tw:inset-0 tw:-z-10"></div>
  </div>
</section>
