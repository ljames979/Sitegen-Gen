<%# Original layout (zig-zag rows): one row per service, photo and words swapping sides down the page. %>
<section class="sg-lib" data-sg-section="services/zigzag">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-6xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="tw:mx-auto tw:max-w-3xl tw:text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-semibold tw:text-ink tw:sm:text-3xl"><%= d.heading %></h2>
        <% if (d.intro) { %><p class="tw:mt-3 tw:text-pretty tw:text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="tw:mt-10 tw:space-y-10 tw:lg:mt-14 tw:lg:space-y-16">
        <% d.items.forEach(function (it, i) { %>
          <div class="sg-zz tw:grid tw:grid-cols-1 tw:gap-6 tw:md:grid-cols-2 tw:md:items-center tw:md:gap-12" data-animate="fade-up">
            <% if (it.imageUrl) { %><img class="tw:aspect-[4/3] tw:w-full tw:rounded-xl tw:object-cover tw:shadow-[var(--shadow-sm)]" src="<%= it.imageUrl %>"<% if (it.image2) { %> data-sg-hover="<%= it.image2 %>"<% } %> alt="" loading="lazy" decoding="async"><% } else { %>
            <div class="tw:flex tw:aspect-[16/9] tw:items-center tw:justify-center tw:rounded-xl tw:bg-surface tw:font-heading tw:text-7xl tw:font-bold tw:text-primary" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %></div><% } %>
            <div>
              <h3 class="tw:font-heading tw:text-xl tw:font-semibold tw:text-ink tw:sm:text-2xl"><%= it.title %></h3>
              <% if (it.description) { %><p class="tw:mt-3 tw:text-lg/relaxed tw:text-pretty tw:text-muted"><%= it.description %></p><% } %>
              <% if (it.price) { %><p class="tw:mt-3 tw:font-medium tw:text-primary"><%= it.price %></p><% } %>
              <a class="tw:mt-4 tw:inline-block tw:font-medium tw:text-primary tw:underline-offset-4 tw:hover:underline" href="<%= it.href %>">More about <%= it.title %> &rarr;</a>
            </div>
          </div>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="tw:mt-10 tw:text-center"><a class="tw:font-medium tw:text-primary tw:underline-offset-4 tw:hover:underline" href="<%= d.moreHref %>">See all services &rarr;</a></p><% } %>
    </div>
  </div>
</section>
