<%# Original layout (heading and help panel beside the accordion, drawn from scratch): native <details>, no JavaScript. %>
<section class="sg-lib" data-sg-section="faq/side">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="sg-flip tw:grid tw:grid-cols-1 tw:gap-10 tw:lg:grid-cols-3 tw:lg:gap-16">
        <div class="tw:lg:col-span-1" data-animate="fade-up">
          <h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-semibold tw:text-ink tw:sm:text-3xl"><%= d.heading %></h2>
          <div class="tw:mt-6 tw:rounded-xl tw:border tw:border-line tw:bg-surface tw:p-5">
            <p class="tw:font-heading tw:font-semibold tw:text-ink">Still have a question?</p>
            <p class="tw:mt-1 tw:text-sm tw:text-pretty tw:text-muted">Send us a message<% if (d.phone) { %> or give us a call<% } %>.</p>
            <div class="tw:mt-4 tw:flex tw:flex-wrap tw:gap-3">
              <a class="tw:inline-block tw:rounded-md tw:bg-primary tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:text-on-primary tw:transition-opacity tw:hover:opacity-90" href="<%= d.ctaHref %>">Contact us</a>
              <% if (d.phone) { %><a class="tw:inline-block tw:rounded-md tw:border tw:border-line tw:bg-page tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:text-ink tw:transition-colors tw:hover:bg-surface" href="tel:<%= d.phoneHref %>"><%= d.phone %></a><% } %>
            </div>
          </div>
        </div>
        <div class="tw:space-y-3 tw:lg:col-span-2" data-animate="stagger">
          <% d.items.forEach(function (it, i) { %>
            <details class="tw:group tw:rounded-xl tw:border tw:border-line tw:bg-surface tw:p-5 tw:open:shadow-[var(--shadow-sm)]" <%= i === 0 ? 'open' : '' %>>
              <summary class="tw:flex tw:cursor-pointer tw:list-none tw:items-center tw:justify-between tw:gap-4 tw:font-heading tw:text-base tw:font-medium tw:text-ink"><%= it.question %><span class="tw:shrink-0 tw:text-primary tw:transition-transform tw:group-open:rotate-45" aria-hidden="true">+</span></summary>
              <p class="tw:mt-3 tw:text-pretty tw:text-muted"><%= it.answer %></p>
            </details>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>
