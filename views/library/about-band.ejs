<%# Adapted from Start Bootstrap Creative (MIT) about band: the story centered on the brand color under a short light rule, with a round light button. %>
<section class="sg-lib" data-sg-section="about/band">
  <div class="tw:bg-primary">
    <div class="tw:mx-auto tw:max-w-3xl tw:px-4 tw:py-16 tw:text-center tw:sm:px-6 tw:lg:px-8 tw:lg:py-24" data-animate="fade-up">
      <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-bold tw:text-on-primary tw:sm:text-4xl"><%= d.heading %></h2>
      <hr class="tw:mx-auto tw:mt-6 tw:h-1 tw:w-14 tw:border-0 tw:bg-on-primary">
      <p class="tw:mt-6 tw:text-lg/relaxed tw:text-pretty tw:whitespace-pre-line tw:text-on-primary/80"><%= d.body %></p>
      <% if (d.moreHref) { %><a class="tw:mt-8 tw:inline-block tw:rounded-full tw:bg-page tw:px-8 tw:py-3 tw:font-bold tw:text-ink tw:transition-opacity tw:hover:opacity-90" href="<%= d.moreHref %>">More about us</a><% } %>
    </div>
  </div>
</section>
