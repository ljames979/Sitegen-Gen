<%# Adapted from Meraki UI (MIT) marketing/testimonials "Single #2": one review on a wide brand-color panel, the reviewer's photo (when they gave one) standing over its edge. %>
<% var r = d.items[0]; %>
<section class="sg-lib" data-sg-section="testimonials/panel">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-6xl tw:px-4 tw:py-14 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-bold tw:text-ink tw:sm:text-4xl"><%= d.heading %></h2>
      </div>
      <div class="tw:mt-10 <%= r.photo ? 'tw:lg:relative tw:lg:py-10' : '' %>" data-animate="fade-up">
        <div class="tw:rounded-xl tw:bg-primary tw:p-8 tw:text-on-primary tw:sm:p-10 <%= r.photo ? 'tw:lg:ml-56 tw:lg:pl-48' : '' %>">
          <% if (r.rating) { %><p aria-label="<%= r.rating %> out of 5 stars"><%= "★".repeat(Math.round(r.rating)) %></p><% } %>
          <blockquote class="tw:mt-3 tw:font-heading tw:text-xl/relaxed tw:text-pretty tw:sm:text-2xl/relaxed">&ldquo;<%= r.quote %>&rdquo;</blockquote>
          <p class="tw:mt-6 tw:font-semibold"><%= r.name %><% if (r.role) { %><span class="tw:font-normal tw:text-on-primary/80"> &middot; <%= r.role %></span><% } %></p>
        </div>
        <% if (r.photo) { %><img class="tw:mx-auto tw:-mt-6 tw:size-40 tw:rounded-xl tw:object-cover tw:shadow-[var(--shadow-md)] tw:lg:absolute tw:lg:inset-y-0 tw:lg:left-12 tw:lg:mt-0 tw:lg:h-full tw:lg:w-72" src="<%= r.photo %>" alt="" loading="lazy"><% } %>
      </div>
      <% if (d.moreHref) { %><p class="tw:mt-8"><a class="tw:font-medium tw:text-primary tw:underline-offset-4 tw:hover:underline" href="<%= d.moreHref %>"><%= d.moreText || 'Read more reviews' %> &rarr;</a></p><% } %>
    </div>
  </div>
</section>
