<%# Adapted from Start Bootstrap Grayscale (MIT) projects: the first service large with its words beside it, then each photo joined to a black panel of words with a short brand-color rule, sides swapping. A service without a photo gets the panel across the row. %>
<% var first = d.items[0], rest = d.items.slice(1); %>
<section class="sg-lib" data-sg-section="services/panels">
  <div class="tw:bg-surface">
    <div class="tw:mx-auto tw:max-w-6xl tw:px-4 tw:py-16 tw:sm:px-6 tw:lg:px-8 tw:lg:py-24">
      <div class="tw:mx-auto tw:max-w-3xl tw:text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-bold tw:tracking-[.12em] tw:text-ink tw:uppercase tw:sm:text-4xl"><%= d.heading %></h2>
      </div>
      <a class="tw:group tw:mt-12 tw:grid tw:items-center tw:gap-6 tw:lg:grid-cols-12 tw:lg:gap-10" href="<%= first.href %>" data-animate="fade-up">
        <% if (first.imageUrl) { %><img class="tw:aspect-[16/10] tw:w-full tw:object-cover tw:lg:col-span-8" src="<%= first.imageUrl %>" alt="<%= first.title %>" loading="lazy"><% } %>
        <div class="tw:text-center tw:lg:text-left <%= first.imageUrl ? 'tw:lg:col-span-4' : 'tw:lg:col-span-12 tw:lg:text-center' %>">
          <h3 class="tw:font-heading tw:text-2xl tw:font-bold tw:tracking-[.08em] tw:text-ink tw:uppercase tw:group-hover:underline"><%= first.title %></h3>
          <% if (first.description) { %><p class="tw:mt-3 tw:text-pretty tw:text-muted"><%= first.description %></p><% } %>
          <% if (first.price) { %><p class="tw:mt-3 tw:text-sm tw:font-bold tw:text-ink"><%= first.price %></p><% } %>
        </div>
      </a>
      <div class="tw:mt-12" data-sg-cards data-animate="stagger">
        <% rest.forEach(function (it, i) { var right = i % 2 === 1; %>
          <a class="tw:group tw:grid <%= it.imageUrl ? 'tw:md:grid-cols-2' : '' %>" href="<%= it.href %>">
            <% if (it.imageUrl) { %><img class="tw:aspect-[4/3] tw:h-full tw:w-full tw:object-cover <%= right ? 'tw:md:order-2' : '' %>" src="<%= it.imageUrl %>" alt="<%= it.title %>" loading="lazy"><% } %>
            <div class="tw:flex tw:items-center tw:bg-black tw:p-8 tw:sm:p-12">
              <div class="tw:w-full tw:text-center <%= it.imageUrl ? (right ? 'tw:md:text-right' : 'tw:md:text-left') : '' %>">
                <h3 class="tw:font-heading tw:text-xl tw:font-bold tw:tracking-[.08em] tw:text-white tw:uppercase tw:group-hover:underline"><%= it.title %></h3>
                <% if (it.description) { %><p class="tw:mt-3 tw:text-pretty tw:text-white/60"><%= it.description %></p><% } %>
                <% if (it.price) { %><p class="tw:mt-3 tw:text-sm tw:font-bold tw:text-white/80"><%= it.price %></p><% } %>
                <hr class="tw:mx-auto tw:mt-5 tw:h-1 tw:w-16 tw:border-0 tw:bg-primary <%= it.imageUrl ? (right ? 'tw:md:mr-0' : 'tw:md:ml-0') : '' %>">
              </div>
            </div>
          </a>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="tw:mt-12 tw:text-center"><a class="tw:inline-block tw:rounded-md tw:bg-primary tw:px-8 tw:py-4 tw:text-sm tw:font-bold tw:tracking-[.15em] tw:text-on-primary tw:uppercase tw:transition-opacity tw:hover:opacity-90" href="<%= d.moreHref %>">See all services</a></p><% } %>
    </div>
  </div>
</section>
