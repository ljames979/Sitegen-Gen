<%# Adapted from Start Bootstrap Creative (MIT) portfolio: photos edge to edge with no gaps; on hover each one washes over in the brand color, with its caption when the owner wrote one. Clicking opens the photo viewer. %>
<section class="sg-lib" data-sg-section="gallery/tiles">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-none tw:py-0">
      <div class="tw:mx-auto tw:max-w-3xl tw:px-4 tw:pt-16 tw:pb-10 tw:text-center tw:sm:px-6 tw:lg:pt-20" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-bold tw:text-ink tw:sm:text-4xl"><%= d.heading %></h2>
        <hr class="tw:mx-auto tw:mt-6 tw:h-1 tw:w-14 tw:border-0 tw:bg-primary">
      </div>
      <div class="tw:grid tw:grid-cols-1 tw:sm:grid-cols-2 tw:lg:grid-cols-3" data-lightbox data-sg-cards>
        <% d.images.forEach(function (im) { %>
          <figure class="tw:group tw:relative tw:cursor-zoom-in tw:overflow-hidden">
            <img class="tw:aspect-[3/2] tw:w-full tw:object-cover tw:transition-transform tw:duration-500 tw:group-hover:scale-105" src="<%= im.src %>" alt="<%= im.alt %>" loading="lazy">
            <figcaption class="tw:pointer-events-none tw:absolute tw:inset-0 tw:flex tw:items-center tw:justify-center tw:bg-primary/90 tw:p-6 tw:text-center tw:font-heading tw:text-xl tw:font-bold tw:text-on-primary tw:opacity-0 tw:transition-opacity tw:duration-300 tw:group-hover:opacity-100" aria-hidden="true"><%= im.caption %></figcaption>
          </figure>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="tw:py-10 tw:text-center"><a class="tw:inline-block tw:rounded-full tw:bg-primary tw:px-8 tw:py-3 tw:font-bold tw:text-on-primary tw:transition-opacity tw:hover:opacity-90" href="<%= d.moreHref %>">See the full gallery</a></p><% } %>
    </div>
  </div>
</section>
