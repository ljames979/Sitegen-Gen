<%# Original layout (collage: words beside one large and two small photos) %>
<% var ims = (d.images || []).map(function (x) { return x && typeof x === 'object' ? x.src : x; }).filter(Boolean); if (!ims.length && d.image) ims = [d.image]; var alt = d.imageAlt || ((d.images || [])[0] || {}).alt || ''; %>
<section class="sg-lib" data-sg-section="about/collage">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="sg-flip tw:grid tw:grid-cols-1 tw:gap-10 tw:lg:grid-cols-2 tw:lg:items-center tw:lg:gap-16">
        <div data-animate="fade-up">
          <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
          <% if (d.heading) { %><h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-semibold tw:text-ink tw:sm:text-3xl"><%= d.heading %></h2><% } %>
          <% if (d.body) { %><p class="<%= d.heading ? 'tw:mt-4' : '' %> tw:text-lg/relaxed tw:text-pretty tw:whitespace-pre-line tw:text-muted"><%= d.body %></p><% } %>
          <% if (d.moreHref) { %><a class="tw:mt-6 tw:inline-block tw:font-medium tw:text-primary tw:underline-offset-4 tw:hover:underline" href="<%= d.moreHref %>">Learn more about us &rarr;</a><% } %>
          <% if (d.buttonText && d.buttonHref) { %><p class="tw:mt-6"><a class="tw:inline-block tw:rounded-md tw:bg-primary tw:px-5 tw:py-3 tw:font-medium tw:text-on-primary tw:shadow-[var(--shadow-sm)] tw:transition-opacity tw:hover:opacity-90" href="<%= d.buttonHref %>"><%= d.buttonText %></a></p><% } %>
        </div>
        <% if (ims.length >= 3) { %>
          <div class="tw:grid tw:grid-cols-3 tw:grid-rows-2 tw:gap-3 tw:sm:gap-4" data-animate="stagger">
            <img class="tw:col-span-2 tw:row-span-2 tw:h-full tw:min-h-64 tw:w-full tw:rounded-xl tw:object-cover" src="<%= ims[0] %>" alt="<%= alt %>" loading="lazy">
            <img class="tw:aspect-square tw:h-full tw:w-full tw:rounded-xl tw:object-cover" src="<%= ims[1] %>" alt="" loading="lazy">
            <img class="tw:aspect-square tw:h-full tw:w-full tw:rounded-xl tw:object-cover" src="<%= ims[2] %>" alt="" loading="lazy">
          </div>
        <% } else if (ims.length) { %><div data-animate="fade-up"><img class="tw:aspect-[4/3] tw:w-full tw:rounded-xl tw:object-cover" src="<%= ims[0] %>" alt="<%= alt %>" loading="lazy"></div><% } %>
      </div>
    </div>
  </div>
</section>
