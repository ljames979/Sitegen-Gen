<%# Adapted from Start Bootstrap Creative (MIT) services: a big line icon in the brand color over each service, a short rule under the heading, no cards. %>
<section class="sg-lib" data-sg-section="services/lineicons">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-6xl tw:px-4 tw:py-16 tw:sm:px-6 tw:lg:px-8 tw:lg:py-24">
      <div class="tw:mx-auto tw:max-w-3xl tw:text-center" data-animate="fade-up">
        <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
        <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-bold tw:text-ink tw:sm:text-4xl"><%= d.heading %></h2>
        <hr class="tw:mx-auto tw:mt-6 tw:h-1 tw:w-14 tw:border-0 tw:bg-primary">
        <% if (d.intro) { %><p class="tw:mt-6 tw:text-pretty tw:text-muted"><%= d.intro %></p><% } %>
      </div>
      <div class="tw:mt-12 tw:grid tw:grid-cols-1 tw:gap-x-8 tw:gap-y-12 tw:text-center tw:sm:grid-cols-2 <%= d.items.length === 4 || d.items.length > 6 ? 'tw:lg:grid-cols-4' : 'tw:lg:grid-cols-3' %>" data-sg-cards data-animate="stagger">
        <% d.items.forEach(function (it) { %>
          <a class="tw:group tw:block" href="<%= it.href %>">
            <svg class="tw:mx-auto tw:size-16 tw:text-primary tw:transition-transform tw:duration-300 tw:group-hover:-translate-y-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- it.icon || '<polyline points="20 6 9 17 4 12"></polyline>' %></svg>
            <h3 class="tw:mt-5 tw:font-heading tw:text-xl tw:font-bold tw:text-ink"><%= it.title %></h3>
            <% if (it.description) { %><p class="tw:mt-3 tw:text-pretty tw:text-muted"><%= it.description %></p><% } %>
            <% if (it.price) { %><p class="tw:mt-3 tw:text-sm tw:font-bold tw:text-ink"><%= it.price %></p><% } %>
          </a>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="tw:mt-12 tw:text-center"><a class="tw:inline-block tw:rounded-full tw:bg-primary tw:px-8 tw:py-3 tw:font-bold tw:text-on-primary tw:transition-opacity tw:hover:opacity-90" href="<%= d.moreHref %>">See all services</a></p><% } %>
    </div>
  </div>
</section>
