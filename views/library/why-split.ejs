<%# Adapted from HyperUI (MIT) marketing/sections/2: a heading on the left, reasons stacked on the right. %>
<section class="sg-lib" data-sg-section="why/split">
  <div class="tw:bg-surface">
    <div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="sg-flip tw:grid tw:grid-cols-1 tw:gap-10 tw:lg:grid-cols-3 tw:lg:gap-16">
        <div class="tw:lg:col-span-1" data-animate="fade-up">
          <% if (d.eyebrow) { %><p class="tw:text-sm tw:font-medium tw:tracking-wide tw:text-primary tw:uppercase"><%= d.eyebrow %></p><% } %>
          <h2 data-sg-head class="tw:font-heading tw:text-2xl tw:font-semibold tw:text-ink tw:sm:text-3xl"><%= d.heading %></h2>
          <% if (d.intro) { %><p class="tw:mt-3 tw:text-pretty tw:text-muted"><%= d.intro %></p><% } %>
        </div>
        <ul class="tw:list-none tw:p-0 tw:space-y-6 tw:lg:col-span-2" data-animate="stagger">
          <% d.items.forEach(function (it) { %>
            <li class="tw:flex tw:gap-4">
              <% if (it.imageUrl) { %><img class="tw:mt-1 tw:size-16 tw:shrink-0 tw:rounded-lg tw:object-cover" src="<%= it.imageUrl %>" alt="" loading="lazy" decoding="async"><% } else { %>
              <span class="tw:mt-1 tw:flex tw:size-6 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-full tw:bg-primary tw:text-on-primary" aria-hidden="true"><svg class="tw:size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
              <% } %>
              <span class="tw:block"><span class="tw:block tw:font-heading tw:text-lg tw:font-semibold tw:text-ink"><%= it.title %></span><% if (it.text) { %><span class="tw:mt-1 tw:block tw:text-pretty tw:text-muted"><%= it.text %></span><% } %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</section>
