<%# Original layout (photo-mosaic hero pattern, drawn from scratch): text on the left, up to three staggered photos on the right. %>
<section class="sg-lib" data-sg-section="hero/mosaic">
  <div class="tw:bg-surface">
    <div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-12 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <div class="sg-flip tw:grid tw:grid-cols-1 tw:gap-10 tw:lg:grid-cols-2 tw:lg:items-center tw:lg:gap-14">
        <div>
          <h1 class="tw:font-heading tw:text-4xl tw:font-bold tw:text-ink tw:sm:text-5xl" data-animate="hero"><%- d.headlineHtml %></h1>
          <% if (d.sub) { %><p class="tw:mt-4 tw:text-base tw:text-pretty tw:text-muted tw:sm:text-lg/relaxed" data-animate="hero"><%= d.sub %></p><% } %>
          <div class="tw:mt-6 tw:flex tw:flex-wrap tw:gap-4" data-animate="hero">
            <a class="tw:inline-block tw:rounded-md tw:bg-primary tw:px-5 tw:py-3 tw:font-medium tw:text-on-primary tw:shadow-[var(--shadow-sm)] tw:transition-opacity tw:hover:opacity-90" href="<%= d.ctaHref %>"><%= d.ctaText %></a>
            <% if (d.phone) { %><a class="tw:inline-block tw:rounded-md tw:border tw:border-line tw:bg-page tw:px-5 tw:py-3 tw:font-medium tw:text-ink tw:shadow-[var(--shadow-sm)] tw:transition-colors tw:hover:bg-surface" href="tel:<%= d.phoneHref %>">Call <%= d.phone %></a><% } %>
          </div>
        </div>
        <% if (d.images.length >= 2) { %>
          <div class="tw:grid tw:grid-cols-2 tw:gap-3 tw:sm:gap-4" data-animate="scene">
            <img class="tw:row-span-2 tw:h-full tw:min-h-64 tw:w-full tw:rounded-xl tw:object-cover tw:shadow-[var(--shadow-md)]" src="<%= d.images[0] %>" alt="" fetchpriority="high">
            <img class="tw:aspect-[4/3] tw:w-full tw:rounded-xl tw:object-cover tw:shadow-[var(--shadow-sm)]" src="<%= d.images[1] %>" alt="" loading="lazy">
            <% if (d.images[2]) { %><img class="tw:aspect-[4/3] tw:w-full tw:rounded-xl tw:object-cover tw:shadow-[var(--shadow-sm)]" src="<%= d.images[2] %>" alt="" loading="lazy"><% } %>
          </div>
        <% } else if (d.images.length === 1) { %>
          <img class="tw:aspect-[4/3] tw:w-full tw:rounded-xl tw:object-cover tw:shadow-[var(--shadow-md)]" src="<%= d.images[0] %>" alt="" fetchpriority="high" data-animate="scene">
        <% } %>
      </div>
    </div>
  </div>
</section>
