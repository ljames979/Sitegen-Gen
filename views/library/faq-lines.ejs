<%# Adapted from Meraki UI (MIT) marketing/faq "Collapse": questions between thin lines with a plus that turns to a minus, the answer set off by a brand-color line. Native <details>, no JavaScript. %>
<section class="sg-lib" data-sg-section="faq/lines">
  <div class="tw:bg-page">
    <div class="tw:mx-auto tw:max-w-4xl tw:px-4 tw:py-14 tw:sm:px-6 tw:lg:px-8 tw:lg:py-20">
      <h2 data-sg-head class="tw:font-heading tw:text-3xl tw:font-bold tw:text-ink tw:sm:text-4xl" data-animate="fade-up"><%= d.heading %></h2>
      <hr class="tw:mt-8 tw:border-line">
      <div class="tw:divide-y tw:divide-line tw:border-b tw:border-line" data-animate="stagger">
        <% d.items.forEach(function (it, i) { %>
          <details class="tw:group tw:py-6" <%= i === 0 ? 'open' : '' %>>
            <summary class="tw:flex tw:cursor-pointer tw:list-none tw:items-center tw:gap-4 tw:font-heading tw:text-lg tw:text-ink">
              <span class="tw:relative tw:size-5 tw:shrink-0 tw:text-primary" aria-hidden="true"><span class="tw:absolute tw:inset-x-0 tw:top-1/2 tw:h-0.5 tw:-translate-y-1/2 tw:rounded tw:bg-current"></span><span class="tw:absolute tw:inset-y-0 tw:left-1/2 tw:w-0.5 tw:-translate-x-1/2 tw:rounded tw:bg-current tw:transition-transform tw:group-open:scale-y-0"></span></span>
              <%= it.question %>
            </summary>
            <p class="tw:mt-4 tw:ml-9 tw:border-l-2 tw:border-primary tw:pl-5 tw:text-pretty tw:text-muted"><%= it.answer %></p>
          </details>
        <% }) %>
      </div>
      <% if (d.moreHref) { %><p class="tw:mt-8"><a class="tw:font-medium tw:text-primary tw:underline-offset-4 tw:hover:underline" href="<%= d.moreHref %>">More questions &rarr;</a></p><% } %>
    </div>
  </div>
</section>
