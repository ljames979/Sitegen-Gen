<!DOCTYPE html>
<html>
<head>
  <title>Hosting billing — <%= site.name %> — SiteGen</title>
  <%- include('partials-head') %>
  <style>
    .copy-row { display: flex; gap: 8px; }
    .copy-row input { margin: 0; flex: 1; }
    .flashbar { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 10px 14px; border-radius: 10px; margin-bottom: 16px; }
    .flashbar.bad { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
    .pill { display: inline-block; padding: 3px 12px; border-radius: 999px; font-size: 13px; font-weight: 600; background: #f1f5f9; }
    .pill.good { background: #dcfce7; color: #166534; }
    .pill.bad { background: #fee2e2; color: #991b1b; }
    .pill.warn { background: #fef3c7; color: #92400e; }
    code.block { display: block; padding: 8px 12px; background: #f1f5f9; border-radius: 8px; word-break: break-all; margin: 6px 0 12px; }
  </style>
</head>
<body>
  <nav>
    <div class="row">
      <a href="/sites/<%= site.id %>/edit" class="muted">&larr; <%= site.name %></a>
      <strong>Hosting billing</strong>
    </div>
  </nav>
  <div class="container">
    <% if (flash) { %><div class="flashbar <%= ['sendfailed','notconfigured','stripefail','bademail','noportal'].includes(flash) ? 'bad' : '' %>"><%= msgs[flash] %></div><% } %>

    <div class="card" style="margin-bottom:20px;">
      <h3>Status</h3>
      <% const cls = ['active','trialing'].includes(row.billing_status) ? 'good' : (row.billing_status === 'past_due' ? 'warn' : (row.billing_status === 'none' ? '' : 'bad')); %>
      <p><span class="pill <%= cls %>"><%= label %></span>
        <% if (row.billing_required) { %>
          <% if (suspended) { %><span class="pill bad">Site is offline</span><% } else { %><span class="pill good">Site is live</span><% } %>
        <% } else { %>
          <span class="pill">Not required: the site stays live without a subscription</span>
        <% } %>
      </p>
      <% if (row.billing_required && row.billing_status === 'past_due' && !suspended) { %>
        <p class="muted">The last payment failed. The site stays live for <%= graceDays %> days while Stripe retries, then goes offline if it is still unpaid.</p>
      <% } %>

      <form method="POST" action="/sites/<%= site.id %>/billing/settings">
        <label style="display:flex; gap:10px; align-items:flex-start; font-weight:500;">
          <input type="checkbox" name="billing_required" value="1" <%= row.billing_required ? 'checked' : '' %> style="width:auto; margin-top:4px;">
          <span>Take this site offline when its hosting subscription is not active
            <span class="muted" style="display:block; font-weight:400;">Visitors see a polite "temporarily unavailable" page. Turn this on only after the client has agreed to the hosting terms. The site goes offline right away if no subscription is active yet.</span></span>
        </label>
        <label>Client's billing email</label>
        <input type="email" name="billing_email" value="<%= row.billing_email %>" placeholder="client@example.com">
        <button type="submit">Save</button>
      </form>
    </div>

    <% if (!configured) { %>
      <div class="card" style="margin-bottom:20px;">
        <h3>Set up Stripe first</h3>
        <p class="muted">Billing needs a Stripe account and three settings in your <code>.env</code> file: <code>STRIPE_SECRET_KEY</code>, <code>STRIPE_PRICE_ID</code> and <code>STRIPE_WEBHOOK_SECRET</code>. The README section "Charging for hosting" walks through it step by step (about 10 minutes).</p>
      </div>
    <% } else { %>
      <div class="card" style="margin-bottom:20px;">
        <h3>Start the hosting subscription</h3>
        <p class="muted" style="margin-top:-6px;">Creates a secure Stripe checkout link for this client. The client pays on Stripe's page; the status above updates by itself.</p>
        <% if (link) { %>
          <label>Checkout link (valid for 24 hours)</label>
          <div class="copy-row"><input type="text" readonly value="<%= link %>" onclick="this.select()"><button type="button" onclick="navigator.clipboard.writeText(this.previousElementSibling.value)">Copy</button></div>
        <% } %>
        <form method="POST" action="/sites/<%= site.id %>/billing/checkout" style="margin-top:12px;">
          <label>Client's email</label>
          <input type="email" name="billing_email" value="<%= row.billing_email %>" placeholder="client@example.com">
          <div class="row" style="gap:8px;">
            <button type="submit">Create link</button>
            <% if (mailConfigured) { %><button type="submit" name="send" value="1" class="btn-secondary">Create and email it</button><% } %>
          </div>
        </form>
        <% if (row.stripe_customer_id) { %>
          <form method="POST" action="/sites/<%= site.id %>/billing/portal" style="margin-top:16px;">
            <button type="submit" class="btn-secondary">Manage subscription in Stripe (update card, cancel)</button>
          </form>
        <% } %>
      </div>
      <% if (!webhookReady) { %>
        <div class="flashbar bad">The webhook secret is missing, so Stripe cannot tell SiteGen when a payment succeeds. Add <code>STRIPE_WEBHOOK_SECRET</code> (README, "Charging for hosting").</div>
      <% } %>
    <% } %>

    <div class="card">
      <h3>Webhook address</h3>
      <p class="muted" style="margin-top:-6px;">In Stripe, add this as a webhook endpoint (it must be your public https address, not localhost):</p>
      <code class="block"><%= webhookUrl %></code>
    </div>
  </div>
</body>
</html>
