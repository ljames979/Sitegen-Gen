<%# The page tools' buttons (+ Add text, pictures, paws, shapes, stamps, Style text, Move & size) and the shape and
    stamp picker. Shared by the editor and the Blocks screen's Edit mode; their code is _page-tools.ejs. %>
        <button type="button" class="btn-secondary" id="addTextBtn" aria-pressed="false" title="Add your own words anywhere on the page, then move them, size them and pick their font and color">+ Add text</button>
        <button type="button" class="btn-secondary" id="addPicBtn" aria-pressed="false" title="Put a picture on top of any block (peeking cats and dogs, or your own), then drag it and pull its corner to size it">+ Add picture</button>
        <% if (typeof cutTool === 'undefined' || cutTool) { %><button type="button" class="btn-secondary" id="addCutBtn" aria-pressed="false" title="Clip the subject out of one of your photos (pet, person or thing) and place it anywhere on a block: then drag, size and turn it">✂ Cut-out photo</button><% } %>
        <button type="button" class="btn-secondary" id="addPawBtn" aria-pressed="false" title="Stamp paw prints anywhere on a block: each click adds one, in your logo color (Esc or click here again to stop)">+ Paw print</button>
        <button type="button" class="btn-secondary" id="addCatPawBtn" aria-pressed="false" title="Stamp cat paw prints anywhere on a block: each click adds one (Esc or click here again to stop)">+ Cat paw</button>
        <button type="button" class="btn-secondary" id="addTrailBtn" aria-pressed="false" title="One click lays a whole trail of cat paw prints winding up the block; drag, size, turn and color it like one picture (pick a dog trail in its menu)">+ Paw trail</button>
        <button type="button" class="btn-secondary" id="addShapeBtn" aria-pressed="false" title="Odd shapes: sparkles, drops, swirls, a cloud badge, an arrow banner, squiggles and more. Pick one, then click the page to place it (each click adds one)">+ Shape</button>
        <button type="button" class="btn-secondary" id="addStampBtn" aria-pressed="false" title="Rubber stamps with your own words: round, framed, seal or postage stamp. Pick one, then click the page to stamp it">+ Stamp</button>
        <button type="button" class="btn-secondary" id="styleTextBtn" aria-pressed="false" title="Click any words on the page to set an exact size, font and color, stretch the box they sit in (drag the white handles), move them or type new words. Select a few words first to style only those">Style text</button>
        <button type="button" class="btn-secondary" id="moveSizeBtn" aria-pressed="false" title="Click any piece of a block (a picture, card, button, icon, shape or words) and drag it to move it, pull its white handles to make it bigger or smaller, type an exact width and height, zoom it, turn it, bring it to the front or hide it">✥ Move &amp; size</button>
