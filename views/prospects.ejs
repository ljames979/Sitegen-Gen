<!DOCTYPE html>
<html>
<head>
  <title>Find new clients — SiteGen</title>
  <%- include('partials-head') %>
  <style>
    .pr-find { display: grid; grid-template-columns: 1.2fr 1fr auto; gap: 10px; align-items: end; }
    @media (max-width: 760px) { .pr-find { grid-template-columns: 1fr; } }
    .pr-find label, .pr-filter label { display: grid; gap: 4px; font-size: 13px; font-weight: 600; }
    .pr-find input, .pr-find select, .pr-filter input, .pr-filter select { margin: 0; }
    .pr-filter { display: flex; gap: 10px; flex-wrap: wrap; align-items: end; margin: 0 0 12px; }
    .pr-row { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 14px; border: 1px solid var(--border); border-radius: 12px; background: #fff; padding: 12px 14px; margin-bottom: 10px; }
    @media (max-width: 760px) { .pr-row { grid-template-columns: 1fr; } }
    .pr-row h3 { margin: 0 0 2px; font-size: 16px; }
    .pr-meta { font-size: 13px; color: var(--muted); margin: 2px 0; overflow-wrap: anywhere; }
    .pr-tag { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; margin-right: 6px; }
    .pr-tag.none { background: #fee2e2; color: #991b1b; } .pr-tag.has { background: #e0e7ff; color: #3730a3; } .pr-tag.st { background: #f1f5f9; color: #334155; }
    .pr-reasons { margin: 6px 0 0; padding-left: 18px; font-size: 13px; color: #92400e; }
    .pr-side { display: grid; gap: 6px; align-content: start; }
    .pr-side form { margin: 0; display: flex; gap: 6px; }
    .pr-side select, .pr-side input { margin: 0; font-size: 13px; padding: 6px 8px; }
    .pr-side button, .pr-side .btn { padding: 6px 10px; font-size: 13px; width: 100%; text-align: center; }
    .pr-flash { padding: 10px 14px; border-radius: 10px; margin-bottom: 14px; background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; }
    .pr-flash.bad { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
  </style>
</head>
<body>
  <nav><div class="row"><a href="/dashboard" class="muted">&larr; Dashboard</a><strong>Find new clients</strong><span style="flex:1"></span><a href="/board">All clients</a></div></nav>
  <div class="container" style="max-width:1100px;">
    <% if (err) { %><div class="pr-flash bad"><%= err %></div><% } %>
    <% if (found >= 0) { %><div class="pr-flash">Found <%= found %> business<%= found === 1 ? '' : 'es' %><%= added > 0 ? `, ${added} new to your list` : added === 0 && found ? ', all already on your list' : '' %>.<%= found === 0 ? ' OpenStreetMap has none of that kind listed there; try a bigger town nearby or another kind of business.' : '' %></div><% } %>
    <div class="card" style="margin-bottom:16px;">
      <h2 style="margin:0 0 4px;">Find businesses that need a website</h2>
      <p class="muted" style="margin:0 0 12px; font-size:14px;">Searches OpenStreetMap, the free map anyone can add to, for one kind of business in a town. Businesses with no website listed come first. OpenStreetMap is not complete, so some businesses are missing and "no website listed" is worth a quick Google before you call.</p>
      <form method="POST" action="/prospects/find" class="pr-find">
        <label>Town or city <input type="text" name="place" required maxlength="120" placeholder="e.g. Kissimmee, FL" value="<%= lastPlace %>"></label>
        <label>Kind of business <select name="niche" required><% niches.forEach(n => { %><option value="<%= n[0] %>" <%= f.niche === n[0] ? 'selected' : '' %>><%= n[1] %></option><% }) %></select></label>
        <button type="submit">Search</button>
      </form>
    </div>

    <% if (total) { %>
    <form method="GET" action="/prospects" class="pr-filter">
      <label>Kind <select name="niche"><option value="">All</option><% niches.forEach(n => { %><option value="<%= n[0] %>" <%= f.niche === n[0] ? 'selected' : '' %>><%= n[1] %></option><% }) %></select></label>
      <label>Website <select name="web"><option value="">Any</option><option value="none" <%= f.web === 'none' ? 'selected' : '' %>>No website listed</option><option value="has" <%= f.web === 'has' ? 'selected' : '' %>>Has a website</option></select></label>
      <label>Status <select name="status"><option value="">Any</option><% statuses.forEach(s => { %><option value="<%= s[0] %>" <%= f.status === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }) %></select></label>
      <label>Name <input type="search" name="q" value="<%= f.q %>" maxlength="60"></label>
      <button type="submit" class="btn-secondary">Show</button>
      <span class="muted" style="font-size:13px;"><%= rows.length %> of <%= total %></span>
    </form>
    <% } %>

    <% const keep = (p) => `<input type="hidden" name="f_niche" value="${f.niche}"><input type="hidden" name="f_status" value="${f.status}"><input type="hidden" name="f_web" value="${f.web}"><input type="hidden" name="f_q" value="${String(f.q).replace(/"/g, '&quot;')}">`; %>
    <% rows.forEach(p => { const n = niches.find(x => x[0] === p.niche); const st = statuses.find(s => s[0] === p.status); %>
    <div class="pr-row" id="p-<%= p.id %>">
      <div>
        <h3><%= p.name %></h3>
        <div><span class="pr-tag <%= p.website ? 'has' : 'none' %>"><%= p.website ? 'Has a website' : 'No website listed' %></span><span class="pr-tag st"><%= st ? st[1] : p.status %></span><% if (n) { %><span class="pr-meta"><%= n[1] %></span><% } %></div>
        <% if (p.address) { %><p class="pr-meta"><%= p.address %></p><% } %>
        <p class="pr-meta"><% if (p.phone) { %><a href="tel:<%= p.phone.replace(/[^+\d]/g, '') %>"><%= p.phone %></a><% } else { %>No phone listed<% } %><% if (p.email) { %> · <a href="mailto:<%= p.email %>"><%= p.email %></a><% } %><% if (p.website) { %> · <a href="<%= p.website %>" target="_blank" rel="noopener noreferrer"><%= p.website.replace(/^https?:\/\//, '').replace(/\/$/, '') %></a><% } %><% if (p.facebook) { %> · <a href="<%= p.facebook %>" target="_blank" rel="noopener noreferrer">Facebook</a><% } %></p>
        <% if (p.checked && p.reasonList.length) { %><ul class="pr-reasons"><% p.reasonList.forEach(r => { %><li><%= r %></li><% }) %></ul><% } %>
        <% if (p.site_id) { %><p class="pr-meta">Demo: <a href="/sites/<%= p.site_id %>/edit"><%= p.siteName || 'open' %></a> · <a href="/sites/<%= p.site_id %>/pitch">Pitch</a></p><% } %>
        <% if (p.note) { %><p class="pr-meta">Note: <%= p.note %></p><% } %>
      </div>
      <div class="pr-side">
        <% if (!p.site_id) { %>
          <% if (p.website) { %>
          <form method="POST" action="/sites/import"><input type="hidden" name="url" value="<%= p.website %>"><input type="hidden" name="prospect_id" value="<%= p.id %>"><button type="submit">Make a demo from their site</button></form>
          <% } else { %>
          <form method="POST" action="/sites/generate"><input type="hidden" name="business_type" value="<%= n ? n[2] : 'local business' %>"><input type="hidden" name="business_name" value="<%= p.name %>"><input type="hidden" name="phone" value="<%= p.phone %>"><input type="hidden" name="address" value="<%= p.address %>"><input type="hidden" name="city" value="<%= p.city %>"><input type="hidden" name="auto_blocks" value="1"><input type="hidden" name="prospect_id" value="<%= p.id %>"><button type="submit">Make a demo</button></form>
          <% } %>
        <% } %>
        <% if (p.website) { %><form method="POST" action="/prospects/<%= p.id %>/check"><%- keep(p) %><button type="submit" class="btn-secondary"><%= p.checked ? 'Check their site again' : 'Check their site' %></button></form><% } %>
        <a class="btn btn-secondary" href="/prospects/<%= p.id %>/email">First email to copy</a>
        <form method="POST" action="/prospects/<%= p.id %>/status"><%- keep(p) %><select name="status" aria-label="Status"><% statuses.forEach(s => { %><option value="<%= s[0] %>" <%= p.status === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }) %></select><button type="submit" class="btn-secondary" style="width:auto;">Save</button></form>
        <form method="POST" action="/prospects/<%= p.id %>/status"><%- keep(p) %><input type="text" name="note" maxlength="500" placeholder="Note (called, left message…)" value="<%= p.note %>" aria-label="Note"><button type="submit" class="btn-secondary" style="width:auto;">Save</button></form>
      </div>
    </div>
    <% }) %>
    <p class="muted" style="font-size:12.5px;">Business details © OpenStreetMap contributors (openstreetmap.org/copyright). A demo is made the same way as on the dashboard and stays private until you share its preview link.</p>
  </div>
</body>
</html>
