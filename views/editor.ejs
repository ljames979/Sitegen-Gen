<!DOCTYPE html>
<html>
<head>
  <title>Edit <%= site.name %> — SiteGen</title>
  <%- include('partials-head') %>
  <style>
    .editor-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 0; height: calc(100vh - 65px); }
    .editor-panel { overflow-y: auto; padding: 24px; }
    .preview-panel { border-left: 1px solid var(--border); background: #fff; display: flex; flex-direction: column; }
    .preview-page-bar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--border); font-size: 13px; flex-shrink: 0; }
    .preview-page-bar label { margin: 0; font-weight: 600; color: var(--muted); }
    .preview-page-bar select { width: auto; padding: 5px 8px; font-size: 13px; }
    @media (max-width: 900px) {
      .editor-layout { grid-template-columns: 1fr; height: auto; }
      .preview-panel { height: 500px; }
    }
    .draggable-section { position: relative; }
    .drag-handle { cursor: grab; user-select: none; padding: 2px 6px; border-radius: 4px; background: #f1f5f9; margin-right: 8px; }
    .section-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
    .section-toolbar .left { display: flex; align-items: center; gap: 4px; }
    .hide-toggle { display: flex; align-items: center; gap: 6px; font-weight: 400; font-size: 13px; color: var(--muted); margin: 0; }
    .draggable-section.dragging { opacity: 0.4; }
    /* page sections as a compact outline: closed sections are one row (title, move, hide); one opens at a time */
    .draggable-section > h3 { cursor: pointer; }
    .draggable-section.collapsed { display: flex; align-items: center; gap: 8px; padding-top: 6px; padding-bottom: 6px; cursor: pointer; }
    .draggable-section.collapsed > :not(.section-toolbar):not(h3) { display: none !important; }
    .draggable-section.collapsed > .section-toolbar { display: contents; }
    .draggable-section.collapsed > h3 { order: 1; flex: 1; margin: 0; font-size: 15.5px; }
    .draggable-section.collapsed .section-toolbar .left { order: 0; }
    .draggable-section.collapsed .sec-move { order: 2; }
    .draggable-section.collapsed .hide-toggle { order: 3; }
    .draggable-section.is-hidden > h3 { opacity: .5; }
    .draggable-section .hide-short, .draggable-section.collapsed .hide-long { display: none; }
    .draggable-section.collapsed .hide-short { display: inline; }
    .sec-move { display: inline-flex; gap: 2px; }
    /* content blocks in the sections list: a picture of the layout, the block's heading and a tag in its group's color */
    .blk-entry { border-left: 4px solid var(--g, #94a3b8); }
    h3.blk-h3 { display: flex; align-items: center; gap: 10px; min-width: 0; }
    h3.blk-h3 .blk-pic { flex: none; width: 48px; height: 32px; border-radius: 5px; box-shadow: 0 0 0 1px #e2e8f0; background: #fff; }
    h3.blk-h3 .blk-h3-main { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .blk-tag { flex: none; margin-left: auto; font-size: 11.5px; font-weight: 600; letter-spacing: .01em; color: var(--g, #475569); background: color-mix(in srgb, var(--g, #64748b) 11%, #fff); border: 1px solid color-mix(in srgb, var(--g, #64748b) 28%, #fff); padding: 2px 8px; border-radius: 999px; max-width: 46%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sec-move button { background: none; color: var(--muted); border: none; padding: 0; min-width: 32px; min-height: 32px; font-size: 15px; line-height: 1; border-radius: 6px; }
    .sec-move button:hover, .sec-move button:focus-visible { background: #f1f5f9; color: var(--text); }
    .sec-outline-bar { display: flex; justify-content: flex-end; margin: -4px 0 6px; }
    .sec-outline-bar button { background: none; color: var(--primary); border: none; padding: 6px 0; font-size: 13px; }
    /* quick search (Ctrl+K) */
    .ed-tabs .cmdk-open { margin-left: auto; color: var(--muted); border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 10px; font-size: 13px; align-self: center; }
    .ed-tabs .cmdk-open kbd { font: 600 11px system-ui, sans-serif; background: #f1f5f9; border-radius: 4px; padding: 2px 5px; margin-left: 6px; }
    .cmdk { position: fixed; inset: 0; z-index: 1000; background: rgba(15,23,42,.45); display: flex; justify-content: center; align-items: flex-start; padding: 12vh 16px 16px; }
    .cmdk[hidden] { display: none; }
    .cmdk-box { width: min(620px, 100%); background: #fff; border-radius: 14px; box-shadow: 0 24px 60px rgba(15,23,42,.35); overflow: hidden; }
    .cmdk-box input { width: 100%; border: none; border-bottom: 1px solid #e2e8f0; border-radius: 0; padding: 18px 20px; font-size: 17px; outline: none; }
    .cmdk-box ul { list-style: none; margin: 0; padding: 6px; max-height: 52vh; overflow-y: auto; }
    .cmdk-box li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 14px; border-radius: 8px; cursor: pointer; font-size: 14.5px; }
    .cmdk-box li small { color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 45%; }
    .cmdk-box li[aria-selected="true"] { background: #eff6ff; }
    .cmdk-box .cmdk-empty { color: var(--muted); cursor: default; }
    .cmdk-foot { margin: 0; padding: 10px 20px; border-top: 1px solid #e2e8f0; color: var(--muted); font-size: 12.5px; }
    .draggable-section.drag-over { border-top: 3px solid var(--primary); }
    .upload-row { display: flex; gap: 8px; margin-bottom: 4px; }
    .upload-row input[type=url] { flex: 1; }
    .autosave-status { font-size: 13px; color: var(--muted); }
    .version-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
    .version-row:last-child { border-bottom: none; }
    details.settings-block summary { cursor: pointer; font-weight: 600; padding: 4px 0; }
    .picker-overlay { position: fixed; inset: 0; background: rgba(15,23,42,0.55); display: none; align-items: center; justify-content: center; z-index: 50; padding: 20px; }
    .picker-overlay.open { display: flex; }
    .picker-box { background: #fff; border-radius: 14px; width: min(860px, 100%); max-height: 88vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
    .picker-head { display: flex; gap: 8px; padding: 16px; border-bottom: 1px solid var(--border); align-items: center; }
    .picker-head input { flex: 1; }
    .picker-grid { padding: 16px; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; }
    .picker-grid button { padding: 0; border: 3px solid transparent; border-radius: 10px; overflow: hidden; background: #e2e8f0; cursor: pointer; aspect-ratio: 4/3; }
    .picker-grid button:hover { border-color: var(--primary); }
    .picker-grid img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .picker-grid button { position: relative; }
    .picker-grid .pk-by { position: absolute; left: 0; right: 0; bottom: 0; padding: 14px 8px 5px; font-size: 11px; line-height: 1.2; color: #fff; text-align: left; background: linear-gradient(transparent, rgba(0,0,0,.65)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .picker-src { display: flex; gap: 6px; padding: 10px 16px 0; }
    .picker-src[hidden] { display: none; }
    .picker-src button { padding: 6px 14px; border-radius: 999px; border: 1px solid #cbd5e1; background: #fff; color: #0f172a; cursor: pointer; font: inherit; font-size: 13px; }
    .picker-src button[aria-pressed="true"] { background: #0f172a; color: #fff; border-color: #0f172a; }
    .picker-foot { padding: 12px 16px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: var(--muted); }
    /* ---- top bar: a few buttons, the rest in menus ---- */
    nav.ed-top { padding: 10px 18px; gap: 12px; flex-wrap: wrap; position: relative; z-index: 30; }
    nav.ed-top .row { flex-wrap: wrap; gap: 8px; }
    .menu { position: relative; }
    .menu > summary { list-style: none; cursor: pointer; }
    .menu > summary::-webkit-details-marker { display: none; }
    .menu > summary:not([aria-label])::after { content: " \25BE"; }
    .menu-list { position: absolute; top: calc(100% + 6px); left: 0; min-width: 240px; background: #fff; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 16px 40px rgba(15,23,42,.16); padding: 6px; z-index: 40; }
    .menu-right .menu-list { left: auto; right: 0; }
    .menu-list a { display: block; padding: 9px 12px; border-radius: 8px; color: var(--text); font-size: 14px; }
    .menu-list a:hover, .menu-list a:focus-visible { background: #f1f5f9; }
    .menu-list a span { display: block; font-size: 12.5px; color: var(--muted); }
    .menu .count { display: inline-block; min-width: 20px; padding: 0 6px; border-radius: 999px; background: var(--primary); color: #fff; font-size: 12px; line-height: 20px; }
    .split-btn { display: flex; } .split-btn form { margin: 0; } .split-btn form button { border-radius: 8px 0 0 8px; }
    .split-btn .menu > summary { border-radius: 0 8px 8px 0; border-left: 1px solid rgba(255,255,255,.35); padding: 10px 12px; }
    /* ---- sticky blanks bar and tabs ---- */
    .ed-sticky { position: sticky; top: -24px; margin: -24px -24px 18px; padding: 14px 24px 0; background: var(--bg); z-index: 20; border-bottom: 1px solid var(--border); }
    .blanks-bar { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 8px 10px 8px 14px; font-size: 14px; }
    .blanks-bar.has-warn { border-color: #fcd34d; background: #fffbeb; }
    .blanks-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .blanks-btns { display: flex; gap: 6px; } .blanks-btns button { padding: 6px 12px; font-size: 13px; }
    #blanksList { list-style: none; margin: 8px 0 2px; padding: 0; max-height: 40vh; overflow: auto; }
    #blanksList li { margin: 0; }
    #blanksList button { display: block; width: 100%; text-align: left; background: none; color: var(--text); font-weight: 400; padding: 7px 8px; border-radius: 6px; font-size: 13.5px; }
    #blanksList button:hover { background: rgba(15,23,42,.05); }
    #blanksList button.warn { color: #92400e; } #blanksList button b { font-weight: 700; }
    #blanksList button[disabled] { cursor: default; opacity: .8; }
    .ed-tabs { display: flex; gap: 4px; margin-top: 10px; }
    .ed-tabs button { background: none; color: var(--muted); border-radius: 0; padding: 10px 14px; border-bottom: 3px solid transparent; font-size: 14.5px; }
    .ed-tabs button[aria-selected="true"] { color: var(--text); border-bottom-color: var(--primary); }
    .editor-panel[data-tab="content"] #editorForm > [data-tab]:not([data-tab="content"]),
    .editor-panel[data-tab="design"] #editorForm > [data-tab]:not([data-tab="design"]),
    .editor-panel[data-tab="features"] #editorForm > [data-tab]:not([data-tab="features"]),
    .editor-panel[data-tab="settings"] #editorForm > [data-tab]:not([data-tab="settings"]) { display: none; }
    .sg-flash { outline: 3px solid #f59e0b !important; outline-offset: 2px; transition: outline-color .4s; }
    /* ---- design tab ---- */
    details.sub { border-top: 1px solid var(--border); margin: 14px -18px 0; padding: 4px 18px 0; }
    details.sub > summary { cursor: pointer; font-weight: 600; padding: 10px 0; }
    .style-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 8px; margin-bottom: 6px; }
    .style-card { display: flex; flex-direction: column; gap: 6px; padding: 6px; background: #fff; color: var(--text); border: 2px solid var(--border); border-radius: 10px; font-weight: 500; text-align: left; }
    .style-card:hover { border-color: #94a3b8; } .style-card.on { border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37,99,235,.18); }
    .sc-swatch { display: flex; align-items: flex-end; gap: 4px; height: 52px; padding: 6px 8px; border-radius: 6px; background: var(--c-bg); border: 1px solid rgba(0,0,0,.06); }
    .sc-aa { flex: 1; font-size: 26px; line-height: 1; color: var(--c-ink); font-weight: 700; }
    .sc-swatch i { width: 16px; height: 16px; border-radius: 50%; background: var(--c-pri); } .sc-swatch i + i { background: var(--c-acc); }
    .sc-name { font-size: 12.5px; line-height: 1.25; }
    /* ---- preview ---- */
    .preview-page-bar { flex-wrap: wrap; }
    .preview-page-bar .seg { display: inline-flex; } .preview-page-bar .seg button { padding: 5px 10px; font-size: 12.5px; border-radius: 0; } .preview-page-bar .seg button:first-child { border-radius: 6px 0 0 6px; } .preview-page-bar .seg button:last-child { border-radius: 0 6px 6px 0; }
    .preview-page-bar .seg button.on { background: #0f172a; color: #fff; }
    .preview-page-bar .click-edit { display: flex; align-items: center; gap: 5px; font-weight: 400; color: var(--text); }
    .preview-page-bar a { margin-left: auto; }
    .preview-stage { flex: 1; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); justify-items: center; min-height: 0; background: #fff; }
    .preview-stage iframe { grid-area: 1 / 1; width: 100%; height: 100%; border: none; background: #fff; transition: max-width .2s; }
    .preview-stage iframe.pv-next { visibility: hidden; }
    .undo-btns { display: inline-flex; gap: 2px; }
    .undo-btns button { background: none; color: var(--text); border: 1px solid var(--border, #e2e8f0); padding: 4px 10px; min-height: 32px; font-size: 15px; line-height: 1; }
    .undo-btns button:disabled { opacity: .35; cursor: default; }
    .preview-stage.phone { background: #e2e8f0; padding: 14px 0; }
    .preview-stage.phone iframe { max-width: 390px; border-radius: 22px; box-shadow: 0 10px 30px rgba(15,23,42,.18); }
    /* ---- save state: one clear label in the top bar ---- */
    .autosave-status { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-weight: 600; font-size: 12.5px; background: #f1f5f9; color: var(--muted); white-space: nowrap; }
    .autosave-status:empty { display: none; }
    .autosave-status::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: currentColor; flex: none; }
    .autosave-status[data-state="saved"] { background: #dcfce7; color: #166534; }
    .autosave-status[data-state="pending"] { background: #fef3c7; color: #92400e; }
    .autosave-status[data-state="saving"] { background: #dbeafe; color: #1e40af; }
    .autosave-status[data-state="saving"]::before { animation: sg-blink 1s ease-in-out infinite; }
    .autosave-status[data-state="error"] { background: #fee2e2; color: #991b1b; }
    @keyframes sg-blink { 50% { opacity: .25; } }
    @media (prefers-reduced-motion: reduce) { .autosave-status[data-state="saving"]::before { animation: none; } }
    /* ---- focused section: the panel shows only the section being edited, under a clear header ---- */
    .focus-bar { display: none; align-items: center; gap: 10px; margin: 10px 0 0; padding: 10px 12px; border-radius: 10px; background: #1e3a8a; color: #fff; }
    .editor-panel.focus .focus-bar { display: flex; }
    .focus-bar button { background: rgba(255,255,255,.14); color: #fff; border: 1px solid rgba(255,255,255,.3); padding: 6px 12px; font-size: 13px; border-radius: 8px; min-height: 36px; }
    .focus-bar button:hover, .focus-bar button:focus-visible { background: rgba(255,255,255,.26); }
    .focus-bar .fb-title { flex: 1; min-width: 0; font-size: 15.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .focus-bar .fb-title span { font-weight: 400; opacity: .8; }
    .focus-bar .fb-hidden { font-size: 12px; padding: 2px 8px; border-radius: 999px; background: #fbbf24; color: #422006; font-weight: 600; }
    .editor-panel.focus .ed-tabs { display: none; }
    .editor-panel.focus #editorForm > :not(.focus-host),
    .editor-panel.focus .focus-host > :not(#sectionsContainer),
    .editor-panel.focus #sectionsContainer > :not(.focus-on),
    .editor-panel.focus .focus-on > h3 { display: none !important; }
    .editor-panel.focus .focus-on { border: none; padding: 0; margin: 0; }
    .editor-panel.focus .focus-on > .section-toolbar { padding: 4px 2px 0; justify-content: flex-end; }
    .editor-panel.focus .focus-on .drag-handle, .editor-panel.focus .focus-on .sec-move { display: none; }
    .grp-title + p { margin-top: 6px !important; }
    /* settings in titled boxes */
    .grp { border: 1px solid var(--border); border-radius: 12px; padding: 2px 14px 14px; margin: 12px 0; background: #fff; transition: border-color .15s, box-shadow .15s; }
    .grp:hover { border-color: #93c5fd; }
    .grp-title { font-weight: 700; font-size: 12.5px; text-transform: uppercase; letter-spacing: .05em; color: #1e3a8a; margin: 12px 0 0; }
    .grp-title + label, .grp-title + * > label:first-child { margin-top: 8px; }
    /* page sections list: the one being edited is marked */
    .draggable-section.collapsed:hover { border-color: #93c5fd; background: #fff; }
    /* picture tiles: card arrangements and footer designs */
    .cp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 8px; }
    .cp-grid.cp-wide { grid-template-columns: repeat(auto-fill, minmax(124px, 1fr)); }
    .cp-tile { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; margin: 0; padding: 10px 6px 8px; border: 2px solid var(--border); border-radius: 10px; background: #fff; cursor: pointer; font-weight: 500; font-size: 12.5px; text-align: center; line-height: 1.25; color: var(--text); }
    .cp-tile:hover { border-color: #94a3b8; }
    .cp-tile input { position: absolute; opacity: 0; width: 1px; height: 1px; }
    .cp-tile svg { width: 60px; height: 40px; color: #64748b; }
    .cp-tile:has(input:checked) { border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37,99,235,.18); }
    .cp-tile:has(input:checked) svg { color: var(--primary); }
    .cp-tile:has(input:focus-visible) { outline: 3px solid #93c5fd; outline-offset: 2px; }
    /* move a card up or down */
    .row-move { display: inline-flex; flex-direction: column; gap: 2px; flex: none; }
    .row-move button { background: #f1f5f9; color: var(--text); border: 1px solid var(--border); padding: 0; width: 30px; min-height: 19px; font-size: 11px; line-height: 1; border-radius: 6px; }
    .row-move button:hover, .row-move button:focus-visible { background: #dbeafe; }
    /* Fonts > Special Fonts cards */
    .sf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; margin: 6px 0 12px; }
    .sf-card { border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; background: #fff; display: flex; flex-direction: column; gap: 6px; }
    .sf-sample { font-size: 28px; line-height: 1.15; min-height: 66px; display: flex; align-items: center; overflow: hidden; word-break: break-word; }
    .sf-name { font-size: 12.5px; } .sf-name .muted { display: block; }
    .sf-use { display: flex; gap: 6px; } .sf-use .btn-secondary { padding: 4px 10px; font-size: 12.5px; }
    .sf-use .btn-secondary.on { background: var(--primary); color: #fff; border-color: transparent; }
  </style>
</head>
<body>
  <div class="cmdk" id="cmdk" hidden role="dialog" aria-modal="true" aria-label="Search settings">
    <div class="cmdk-box">
      <input type="text" id="cmdkInput" placeholder="Search settings, sections and tools…" autocomplete="off" aria-controls="cmdkList" aria-label="Search settings, sections and tools">
      <ul id="cmdkList" role="listbox"></ul>
      <p class="cmdk-foot">&uarr; &darr; to move &middot; Enter to open &middot; Esc to close</p>
    </div>
  </div>
  <% const bizCount = (leadCount || 0) + (pendingReviews || 0) + (pendingBookings || 0); %>
  <nav class="ed-top">
    <div class="row">
      <a href="/dashboard" class="muted">&larr; Dashboard</a>
      <strong><%= site.name %></strong>
      <span class="undo-btns"><button type="button" id="undoBtn" title="Undo (Ctrl+Z)" aria-label="Undo" disabled>&#8630;</button><button type="button" id="redoBtn" title="Redo (Ctrl+Shift+Z)" aria-label="Redo" disabled>&#8631;</button></span>
      <span class="autosave-status" id="autosaveStatus"></span>
    </div>
    <div class="row ed-actions">
      <a href="/sites/<%= site.id %>/preview" target="_blank" class="btn-secondary btn" title="Open the full preview in a new tab">Preview</a>
      <details class="menu">
        <summary class="btn btn-secondary">Show the client</summary>
        <div class="menu-list">
          <a href="/sites/<%= site.id %>/pitch"><strong>Pitch mode</strong><span>Full-screen show of the site that scrolls itself</span></a>
          <a href="/sites/<%= site.id %>/compare"><strong>Compare 3 designs</strong><span>The same business in three styles, side by side</span></a>
          <a href="/sites/<%= site.id %>/pitch#share"><strong>Share a preview link</strong><span>A private link the client can open on their phone</span></a>
        </div>
      </details>
      <details class="menu">
        <summary class="btn btn-secondary">Design tools</summary>
        <div class="menu-list">
          <a href="/sites/<%= site.id %>/lab"><strong>Design lab</strong><span>Shuffle style, fonts, colors and layouts, lock what you like</span></a>
          <a href="/sites/<%= site.id %>/brand"><strong>Brand kit</strong><span>Colors, fonts, buttons, browser icon and share picture from the logo</span></a>
          <a href="/sites/<%= site.id %>/blocks"><strong>Blocks</strong><span>Mix and match: build the home page from any section of any style</span></a>
          <a href="/sites/<%= site.id %>/signature"><strong>Signature pieces</strong><span>22 live artwork home pages, one made for each industry (premium)</span></a>
          <a href="/sites/<%= site.id %>/styles"><strong>Style Library</strong><span>44 styles on 8 page blueprints, each shown with this site's own hero</span></a>
          <a href="/sites/<%= site.id %>/devices"><strong>Device wall</strong><span>Phone, tablet, laptop and wide screen at once, download as a picture</span></a>
        </div>
      </details>
      <a href="/sites/<%= site.id %>/quality" class="btn-secondary btn" title="Check contrast, mobile tap sizes, photos and fonts before you publish">Check quality</a>
      <details class="menu">
        <summary class="btn btn-secondary">Business<% if (bizCount) { %> <span class="count"><%= bizCount %></span><% } %></summary>
        <div class="menu-list">
          <a href="/sites/<%= site.id %>/leads">Leads<% if (leadCount) { %> (<%= leadCount %>)<% } %></a>
          <a href="/sites/<%= site.id %>/reviews">Reviews<% if (pendingReviews) { %> (<%= pendingReviews %> new)<% } %></a>
          <% if (site.sections.booking.enabled || pendingBookings) { %><a href="/sites/<%= site.id %>/bookings">Bookings<% if (pendingBookings) { %> (<%= pendingBookings %> new)<% } %></a><% } %>
          <a href="/sites/<%= site.id %>/payments">Payments</a>
          <a href="/sites/<%= site.id %>/report">Report</a>
          <a href="/sites/<%= site.id %>/billing">Billing</a>
        </div>
      </details>
      <div class="split-btn">
        <form method="POST" action="/sites/<%= site.id %>/publish">
          <input type="hidden" name="published" value="<%= site.published ? '0' : '1' %>">
          <button type="submit" class="<%= site.published ? 'btn-danger' : '' %>">
            <%= site.published ? 'Unpublish' : 'Publish' %>
          </button>
        </form>
        <details class="menu menu-right">
          <summary class="btn <%= site.published ? 'btn-danger' : '' %>" aria-label="More publishing options">&#9662;</summary>
          <div class="menu-list">
            <% if (site.published) { %><a href="/site/<%= site.slug %>" target="_blank">View live</a><% } %>
            <a href="/sites/<%= site.id %>/hosting" title="Publish to Netlify with your own domain and HTTPS">Publish online (Netlify)</a>
            <a href="/sites/<%= site.id %>/export" title="Download the finished site as a zip of plain HTML files">Export as a zip</a>
            <a href="/sites/<%= site.id %>/history" title="Look at and roll back to an earlier publish">Publish history</a>
          </div>
        </details>
      </div>
    </div>
  </nav>

  <div class="editor-layout">
    <% const startTab = bookingFlash ? 'features' : (newClientLink || clientLinkFlash || newInvite || clientUserFlash) ? 'settings' : (typeof indFlash !== 'undefined' && indFlash) ? 'design' : 'content'; %>
    <div class="editor-panel" id="editorPanel" data-tab="<%= startTab %>">
      <% if (saved) { %><div class="flash">Saved.</div><% } %>
      <% if (imported) { %><div class="flash">Imported from your old site and switched to a modern theme — review and edit anything below, then publish.</div><% } %>
      <% if (refreshed) { %><div class="flash">Refreshed content from the source URL. Your previous version was saved to history in case you want it back.</div><% } %>
      <% if (fromIntake) { %><div class="flash">Built from your client's questionnaire answers. Their own words were used for the services, story and FAQ. Review the "Check these" list on their answers page before publishing.</div><% } %>
      <% if (generated && generatedByAi) { %><div class="flash">Generated a starting point and wrote the text with AI from the details you gave. Read it through and fix anything that isn't accurate for this business before publishing.</div><% } else if (generated) { %><div class="flash">Generated a starting point for your site from the built-in templates — the text is generic starter copy, so review it (especially any claims like "licensed", "24/7" or "same-day") before publishing.</div><% } %>
      <% if (rewrite === 'done') { %><div class="flash">Rewrote the text with AI. Your previous version was saved to history in case you want it back.</div><% } %>
      <% if (rewrite === 'failed') { %><div class="flash" style="background:#fef2f2; color:#991b1b;">The AI rewrite didn't work this time (nothing was changed). Try again in a moment.</div><% } %>
      <% if (rewrite === 'off') { %><div class="flash" style="background:#fef2f2; color:#991b1b;">AI rewriting isn't set up yet — add ANTHROPIC_API_KEY to the .env file (see the README).</div><% } %>

      <div class="ed-sticky">
        <div class="blanks-bar" id="blanksBar">
          <div class="blanks-top">
            <span id="blanksSummary"></span>
            <span class="blanks-btns">
              <button type="button" class="btn-secondary" id="blanksNext">Next &rarr;</button>
              <button type="button" class="btn-secondary" id="blanksToggle" aria-expanded="false" aria-controls="blanksList">Show list</button>
            </span>
          </div>
          <ul id="blanksList" hidden></ul>
        </div>
        <div class="ed-tabs" role="tablist" aria-label="Editor sections">
          <button type="button" role="tab" data-tab-btn="content">Content</button>
          <button type="button" role="tab" data-tab-btn="design">Design</button>
          <button type="button" role="tab" data-tab-btn="features">Features</button>
          <button type="button" role="tab" data-tab-btn="settings">Settings</button>
          <button type="button" class="cmdk-open" id="cmdkOpen" title="Find any setting, section or tool">Search<kbd>Ctrl K</kbd></button>
        </div>
        <div class="focus-bar" id="focusBar">
          <button type="button" id="focusBack" title="Back to the list of page sections">&larr; All sections</button>
          <strong class="fb-title" id="focusTitle"></strong>
          <span class="fb-hidden" id="focusHidden" hidden>Hidden</span>
        </div>
      </div>

      <form method="POST" action="/sites/<%= site.id %>/edit" id="editorForm" novalidate>
        <input type="hidden" name="pics_json" id="picsJson" value="<%= JSON.stringify(picBoxes.clean(((site.sections.texts || {}).pics))) %>">
        <input type="hidden" name="texts_json" id="textsJson" value="<%= JSON.stringify(textBoxes.clean(((site.sections.texts || {}).items))) %>">
        <input type="hidden" name="tstyles_json" id="tstylesJson" value="<%= JSON.stringify(textStyles.clean(((site.sections.texts || {}).styles))) %>">
        <input type="hidden" name="estyles_json" id="estylesJson" value="<%= JSON.stringify(elStyles.clean(((site.sections.texts || {}).elems))) %>">
        <input type="hidden" name="wmarks_json" id="wmarksJson" value="<%= JSON.stringify(watermark.clean(((site.sections.texts || {}).wmarks))) %>">

        <div class="section-block" data-tab="content" id="basicsBlock">
          <h3>Business basics</h3>
          <label>Business name</label>
          <input type="text" name="name" value="<%= site.name %>" maxlength="80">
          <label>Logo</label>
          <div class="upload-row">
            <input type="url" name="theme_logoUrl" value="<%= site.theme.logoUrl || '' %>" placeholder="https://... or upload">
            <input type="file" accept="image/*" class="file-input" hidden>
            <button type="button" class="btn-secondary upload-btn">Upload</button>
          </div>
          <label>Browser icon (favicon)</label>
          <div class="upload-row">
            <input type="url" name="theme_faviconUrl" value="<%= site.theme.faviconUrl || '' %>" placeholder="Empty = the logo, or the first letter of the name">
            <input type="file" accept="image/*" class="file-input" hidden>
            <button type="button" class="btn-secondary upload-btn">Upload</button>
          </div>
          <input type="hidden" name="theme_touchIconUrl" value="<%= site.theme.touchIconUrl || '' %>">
          <p class="muted" style="font-size:12.5px; margin:4px 0 0;"><a href="/sites/<%= site.id %>/brand">Brand kit</a> makes the icon, a share picture, matching colors, fonts and button shape from the logo.</p>
        </div>

        <div data-tab="content" class="focus-host">
        <h3 style="margin-top:4px;">Page sections</h3>
        <p class="muted" style="font-size:13px; margin-top:-8px;">Drag to reorder. Tick "Hidden from published page" to hide a section without deleting its content. Tip: click anything in the preview to jump to its box here.</p>

        <% // the list holds the page sections and the content blocks (blk:<id>, each one's editor is moved into its entry)
           const _blkItems = ((site.sections.blocks && site.sections.blocks.items) || []).filter(b => b.id);
           const _blkKinds = blockKinds;
           const _blkTitle = b => 'Content block · ' + (_blkKinds[b.type] || 'Block') + (b.heading ? ': ' + b.heading.replace(/[\[\]]/g, '').slice(0, 40) : '');
           // the heading shown in the list: a small picture of the block's layout, its own heading (or the design's name
           // when it has none yet) and a tag in its group's color with the design's name (blockcatalog.js)
           const _esc = t => String(t).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
           const _blkHead = b => { const i = blockCatalog.info(b.type), h = String(b.heading || '').replace(/\{\{([^{}|<>]{1,300}?)(?:\|[^{}|<>]{0,40}){1,6}\}\}/g, '$1').replace(/[\[\]]/g, '').trim();
             return i.pic + '<span class="blk-h3-main">' + _esc(h ? h.slice(0, 60) : i.name) + '</span><span class="blk-tag" title="' + _esc(i.groupLabel) + '">' + _esc(i.name) + '</span>'; };
           const _listKeys = (site.layout.items || site.layout.order).filter(k => !k.startsWith('blk:') || _blkItems.some(b => 'blk:' + b.id === k));
           _blkItems.forEach(b => { if (!_listKeys.includes('blk:' + b.id)) _listKeys.push('blk:' + b.id); }); %>
        <input type="hidden" name="layout_order" id="layoutOrderInput" value="<%= _listKeys.join(',') %>">

        <div id="sectionsContainer">
          <% _listKeys.forEach(key => { %>
            <% if (key.startsWith('blk:')) { const _b = _blkItems.find(b => 'blk:' + b.id === key); %>
            <div class="section-block draggable-section blk-entry" draggable="true" data-key="<%= key %>" style="--g:<%= blockCatalog.info(_b.type).color %>">
              <div class="section-toolbar">
                <div class="left">
                  <span class="drag-handle" title="Drag to reorder">⠿</span>
                </div>
                <label class="hide-toggle">
                  <input type="checkbox" name="hidden_sections" value="<%= key %>" <%= site.layout.hidden.includes(key) ? 'checked' : '' %>>
                  Hidden from published page
                </label>
              </div>
              <h3 class="blk-h3" data-name="<%= _blkTitle(_b) %>"><%- _blkHead(_b) %></h3>
              <div class="blk-host" data-blk-host="<%= _b.id %>"></div>
            </div>
            <% return; } %>
            <div class="section-block draggable-section" draggable="true" data-key="<%= key %>">
              <div class="section-toolbar">
                <div class="left">
                  <span class="drag-handle" title="Drag to reorder">⠿</span>
                </div>
                <label class="hide-toggle">
                  <input type="checkbox" name="hidden_sections" value="<%= key %>" <%= site.layout.hidden.includes(key) ? 'checked' : '' %>>
                  Hidden from published page
                </label>
              </div>
              <%- include('sections/' + key, { site }) %>
            </div>
          <% }) %>
        </div>
        </div>

        <details class="section-block settings-block" data-tab="settings" open>
          <summary>Site &amp; SEO settings</summary>
          <label>Custom domain (optional)</label>
          <input type="text" name="custom_domain" value="<%= site.custom_domain || '' %>" placeholder="www.yourdomain.com">
          <p class="muted" style="font-size:13px;">Point this domain's DNS at wherever this app is hosted for it to work.</p>
          <label>Browser tab title (SEO)</label>
          <input type="text" name="seo_title" value="<%= site.sections.seo ? site.sections.seo.title : '' %>" maxlength="70">
          <label>Search description (SEO)</label>
          <textarea name="seo_description" maxlength="160"><%= site.sections.seo ? site.sections.seo.description : '' %></textarea>
          <label>Share picture (optional)</label>
          <input type="text" name="seo_shareImage" value="<%= site.sections.seo && site.sections.seo.shareImage ? site.sections.seo.shareImage : '' %>" placeholder="Picture shown when the site link is texted or posted. Empty = the home photo">
        </details>

        <details class="section-block settings-block" data-tab="features" id="followUpBlock">
          <summary>Lead follow-up</summary>
          <% const fuC = site.sections.contact || {}; const fu = fuC.followUp || { enabled: false, steps: [] }; const fuSteps = [0, 1, 2].map(i => fu.steps[i] || { afterHours: [24, 72, 168][i], text: '' }); %>
          <label class="check"><input type="checkbox" name="rem_off" value="1" <%= fuC.remindersOff ? 'checked' : '' %>> Do not email me "follow up today" reminders</label>
          <p class="muted" style="font-size:12.5px;">Set a follow-up date on any lead (Leads page). On that day you get one email listing the leads that are due.</p>
          <label class="check"><input type="checkbox" name="fu_enabled" value="1" <%= fu.enabled ? 'checked' : '' %>> Email new leads automatically if I have not been in touch</label>
          <p class="muted" style="font-size:12.5px;">Only leads who left an email address. Each step is sent only while the lead is still marked <strong>New</strong>: change the status (Contacted, Quoted, Won, Lost) and the rest are cancelled. Every email has a "stop emailing me" link. Needs email sending set up (README). Use [name], [business] and [phone] in the text. Empty text uses a plain default.</p>
          <% fuSteps.forEach((st, i) => { %>
            <div class="seo-page-row" style="padding:8px 10px;">
              <strong>Email <%= i + 1 %></strong> — send after
              <input type="number" name="fu_hours" min="1" max="720" value="<%= st.afterHours %>" style="width:80px; display:inline-block; margin:0 6px;"> hours
              <textarea name="fu_text" rows="3" maxlength="1200" placeholder="<%= leadsLibDefault %>"><%= st.text %></textarea>
            </div>
          <% }) %>
        </details>

        <details class="section-block settings-block" data-tab="features" id="calcBlock" <%= calcLib.normalize(site.sections.calculator).enabled ? 'open' : '' %>>
          <summary>Quote / estimate calculator</summary>
          <%- include('sections/_calculator', { site }) %>
        </details>

        <details class="section-block settings-block" data-tab="features" id="chatBlock">
          <summary>Chat assistant</summary>
          <% const chc = site.sections.chat || {}; %>
          <label class="check"><input type="checkbox" name="chat_enabled" value="1" <%= chc.enabled ? 'checked' : '' %>> Show a chat bubble on the site</label>
          <p class="muted" style="font-size:12.5px;">Visitors ask questions and get short answers taken only from this site's text: services, FAQ, hours and contact details. When it does not know, it says so and offers a box to leave their details, which arrives as a lead (marked "From chat") with the conversation attached. <%= hasAi() ? 'AI is set up on this server.' : 'No AI key is set up on this server, so it will answer from your FAQ and hours only (see the README to add one).' %> Add real FAQ answers for best results. It is labelled as automated.</p>
          <label>Greeting (optional)</label>
          <input type="text" name="chat_greeting" value="<%= chc.greeting || '' %>" maxlength="200" placeholder="Hi! Ask a question about <%= site.name %>.">
          <label>Most AI replies per day for this site (keeps costs in check)</label>
          <input type="number" name="chat_dailyCap" min="10" max="1000" value="<%= chc.dailyCap || 200 %>">
        </details>

        <details class="section-block settings-block" data-tab="settings" id="legalBlock">
          <summary>Privacy &amp; Terms pages</summary>
          <% const lg = site.sections.legal || {}; %>
          <label class="check"><input type="checkbox" name="legal_enabled" value="1" <%= lg.enabled ? 'checked' : '' %>> Add Privacy Policy and Terms of Use pages (linked in the footer)</label>
          <p class="muted" style="font-size:12.5px;">The text is written from what this site really does: forms, booking, analytics and fonts only appear if they apply. It is a starting template, not legal advice. Have a lawyer look it over before you rely on it.</p>
          <label>Business name used in the text</label>
          <input type="text" name="legal_ownerName" value="<%= lg.ownerName || '' %>" maxlength="120" placeholder="<%= site.name %>">
          <label>Privacy contact email</label>
          <input type="email" name="legal_email" value="<%= lg.email || '' %>" maxlength="254" placeholder="Empty = the contact email">
          <label>Business address (optional)</label>
          <input type="text" name="legal_address" value="<%= lg.address || '' %>" maxlength="200">
          <label>State whose laws apply (optional)</label>
          <input type="text" name="legal_state" value="<%= lg.state || '' %>" maxlength="60" placeholder="Florida">
          <label>"Last updated" date</label>
          <input type="text" name="legal_updated" value="<%= lg.updated || '' %>" maxlength="40" placeholder="Empty = set when you save">
          <label>Notice bar</label>
          <select name="legal_banner"><% [['', 'Only when visitor tracking is on (asks to accept)'], ['always', 'Also show a short privacy notice on every site']].forEach(o => { %><option value="<%= o[0] %>" <%= (lg.banner || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <label>Extra privacy text (optional)</label>
          <textarea name="legal_privacyExtra" rows="3" maxlength="3000"><%= lg.privacyExtra || '' %></textarea>
          <label>Extra terms (optional, e.g. cancellation or payment rules)</label>
          <textarea name="legal_termsExtra" rows="3" maxlength="3000"><%= lg.termsExtra || '' %></textarea>
        </details>

        <details class="section-block settings-block" data-tab="settings" id="seoPagesBlock">
          <summary>Search &amp; sharing for each page</summary>
          <%- include('sections/_seo-pages', { site }) %>
        </details>

        <details class="section-block settings-block" data-tab="design" open>
          <summary>Theme</summary>
          <label>Approved client styles</label>
          <div class="style-cards" id="styleCards">
            <% extraThemes.THEMES.filter(t => t.no).forEach(t => { const v = t.vars || {}; %>
              <button type="button" class="style-card<%= site.theme.style === t.id ? ' on' : '' %>" data-style="<%= t.id %>" title="<%= t.label %>" style="--c-bg:<%= v['--page-bg'] || '#fff' %>; --c-ink:<%= v['--ink'] || '#111' %>; --c-pri:<%= (t.palette || {}).primary || '#2563eb' %>; --c-acc:<%= (t.palette || {}).accent || '#333' %>;">
                <span class="sc-swatch"><span class="sc-aa" style="font-family:<%= t.heading ? t.heading.css : 'inherit' %>">Aa</span><i></i><i></i></span>
                <span class="sc-name"><%= t.no %>. <%= t.label.split(' (')[0] %></span>
              </button>
            <% }) %>
          </div>
          <label for="themeStyleSel">All styles</label>
          <select name="theme_style" id="themeStyleSel">
            <option value="modern" <%= site.theme.style==='modern'?'selected':'' %>>Modern</option>
            <option value="classic" <%= site.theme.style==='classic'?'selected':'' %>>Classic</option>
            <option value="bold" <%= site.theme.style==='bold'?'selected':'' %>>Bold</option>
            <option value="editorial" <%= site.theme.style==='editorial'?'selected':'' %>>Editorial</option>
            <option value="minimal" <%= site.theme.style==='minimal'?'selected':'' %>>Minimal</option>
            <option value="warm" <%= site.theme.style==='warm'?'selected':'' %>>Warm</option>
            <option value="midnight" <%= site.theme.style==='midnight'?'selected':'' %>>Midnight (dark)</option>
            <option value="split" <%= site.theme.style==='split'?'selected':'' %>>Split hero (photo on the right)</option>
            <option value="poster" <%= site.theme.style==='poster'?'selected':'' %>>Poster (loud, flat)</option>
            <option value="agency" <%= site.theme.style==='agency'?'selected':'' %>>Agency (full home page: tiles, service photos, reviews)</option>
            <% extraThemes.THEMES.filter(t => !t.no && !t.lib && !t.atelier && !t.tpl).forEach(t => { %><option value="<%= t.id %>" <%= site.theme.style===t.id?'selected':'' %>><%= t.label %></option><% }) %>
            <optgroup label="Approved client styles (style index 1 to 12)">
              <% extraThemes.THEMES.filter(t => t.no).forEach(t => { %><option value="<%= t.id %>" <%= site.theme.style===t.id?'selected':'' %>><%= t.no %>. <%= t.label %></option><% }) %>
            </optgroup>
            <optgroup label="From free templates (MIT): pair with their blocks">
              <% extraThemes.THEMES.filter(t => t.tpl).forEach(t => { %><option value="<%= t.id %>" <%= site.theme.style===t.id?'selected':'' %>><%= t.label %></option><% }) %>
            </optgroup>
            <optgroup label="Style Library (<%= extraThemes.LIB_IDS.length %> styles)">
              <% extraThemes.THEMES.filter(t => t.lib).forEach(t => { %><option value="<%= t.id %>" <%= site.theme.style===t.id?'selected':'' %>><%= t.label %></option><% }) %>
            </optgroup>
            <optgroup label="Signature pieces, premium (<%= extraThemes.ATELIER_IDS.length %>)">
              <% extraThemes.THEMES.filter(t => t.atelier).forEach(t => { %><option value="<%= t.id %>" <%= site.theme.style===t.id?'selected':'' %>><%= t.label %></option><% }) %>
            </optgroup>
          </select>
          <p class="muted" style="font-size:12.5px; margin:0 0 6px;"><a href="/sites/<%= site.id %>/styles">Browse the Style Library</a> to see every style with this site's own hero, or the <a href="/sites/<%= site.id %>/signature">Signature pieces</a>: live artwork home pages, one per industry.</p>
          <p class="muted" id="styleHint" style="font-size:13px; margin:0 0 8px;"><%= extraThemes.STYLE_HINTS[site.theme.style] || '' %></p>
          <p id="stylePalette" style="font-size:13px; margin:0 0 8px;<%= (extraThemes.byId[site.theme.style] && extraThemes.byId[site.theme.style].palette) ? '' : ' display:none;' %>">
            <button type="button" class="btn-secondary" id="stylePaletteBtn">Use this style's own colors</button>
            <span class="muted">If the client has brand colors, keep theirs instead: they replace only the brand and accent colors.</span>
          </p>

          <label>Home page layout</label>
          <% const layoutNow = site.theme.homeLayout || (site.theme.homeFull ? 'full' : ''); %>
          <select name="theme_homeLayout">
            <% [['', 'Automatic (the style decides)'], ['basic', 'Basic: hero and photos only'], ['full', 'Full: service tiles, service cards, reviews'], ['story', 'Story: photo + text rows for each service'], ['tiles', 'Photo tiles: big image tiles for each service'], ['list', 'List: numbered service list'], ['showcase', 'Showcase: big photo + alternating service rows'], ['split', 'Split: photo beside the intro, service cards below'], ['servicesfirst', 'Services first: services right under the hero'], ['trust', 'Trust-led: big stats, numbered services, reviews'], ['photos', 'Photo-heavy: large gallery and photo tiles'], ['localpro', 'Local pro: reviews, why-choose cards, FAQ, areas and a quote form on the home page'], ['blueprint', 'Industry blueprint: sections chosen and ordered for this kind of business (section library)'], ['stylelib', "Style Library page: the style's own hero and sections (Style Library styles only)"], ['atelier', "Signature page: the piece's live artwork over your content (Signature pieces only)"], ['mix', 'Mix and match blocks: any sections from any style, in your order (built on the Blocks page)']].forEach(o => { %><option value="<%= o[0] %>" <%= layoutNow === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
          </select>
          <input type="hidden" name="theme_mix" value="<%= JSON.stringify(site.theme.mix || []) %>">
          <p class="muted" style="font-size:12.5px; margin:4px 0 8px;">The preview on the right updates after a moment. Pick a style, then try different home layouts. To mix sections from different styles, open the <a href="/sites/<%= site.id %>/blocks">Blocks page</a><%= (site.theme.mix || []).length ? ' (' + site.theme.mix.length + ' blocks saved)' : '' %>.</p>
          <div id="slBpRow"<%= String(site.theme.style || '').startsWith('sl-') ? '' : ' hidden' %>>
            <label for="theme_slBlueprint">Style Library blueprint</label>
            <select name="theme_slBlueprint" id="theme_slBlueprint">
              <option value="" <%= !site.theme.slBlueprint ? 'selected' : '' %>>The style's own</option>
              <% Object.keys(styleLibBlueprints).forEach(k => { %><option value="<%= k %>" <%= site.theme.slBlueprint === k ? 'selected' : '' %>><%= styleLibBlueprints[k].name %>: <%= styleLibBlueprints[k].note %></option><% }) %>
            </select>
            <p class="muted" style="font-size:12.5px; margin:4px 0 8px;">Style Library styles draw their own home page with "Automatic" or "Style Library page" above. Sections with nothing real to show are left out.</p>
          </div>
          <% if (bpUi) { %>
          <details class="sub">
            <summary>Industry blueprint sections</summary>
          <div id="bpPanel" style="border:1px solid var(--border,#e2e8f0); border-radius:10px; padding:12px 14px; margin:8px 0 12px;">
            <strong>Industry blueprint</strong>
            <p class="muted" style="font-size:12.5px; margin:4px 0 8px;">Used when the home layout above is "Industry blueprint". Sections with no real content on your site are skipped automatically.</p>
            <label for="theme_blueprint">Blueprint</label>
            <select name="theme_blueprint" id="theme_blueprint">
              <option value="" <%= !site.theme.blueprint || site.theme.blueprint === 'auto' ? 'selected' : '' %>>Automatic: <%= bpUi.all[bpUi.resolved].label %></option>
              <% Object.keys(bpUi.all).forEach(id => { %><option value="<%= id %>" <%= site.theme.blueprint === id ? 'selected' : '' %>><%= bpUi.all[id].label %></option><% }) %>
            </select>
            <p class="muted" style="font-size:12.5px; margin:4px 0 8px;"><%= bpUi.all[bpUi.resolved].note %></p>
            <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin:6px 0 10px;">
              <button type="button" class="btn-secondary" id="bpShuffle" title="Pick a different mix of section layouts">&#127922; Shuffle layouts</button>
              <button type="button" class="btn-secondary" id="bpShuffleUndo" hidden>Undo shuffle</button>
              <label style="font-weight:400; margin:0;">Photo sides
                <select name="theme_bpAlt" style="width:auto; display:inline-block; margin:0 0 0 4px;"><option value="" <%= site.theme.bpAlt !== 'off' ? 'selected' : '' %>>Alternate automatically</option><option value="off" <%= site.theme.bpAlt === 'off' ? 'selected' : '' %>>Keep each layout's own side</option></select></label>
            </div>
            <p class="muted" style="font-size:12.5px; margin:0 0 8px;">Shuffle switches the home page to this blueprint and picks a new layout for every section. &rsaquo; steps one section to its next layout. In the preview, hover a section for the same buttons.</p>
            <% bpUi.rows.forEach(sec => { const cur = (site.theme.bpVariants || {})[sec.family] || sec.variant; const off = (site.theme.bpSkip || []).includes(sec.family); %>
              <div style="display:flex; gap:10px; align-items:center; margin:6px 0; flex-wrap:wrap;">
                <span style="min-width:120px; font-weight:600;"><%= bpUi.families[sec.family] %></span>
                <select name="bpv_<%= sec.family %>" style="flex:1; min-width:160px;" data-bp-variant="<%= sec.family %>">
                  <% bpUi.variants[sec.family].forEach(v => { %><option value="<%= v.variant %>" <%= cur === v.variant ? 'selected' : '' %> data-flip="<%= v.flippable ? 1 : 0 %>" title="<%= v.hint %>"><%= v.label %></option><% }) %>
                </select>
                <button type="button" class="btn-secondary bp-next" data-bp-next="<%= sec.family %>" title="Next layout" aria-label="Next layout for <%= bpUi.families[sec.family] %>">&rsaquo;</button>
                <% const so0 = (site.theme.bpSec || {})[sec.family] || {}; %>
                <label style="font-weight:400; display:flex; gap:6px; align-items:center;" title="Mirror the layout: photo on the left becomes photo on the right"><input type="checkbox" name="bps_<%= sec.family %>_flip" value="1" <%= so0.flip ? 'checked' : '' %>> Flip</label>
                <label style="font-weight:400; display:flex; gap:6px; align-items:center;"><input type="checkbox" name="bp_skip" value="<%= sec.family %>" <%= off ? 'checked' : '' %>> Leave out</label>
              </div>
              <% { const so = (site.theme.bpSec || {})[sec.family] || {}; %>
              <details style="margin:0 0 8px 0; padding-left:2px;">
                <summary style="cursor:pointer; font-size:13px; color:var(--muted,#64748b);">Size, photo and effects for this section<%= (so.shape || so.emoji || so.doodle || so.bg || so.title || so.space || so.width || so.text || so.padY || so.maxW || so.fs || so.photo) ? ' (changed)' : '' %></summary>
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:6px;">
                  <label style="flex:1; min-width:150px; font-weight:400;">Heading text <input type="text" name="bps_<%= sec.family %>_title" value="<%= so.title || '' %>" maxlength="80" placeholder="Automatic"></label>
                  <label style="width:110px; font-weight:400;">Emoji <input type="text" name="bps_<%= sec.family %>_emoji" value="<%= so.emoji || '' %>" maxlength="12" placeholder="e.g. 🔧"></label>
                  <label style="flex:1; min-width:150px; font-weight:400;">Hand-drawn underline
                    <select name="bps_<%= sec.family %>_doodle"><% [['', 'Follow the site setting'], ['on', 'On for this section'], ['off', 'Off for this section']].forEach(o => { %><option value="<%= o[0] %>" <%= (so.doodle || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></label>
                  <label style="flex:1; min-width:150px; font-weight:400;">Photo shape
                    <select name="bps_<%= sec.family %>_shape"><% [['', 'Normal'], ['arch', 'Arch'], ['circle', 'Circle'], ['blob', 'Soft blob']].forEach(o => { %><option value="<%= o[0] %>" <%= (so.shape || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></label>
                  <label style="flex:1; min-width:150px; font-weight:400;">Background
                    <select name="bps_<%= sec.family %>_bg"><% [['', 'Default'], ['alt', 'Alternate shade'], ['brand', 'Brand color'], ['themegrad', 'Brand gradient (brand to accent)'], ['color', 'Your color (pick below)'], ['gradient', 'Your gradient (pick below)'], ['preset', 'Gradient from the gallery (pick below)']].forEach(o => { %><option value="<%= o[0] %>" <%= (so.bg || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></label>
                </div>
                <% if (sec.family !== 'hero' && sec.family !== 'banner') { %><%- include('sections/_size-controls', { pre: 'bps_' + sec.family + '_', o: so, photo: true }) %><% } %>
              </details>
              <% } %>
            <% }) %>
            <p style="margin:10px 0 4px; font-weight:600;">Add a section</p>
            <div style="display:flex; flex-wrap:wrap; gap:6px 16px;">
              <% Object.keys(bpUi.families).filter(f => f !== 'hero' && f !== 'custom' && !bpUi.rows.some(r => r.family === f && !r.added)).forEach(f => { %>
                <label style="font-weight:400; display:flex; gap:6px; align-items:center;"><input type="checkbox" name="bp_add" value="<%= f %>" <%= (site.theme.bpAdd || []).includes(f) ? 'checked' : '' %>> <%= bpUi.families[f] %></label>
              <% }) %>
            </div>
            <p class="muted" style="font-size:12.5px; margin:4px 0 0;">Added sections show on any home layout: with "Industry blueprint" they take their place in the order, with other layouts they go near the end of the home page. A section only shows when the site has content for it (the scrolling banner needs at least 3 badges, services or towns).</p>
            <label style="font-weight:400; display:flex; gap:6px; align-items:center; margin-top:8px;"><input type="checkbox" name="theme_bpHero" value="native" <%= site.theme.bpHero === 'native' ? 'checked' : '' %>> Keep my original hero (for video or photo slides)</label>
          </div>
          </details>
          <% } %>
          <label>Type of business</label>
          <input type="text" name="meta_businessType" maxlength="100" value="<%= (site.sections.meta && site.sections.meta.businessType) || '' %>" placeholder="e.g. roofer, dog groomer, restaurant, law firm">
          <p class="muted" style="font-size:12.5px; margin:4px 0 8px;"><%= designAdvice ? 'Used for the suggestions below. Change it and save to see different ones.' : 'Type your kind of business, then save, to get style, color and font suggestions that suit it.' %></p>
          <% if (typeof indFlash !== 'undefined' && indFlash) { const IM = { ok: 'Done. The wording and/or photos were replaced to suit this business. Your old version is in Version history if you want it back.', partial: 'Wording was replaced, but no photos were found. Photos need a Pexels key in the .env file (PEXELS_API_KEY).', nophotos: 'No photos were found, so nothing changed. Photos need a Pexels key in the .env file (PEXELS_API_KEY).', notype: 'Type your kind of business above and save first, so I know what to fill in.' }; %>
          <div class="hint" style="background:#eef6ff;border-radius:8px;padding:8px 10px;margin:8px 0;"><%= IM[indFlash] || '' %></div><% } %>
          <% if (designAdvice) { %>
          <details class="design-advice" id="designAdvice">
            <summary>Suggested for <%= designAdvice.label.toLowerCase() %></summary>
            <p class="muted" style="font-size:12.5px;margin:6px 0;">Based on design guidance for <%= designAdvice.productType %> (<%= designAdvice.fit === 'direct' ? 'a direct match' : designAdvice.fit === 'close' ? 'a close match' : 'the nearest match' %>). Click a style, color or font to try it; those do not change your text or photos.</p>
            <div style="margin:10px 0;padding:10px;border:1px dashed var(--border,#cbd5e1);border-radius:8px;">
              <strong style="font-size:13px;">Fill in for this business</strong>
              <p class="muted" style="font-size:12.5px;margin:4px 0 8px;">Replaces the headline, about text, services and FAQ, and/or the photos, with ones that suit a <%= designAdvice.label.toLowerCase() %>. Colors, contact details and hours stay. Save your other edits first. The old version is kept in Version history.</p>
              <button type="submit" form="indForm" name="what" value="both" class="btn-secondary" onclick="return confirm('Replace the wording and photos with ones that suit this business? Your old version is kept in Version history.');">Wording + photos</button>
              <button type="submit" form="indForm" name="what" value="wording" class="btn-secondary" onclick="return confirm('Replace the headline, about text, services and FAQ?');">Wording only</button>
              <button type="submit" form="indForm" name="what" value="photos" class="btn-secondary" onclick="return confirm('Replace the photos?');">Photos only</button>
            </div>
            <label>Styles that suit this business</label>
            <div class="chips" id="daStyles"><% designAdvice.recommendedStyles.forEach((s, i) => { %><button type="button" class="btn-secondary" data-da-style="<%= s %>"><%= s %><%= i === 0 ? ' (top pick)' : '' %></button> <% }) %></div>
            <label>Color sets</label>
            <div class="pal-grid" id="daPalettes"><% designAdvice.palettes.forEach(p => { %><button type="button" class="pal-sw" data-da-primary="<%= p.primaryColor %>" data-da-accent="<%= p.accentColor %>" title="<%= p.note || p.from %>"><span class="pal-dots"><i style="background:<%= p.primaryColor %>"></i><i style="background:<%= p.accentColor %>"></i></span><span class="pal-name"><%= p.from.split('/')[0] %></span></button><% }) %></div>
            <% if (designAdvice.fonts.length) { %><label>Font pairs</label>
            <div class="chips" id="daFonts"><% designAdvice.fonts.forEach(f => { %><button type="button" class="btn-secondary" data-da-heading="<%= f.heading %>" data-da-body="<%= f.body %>"><%= f.heading %> + <%= f.body %></button> <% }) %></div><% } %>
            <% if (designAdvice.landing) { %><p class="hint" style="margin-top:10px;"><strong>Page flow that works here:</strong> <%= designAdvice.landing.sections %></p><% } %>
            <% if (designAdvice.avoidStyles.length || designAdvice.tips.length) { %>
              <p class="hint"><strong>Better to avoid:</strong>
                <%= designAdvice.avoidStyles.map(a => a.id + ' style').concat(designAdvice.motion === 'calm' ? ['heavy animation'] : []).concat(designAdvice.tips.filter(t => t.length < 60)).join(', ') %>.</p>
            <% } %>
          </details>
          <% } %>
          <details class="sub">
            <summary>Colors</summary>
          <label>Primary color</label>
          <input type="text" name="theme_primaryColor" value="<%= site.theme.primaryColor %>">
          <label>Accent color</label>
          <input type="text" name="theme_accentColor" value="<%= site.theme.accentColor %>">
          <label>Background color (dark styles only)</label>
          <input type="text" name="theme_bgColor" value="<%= site.theme.bgColor || '' %>" placeholder="Leave empty to use the style's own (e.g. #0a0806)">
          <label>Company name color (in the header and footer)</label>
          <select name="theme_nameFx" onchange="document.getElementById('nameColorRow').hidden = !this.value"><% nameFx.MODES.forEach(m => { %><option value="<%= m.id %>" <%= (site.theme.nameFx || '') === m.id ? 'selected' : '' %>><%= m.label %></option><% }) %></select>
          <div id="nameColorRow" <%- site.theme.nameFx ? '' : 'hidden' %>>
            <label>Name color (optional, e.g. #e11d48)</label>
            <input type="text" name="theme_nameColor" value="<%= site.theme.nameColor || '' %>" placeholder="Leave empty to use your Primary color">
          </div>
          <p class="hint">"One color" paints the name in the color above (or your Primary color). The shine and the slow change use that color plus your Primary and Accent colors. Pale colors are darkened just enough to stay easy to read, the name stays white over a hero photo, and it holds still for visitors who turn motion off.</p>
          <div id="darkPals" class="pal-grid" style="margin:6px 0 10px;" data-note="Ready-made dark palettes for the Luxury dark style"></div>
          <p class="hint">The Luxury dark style uses your Primary color for the glow, buttons and headings. Click a palette below to set primary, accent and background together, or type your own colors above.</p>
          <div id="paletteBox" class="palette-box" data-biztype="<%= (site.sections.meta && site.sections.meta.businessType) || '' %>">
            <div id="palCheck" class="pal-check" aria-live="polite"></div>
            <details>
              <summary>Matching color palettes</summary>
              <p class="muted" style="font-size:12.5px; margin:6px 0;">Click a set to use it. Each swatch shows the primary color (buttons, links) and the accent (footer, dark bands). Your photos and text are not changed, and you can undo.</p>
              <label style="margin-top:6px;">Pull colors from a logo</label>
              <div class="pal-base"><input type="file" id="palLogoFile" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" style="margin:0;"><button type="button" class="btn-secondary" id="palLogoSite">Use the site logo</button></div>
              <p class="muted" id="palLogoMsg" style="font-size:12.5px; margin:0 0 6px;"></p>
              <div class="pal-grid" id="palLogo"></div>
              <label style="margin-top:6px;">Build matches from one color</label>
              <div class="pal-base"><input type="color" id="palBase" value="<%= /^#[0-9a-fA-F]{6}$/.test(site.theme.primaryColor) ? site.theme.primaryColor : '#2563eb' %>" aria-label="Base color"><span class="muted" style="font-size:12.5px;">Pick the client's main brand color</span></div>
              <div class="pal-grid" id="palSuggest"></div>
              <label>Ready-made for businesses like this</label>
              <div class="pal-grid" id="palIndustry"></div>
              <button type="button" class="btn-secondary" id="palUndo" style="display:none; margin-top:8px;">Undo palette</button>
            </details>
          </div>
          </details>
          <details class="sub">
            <summary>Fonts</summary>
          <label>Base font (used when no font below is picked)</label>
          <select name="theme_font">
            <option value="Inter, system-ui, sans-serif" <%= site.theme.font.startsWith('Inter')?'selected':'' %>>Inter (modern sans)</option>
            <option value="Georgia, 'Times New Roman', serif" <%= site.theme.font.startsWith('Georgia')?'selected':'' %>>Georgia (classic serif)</option>
            <option value="'Trebuchet MS', sans-serif" <%= site.theme.font.startsWith("'Trebuchet")?'selected':'' %>>Trebuchet (friendly)</option>
          </select>
          <% const groups = {}; fonts.FONTS.forEach(f => { (groups[f.group] = groups[f.group] || []).push(f); });
             const known = (n) => fonts.FONTS.some(f => f.name === n);
             const hSel = site.theme.headingFont || '', bSel = site.theme.bodyFont || ''; %>
          <label>Heading font</label>
          <select name="theme_headingFont" class="font-pick" data-sample="headingSample">
            <option value="">Style default</option>
            <% Object.keys(groups).forEach(g => { %><optgroup label="<%= g %>"><% groups[g].forEach(f => { %><option value="<%= f.name %>" <%= hSel === f.name ? 'selected' : '' %>><%= f.name %><%= f.hint ? ' — ' + f.hint : '' %></option><% }) %></optgroup><% }) %>
          </select>
          <input type="text" name="theme_headingFontCustom" value="<%= hSel && !known(hSel) ? hSel : '' %>" placeholder="…or type any Google Font name, e.g. Fascinate" class="font-custom" data-sample="headingSample">
          <div id="headingSample" class="font-sample" style="font-size:26px; margin:2px 0 10px;">Ink &amp; Iron Tattoo Studio</div>
          <label>Body font</label>
          <select name="theme_bodyFont" class="font-pick" data-sample="bodySample">
            <option value="">Base font</option>
            <% Object.keys(groups).forEach(g => { %><optgroup label="<%= g %>"><% groups[g].forEach(f => { %><option value="<%= f.name %>" <%= bSel === f.name ? 'selected' : '' %>><%= f.name %><%= f.hint ? ' — ' + f.hint : '' %></option><% }) %></optgroup><% }) %>
          </select>
          <input type="text" name="theme_bodyFontCustom" value="<%= bSel && !known(bSel) ? bSel : '' %>" placeholder="…or type any Google Font name" class="font-custom" data-sample="bodySample">
          <div id="bodySample" class="font-sample" style="font-size:15px; margin:2px 0 10px;">Walk-ins welcome. Custom designs by appointment.</div>
          <details class="sub special-fonts" id="specialFonts">
            <summary>Special Fonts</summary>
            <p class="hint">Hand-lettering looks: retro swirly script, brush script, hand-drawn capitals, tall cartoon capitals and worn capitals. Use one for the headings or the body, or pick it in Style text or + Add text to set just a few words in it.</p>
            <div class="sf-grid"><% fonts.SPECIAL.forEach((f, i) => { %>
              <div class="sf-card">
                <div class="sf-sample" style="font-family:'<%= f.name %>', cursive; color:<%= ['#880d1e', '#dd2d4a', '#f26a8d', '#e0789c', '#4fb3c2'][i % 5] %>;<%= f.caps ? ' text-transform:uppercase;' : '' %>"><%= site.name || 'Your Business' %></div>
                <div class="sf-name"><strong><%= f.name %></strong> <span class="muted"><%= f.look %></span></div>
                <div class="sf-use"><button type="button" class="btn-secondary" data-sf-use="theme_headingFont" data-sf-font="<%= f.name %>">Headings</button><button type="button" class="btn-secondary" data-sf-use="theme_bodyFont" data-sf-font="<%= f.name %>">Body</button></div>
              </div><% }) %></div>
            <script>
              (function () {
                var box = document.getElementById('specialFonts'); if (!box) return;
                var loaded = false;
                function load() {
                  if (loaded) return; loaded = true;
                  var l = document.createElement('link'); l.rel = 'stylesheet';
                  l.href = 'https://fonts.googleapis.com/css2?<%- fonts.SPECIAL.map(f => fonts.familyParam(f.name)).join('&') %>&display=swap';
                  document.head.appendChild(l);
                }
                box.addEventListener('toggle', function () { if (box.open) load(); });
                if (box.open) load();
                box.addEventListener('click', function (e) {
                  var b = e.target.closest('[data-sf-use]'); if (!b) return;
                  var sel = document.querySelector('select[name=' + b.dataset.sfUse + ']'); if (!sel) return;
                  sel.value = b.dataset.sfFont;
                  sel.dispatchEvent(new Event('change', { bubbles: true })); sel.dispatchEvent(new Event('input', { bubbles: true }));
                  box.querySelectorAll('[data-sf-use="' + b.dataset.sfUse + '"]').forEach(function (x) { x.classList.toggle('on', x === b); });
                  var hc = document.querySelector('select[name=theme_headingCase]');
                  if (b.dataset.sfUse === 'theme_headingFont' && hc && !hc.value && !/Hand|Guy|Chicle|Dirt|Hallelujah/.test(b.dataset.sfFont)) { hc.value = 'none'; hc.dispatchEvent(new Event('change', { bubbles: true })); }
                });
              })();
            </script>
          </details>
          <label>Heading capitalization</label>
          <select name="theme_headingCase">
            <option value="" <%= !site.theme.headingCase ? 'selected' : '' %>>Style default</option>
            <option value="none" <%= site.theme.headingCase === 'none' ? 'selected' : '' %>>Normal (best for gothic / script fonts)</option>
            <option value="uppercase" <%= site.theme.headingCase === 'uppercase' ? 'selected' : '' %>>UPPERCASE</option>
          </select>
          <script>
            (function () {
              var loaded = {};
              function show(name, el) {
                if (!name) { el.style.fontFamily = ''; return; }
                if (!/^[A-Za-z][A-Za-z0-9 ]{1,39}$/.test(name)) return;
                if (!loaded[name]) {
                  var l = document.createElement('link'); l.rel = 'stylesheet';
                  l.href = 'https://fonts.googleapis.com/css2?family=' + encodeURIComponent(name).replace(/%20/g, '+') + '&display=swap';
                  document.head.appendChild(l); loaded[name] = 1;
                }
                el.style.fontFamily = "'" + name + "', sans-serif";
              }
              document.querySelectorAll('.font-pick, .font-custom').forEach(function (inp) {
                function update() {
                  var el = document.getElementById(inp.dataset.sample);
                  var pair = document.querySelectorAll('[data-sample="' + inp.dataset.sample + '"]');
                  var custom = Array.prototype.find.call(pair, function (x) { return x.classList.contains('font-custom'); });
                  var pick = Array.prototype.find.call(pair, function (x) { return x.classList.contains('font-pick'); });
                  show((custom && custom.value.trim()) || (pick && pick.value), el);
                }
                inp.addEventListener(inp.tagName === 'SELECT' ? 'change' : 'input', function () {
                  // picking from the list clears a typed name, and typing resets the list
                  var pair = document.querySelectorAll('[data-sample="' + inp.dataset.sample + '"]');
                  Array.prototype.forEach.call(pair, function (x) {
                    if (x !== inp) { if (x.tagName === 'SELECT') x.value = ''; else x.value = ''; }
                  });
                  update();
                });
                update();
              });
            })();
          </script>
          </details>
          <details class="sub">
            <summary>Motion</summary>
          <% const mTierNow = motionLib.resolveLevel(site.theme, site.sections.hero); const mShNow = motionLib.isShader(site.theme.motionShader) ? site.theme.motionShader : 'aurora'; %>
          <label>Motion level</label>
          <select name="theme_motionLevel" id="motionLevel"><% motionLib.LEVELS.forEach(l => { %><option value="<%= l.id %>" <%= mTierNow === l.id ? 'selected' : '' %>><%= l.label %>: <%= l.hint %></option><% }) %></select>
          <% if (levelSuggest && levelSuggest.level !== mTierNow) { %><p class="hint">Suggested for this kind of business: <strong><%= motionLib.LEVELS.find(l => l.id === levelSuggest.level).label %></strong>. <%= levelSuggest.why %> <button type="button" class="btn-secondary" id="levelApply" data-level="<%= levelSuggest.level %>">Use <%= motionLib.LEVELS.find(l => l.id === levelSuggest.level).label %></button></p><% } else if (levelSuggest) { %><p class="hint">This level suits this kind of business. <%= levelSuggest.why %></p><% } %>
          <div id="shaderRow" <%- mTierNow === 'showcase' ? '' : 'hidden' %>>
            <label>Animated hero background</label>
            <select name="theme_motionShader"><% motionLib.SHADERS.forEach(sh => { %><option value="<%= sh.id %>" <%= mShNow === sh.id ? 'selected' : '' %>><%= sh.label %>: <%= sh.hint %></option><% }) %></select>
            <p class="hint">Replaces the hero photo with a moving gradient in your colours. It can make the page heavier; the quality check will tell you if it does. Showcase uses the site's own hero, so a library hero design is swapped for it.</p>
          </div>
          <label>Motion style</label>
          <% const mLevel = motionLib.resolve(site.theme, site.sections.hero); %>
          <select name="theme_motionStyle" id="motionStyle"><% motionLib.PRESETS.forEach(pr => { %><option value="<%= pr.id %>" <%= mLevel === pr.id ? 'selected' : '' %>><%= pr.label %>: <%= pr.hint %></option><% }) %></select>
          <% if (motionSuggest && motionSuggest !== mLevel) { %><p class="hint">Suggested for this kind of business: <strong><%= motionSuggest %></strong>. <button type="button" class="btn-secondary" id="motionApply" data-level="<%= motionSuggest %>">Use <%= motionSuggest %></button></p><% } %>
          <p class="hint">Motion level picks which effects are available; Motion style picks how strong they are. Lively's word-by-word headline and photo zoom need Premium or Showcase.</p>
          <p class="hint">Controls fade-ins, the headline, number counters and the photo zoom. Open "Preview" and use the switcher at the bottom to show a client the difference.</p>
          <label class="check"><input type="checkbox" name="theme_hoverLift" value="1" <%= site.theme.hoverLift ? 'checked' : '' %>> Cards lift slightly when hovered</label>
          <p class="hint">Visitors who have "reduce motion" turned on in their device never see animation, and the page is complete if the animation script does not load.</p>
          </details>
          <details class="sub" id="motionExtras">
            <summary>Motion extras (personality, buttons, headlines, photos)</summary>
          <% const mf = site.theme; const autoFeel = motionFx.BY_STYLE[mf.style]; %>
          <label>Motion personality</label>
          <select name="theme_motionFeel"><option value="">Automatic for this style<%= autoFeel ? ' (' + motionFx.FEELS.find(f => f.id === autoFeel).label + ')' : ' (Standard)' %></option><% motionFx.FEELS.forEach(f => { %><option value="<%= f.id %>" <%= mf.motionFeel === f.id ? 'selected' : '' %>><%= f.label %>: <%= f.hint %></option><% }) %></select>
          <label>Speed <output id="mSpeedOut"><%= mf.motionSpeed || 100 %>%</output></label>
          <input type="range" name="theme_motionSpeed" min="50" max="150" step="10" value="<%= mf.motionSpeed || 100 %>" oninput="document.getElementById('mSpeedOut').textContent = this.value + '%'">
          <label class="check"><input type="checkbox" id="mBounceOn" <%= mf.motionBounce !== '' && mf.motionBounce != null ? 'checked' : '' %> onchange="document.getElementById('mBounce').disabled = !this.checked"> Set my own bounciness</label>
          <input type="range" id="mBounce" name="theme_motionBounce" min="0" max="100" step="10" value="<%= mf.motionBounce !== '' && mf.motionBounce != null ? mf.motionBounce : 40 %>" <%= mf.motionBounce !== '' && mf.motionBounce != null ? '' : 'disabled' %>>
          <p class="hint">Personality changes how things arrive: Glide is slow and smooth, Bounce overshoots a little, Snap is quick. Speed and bounciness fine-tune it.</p>
          <label>Buttons</label>
          <% [['shine', 'A light shine sweeps across the main buttons now and then'], ['nudge', 'An arrow on buttons nudges forward on hover'], ['press', 'Buttons press in when tapped'], ['magnetic', 'Buttons lean toward the mouse (computers only)']].forEach(o => { %><label class="check"><input type="checkbox" name="theme_btnFx_<%= o[0] %>" value="1" <%= (mf.buttonFx || []).includes(o[0]) ? 'checked' : '' %>> <%= o[1] %></label><% }) %>
          <label>Headline movement</label>
          <select name="theme_headlineFx"><% [['', 'None'], ['weight', 'Grows bolder as it appears'], ['width', 'Stretches out as it appears'], ['settle', 'Letters settle into place one by one']].forEach(o => { %><option value="<%= o[0] %>" <%= (mf.headlineFx || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <p class="hint">Bolder and stretch look smoothest with a heading font from the "Variable" group under Fonts.</p>
          <label class="check"><input type="checkbox" name="theme_inkFx" value="1" <%= mf.inkFx ? 'checked' : '' %>> Section headings fill in word by word as visitors scroll</label>
          <label class="check"><input type="checkbox" name="theme_floatTags" value="1" <%= mf.floatTags ? 'checked' : '' %>> Little tags with your service names float beside the Card fan and Grid zoom photos</label>
          <label class="check"><input type="checkbox" name="theme_scrollFx" value="1" <%= mf.scrollFx ? 'checked' : '' %>> Photos unmask and settle as they scroll into view</label>
          <label class="check"><input type="checkbox" name="theme_highlightCircle" value="1" <%= mf.highlightCircle ? 'checked' : '' %>> A hand-drawn circle draws around your numbers</label>
          <label>Photos on hover (computers)</label>
          <select name="theme_photoFx"><% [['', 'Nothing'], ['tilt', '3D tilt toward the mouse'], ['color', 'Black and white, turning to color'], ['zoom', 'Gentle zoom']].forEach(o => { %><option value="<%= o[0] %>" <%= (mf.photoFx || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <p class="hint">A service can also show a second photo on hover (for example the finished job): add it as "Hover photo" on that service.</p>
          <label class="check"><input type="checkbox" name="theme_kenBurns" value="1" <%= mf.kenBurns ? 'checked' : '' %>> Hero photos slowly pan and zoom (Ken Burns)</label>
          <label class="check"><input type="checkbox" name="theme_spotlight" value="1" <%= mf.spotlight ? 'checked' : '' %>> A soft light follows the mouse across the hero (computers only)</label>
          <label class="check"><input type="checkbox" name="theme_areaPop" value="1" <%= mf.areaPop ? 'checked' : '' %>> Towns you serve pop in one by one</label>
          <input type="hidden" name="theme_successFx" value="0"><label class="check"><input type="checkbox" name="theme_successFx" value="1" <%= mf.successFx !== false ? 'checked' : '' %>> Animated check mark when a form or booking goes through</label>
          <label class="check"><input type="checkbox" name="theme_confetti" value="1" <%= mf.confetti ? 'checked' : '' %>> Confetti when a booking is confirmed (best for fun businesses)</label>
          <label>More effects</label>
          <% extraFx.EFFECTS.forEach(o => { %><label class="check"><input type="checkbox" name="theme_xfx_<%= o[0] %>" value="1" <%= (mf.xfx || []).includes(o[0]) ? 'checked' : '' %>> <strong><%= o[1] %>:</strong> <%= o[2] %></label><% }) %>
          <p class="hint">Tip: pick two or three that suit the business rather than all of them. Sideways scroll and the photo strip both use the gallery, so with both on the gallery becomes the strip.</p>
          <p class="hint">More moving layouts are in the home layout list: Services "Pinned story" and "Stacking cards", Gallery "Film reel", "Card fan" and "Grid zoom", Services "Word ticker", Pricing "Fanned cards", and the Steps block's "Stacking cards" look. Everything here stays still for visitors who ask for less motion.</p>
          </details>
          <details class="sub">
            <summary>Buttons, spacing and header</summary>
          <label>Button shape</label>
          <select name="theme_buttonShape"><% [['', 'Let the style decide'], ['square', 'Square'], ['rounded', 'Rounded'], ['pill', 'Pill (fully round)']].forEach(o => { %><option value="<%= o[0] %>" <%= (site.theme.buttonShape || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <label>Corner roundness (cards, photos, boxes)</label>
          <select name="theme_corners"><% [['', 'Let the style decide'], ['sharp', 'Sharp'], ['soft', 'Soft'], ['round', 'Very round']].forEach(o => { %><option value="<%= o[0] %>" <%= (site.theme.corners || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <label>Space between sections</label>
          <select name="theme_spacing"><% [['', 'Normal'], ['compact', 'Compact'], ['airy', 'Airy (more white space)']].forEach(o => { %><option value="<%= o[0] %>" <%= (site.theme.spacing || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <label>Heading size</label>
          <select name="theme_headingScale"><% [['', 'Normal'], ['large', 'Large'], ['xl', 'Extra large (bold statement headings)']].forEach(o => { %><option value="<%= o[0] %>" <%= (site.theme.headingScale || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <label style="display:flex; align-items:center; gap:8px; font-weight:400;"><input type="checkbox" name="theme_bands" value="1" style="width:auto;" <%= site.theme.bands ? 'checked' : '' %>> Alternate light and dark sections on the home page</label>
          <label>Header (top menu bar)</label>
          <select name="theme_header"><% [['', 'Sticky bar (stays at the top)'], ['shrink', 'Sticky, shrinks as you scroll'], ['transparent', 'Transparent over the home photo, solid on scroll'], ['static', 'Not sticky (scrolls away)']].forEach(o => { %><option value="<%= o[0] %>" <%= (site.theme.header || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <label>Header color</label>
          <select name="theme_headerBg" onchange="document.getElementById('headerColorRow').hidden = this.value !== 'custom'"><% headerColor.MODES.forEach(m => { %><option value="<%= m.id %>" <%= (site.theme.headerBg || '') === m.id ? 'selected' : '' %>><%= m.label %></option><% }) %></select>
          <div id="headerColorRow" <%- site.theme.headerBg === 'custom' ? '' : 'hidden' %>>
            <label>Your header color (e.g. #0f172a)</label>
            <input type="text" name="theme_headerColor" value="<%= site.theme.headerColor || '' %>" placeholder="Leave empty to use your Primary color">
          </div>
          <p class="hint">The menu, your name and the button change color to stay easy to read on the bar. "Clear" drops the bar so the page shows through; once a visitor scrolls it takes the page's own color so the menu stays readable. Over a hero photo with a see-through header, the header stays clear at the top whatever you pick here.</p>
          <label>Scroll Smoother and Split text</label>
          <p class="hint">These are in the <a href="/sites/<%= site.id %>/lab">Design lab</a>, in the "Scroll and text motion" card, where you can try them on the preview before saving.</p>
          <label>Header layout</label>
          <select name="theme_headerLayout"><% [['', 'Logo left, menu right'], ['centered', 'Logo centered, menu underneath']].forEach(o => { %><option value="<%= o[0] %>" <%= (site.theme.headerLayout || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <label>Menu bar style</label>
          <select name="theme_menuStyle"><% menuStyles.STYLES.forEach(o => { %><option value="<%= o[0] %>" <%= (site.theme.menuStyle || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <p class="hint">How the menu bar at the top looks. Your name or logo, page links and call button stay the same in each style. The full-screen menu and side drawer also give phone visitors a menu button.</p>
          </details>
          <details class="sub" id="lookFeel">
            <summary>Finishing touches (texture, dark mode, page changes)</summary>
          <label class="check"><input type="checkbox" name="theme_grain" value="1" <%= site.theme.grain ? 'checked' : '' %>> Film grain: a faint paper-like texture over the whole page</label>
          <label class="check"><input type="checkbox" name="theme_glassNav" value="1" <%= site.theme.glassNav ? 'checked' : '' %>> Glass header: the menu bar floats as a frosted panel</label>
          <label class="check"><input type="checkbox" name="theme_hideMenu" value="1" <%= site.theme.hideMenu ? 'checked' : '' %>> Hide the menu links (About Us, What We Offer...) in the top bar; the name or logo and the call button stay</label>
          <label class="check"><input type="checkbox" name="theme_softShadows" value="1" <%= site.theme.softShadows ? 'checked' : '' %>> Soft shadows: deeper, softer shadows on cards instead of borders</label>
          <label class="check"><input type="checkbox" name="theme_cardStack" value="1" <%= site.theme.cardStack ? 'checked' : '' %>> Stacked sections: each section slides over the last like a card with rounded top corners</label>
          <% const _gmenu = gradients.menu(site.theme, false), _gopts = (cur, none) => '<option value="">' + none + '</option>' + _gmenu.map(g => '<optgroup label="' + g[0] + '">' + g[1].map(x => '<option value="' + x[0] + '"' + (cur === x[0] ? ' selected' : '') + '>' + x[1] + '</option>').join('') + '</optgroup>').join(''); %>
          <label>Gradient behind the whole page</label>
          <select name="theme_pageGrad"><%- _gopts(site.theme.pageGrad || '', 'Off (plain page)') %></select>
          <label class="check"><input type="checkbox" name="theme_pageGradScroll" value="1" <%= site.theme.pageGradScroll ? 'checked' : '' %>> Shift its colors as visitors scroll down the page</label>
          <p class="hint">Sections with the default background sit on one continuous wash. It is mixed into your page color so text stays readable. The color shift holds still for visitors who turn motion off.</p>
          <% const _gmenuAll = gradients.menu(site.theme), _hbg = site.theme.homeBg || {}; %>
          <details class="sub" style="margin:6px 0 10px;">
            <summary>Gradient or texture behind each home page section (any home layout)<%= Object.keys(_hbg).length ? ' (' + Object.keys(_hbg).length + ' set)' : '' %></summary>
            <p class="hint">Every gradient and texture from the gallery, for the home page's own sections in the Automatic, Basic, Full, Story and Photo tiles layouts. (Industry blueprint sections pick theirs under "Size, photo and effects for this section".) The heading and words over it turn light or dark so they stay readable; cards keep their own colors.</p>
            <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 6px 12px;">
              <% gradients.HOME_SECS.forEach(([k, name]) => { %><label style="font-weight:400; margin:0;"><%= name %>
                <select name="theme_hbg_<%= k %>"><option value="">Normal background</option><% _gmenuAll.forEach(g => { %><optgroup label="<%= g[0] %>"><% g[1].forEach(x => { %><option value="<%= x[0] %>" <%= _hbg[k] === x[0] ? 'selected' : '' %>><%= x[1] %></option><% }) %></optgroup><% }) %></select></label><% }) %>
            </div>
          </details>
          <label>Gradient for headings and edges</label>
          <select name="theme_gradPick"><%- _gopts(site.theme.gradPick || '', 'Your colors, bold (brand to accent)') %></select>
          <label class="check"><input type="checkbox" name="theme_gradText" value="1" <%= site.theme.gradText ? 'checked' : '' %>> Gradient headings: section headings filled with the gradient (colors darkened or lightened until they read on the page)</label>
          <label>Gradient borders and glows on cards and buttons</label>
          <select name="theme_gradEdge"><% [['', 'Off'], ['border', 'Gradient border'], ['glow', 'Two-color glow'], ['both', 'Border and glow']].forEach(o => { %><option value="<%= o[0] %>" <%= (site.theme.gradEdge || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <label>Moving between pages</label>
          <select name="theme_pageTransition"><% [['', 'Instant (no transition)'], ['fade', 'Fade'], ['slide', 'Slide'], ['morph', 'Morph (the clicked photo or title grows into the next page)']].forEach(o => { %><option value="<%= o[0] %>" <%= (site.theme.pageTransition || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <p class="hint">Works in Chrome, Edge and Safari 18.2 and newer; other browsers just change pages as normal. Off for visitors who ask for less motion.</p>
          <label>Dark mode for visitors</label>
          <select name="theme_darkMode"><% [['', 'Off (always light)'], ['toggle', 'Button in the menu (starts from the visitor\'s device setting)'], ['auto', 'Follow the visitor\'s device setting, no button']].forEach(o => { %><option value="<%= o[0] %>" <%= (site.theme.darkMode || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
          <% if (lookfeel.isDarkStyle(site.theme.style, extraThemes.byId[site.theme.style])) { %><p class="hint">This style is already dark, so the dark mode setting is not used with it.</p><% } else { %><p class="hint">The dark colors are worked out from your brand color, with text kept readable (checked for contrast).</p><% } %>
          </details>
          <details class="sub">
            <summary>Emoji and hand-drawn touches</summary>
          <label>Your emoji (used in doodles, headings and floating shapes)</label>
          <input type="text" name="theme_emoji" id="themeEmoji" value="<%= site.theme.emoji || '' %>" maxlength="40" placeholder="e.g. 🐾 ✂️ 🦴 (up to 4)">
          <div id="emojiSets" class="pal-grid" style="margin:6px 0 10px;"></div>
          <label class="check"><input type="checkbox" name="theme_doodles" value="1" <%= site.theme.doodles ? 'checked' : '' %>> Hand-drawn touches: sparkle marks around the home headline and a squiggle under section headings</label>
          <label class="check"><input type="checkbox" name="theme_emojiHeads" value="1" <%= site.theme.emojiHeads ? 'checked' : '' %>> Show the first emoji next to every section heading</label>
          </details>
        </details>

        <details class="section-block settings-block" data-tab="design" id="footerBlock">
          <summary>Footer design</summary>
          <p class="muted" style="font-size:13px; margin-top:0;">How the bottom of every page looks. Each one uses only this site's name, links and contact details.</p>
          <% const _ft = {
               '': '<rect width="60" height="40" rx="4" fill="#1e293b"/><rect x="6" y="9" width="14" height="3" rx="1" fill="#fff"/><rect x="26" y="9" width="10" height="2" rx="1" fill="#94a3b8"/><rect x="26" y="15" width="10" height="2" rx="1" fill="#94a3b8"/><rect x="42" y="9" width="12" height="2" rx="1" fill="#94a3b8"/><rect x="42" y="15" width="10" height="2" rx="1" fill="#94a3b8"/><rect x="6" y="15" width="12" height="2" rx="1" fill="#94a3b8"/>',
               centered: '<rect width="60" height="40" rx="4" fill="#1e293b"/><rect x="22" y="8" width="16" height="3" rx="1" fill="#fff"/><rect x="12" y="17" width="36" height="2" rx="1" fill="#94a3b8"/><rect x="18" y="23" width="24" height="2" rx="1" fill="#94a3b8"/><circle cx="26" cy="31" r="2" fill="#94a3b8"/><circle cx="34" cy="31" r="2" fill="#94a3b8"/>',
               light: '<rect width="60" height="40" rx="4" fill="#f1f5f9"/><rect width="60" height="3" fill="var(--primary)"/><rect x="6" y="11" width="14" height="3" rx="1" fill="#0f172a"/><rect x="26" y="11" width="10" height="2" rx="1" fill="#64748b"/><rect x="26" y="17" width="10" height="2" rx="1" fill="#64748b"/><rect x="42" y="11" width="12" height="2" rx="1" fill="#64748b"/>',
               brand: '<rect width="60" height="40" rx="4" fill="var(--primary)"/><rect x="6" y="8" width="22" height="5" rx="1" fill="#fff"/><rect x="38" y="7" width="16" height="7" rx="3.5" fill="#fff"/><rect x="6" y="22" width="48" height="1" fill="#fff" opacity=".4"/><rect x="6" y="28" width="12" height="2" rx="1" fill="#fff" opacity=".8"/><rect x="26" y="28" width="10" height="2" rx="1" fill="#fff" opacity=".8"/>',
               split: '<rect width="60" height="40" rx="4" fill="#1e293b"/><rect x="4" y="5" width="22" height="30" rx="4" fill="var(--primary)" opacity=".75"/><rect x="8" y="10" width="13" height="3" rx="1" fill="#fff"/><rect x="8" y="24" width="14" height="4" rx="1" fill="#fff"/><rect x="32" y="10" width="10" height="2" rx="1" fill="#94a3b8"/><rect x="46" y="10" width="9" height="2" rx="1" fill="#94a3b8"/>',
               wordmark: '<rect width="60" height="40" rx="4" fill="#1e293b"/><rect x="6" y="6" width="10" height="2" rx="1" fill="#94a3b8"/><rect x="25" y="6" width="10" height="2" rx="1" fill="#94a3b8"/><rect x="44" y="6" width="10" height="2" rx="1" fill="#94a3b8"/><text x="30" y="36" text-anchor="middle" font-size="19" font-weight="800" fill="none" stroke="var(--primary)" stroke-width=".8" font-family="system-ui">Name</text>'
             }; %>
          <div class="cp-grid cp-wide" role="radiogroup" aria-label="Footer design">
            <% cardLayouts.FOOTERS.forEach(f => { %>
              <label class="cp-tile" title="<%= f.label %>: <%= f.hint %>">
                <input type="radio" name="theme_footerStyle" value="<%= f.id %>" <%= (site.theme.footerStyle || '') === f.id ? 'checked' : '' %>>
                <svg viewBox="0 0 60 40" aria-hidden="true"><%- _ft[f.id] %></svg>
                <span><%= f.label %></span>
              </label>
            <% }) %>
          </div>
        </details>

        <details class="section-block settings-block" data-tab="design">
          <summary>Different style on specific pages</summary>
          <p class="muted" style="font-size:13px; margin-top:0;">Optional. Each page normally uses the site style above. Pick another style for a page to try a different look there. The menu and footer on that page follow its style, so use this sparingly to keep the site feeling like one brand.</p>
          <% const pageStyleNow = site.theme.pageStyles || {}; const psLabels = { home: 'Home', about: 'About', services: 'Services (and each service page)', testimonials: 'Reviews', whyChoose: 'Why choose us', gallery: 'Gallery', faq: 'FAQ', blog: 'News & tips', hours: 'Hours', contact: 'Contact' }; %>
          <% extraThemes.PAGE_KEYS_FOR_STYLE.forEach(k => { %>
            <label><%= psLabels[k] %></label>
            <select name="pagestyle_<%= k %>">
              <option value="">Same as the site</option>
              <% extraThemes.ALL_STYLES.forEach(id => { %><option value="<%= id %>" <%= pageStyleNow[k] === id ? 'selected' : '' %>><%= id.startsWith('sl-') ? 'Style Library: ' + extraThemes.byId[id].label : id.startsWith('at-') ? 'Signature: ' + extraThemes.byId[id].label : id.charAt(0).toUpperCase() + id.slice(1) %></option><% }) %>
            </select>
          <% }) %>
        </details>

        <details class="section-block settings-block" data-tab="features">
          <summary>Announcement bar<%= (site.sections.announcement && site.sections.announcement.enabled) ? ' (on)' : '' %></summary>
          <%- include('sections/_announcement', { site }) %>
        </details>

        <details class="section-block settings-block" data-tab="features" id="bookingBlock" <%= (bookingFlash || site.sections.booking.enabled) ? 'open' : '' %>>
          <summary>Online booking<%= site.sections.booking.enabled ? ' (on)' : '' %></summary>
          <%- include('sections/_booking', { site }) %>
        </details>

        <details class="section-block settings-block" data-tab="features" id="membersBlock" <%= site.sections.members && site.sections.members.enabled ? 'open' : '' %>>
          <summary>Members area (visitor log-ins)<%= site.sections.members && site.sections.members.enabled ? ' (on)' : '' %></summary>
          <%- include('sections/_members', { site }) %>
        </details>

        <details class="section-block settings-block" data-tab="features" id="payBlock" <%= site.sections.payments && site.sections.payments.enabled ? 'open' : '' %>>
          <summary>Card payments (Stripe)<%= site.sections.payments && site.sections.payments.enabled ? ' (on)' : '' %></summary>
          <%- include('sections/_payments', { site }) %>
        </details>

        <details class="section-block settings-block" data-tab="content" id="customBlock" <%= ((site.sections.custom || {}).items || []).length ? 'open' : '' %>>
          <summary>Your own sections (words, photos, or both)<%= ((site.sections.custom || {}).items || []).length ? ' (' + site.sections.custom.items.length + ')' : '' %></summary>
          <%- include('sections/_custom', { site, bpUi }) %>
        </details>

        <details class="section-block settings-block" data-tab="content">
          <summary>Add a content block (<%= blockCatalog.LIST.length %> designs to choose from)</summary>
          <%- include('sections/_blocks', { site }) %>
        </details>

        <details class="section-block settings-block" data-tab="content">
          <summary>Trust &amp; credentials</summary>
          <%- include('sections/_trust', { site }) %>
        </details>

        <details class="section-block settings-block" data-tab="settings">
          <summary>Local SEO &amp; tracking</summary>
          <%- include('sections/_local', { site }) %>
        </details>

        <details class="section-block settings-block" data-tab="features" id="aiEditBlock">
          <summary>Ask AI to change something</summary>
          <%- include('_aiedit', { aiBase: '/sites/' + site.id, aiOn: aiConfigured, aiTheme: true }) %>
        </details>

        <details class="section-block settings-block" data-tab="features">
          <summary>Rewrite text with AI</summary>
          <% if (aiConfigured) { %>
            <p class="muted" style="font-size:13px;">Rewrites the headline, About text, services, FAQ and search description using this site's details. Photos, contact info, hours and credentials are left alone, and the current version is saved to history first.</p>
            <label>Anything to change? (optional)</label>
            <textarea id="rewriteInstruction" rows="2" placeholder="e.g. More premium tone. Emphasize emergency repairs and commercial work."></textarea>
            <button type="button" class="btn-secondary" id="rewriteBtn" style="margin-top:8px;">Rewrite with AI</button>
          <% } else { %>
            <p class="muted" style="font-size:13px;">Not set up. Add <code>ANTHROPIC_API_KEY</code> to the server's <code>.env</code> file to have Claude write tailored copy instead of generic template text (see the README, "AI-written copy").</p>
          <% } %>
        </details>

        <details class="section-block settings-block" data-tab="settings" <%= (newClientLink || clientLinkFlash) ? 'open' : '' %>>
          <summary>Client access</summary>
          <p class="muted" style="font-size:13px;">A private link your client can use — no account needed — to update their headline, about text, services, hours, contact details and photos. They can't change the design, publishing, domain or credentials.</p>
          <% if (newClientLink) { %>
            <div class="flash" style="word-break:break-all;">
              Copy this link now — it is shown only once:<br>
              <strong id="clientLinkText"><%= newClientLink %></strong><br>
              <button type="button" class="btn-secondary" style="margin-top:8px;" onclick="navigator.clipboard.writeText(document.getElementById('clientLinkText').textContent); this.textContent='Copied';">Copy link</button>
            </div>
          <% } %>
          <% if (clientLinkFlash === 'revoked') { %><div class="flash">Client link turned off.</div><% } %>
          <% if (clientLinkInfo) { %>
            <p style="font-size:14px;">A client link is active<%= clientLinkInfo.last_used_at ? ' (last used ' + clientLinkInfo.last_used_at + ')' : ' (not used yet)' %>. For security the link itself can't be shown again.</p>
          <% } %>
          <button type="button" class="btn-secondary" data-client-link="create"><%= clientLinkInfo ? 'Replace link (old one stops working)' : 'Create client link' %></button>
          <% if (clientLinkInfo) { %><button type="button" class="btn-danger" data-client-link="revoke">Turn off link</button><% } %>
        </details>

        <details class="section-block settings-block" data-tab="settings" id="clientUsersBlock" <%= (newInvite || clientUserFlash) ? 'open' : '' %>>
          <summary>Client logins<%= clientUsers.length ? ' (' + clientUsers.length + ')' : '' %></summary>
          <p class="muted" style="font-size:13px;">Give a client their own email and password (instead of a shared link). They can update the same basics: headline, about text, services, hours, contact details and photos. Never the design, publishing or domain.</p>
          <% if (newInvite) { %>
            <div class="flash" style="word-break:break-all;">
              <%= newInvite.emailed ? 'Invite emailed to ' + newInvite.email + '. You can also send this link yourself' : 'Send this link to ' + newInvite.email + ' (email sending is not set up)' %> — it works for 7 days and is shown only once:<br>
              <strong id="inviteLinkText"><%= newInvite.link %></strong><br>
              <button type="button" class="btn-secondary" style="margin-top:8px;" onclick="navigator.clipboard.writeText(document.getElementById('inviteLinkText').textContent); this.textContent='Copied';">Copy link</button>
            </div>
          <% } %>
          <% if (clientUserFlash === 'removed') { %><div class="flash">Login removed.</div><% } %>
          <% if (clientUserFlash === 'bademail') { %><div class="error">That email address does not look right.</div><% } %>
          <% if (clientUserFlash === 'toomany') { %><div class="error">Up to 10 client logins per site.</div><% } %>
          <% clientUsers.forEach(u => { %>
            <div class="version-row">
              <span><strong><%= u.name || u.email %></strong><% if (u.name) { %> <span class="muted"><%= u.email %></span><% } %><br>
                <span class="muted"><%= u.active ? (u.last_login_at ? 'Last login ' + u.last_login_at : 'Password set') : 'Invite not accepted yet' %></span></span>
              <span>
                <button type="button" class="btn-secondary" data-cu="invite" data-id="<%= u.id %>"><%= u.active ? 'Reset password' : 'New invite' %></button>
                <button type="button" class="btn-danger" data-cu="delete" data-id="<%= u.id %>">Remove</button>
              </span>
            </div>
          <% }) %>
          <label>Client's email</label>
          <input type="email" id="cuEmail" placeholder="client@theirbusiness.com">
          <label>Name (optional)</label>
          <input type="text" id="cuName" maxlength="80">
          <button type="button" class="btn-secondary" style="margin-top:8px;" data-cu="add">Invite client</button>
        </details>

        <details class="section-block settings-block" data-tab="settings" id="pitchBlock">
          <summary>Pitch mode</summary>
          <p class="muted" style="font-size:13px;">Pitch mode shows the site full screen and scrolls through it on its own. Open it from <strong>Show the client</strong> at the top. If the client already has a website, add a screenshot of it here and Pitch mode can show a drag slider from their old site to the new one.</p>
          <label>Screenshot of the client's current website (optional)</label>
          <div class="upload-row">
            <input type="url" name="pitch_oldShot" value="<%= (site.sections.pitch && site.sections.pitch.oldShot) || '' %>" placeholder="Upload a screenshot of the top of their old home page">
            <input type="file" accept="image/*" class="file-input" hidden>
            <button type="button" class="btn-secondary upload-btn">Upload</button>
          </div>
          <label>Their current website address (optional, shown as a label)</label>
          <input type="text" name="pitch_oldUrl" value="<%= (site.sections.pitch && site.sections.pitch.oldUrl) || site.source_url || '' %>" maxlength="200" placeholder="e.g. www.theiroldsite.com">
        </details>

        <% if (site.source_url) { %>
          <details class="section-block settings-block" data-tab="settings">
            <summary>Imported from <%= site.source_url %></summary>
            <p class="muted" style="font-size:13px;">Pull fresh content from the original URL. Your current content is saved to history first, so you can undo this.</p>
            <button type="submit" form="refreshForm" class="btn-secondary" onclick="return confirm('Refresh content from the original site? Your current edits will be saved to history first.');">Refresh from source</button>
          </details>
        <% } %>

        <% if (versions.length) { %>
          <details class="section-block settings-block" data-tab="settings">
            <summary>Version history</summary>
            <% versions.forEach(v => { %>
              <div class="version-row">
                <span><%= v.label || 'Save' %> — <%= v.created_at %></span>
                <button type="submit" form="restore-<%= v.id %>" class="btn-secondary" onclick="return confirm('Restore this version? Your current content will be saved to history first.');">Restore</button>
              </div>
            <% }) %>
          </details>
        <% } %>

        <button type="submit" style="width:100%; padding:14px; font-size:16px; margin-top:12px;">Save changes</button>
      </form>
      <%# These forms live OUTSIDE the editor form (HTML does not allow nested forms; a nested one cuts the editor form short and drops fields) %>
      <% if (site.source_url) { %><form id="refreshForm" method="POST" action="/sites/<%= site.id %>/refresh" style="display:none;"></form><% } %>
      <form id="indForm" method="POST" action="/sites/<%= site.id %>/apply-industry" style="display:none;"></form>
      <form id="bookingPresetForm" method="POST" action="/sites/<%= site.id %>/booking/preset" style="display:none;"></form>
      <% versions.forEach(v => { %><form id="restore-<%= v.id %>" method="POST" action="/sites/<%= site.id %>/versions/<%= v.id %>/restore" style="display:none;"></form><% }) %>
    </div>

    <div class="preview-panel">
      <div class="preview-page-bar">
        <label for="previewPageSelect">Previewing:</label>
        <select id="previewPageSelect">
          <option value="home">Home</option>
          <% const pageLabels = { about: 'About', services: 'Services', testimonials: 'Reviews', whyChoose: 'Why Choose Us', gallery: 'Gallery', faq: 'FAQ', blog: 'News & Tips', hours: 'Hours', contact: 'Contact' }; %>
          <% site.layout.order.filter(k => k !== 'hero' && k !== 'extraPages').forEach(k => { %>
            <option value="<%= k %>"><%= (site.sections[k] && site.sections[k].heading) || pageLabels[k] || k %><%= site.layout.hidden.includes(k) ? ' (hidden)' : '' %></option>
          <% }) %>
          <% if (site.sections.booking.enabled) { %><option value="book">Booking page</option><% } %>
          <optgroup label="Your extra pages" id="pvExtraPages"<%= extraPagesNav.length ? '' : ' hidden' %>><% extraPagesNav.forEach(e => { %><option value="p/<%= e.slug %>"><%= e.title %></option><% }) %></optgroup>
        </select>
        <span class="seg" role="group" aria-label="Preview width">
          <button type="button" class="btn-secondary on" data-pw="desktop" aria-pressed="true">Desktop</button><button type="button" class="btn-secondary" data-pw="phone" aria-pressed="false">Phone</button>
        </span>
        <label class="click-edit"><input type="checkbox" id="clickEdit" checked> Click to edit</label>
        <%- include('_page-tools-bar') %>
        <a href="/sites/<%= site.id %>/preview" target="_blank" class="muted" title="Open the preview in a new tab (with the motion switcher)">Open &#8599;</a>
      </div>
      <%- include('_page-tools-pick') %>
      <div class="preview-stage" id="previewStage"><iframe src="/sites/<%= site.id %>/preview?bar=0" id="previewFrame" title="Site preview"></iframe></div>
    </div>
  </div>

      <div class="picker-overlay" id="pickerOverlay">
    <div class="picker-box">
      <div class="picker-head">
        <input type="text" id="pickerQuery" placeholder="Search photos (e.g. roofing crew, hair salon interior)">
        <button type="button" id="pickerSearch">Search</button>
        <button type="button" class="btn-secondary" id="pickerClose">Close</button>
      </div>
      <div class="picker-src" id="pickerSrc" role="group" aria-label="Photo source" hidden>
        <button type="button" data-src="pexels" aria-pressed="true">Pexels</button><button type="button" data-src="unsplash" aria-pressed="false">Unsplash</button>
      </div>
      <div class="picker-grid" id="pickerGrid"></div>
      <div class="picker-foot">
        <span id="pickerNote">Free photos from Pexels. Click one to use it.</span>
        <button type="button" class="btn-secondary" id="pickerMore" hidden>Show more</button>
      </div>
    </div>
  </div>

  <script src="/palette.js"></script>
  <script src="/shapeart.js"></script>
  <script src="/photoedit.js"></script>
  <script>
    const siteId = <%= site.id %>;




    const STYLE_HINTS = <%- JSON.stringify(extraThemes.STYLE_HINTS) %>;
    document.addEventListener('mouseover', (e) => {
      const chip = e.target.closest('#styleCards [data-style]');
      if (chip) document.getElementById('styleHint').textContent = STYLE_HINTS[chip.dataset.style] || '';
    });
    document.addEventListener('mouseout', (e) => {
      if (!e.target.closest('#styleCards [data-style]')) return;
      document.getElementById('styleHint').textContent = STYLE_HINTS[document.querySelector('select[name=theme_style]').value] || '';
    });
    document.querySelector('select[name=theme_style]').addEventListener('change', (e) => {
      document.querySelectorAll('#styleCards .style-card').forEach(b => b.classList.toggle('on', b.dataset.style === e.target.value));
      document.getElementById('styleHint').textContent = STYLE_HINTS[e.target.value] || '';
      document.getElementById('slBpRow').hidden = !e.target.value.startsWith('sl-');
    });

    // ---- approved styles bring their own brand/accent colors, applied only on request ----
    (function () {
      var PAL = <%- JSON.stringify(Object.fromEntries(extraThemes.THEMES.filter(t => t.palette).map(t => [t.id, t.palette]))) %>;
      var sel = document.querySelector('select[name=theme_style]'), box = document.getElementById('stylePalette'), btn = document.getElementById('stylePaletteBtn');
      if (!sel || !box || !btn) return;
      function set(n, v) { var el = document.querySelector('[name=' + n + ']'); if (!el) return; el.value = v; el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true })); }
      sel.addEventListener('change', function () { box.style.display = PAL[sel.value] ? '' : 'none'; });
      btn.addEventListener('click', function () { var p = PAL[sel.value]; if (!p) return; set('theme_primaryColor', p.primary); set('theme_accentColor', p.accent); });
    })();

    // ---- style chips: one click switches the style (the preview refreshes after autosave) ----
    document.addEventListener('click', (e) => {
      const chip = e.target.closest('#styleCards [data-style]');
      if (!chip) return;
      const sel = document.querySelector('select[name=theme_style]');
      sel.value = chip.dataset.style;
      document.querySelectorAll('#styleCards .style-card').forEach(b => b.classList.toggle('on', b.dataset.style === sel.value));
      sel.dispatchEvent(new Event('input', { bubbles: true }));
      sel.dispatchEvent(new Event('change', { bubbles: true }));
    });


    // ---- photo strips: visible URL rows feed the hidden list that is saved ----
    function syncStrips() {
      document.querySelectorAll('.block-row').forEach(function (row) {
        var sb = row.querySelector('textarea.sh-body');   // Rolling words with photo shapes: the rolling words, the small words, then the photos
        if (sb) {
          var lines = function (sel, tag) { return row.querySelector(sel).value.split('\n').map(function (l) { return l.trim(); }).filter(Boolean).map(function (l) { return tag + l; }); };
          var pics = Array.prototype.map.call(row.querySelectorAll('.sh-url'), function (i) { return i.value.trim(); }).filter(Boolean);
          sb.value = lines('.sh-roll', 'roll: ').concat(lines('.sh-sub', 'sub: '), pics.length ? ['photos: ' + pics.join(' ')] : []).join('\n');
          return;
        }
        var pbb = row.querySelector('textarea.pb-body');   // Photo that blends in: the words, the photos, the owner's color
        if (pbb) {
          var pw = function (k) { var v = row.querySelector('.pb-' + k).value.replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); return v ? [k + ': ' + v] : []; };
          var pp = Array.prototype.map.call(row.querySelectorAll('.pb-url'), function (i) { return i.value.trim(); }).filter(Boolean);
          var pcut = row.querySelector('.pb-cuts').value.split(/\s+/).filter(function (x) { return x && pp.indexOf(x.split('|')[0]) >= 0; });   // cut-outs of the photos still listed
          pbb.value = pw('top').concat(pw('badge'), pw('note'), pp.length ? ['photos: ' + pp.join(' ')] : [], row.querySelector('.pb-own').checked ? ['color: ' + row.querySelector('.pb-color').value] : [], pcut.length ? ['cutouts: ' + pcut.join(' ')] : []).join('\n');
          return;
        }
        var adb = row.querySelector('textarea.ad-body');   // Photo with round-photo points: the big photos, then each point
        if (adb) {
          var ap = Array.prototype.map.call(row.querySelectorAll('.ad-url'), function (i) { return i.value.trim(); }).filter(Boolean);
          var al = ap.length ? ['photos: ' + ap.join(' ')] : [], aus = row.querySelectorAll('.ad-iu');
          Array.prototype.forEach.call(row.querySelectorAll('.ad-it'), function (t, n) { var w = t.value.replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(), u = (aus[n] ? aus[n].value : '').trim(); if (w || u) al.push('item: ' + u + ' | ' + w); });
          adb.value = al.join('\n');
          return;
        }
        var cbb = row.querySelector('textarea.cb-body');   // Card over a color band: the card's words, the checklist, the photos, the colors
        if (cbb) {
          var cf = function (sel) { return row.querySelector(sel).value.replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var cu = function (sel) { return Array.prototype.map.call(row.querySelectorAll(sel), function (i) { return i.value.trim(); }).filter(Boolean); };
          var cl = [];
          if (cf('.cb-text')) cl.push('text: ' + cf('.cb-text'));
          if (cf('.cb-list')) cl.push('list: ' + cf('.cb-list'));
          row.querySelector('.cb-items').value.split('\n').map(function (l) { return l.replace(/[|]+/g, ' ').trim(); }).filter(Boolean).slice(0, 6).forEach(function (t) { cl.push('item: ' + t); });
          if (cu('.cb-l-url').length) cl.push('left: ' + cu('.cb-l-url').join(' '));
          if (cu('.cb-r-url').length) cl.push('right: ' + cu('.cb-r-url').join(' '));
          if (row.querySelector('.cb-own-card').checked) cl.push('card: ' + row.querySelector('.cb-card').value);
          if (row.querySelector('.cb-own-band').checked) cl.push('band: ' + row.querySelector('.cb-band').value);
          cbb.value = cl.join('\n');
          return;
        }
        var mb = row.querySelector('textarea.mh-body');   // Photo mosaic hero: the line under the title, the photos
        if (mb) {
          var ms = row.querySelector('.mh-sub').value.replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim();
          var mp = Array.prototype.map.call(row.querySelectorAll('.mh-url'), function (i) { return i.value.trim(); }).filter(Boolean);
          mb.value = (ms ? ['sub: ' + ms] : []).concat(mp.length ? ['photos: ' + mp.join(' ')] : []).join('\n');
          return;
        }
        var tb = row.querySelector('textarea.tb-body');   // Photo, words and a big letter: the words, the big box, the two photo spots
        if (tb) {
          var tf = function (sel) { var x = row.querySelector(sel); return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var tu = function (sel) { return Array.prototype.map.call(row.querySelectorAll(sel), function (i) { return i.value.trim(); }).filter(Boolean); };
          var tl = [];
          ['bold', 'text', 'strong', 'big'].forEach(function (k) { if (tf('.tb-' + k)) tl.push(k + ': ' + tf('.tb-' + k)); });
          if (tu('.tb-l-url').length) tl.push('left: ' + tu('.tb-l-url').join(' '));
          if (tu('.tb-r-url').length) tl.push('right: ' + tu('.tb-r-url').join(' '));
          tb.value = tl.join('\n');
          return;
        }
        var ppb = row.querySelector('textarea.pp-body');   // Photo and words pairs: label, one line per pair, color, shapes
        if (ppb) {
          var pp1 = function (x) { return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var ppl = pp1(row.querySelector('.pp-label')) ? ['label: ' + pp1(row.querySelector('.pp-label'))] : [];
          Array.prototype.forEach.call(row.querySelectorAll('.pp-pair'), function (f) { var u = pp1(f.querySelector('.pp-url')), t = pp1(f.querySelector('.pp-title')), w = pp1(f.querySelector('.pp-text')); if (u || t || w) ppl.push('pair: ' + u + ' | ' + t + ' | ' + w); });
          if (row.querySelector('.pp-own-color').checked) ppl.push('color: ' + pp1(row.querySelector('.pp-color')));
          if (!row.querySelector('.pp-shapes').checked) ppl.push('shapes: off');
          ppb.value = ppl.join('\n');
          return;
        }
        var abb = row.querySelector('textarea.ab-body');   // About Us blocks: one line per field, in the order the fields are shown
        if (abb) {
          var ab1 = function (x) { return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var abl = [];
          Array.prototype.forEach.call(row.querySelectorAll('[data-abf]'), function (el) {
            var k = el.getAttribute('data-ab'), kind = el.getAttribute('data-abf');
            if (kind === 'line') { if (ab1(el)) abl.push(k + ': ' + ab1(el)); }
            else if (kind === 'paras') String(el.value || '').split('\n').map(function (t) { return ab1({ value: t }); }).filter(Boolean).forEach(function (t) { abl.push(k + ': ' + t); });
            else if (kind === 'row') { var parts = Array.prototype.map.call(el.querySelectorAll('.ab-c'), ab1); if (parts.some(Boolean)) abl.push(k + ': ' + parts.join(' | ')); }
            else if (kind === 'color') { if (el.querySelector('.ab-own').checked) abl.push(k + ': ' + ab1(el.querySelector('.ab-color'))); }
            else if (kind === 'toggle') { if (!el.checked) abl.push(k + ': off'); }
          });
          abb.value = abl.join('\n');
          return;
        }
        var opb = row.querySelector('textarea.op-body');   // Photo on two color blocks: label, paragraphs, note, colors, shapes
        if (opb) {
          var op1 = function (x) { return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var opl = op1(row.querySelector('.op-label')) ? ['label: ' + op1(row.querySelector('.op-label'))] : [];
          String(row.querySelector('.op-text').value || '').split('\n').map(function (t) { return op1({ value: t }); }).filter(Boolean).forEach(function (t) { opl.push('text: ' + t); });
          if (op1(row.querySelector('.op-note'))) opl.push('note: ' + op1(row.querySelector('.op-note')));
          ['color', 'accent', 'button', 'bg'].forEach(function (k) { if (row.querySelector('.op-own-' + k).checked) opl.push(k + ': ' + op1(row.querySelector('.op-' + k))); });
          if (!row.querySelector('.op-shapes').checked) opl.push('shapes: off');
          opb.value = opl.join('\n');
          return;
        }
        var fpb = row.querySelector('textarea.fp-body');   // Photo in frames with a card: paragraphs, note, colors
        if (fpb) {
          var fp1 = function (x) { return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var fpl = String(row.querySelector('.fp-text').value || '').split('\n').map(function (t) { return fp1({ value: t }); }).filter(Boolean).map(function (t) { return 'text: ' + t; });
          if (fp1(row.querySelector('.fp-note'))) fpl.push('note: ' + fp1(row.querySelector('.fp-note')));
          ['color', 'bg', 'card'].forEach(function (k) { if (row.querySelector('.fp-own-' + k).checked) fpl.push(k + ': ' + fp1(row.querySelector('.fp-' + k))); });
          fpb.value = fpl.join('\n');
          return;
        }
        var rpb = row.querySelector('textarea.rp-body');   // Round photo with a color card: paragraphs, note, colors, shapes
        if (rpb) {
          var rp1 = function (x) { return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var rpl = String(row.querySelector('.rp-text').value || '').split('\n').map(function (t) { return rp1({ value: t }); }).filter(Boolean).map(function (t) { return 'text: ' + t; });
          if (rp1(row.querySelector('.rp-note'))) rpl.push('note: ' + rp1(row.querySelector('.rp-note')));
          ['color', 'bg'].forEach(function (k) { if (row.querySelector('.rp-own-' + k).checked) rpl.push(k + ': ' + rp1(row.querySelector('.rp-' + k))); });
          if (!row.querySelector('.rp-shapes').checked) rpl.push('shapes: off');
          rpb.value = rpl.join('\n');
          return;
        }
        var sfb = row.querySelector('textarea.sf-body');   // Contact form with shapes: the line, the four colors, shapes
        if (sfb) {
          var sf1 = function (x) { return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var sfl = sf1(row.querySelector('.sf-text')) ? ['text: ' + sf1(row.querySelector('.sf-text'))] : [];
          ['color', 'accent', 'panel', 'bg'].forEach(function (k) { if (row.querySelector('.sf-own-' + k).checked) sfl.push(k + ': ' + sf1(row.querySelector('.sf-' + k))); });
          if (!row.querySelector('.sf-shapes').checked) sfl.push('shapes: off');
          sfb.value = sfl.join('\n');
          return;
        }
        var rgb = row.querySelector('textarea.rg-body');   // Words and photo with rings: paragraphs, note, the two colors, shapes
        if (rgb) {
          var rg1 = function (x) { return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var rgl = String(row.querySelector('.rg-text').value || '').split('\n').map(function (t) { return rg1({ value: t }); }).filter(Boolean).map(function (t) { return 'text: ' + t; });
          if (rg1(row.querySelector('.rg-note'))) rgl.push('note: ' + rg1(row.querySelector('.rg-note')));
          if (row.querySelector('.rg-own-color').checked) rgl.push('color: ' + rg1(row.querySelector('.rg-color')));
          if (row.querySelector('.rg-own-bg').checked) rgl.push('bg: ' + rg1(row.querySelector('.rg-bg')));
          if (!row.querySelector('.rg-shapes').checked) rgl.push('shapes: off');
          rgb.value = rgl.join('\n');
          return;
        }
        var twb = row.querySelector('textarea.tw-body');   // Two photos and links: paragraphs, the two photos, the links, the two colors
        if (twb) {
          var tf1 = function (x) { return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var twl = String(row.querySelector('.tw-text').value || '').split('\n').map(function (t) { return tf1({ value: t }); }).filter(Boolean).map(function (t) { return 'text: ' + t; });
          Array.prototype.forEach.call(row.querySelectorAll('.tw-url'), function (i) { twl.push('photo: ' + tf1(i)); });
          Array.prototype.forEach.call(row.querySelectorAll('.tw-link'), function (f) { var lb = tf1(f.querySelector('.tw-label')); if (lb) twl.push('link: ' + lb + ' | ' + tf1(f.querySelector('.tw-href'))); });
          if (row.querySelector('.tw-own-color').checked) twl.push('color: ' + tf1(row.querySelector('.tw-color')));
          if (row.querySelector('.tw-own-panel').checked) twl.push('panel: ' + tf1(row.querySelector('.tw-panel')));
          twb.value = twl.join('\n');
          return;
        }
        var rcb = row.querySelector('textarea.rc-body');   // Reviews on a card: the two colors, then one line per review (photo | words | name)
        if (rcb) {
          var rf = function (x) { return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var rl = [];
          if (row.querySelector('.rc-own-bg').checked) rl.push('bg: ' + rf(row.querySelector('.rc-bg')));
          if (row.querySelector('.rc-own-card').checked) rl.push('card: ' + rf(row.querySelector('.rc-card')));
          Array.prototype.forEach.call(row.querySelectorAll('.rc-review'), function (f) {
            var q = rf(f.querySelector('.rc-quote'));
            if (q) rl.push('review: ' + rf(f.querySelector('.rc-url')) + ' | ' + q + ' | ' + rf(f.querySelector('.rc-name')));
          });
          rcb.value = rl.join('\n');
          return;
        }
        var ptb = row.querySelector('textarea.pt-body');   // Photo picks the words: one line per card (photo | color | title | words)
        if (ptb) {
          var pf = function (x) { return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          ptb.value = Array.prototype.map.call(row.querySelectorAll('.pt-card'), function (f) {
            var u = pf(f.querySelector('.pt-url')), t = pf(f.querySelector('.pt-title')), w = pf(f.querySelector('.pt-text')), c = f.querySelector('.pt-own').checked ? pf(f.querySelector('.pt-color')) : '';
            return u || t || w ? 'card: ' + u + ' | ' + c + ' | ' + t + ' | ' + w : '';
          }).filter(Boolean).join('\n');
          return;
        }
        var ab = row.querySelector('textarea.ab-body');   // About with phone: the paragraphs, the bold line, the phone
        if (ab) {
          var one = function (x) { return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var al = Array.prototype.map.call(row.querySelectorAll('.ab-text'), one).filter(Boolean).map(function (t) { return 'text: ' + t; });
          if (one(row.querySelector('.ab-bold'))) al.push('bold: ' + one(row.querySelector('.ab-bold')));
          if (row.querySelector('.ab-nophone').checked) al.push('phone: none'); else if (one(row.querySelector('.ab-phone'))) al.push('phone: ' + one(row.querySelector('.ab-phone')));
          ab.value = al.join('\n');
          return;
        }
        var hb = row.querySelector('textarea.hc-body');   // Hero card: words, price, detail, two buttons, the bar, the color
        if (hb) {
          var f = function (sel, el) { var x = (el || row).querySelector(sel); return (x ? x.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var hl = [];
          if (f('.hc-intro')) hl.push('intro: ' + f('.hc-intro'));
          if (f('.hc-price') || f('.hc-pnote')) hl.push('price: ' + f('.hc-price') + ' | ' + f('.hc-pnote'));
          if (f('.hc-detail') || f('.hc-dnote')) hl.push('detail: ' + f('.hc-detail') + ' | ' + f('.hc-dnote'));
          var lts = row.querySelectorAll('.hc-lt'), lus = row.querySelectorAll('.hc-lu');
          Array.prototype.forEach.call(lts, function (t, i) { var lt = t.value.replace(/[|\r\n]+/g, ' ').trim(), lu = (lus[i] ? lus[i].value : '').trim(); if (lt && lu) hl.push('link: ' + lt + ' | ' + lu); });
          if (f('.hc-bname') || f('.hc-bopt') || f('.hc-bprice')) hl.push('bar: ' + f('.hc-bname') + ' | ' + f('.hc-bopt') + ' | ' + f('.hc-bprice'));
          if (row.querySelector('.hc-own').checked) hl.push('color: ' + row.querySelector('.hc-color').value);
          hb.value = hl.join('\n');
          return;
        }
        var kb = row.querySelector('textarea.sk-body');   // Stacked cards: the label, the rating, the colors, then one line per card
        if (kb) {
          var v = function (el) { return (el ? el.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var lines = [];
          if (v(row.querySelector('.sk-label'))) lines.push('label: ' + v(row.querySelector('.sk-label')));
          if (v(row.querySelector('.sk-rating')) || v(row.querySelector('.sk-rtext'))) lines.push('rating: ' + v(row.querySelector('.sk-rating')) + ' | ' + v(row.querySelector('.sk-rtext')));
          if (row.querySelector('.sk-colors').value !== 'soft') lines.push('colors: ' + row.querySelector('.sk-colors').value);
          var cards = Array.prototype.map.call(row.querySelectorAll('.sk-card'), function (c) { return 'card: ' + v(c.querySelector('.sk-name')) + ' | ' + v(c.querySelector('.sk-line')) + ' | ' + c.querySelector('.sk-stars').value + ' | ' + v(c.querySelector('.sk-url')) + ' | ' + v(c.querySelector('.sk-words')); });
          // only up to the last card with something on it
          while (cards.length && /^card: \s*\|\s*\|\s*\|\s*\|\s*$/.test(cards[cards.length - 1])) cards.pop();
          kb.value = lines.concat(cards).join('\n');
          return;
        }
        var nb = row.querySelector('textarea.nc-body');   // Connected photo cards: the small words, then one line per card
        if (nb) {
          var one = function (el) { return (el ? el.value : '').replace(/[|\r\n]+/g, ' ').replace(/\s+/g, ' ').trim(); };
          var tagged = function (sel, t) { var el = row.querySelector(sel); return (el ? el.value : '').split('\n').map(function (l) { return l.trim(); }).filter(Boolean).map(function (l) { return t + l; }); };
          var out = tagged('.nc-roll', 'roll: ').concat(tagged('.nc-sub', 'sub: '));
          row.querySelectorAll('.nc-card').forEach(function (c) {
            var lab = one(c.querySelector('.nc-label')), tag = one(c.querySelector('.nc-tag')), w = one(c.querySelector('.nc-words'));
            var urls = Array.prototype.map.call(c.querySelectorAll('.nc-url'), function (i) { return i.value.trim(); }).filter(Boolean);
            if (w) out.push('text: ' + lab + ' | ' + tag + ' | ' + w);
            else if (lab || tag || urls.length) out.push('card: ' + lab + ' | ' + tag + ' | ' + urls.join(' '));
          });
          nb.value = out.join('\n');
          return;
        }
        var hidden = row.querySelector('textarea.strip-body');
        if (!hidden) return;
        var urls = Array.prototype.map.call(row.querySelectorAll('.strip-url'), function (i) { return i.value.trim(); }).filter(Boolean);
        var words = row.querySelector('.wall-text');   // Brand wall: the owner's lines, then the photo links
        hidden.value = (words ? words.value.split('\n').map(function (l) { return l.trim(); }).filter(Boolean) : []).concat(urls).join('\n');
      });
    }
    // Stacked cards: the card boxes shown follow "How many cards"
    document.addEventListener('change', function (e) {
      if (!e.target.classList || !e.target.classList.contains('sk-count')) return;
      var n = +e.target.value;
      e.target.closest('.block-row').querySelectorAll('.sk-card').forEach(function (c, i) { c.hidden = i >= n; });
    });
    document.addEventListener('click', function (e) {
      var ncAdd = e.target.closest('[data-ncadd]');   // Connected photo cards: a new empty card (6 at most)
      if (ncAdd) {
        var list = ncAdd.previousElementSibling;
        if (list.children.length >= 6) return;
        var card = list.firstElementChild.cloneNode(true);
        card.querySelectorAll('input, textarea').forEach(function (i) { if (i.type !== 'file') { i.value = ''; i.textContent = ''; } });
        card.querySelectorAll('.strip-rows .upload-row').forEach(function (r, k) { if (k) r.remove(); });
        list.appendChild(card);
        return;
      }
      var ncRm = e.target.closest('.nc-remove');
      if (ncRm) {
        var c = ncRm.closest('.nc-card');
        if (c.parentNode.children.length > 1) c.remove(); else c.querySelectorAll('input, textarea').forEach(function (i) { if (i.type !== 'file') i.value = ''; });
        syncStrips(); scheduleAutosave();
        return;
      }
      var add = e.target.closest('[data-stripadd]');
      if (add) {
        var rows = add.previousElementSibling;
        if (add.dataset.max && rows.children.length >= +add.dataset.max) return;
        var first = rows.querySelector('.upload-row');
        var copy = first.cloneNode(true);
        copy.querySelectorAll('input').forEach(function (i) { if (i.type !== 'file') i.value = ''; });
        rows.appendChild(copy);
        return;
      }
      var rm = e.target.closest('.strip-remove');
      if (rm) { var r = rm.closest('.upload-row'); if (r.parentNode.children.length > 1) r.remove(); else r.querySelector('.strip-url').value = ''; syncStrips(); scheduleAutosave(); }
    });
    document.addEventListener('submit', syncStrips, true);
    document.addEventListener('input', syncStrips, true);
    // Photo that blends in: cut out the pets (cutout.js on the server), one photo at a time, then switch the block to
    // "Pets cut out". Photos already cut out are kept; the originals stay in the list (switch back any time).
    document.addEventListener('click', async function (e) {
      var btn = e.target.closest('.pb-cutbtn'); if (!btn) return;
      var row = btn.closest('.block-row'), msg = row.querySelector('.pb-cutmsg'), hid = row.querySelector('.pb-cuts');
      var urls = Array.prototype.map.call(row.querySelectorAll('.pb-url'), function (i) { return i.value.trim(); }).filter(Boolean);
      if (!urls.length) { msg.textContent = 'Add a photo first.'; return; }
      var map = {}; hid.value.split(/\s+/).forEach(function (x) { var k = x.split('|'); if (k[1]) map[k[0]] = k[1]; });
      btn.disabled = true;
      try {
        for (var i = 0; i < urls.length; i++) {
          if (map[urls[i]]) continue;
          msg.textContent = 'Cutting out photo ' + (i + 1) + ' of ' + urls.length + '… (the first one can take a minute)';
          var r = await fetch('/sites/' + siteId + '/cutout', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ url: urls[i] }) });
          var j = await r.json().catch(function () { return { ok: false, error: 'the app refused (error ' + r.status + ')' }; });
          if (!j.ok) { msg.textContent = 'Photo ' + (i + 1) + ': ' + (j.error || 'could not cut it out.'); break; }
          map[urls[i]] = j.url;
          hid.value = Object.keys(map).map(function (k) { return k + '|' + map[k]; }).join(' ');
        }
        if (urls.every(function (u) { return map[u]; })) {
          var sel = row.querySelectorAll('.pb-sidepick select');
          if (sel && sel[1]) { sel[1].value = 'cut'; sel[1].dispatchEvent(new Event('change', { bubbles: true })); }
          msg.textContent = 'Done: the pets now stand on the block\'s color.';
        }
      } catch (err) { msg.textContent = 'Could not cut out the photos. Check that SiteGen is running.'; }
      btn.disabled = false;
      syncStrips(); scheduleAutosave();
    });
    document.addEventListener('change', syncStrips, true);

    // ---- ✂ Cut out, on every box that loads a picture (Leo, 2026-11-03): the same cut-out tool as the Photo that
    // blends in block (cutout.js) finds the subject of the photo and makes its backdrop see-through. The box then holds
    // the cut-out copy, so whatever block or section shows that photo shows the cut-out instead. "Undo cut" puts the
    // original back (this browser remembers which photo each cut-out came from). ----
    const CUT_SKIP = /^(theme_faviconUrl|pitch_oldShot)$/;   // the tab icon and the old-site screenshot stay as they are
    const isCut = (u) => /^\/uploads\/cut-[a-z0-9]+\.(webp|png)$/.test(String(u || '').trim());
    const cutOrig = {
      all() { try { return JSON.parse(localStorage.getItem('sg-cut-orig') || '{}') || {}; } catch (e) { return {}; } },
      get(cut) { return this.all()[cut] || ''; },
      set(cut, orig) { const m = this.all(); m[cut] = orig; try { localStorage.setItem('sg-cut-orig', JSON.stringify(m)); } catch (e) { /* storage blocked */ } }
    };
    // cut out one photo on the server; resolves to the cut-out's address (or throws with a message to show)
    async function cutPhoto(url) {
      url = String(url || '').trim();
      if (!url) throw new Error('Add a photo first');
      if (isCut(url)) return url;
      const r = await fetch('/sites/' + siteId + '/cutout', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ url }) });
      const j = await r.json().catch(() => ({ ok: false, error: 'the app refused (error ' + r.status + ')' }));
      if (!j.ok) throw new Error(j.error || 'Could not cut out that photo');
      cutOrig.set(j.url, url);
      return j.url;
    }
    function cutBtnFor(row) {
      if (!row || row.querySelector('.cut-btn')) return;
      const url = row.querySelector('input[type=url]'), fi = row.querySelector('.file-input'), up = row.querySelector('.upload-btn');
      if (!url || !fi || !up || !/image/.test(fi.getAttribute('accept') || '') || CUT_SKIP.test(url.name || '')) return;
      if (url.classList.contains('pb-url')) return;   // that block has its own "Cut out the pets" button
      const b = document.createElement('button'); b.type = 'button'; b.className = 'btn-secondary cut-btn';
      b.title = 'Cut out the subject of this photo (pet, person or thing) and make its backdrop see-through';
      (row.querySelector('.pick-btn') || up).after(b);
      // 🎨 Edit photo (photoedit.js): select any part of the photo; more photo tools join it step by step
      if (window.SGPhotoEdit && !row.querySelector('.pe-btn')) {
        const pe = document.createElement('button'); pe.type = 'button'; pe.className = 'btn-secondary pe-btn';
        pe.textContent = '🎨 Edit photo'; pe.title = 'Open the photo editor: click any part of the photo (the pet, a towel, the background) to select it';
        b.after(pe);
      }
      cutLabel(row);
    }
    function cutLabel(row) {
      const b = row && row.querySelector('.cut-btn'), url = row && row.querySelector('input[type=url]'); if (!b || !url || b.disabled) return;
      const v = url.value.trim();
      b.hidden = isCut(v) && !cutOrig.get(v);
      b.textContent = isCut(v) ? '↩ Undo cut' : '✂ Cut out';
      b.dataset.state = isCut(v) ? 'cut' : 'photo';
    }
    document.querySelectorAll('.upload-row').forEach(cutBtnFor);
    document.querySelectorAll('template').forEach(t => t.content.querySelectorAll('.upload-row').forEach(cutBtnFor));
    // rows added later (+ Add photo, + Add service ...) get the button too; copied rows get their label redone
    new MutationObserver((muts) => muts.forEach(m => m.addedNodes.forEach(n => {
      if (n.nodeType !== 1) return;
      (n.matches('.upload-row') ? [n] : [...n.querySelectorAll('.upload-row')]).forEach(r => { cutBtnFor(r); const b = r.querySelector('.cut-btn'); if (b) { b.disabled = false; cutLabel(r); } });
    }))).observe(document.body, { childList: true, subtree: true });
    document.addEventListener('input', (e) => { if (e.target.matches && e.target.matches('.upload-row input[type=url]')) cutLabel(e.target.closest('.upload-row')); });
    // lists that grow in the About Us style blocks (Leo, 2026-11-04: "the option to add as many bulletins as needed"):
    // "+ Add" copies the last row empty (its photo box keeps the Cut out button), "Remove" drops a row or empties the last one
    document.addEventListener('click', (e) => {
      const add = e.target.closest('.ab-add'), del = e.target.closest('.ab-del');
      if (!add && !del) return;
      const clear = (box) => { box.querySelectorAll('input, textarea').forEach(i => { if (i.type !== 'file' && i.type !== 'button' && i.type !== 'checkbox') i.value = ''; }); box.querySelectorAll('select').forEach(x => { x.selectedIndex = 0; }); box.querySelectorAll('.upload-row').forEach(r => { if (typeof cutLabel === 'function') cutLabel(r); }); };
      const fs = del && del.closest('.ab-row'), k = add ? add.getAttribute('data-ab') : fs.getAttribute('data-ab');
      const box = add ? add.parentNode : fs.parentNode, btn = add || box.querySelector('.ab-add[data-ab="' + k + '"]'), max = btn ? (+btn.getAttribute('data-max') || 12) : 12;
      const rows = box.querySelectorAll('.ab-row[data-ab="' + k + '"]');
      if (add) {
        if (rows.length >= max) { add.disabled = true; return; }
        const last = rows[rows.length - 1], c = last.cloneNode(true);
        clear(c); last.after(c);
        if (rows.length + 1 >= max) add.disabled = true;
        const f = c.querySelector('input[type=text], textarea, input[type=url]'); if (f) f.focus();
      } else {
        if (rows.length > 1) fs.remove(); else clear(fs);
        if (btn) btn.disabled = false;
      }
      if (typeof scheduleAutosave === 'function') scheduleAutosave();
    });
    document.addEventListener('click', (e) => {
      const b = e.target.closest('.pe-btn'); if (!b) return;
      const url = b.closest('.upload-row').querySelector('input[type=url]'), v = url.value.trim();
      if (!v) { statusEl.textContent = 'Add a photo first, then edit it'; return; }
      // Save photo puts the finished photo in the box (the original and the changes stay with the site)
      const onSave = (u) => { url.value = u; url.dispatchEvent(new Event('input', { bubbles: true })); url.dispatchEvent(new Event('change', { bubbles: true })); scheduleAutosave(); statusEl.textContent = 'Photo saved with your changes. 🎨 Edit photo opens them again'; };
      try { window.SGPhotoEdit.open({ siteId, src: v, onSave }); } catch (err) { statusEl.textContent = err.message || 'Could not open the photo editor'; }
    });
    document.addEventListener('click', async (e) => {
      const b = e.target.closest('.cut-btn'); if (!b) return;
      const row = b.closest('.upload-row'), url = row.querySelector('input[type=url]'), v = url.value.trim();
      const put = (u) => { url.value = u; url.dispatchEvent(new Event('input', { bubbles: true })); url.dispatchEvent(new Event('change', { bubbles: true })); scheduleAutosave(); };
      if (b.dataset.state === 'cut') { const o = cutOrig.get(v); if (o) { put(o); statusEl.textContent = 'The original photo is back'; } return; }
      if (!v) { statusEl.textContent = 'Add a photo first, then cut it out'; return; }
      b.disabled = true; b.textContent = 'Cutting out… (the first time takes a minute)';
      try { put(await cutPhoto(v)); statusEl.textContent = 'Cut out: the backdrop is now see-through. "Undo cut" puts the photo back'; }
      catch (err) { statusEl.textContent = err.message || 'Could not cut out that photo. Check that SiteGen is running.'; }
      b.disabled = false; cutLabel(row);
    });

    // ---- move a card (service, review, reason, question, photo, hours row, extra page) up or down: the site shows them in this order ----
    (function () {
      const LISTS = ['servicesList', 'testimonialsList', 'whyChooseList', 'galleryList', 'faqList', 'hoursList', 'extraList'];
      const TPLS = ['tpl-service', 'tpl-testimonial', 'tpl-whyChoose', 'tpl-gallery', 'tpl-faq', 'tpl-hours', 'tpl-extra'];
      function addMove(row) {
        if (row.querySelector(':scope > .row-move')) return;
        const mv = document.createElement('span'); mv.className = 'row-move';
        mv.innerHTML = '<button type="button" data-row-move="-1" title="Move up" aria-label="Move up">&#9650;</button><button type="button" data-row-move="1" title="Move down" aria-label="Move down">&#9660;</button>';
        const rm = row.querySelector(':scope > .remove-row');
        if (rm) rm.before(mv); else row.append(mv);
      }
      LISTS.forEach(id => { const l = document.getElementById(id); if (l) l.querySelectorAll(':scope > .service-row, :scope > .gallery-row').forEach(addMove); });
      TPLS.forEach(id => { const t = document.getElementById(id); if (t) t.content.querySelectorAll('.service-row, .gallery-row').forEach(r => { if (r.parentNode === t.content) addMove(r); }); });
      document.addEventListener('click', (e) => {
        const b = e.target.closest('[data-row-move]'); if (!b) return;
        const row = b.closest('.service-row, .gallery-row'), dir = +b.dataset.rowMove;
        const other = dir < 0 ? row.previousElementSibling : row.nextElementSibling;
        if (!other || !other.matches('.service-row, .gallery-row')) return;
        if (dir < 0) row.parentNode.insertBefore(row, other); else row.parentNode.insertBefore(other, row);
        b.focus();
        scheduleAutosave();
      });
    })();

    // ---- content blocks: each one has its own entry in Page sections (its editor moves into it); add, move, duplicate, delete ----
    const blockRows = () => [...document.querySelectorAll('#editorForm .block-row')];
    const blockId = () => 'b' + Array.from({ length: 7 }, () => 'abcdefghijklmnopqrstuvwxyz0123456789'[Math.floor(Math.random() * 36)]).join('');
    const BLOCK_KINDS = <%- JSON.stringify(blockKinds) %>;
    function blockTitle(row) {
      const type = (row.querySelector('[name=block_type]') || {}).value, h = ((row.querySelector('[name=block_heading]') || {}).value || '').replace(/\{\{([^{}|<>]{1,300}?)(?:\|[^{}|<>]{0,40}){1,6}\}\}/g, '$1').replace(/[\[\]]/g, '').trim();
      return 'Content block · ' + (BLOCK_KINDS[type] || 'Block') + (h ? ': ' + h.slice(0, 40) : '');
    }
    // the entry's heading: picture, the block's own heading (or the design's name) and a colored tag (as drawn on the server)
    const BLOCK_INFO = <%- JSON.stringify(blockCatalog.infoAll()).replace(/</g, '\\u003c') %>;
    function setBlockHead(sec, row) {
      const h3 = sec.querySelector(':scope > h3'), type = (row.querySelector('[name=block_type]') || {}).value, i = BLOCK_INFO[type] || BLOCK_INFO.photoText;
      const own = ((row.querySelector('[name=block_heading]') || {}).value || '').replace(/\{\{([^{}|<>]{1,300}?)(?:\|[^{}|<>]{0,40}){1,6}\}\}/g, '$1').replace(/[\[\]]/g, '').trim();
      h3.className = 'blk-h3'; h3.dataset.name = blockTitle(row); sec.style.setProperty('--g', i.color);
      h3.innerHTML = i.pic + '<span class="blk-h3-main"></span><span class="blk-tag"></span>';
      h3.querySelector('.blk-h3-main').textContent = own ? own.slice(0, 60) : i.name;
      const tag = h3.querySelector('.blk-tag'); tag.textContent = i.name; tag.title = i.groupLabel;
    }
    // a new entry for a block, after `after` (an entry) or at the end of the list
    function blockEntry(row, after) {
      const idEl = row.querySelector('[name=block_id]');
      if (!/^b[a-z0-9]{7}$/.test(idEl.value) || blockRows().some(r => r !== row && r.querySelector('[name=block_id]').value === idEl.value)) idEl.value = blockId();
      const sec = document.createElement('div');
      sec.className = 'section-block draggable-section blk-entry'; sec.draggable = true; sec.dataset.key = 'blk:' + idEl.value;
      sec.innerHTML = '<div class="section-toolbar"><div class="left"><span class="drag-handle" title="Drag to reorder">⠿</span></div><label class="hide-toggle"><input type="checkbox" name="hidden_sections"> Hidden from published page</label></div><h3></h3><div class="blk-host"></div>';
      sec.querySelector('[name=hidden_sections]').value = 'blk:' + idEl.value;
      setBlockHead(sec, row);
      sec.querySelector('.blk-host').append(row);
      const list = document.getElementById('sectionsContainer');
      if (after) after.after(sec); else list.append(sec);
      if (window.sgDecorateSection) window.sgDecorateSection(sec);
      return sec;
    }
    // the editors drawn in the Content blocks box go into their entries
    (function () {
      blockRows().forEach(row => {
        const host = document.querySelector('[data-blk-host="' + row.querySelector('[name=block_id]').value + '"]');
        if (host && !host.children.length) host.append(row); else blockEntry(row);
      });
    })();
    // a new block opens in its own entry, ready to fill in
    window.sgAddBlockRow = (row, after) => {
      const sec = blockEntry(row, after);
      if (window.sgOpenSection) window.sgOpenSection(sec);
      setTimeout(() => { const f = row.querySelector('[name=block_heading]'); sec.scrollIntoView({ block: 'start' }); if (f) f.focus({ preventScroll: true }); }, 30);
      scheduleAutosave();
      return sec;
    };
    document.addEventListener('input', (e) => {
      const row = e.target.closest('.block-row'), sec = row && row.closest('.blk-entry');
      if (sec && e.target.name === 'block_heading') { setBlockHead(sec, row); if (sec.classList.contains('focus-on')) { const t = document.getElementById('focusTitle'); if (t) { t.innerHTML = '<span>Editing:</span> '; t.append(blockTitle(row)); } } }
    });
    document.addEventListener('click', (e) => {
      const nb = e.target.closest('[data-newblock]');
      if (nb && blockRows().length >= <%= blockCatalog.MAX_BLOCKS %>) { statusEl.textContent = 'A site can have up to <%= blockCatalog.MAX_BLOCKS %> content blocks (hidden ones count too). Delete a block you no longer use to add another'; return; }
      if (nb) {
        const tpl = document.getElementById('tpl-block-' + nb.dataset.newblock);
        if (tpl) window.sgAddBlockRow(tpl.content.cloneNode(true).querySelector('.block-row'));
        return;
      }
      const btn = e.target.closest('[data-block]');
      if (!btn) return;
      const row = btn.closest('.block-row'), sec = row.closest('.blk-entry');
