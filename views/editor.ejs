        else if (e.key === 'Enter' && editing && editing.field.tagName === 'INPUT') { e.preventDefault(); endInline(true); }
      }
      function onInlinePaste(e) {
        e.preventDefault();
        const t = (e.clipboardData && e.clipboardData.getData('text/plain')) || '';
        editing.doc.execCommand('insertText', false, t);
      }
      // (the size boxes in the bar take the focus for a moment: that does not end the typing)
      function onInlineBlur() { setTimeout(() => { if (editing && editing.doc.activeElement !== editing.node && !editing.bar.contains(editing.doc.activeElement)) endInline(true); }, 0); }
      // wrap the selected words in [brackets]: the headline's highlighted words
      function highlightSelection() {
        const { field, doc } = editing;
        const picked = String(doc.defaultView.getSelection() || '').replace(/\s+/g, ' ').trim();
        if (!picked) { statusEl.textContent = 'Select the words to highlight first'; return; }
        const plain = field.value.replace(/[\[\]]/g, '');
        const at = plain.indexOf(picked);
        if (at < 0) return;
        field.value = plain.slice(0, at) + '[' + picked + ']' + plain.slice(at + picked.length);
        field.dispatchEvent(new Event('input', { bubbles: true }));
        endInline(true);
      }
      // size, font and color for the words picked on the page (all of the box's words when none are picked)
      function styleSelection() {
        const { field, doc, node } = editing;
        const picked = String(doc.defaultView.getSelection() || '').replace(/\s+/g, ' ').trim();
        const v = field.value;
        let s = 0, e = v.length;
        if (picked) { const at = v.indexOf(picked); if (at < 0) { statusEl.textContent = 'Pick words inside one line to style them'; return; } s = at; e = at + picked.length; }
        else if (v.indexOf('{{') >= 0) { statusEl.textContent = 'Select the words to style first'; return; }
        const fr = preview.getBoundingClientRect(), r = node.getBoundingClientRect();
        endInline(true);
        if (window.sgStyleWords) window.sgStyleWords(field, s, e, { top: fr.top + r.bottom + 8, left: fr.left + r.left });
      }
      async function endInline(keep) {
        if (!editing) return;
        const { node, field, bar, orig, handles } = editing;
        editing = null;
        if (handles) handles.remove();
        node.removeEventListener('input', onInlineInput); node.removeEventListener('keydown', onInlineKey);
        node.removeEventListener('paste', onInlinePaste); node.removeEventListener('blur', onInlineBlur);
        node.removeAttribute('contenteditable'); node.classList.remove('sg-ie-on'); bar.remove();
        if (!keep && field.value !== orig) { field.value = orig; field.dispatchEvent(new Event('input', { bubbles: true })); }
        inlineEditing = false;
        if (field.value !== orig || pvStale || !keep) { pvStale = false; await flushSave(); freshPreview(); }
      }
      onPreviewLoad(hook);
      hook();
    })();

    <%- include('_page-tools') %>
    // ---- section layouts: next layout, flip, shuffle (editor boxes and hover buttons in the preview) ----
    (function () {
      const fire = (el) => { el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true })); };
      const saveNow = () => { clearTimeout(autosaveTimer); doAutosave(); };
      const layoutSel = form.querySelector('[name=theme_homeLayout]');
      const variantSel = (fam) => form.querySelector('[data-bp-variant="' + fam + '"]');
      const customRow = (i) => document.querySelectorAll('#customList .custom-row')[i];
      function step(sel, dir, skipFirst) {
        const n = sel.options.length, lo = skipFirst ? 1 : 0;
        let i = sel.selectedIndex + (dir || 1);
        if (i >= n) i = lo; if (i < lo) i = n - 1;
        sel.selectedIndex = i; fire(sel);
      }
      form.querySelectorAll('[data-bp-next]').forEach(b => b.addEventListener('click', () => step(variantSel(b.dataset.bpNext), 1)));
      const btn = document.getElementById('bpShuffle'), undo = document.getElementById('bpShuffleUndo');
      let saved = null;
      if (btn) btn.addEventListener('click', () => {
        const sels = [...form.querySelectorAll('[data-bp-variant]')], flips = [...form.querySelectorAll('input[name^=bps_][name$=_flip]')];
        saved = { layout: layoutSel.value, v: sels.map(x => x.value), f: flips.map(x => x.checked) };
        sels.forEach(x => {
          // parallax scenes are a deliberate choice, so the shuffle leaves them out
          const opts = [...x.options].filter(o => !/^scene-/.test(o.value) && o.value !== x.value);
          if (opts.length) x.value = opts[Math.floor(Math.random() * opts.length)].value;
        });
        flips.forEach(x => { x.checked = Math.random() < 0.5; });
        layoutSel.value = 'blueprint';
        fire(layoutSel); undo.hidden = false; saveNow();
      });
      if (undo) undo.addEventListener('click', () => {
        if (!saved) return;
        const sels = [...form.querySelectorAll('[data-bp-variant]')], flips = [...form.querySelectorAll('input[name^=bps_][name$=_flip]')];
        sels.forEach((x, i) => { x.value = saved.v[i]; }); flips.forEach((x, i) => { x.checked = saved.f[i]; });
        layoutSel.value = saved.layout; fire(layoutSel); undo.hidden = true; saved = null; saveNow();
      });

      // hover buttons on each section in the preview
      function hook() {
        let doc; try { doc = preview.contentDocument; } catch (e) { return; }
        if (!doc || !doc.body || doc.__sgLayoutHooked) return; doc.__sgLayoutHooked = true;
        const st = doc.createElement('style');
        st.textContent = '.sg-lt{position:absolute;z-index:2147483000;display:none;gap:4px;padding:4px;background:#0f172a;border-radius:10px;box-shadow:0 6px 20px rgba(0,0,0,.25);font:600 12.5px system-ui,sans-serif}' +
          '.sg-lt button{all:unset;cursor:pointer;color:#fff;padding:6px 9px;border-radius:7px;line-height:1}.sg-lt button:hover,.sg-lt button:focus-visible{background:#334155}.sg-lt .lbl{color:#94a3b8;padding:6px 4px 6px 8px}.sg-lt [hidden]{display:none !important}';
        doc.head.appendChild(st);
        const bar = doc.createElement('div'); bar.className = 'sg-lt'; bar.setAttribute('aria-hidden', 'true');
        bar.innerHTML = '<span class="lbl"></span><button type="button" data-a="prev" title="Previous layout">&lsaquo;</button><button type="button" data-a="next" title="Next layout">Layout &rsaquo;</button><button type="button" data-a="flip" title="Mirror this section">&#8646; Flip</button><button type="button" data-a="up" title="Move up the page">&uarr;</button><button type="button" data-a="down" title="Move down the page">&darr;</button>';
        doc.body.appendChild(bar);
        let cur = null;
        function target(sec) {
          if (sec.dataset.sgBlk != null) { const row = document.querySelectorAll('#editorForm .block-row')[+sec.dataset.sgBlk]; return row ? { blk: +sec.dataset.sgBlk, label: (row.querySelector('.block-kind') || {}).textContent || 'Block' } : null; }
          const fam = sec.dataset.sgFam;
          if (fam === 'custom') { const row = customRow(+sec.dataset.sgCi); return row ? { sel: row.querySelector('[name=cs_layout]'), flip: row.querySelector('[name=cs_flip]'), custom: true, label: 'Your section' } : null; }
          const sel = variantSel(fam); if (!sel) return null;
          return { sel, flip: form.querySelector('input[name="bps_' + fam + '_flip"]'), label: (sel.closest('div').querySelector('span') || {}).textContent || fam };
        }
        function place(sec) {
          const t = target(sec); if (!t) { bar.style.display = 'none'; return; }
          cur = { sec, t };
          bar.querySelector('.lbl').textContent = t.label;
          const opt = t.sel ? t.sel.options[t.sel.selectedIndex] : null;
          bar.querySelector('[data-a=flip]').hidden = !t.flip || (!t.custom && opt && opt.dataset.flip === '0');
          bar.querySelectorAll('[data-a=prev], [data-a=next]').forEach(b => { b.hidden = !t.sel; });
          bar.querySelectorAll('[data-a=up], [data-a=down]').forEach(b => { b.hidden = !t.custom && t.blk == null; });
          const r = sec.getBoundingClientRect();
          bar.style.display = 'flex';
          bar.style.top = (Math.min(Math.max(r.top + 10, 92), r.bottom - 50) + doc.defaultView.scrollY) + 'px';
          bar.style.left = Math.max(8, r.right + doc.defaultView.scrollX - bar.offsetWidth - 10) + 'px';
        }
        doc.addEventListener('mouseover', (e) => { const sec = e.target.closest('.sg-sec[data-sg-fam], [data-sg-blk]'); if (sec && (!cur || cur.sec !== sec)) place(sec); });
        bar.addEventListener('click', (e) => {
          const b = e.target.closest('button'); if (!b || !cur) return;
          e.preventDefault(); e.stopPropagation();
          const t = cur.t;
          if (b.dataset.a === 'up' || b.dataset.a === 'down') {
            const dir = b.dataset.a === 'up' ? -1 : 1;
            if (t.blk != null) window.sgMoveBlock && window.sgMoveBlock(t.blk, dir);
            else window.sgMoveCustom && window.sgMoveCustom(+cur.sec.dataset.sgCi, dir);
            bar.style.display = 'none'; cur = null;
            statusEl.textContent = 'Moving…'; saveNow(); return;
          }
          if (b.dataset.a === 'flip') { if (t.flip.type === 'checkbox') t.flip.checked = !t.flip.checked; else t.flip.value = t.flip.value ? '' : '1'; fire(t.flip); }
          else step(t.sel, b.dataset.a === 'prev' ? -1 : 1, t.custom);
          statusEl.textContent = 'Changing layout…'; saveNow();
        });
      }
      onPreviewLoad(hook);
      hook();
    })();

    // ---- where am I: the section being edited is outlined on the page with an "Editing: ..." tag, and pointing at
    // a box in the panel lights up the words or photo it controls ----
    (function () {
      const FAM = { whyChoose: 'why' };
      const norm = (t) => String(t || '').replace(/\{\{([^{}|<>]{1,300}?)(?:\|[^{}|<>]{0,40}){1,6}\}\}/g, '$1').replace(/[\[\]]/g, '').replace(/\s+/g, ' ').trim().toLowerCase();
      const fileKey = (u) => { const m = /([^\/?#]+?)(?:-\d{2,4})?\.(?:jpe?g|png|gif|webp|avif|svg)(?:[?#].*)?$/i.exec(String(u || '')); return m ? m[1].toLowerCase() : ''; };
      const secs = () => [...document.querySelectorAll('#sectionsContainer .draggable-section')];
      let cur = null, hintIdx = null, tag = null, ro = null;
      const pdoc = () => { try { const d = preview.contentDocument; return d && d.body ? d : null; } catch (e) { return null; } };
      const root = (d) => d.querySelector('main') || d.body;
      // the page-level block (a direct child of <main>, or the footer) an element sits in
      function topBlock(el, d) {
        const m = root(d);
        for (let n = el; n && n !== d.body; n = n.parentElement) { if (n.parentElement === m) return n; if (n.tagName === 'FOOTER' || n.tagName === 'HEADER' && n.parentElement === d.body) return n; }
        return null;
      }
      window.sgPreviewBlock = (el) => { const d = pdoc(); return d && el ? topBlock(el, d) : null; };
      // a block made from a library section names its family, which names the page section
      window.sgSectionForBlock = (block) => {
        const s = block.matches('[data-sg-fam]') ? block : block.querySelector('[data-sg-fam]');
        if (!s) return null;
        const fam = s.dataset.sgFam, key = Object.keys(FAM).find(k => FAM[k] === fam) || fam;
        return secs().find(b => b.dataset.key === key) || null;
      };
      // everything on the page with words, deepest first wins
      function textEls(d) {
        return [...d.body.querySelectorAll('main *, footer *')].filter(n => !n.closest('.sg-lt, .sg-edit-tag, script, style, template, svg'));
      }
      function matchText(d, v, els) {
        if (!v || v.length < 3) return [];
        els = els || textEls(d);
        let hits = els.filter(n => norm(n.textContent) === v);
        if (!hits.length && v.length >= 8) hits = els.filter(n => { const t = norm(n.textContent); return t.length < v.length * 3 && t.includes(v); });
        return hits.filter(h => !hits.some(o => o !== h && h.contains(o))).slice(0, 6);
      }
      function matchImage(d, url) {
        const k = fileKey(url); if (!k) return [];
        const imgs = [...d.querySelectorAll('img')].filter(i => fileKey(i.currentSrc || i.src) === k || fileKey(i.getAttribute('src')) === k);
        const bgs = [...d.querySelectorAll('[style*="url("], [data-hero-photo]')].filter(n => fileKey((/url\(["']?([^"')]+)/.exec(n.getAttribute('style') || '') || [])[1] || n.getAttribute('data-hero-photo')) === k);
        return imgs.concat(bgs).slice(0, 6);
      }
      function blocksFor(sec, d) {
        if (hintIdx != null) { const b = root(d).children[hintIdx]; if (b) return [b]; }
        if (sec.matches('.blk-entry')) {   // a content block: its spot on the page, by its place in the list of blocks
          const i = [...document.querySelectorAll('#editorForm .block-row')].indexOf(sec.querySelector('.block-row'));
          const el = d.querySelector('[data-sg-blk="' + i + '"]');
          return el ? [topBlock(el, d) || el] : [];
        }
        const fam = FAM[sec.dataset.key] || sec.dataset.key;
        const fromFam = [...new Set([...d.querySelectorAll('[data-sg-fam="' + fam + '"]')].map(x => topBlock(x, d) || x))];
        if (fromFam.length) return fromFam;
        // words that only show in the footer or menu (a link named like the section) don't count, except for hours and contact
        const inFooter = ['hours', 'contact'].includes(sec.dataset.key);
        const els = textEls(d).filter(n => (inFooter || !n.closest('footer')) && !n.closest('nav'));
        const vals = [...sec.querySelectorAll('input[type=text], input:not([type]), textarea')].filter(f => !f.closest('template'))
          .map(f => norm(f.value)).filter(v => v.length >= 4).sort((a, b) => b.length - a.length).slice(0, 8);
        for (const v of vals) { const h = matchText(d, v, els)[0]; const b = h && topBlock(h, d); if (b) return [b]; }
        return [];
      }
      function ensureStyle(d) {
        if (d.getElementById('sg-where-style')) return;
        const st = d.createElement('style'); st.id = 'sg-where-style';
        st.textContent = '.sg-edit-frame{position:fixed;z-index:2147483000;pointer-events:none;border:3px solid #2563eb;box-sizing:border-box}' +
          '.sg-edit-tag{position:fixed;z-index:2147483001;pointer-events:none;background:#2563eb;color:#fff;font:600 13px/1 system-ui,sans-serif;padding:7px 11px;border-radius:0 0 10px 0;box-shadow:0 4px 14px rgba(0,0,0,.2)}' +
          '.sg-pv-hl{outline:3px solid #f59e0b !important;scroll-margin-top:120px;outline-offset:3px;background-color:rgba(245,158,11,.16) !important;border-radius:4px}';
        d.head.appendChild(st);
      }
      // the height of a header that stays stuck to the top of the page, so the outline and tag sit below it
      function stuckTop(d) {
        let y = 0;
        d.body.querySelectorAll('body > nav, body > header, body > .top-bar, .site-nav').forEach(n => {
          const cs = d.defaultView.getComputedStyle(n), r = n.getBoundingClientRect();
          if (r.height >= d.defaultView.innerHeight / 3) return;
          if (cs.position === 'fixed' && r.top <= 1) y = Math.max(y, r.bottom);
          else if (cs.position === 'sticky') y = Math.max(y, (parseFloat(cs.top) || 0) + r.height);
        });
        return y;
      }
      // the outline and tag are drawn over the page (not on the section itself), so nothing in the design covers them
      let frames = [];
      function place(d) {
        if (!tag) return;
        const list = [...d.querySelectorAll('.sg-editing')];
        const vh = d.defaultView.innerHeight, top = stuckTop(d);
        while (frames.length < list.length) { const f = d.createElement('div'); f.className = 'sg-edit-frame'; f.setAttribute('aria-hidden', 'true'); d.body.appendChild(f); frames.push(f); }
        frames.forEach((f, i) => {
          const b = list[i]; if (!b) { f.style.display = 'none'; return; }
          const r = b.getBoundingClientRect();
          const t = Math.max(r.top, top);
          f.style.display = r.bottom < top + 8 || r.top > vh ? 'none' : '';
          f.style.borderTopColor = r.top < top ? 'transparent' : '';
          f.style.top = t + 'px'; f.style.left = r.left + 'px'; f.style.width = r.width + 'px'; f.style.height = (r.bottom - t) + 'px';
        });
        const vis = list.map(b => b.getBoundingClientRect()).find(r => r.bottom > top + 30 && r.top < vh);
        if (!vis) { tag.style.display = 'none'; return; }
        tag.style.display = '';
        tag.style.top = Math.min(Math.max(vis.top, top), vis.bottom - 30) + 'px'; tag.style.left = Math.max(vis.left, 0) + 'px';
      }
      function paint(scroll) {
        const d = pdoc(); if (!d) return;
        ensureStyle(d);
        d.querySelectorAll('.sg-editing').forEach(n => n.classList.remove('sg-editing'));
        if (tag && tag.ownerDocument !== d) { tag = null; frames = []; }
        if (!cur) { if (tag) tag.style.display = 'none'; frames.forEach(f => { f.style.display = 'none'; }); return; }
        const list = blocksFor(cur, d);
        // opened from the list but not on the page being previewed: show the section's own page instead
        const pageSel = document.getElementById('previewPageSelect');
        if (!list.length && scroll && pageSel && pageSel.value !== cur.dataset.key && [...pageSel.options].some(o => o.value === cur.dataset.key)) {
          pageSel.value = cur.dataset.key; pageSel.dispatchEvent(new Event('change'));
        }
        list.forEach(b => b.classList.add('sg-editing'));
        if (!tag) { tag = d.createElement('div'); tag.className = 'sg-edit-tag'; tag.setAttribute('aria-hidden', 'true'); d.body.appendChild(tag); }
        tag.textContent = 'Editing: ' + (window.sgSectionName ? window.sgSectionName(cur) : cur.dataset.key);
        place(d);
        if (!d.__sgWhere) {
          d.__sgWhere = true;
          let raf = 0; const later = () => { if (!raf) raf = d.defaultView.requestAnimationFrame(() => { raf = 0; place(d); }); };
          d.defaultView.addEventListener('resize', later); d.defaultView.addEventListener('scroll', later, { passive: true });
          try { ro = new d.defaultView.ResizeObserver(() => place(d)); ro.observe(d.body); } catch (e) { /* older browser */ }
        }
        if (scroll && list[0]) {
          const r = list[0].getBoundingClientRect(), h = d.defaultView.innerHeight;
          const top = stuckTop(d);
          if (r.top < top || r.top > h * 0.6) d.defaultView.scrollTo({ top: d.defaultView.scrollY + r.top - top - 8, behavior: 'smooth' });
        }
      }
      window.sgFocusChanged = (sec, opts) => {
        const d = pdoc();
        hintIdx = opts.block && d && opts.block.parentElement === root(d) ? [...root(d).children].indexOf(opts.block) : null;
        if (sec !== cur && !opts.block) hintIdx = null;
        cur = sec;
        paint(!opts.noScroll);
      };
      cur = document.querySelector('#sectionsContainer .focus-on');
      onPreviewLoad(() => paint(false));
      paint(true);

      // pointing at (or typing in) a box in the panel lights up what it controls on the page
      let lit = [];
      const unlight = () => { lit.forEach(n => n.classList.remove('sg-pv-hl')); lit = []; };
      function fieldAt(t) {
        if (!t || !t.closest || t.closest('template')) return null;
        let f = t.closest('input, textarea');
        if (!f && t.tagName === 'LABEL') { const n = t.nextElementSibling; f = n && (n.matches('input, textarea') ? n : n.querySelector('input[type=url], input[type=text], textarea')); }
        if (!f && t.closest('.upload-row')) f = t.closest('.upload-row').querySelector('input[type=url], input[type=text]');
        if (!f || !f.name || ['hidden', 'file', 'checkbox', 'radio', 'color', 'number', 'range'].includes(f.type)) return null;
        return f;
      }
      function light(f, scroll) {
        unlight();
        const d = pdoc(); if (!d || !f || !f.value.trim()) return;
        ensureStyle(d);
        const v = f.value.trim();
        lit = (f.type === 'url' || fileKey(v)) ? matchImage(d, v) : matchText(d, norm(v));
        lit.forEach(n => n.classList.add('sg-pv-hl'));
        if (scroll && lit[0]) {
          const r = lit[0].getBoundingClientRect(), h = d.defaultView.innerHeight;
          if (r.bottom < 0 || r.top > h) lit[0].scrollIntoView({ block: 'center', behavior: 'smooth' });
        }
      }
      let hov = null;
      form.addEventListener('mouseover', (e) => { const f = fieldAt(e.target); if (f !== hov) { hov = f; if (f) light(f, false); else if (document.activeElement && !fieldAt(document.activeElement)) unlight(); } });
      form.addEventListener('mouseleave', () => { hov = null; const a = fieldAt(document.activeElement); if (a) light(a, false); else unlight(); });
      form.addEventListener('focusin', (e) => { const f = fieldAt(e.target); if (f) light(f, true); });
      form.addEventListener('focusout', () => { setTimeout(() => { if (!fieldAt(document.activeElement) && !hov) unlight(); }, 0); });
      onPreviewLoad(() => { lit = []; const a = fieldAt(document.activeElement); if (a) light(a, false); });
    })();

    window.aiEditHooks = { before: async () => { clearTimeout(autosaveTimer); await doAutosave(); } };

    // ---- AI rewrite (submitted as its own form, since it lives inside the editor form) ----
    const rewriteBtn = document.getElementById('rewriteBtn');
    if (rewriteBtn) {
      rewriteBtn.addEventListener('click', async () => {
        if (!confirm('Rewrite the headline, About text, services and FAQ with AI? The current version is saved to history first.')) return;
        rewriteBtn.disabled = true;
        rewriteBtn.textContent = 'Writing… (up to a minute)';
        clearTimeout(autosaveTimer);
        await doAutosave(); // make sure nothing typed a moment ago is lost
        const f = document.createElement('form');
        f.method = 'POST';
        f.action = `/sites/${siteId}/rewrite-copy`;
        const i = document.createElement('input');
        i.type = 'hidden'; i.name = 'instruction';
        i.value = document.getElementById('rewriteInstruction').value;
        f.appendChild(i);
        document.body.appendChild(f);
        f.submit();
      });
    }
  </script>
