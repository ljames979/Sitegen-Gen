    setTab(edPanel.dataset.tab !== 'content' ? edPanel.dataset.tab : (location.hash.slice(1) || 'content'), true);

    // ---- jump to a field: switch tab, open its boxes, scroll, highlight ----
    function revealField(el, hint) {
      if (!el) return false;
      const holder = el.closest('[data-tab]');
      if (holder) setTab(holder.dataset.tab, true);
      for (let d = el.closest('details'); d; d = d.parentElement && d.parentElement.closest('details')) d.open = true;
      const sec = el.closest('.draggable-section');
