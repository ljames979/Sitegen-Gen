    // ---- "Before you publish" bar: counts what is left and jumps to it ----
    (function () {
      let items = <%- JSON.stringify(checklist) %>, at = -1;
      const sum = document.getElementById('blanksSummary'), list = document.getElementById('blanksList');
      const nextBtn = document.getElementById('blanksNext'), tog = document.getElementById('blanksToggle'), bar = document.getElementById('blanksBar');
      function target(it) {
        if (it.match) {
          let re = null; try { re = new RegExp(it.match, 'i'); } catch (e) { /* bad pattern: fall back to the field */ }
          const hit = re && textFields().find(f => re.test(f.value));
          if (hit) return hit;
        }
        return it.field ? document.querySelector(it.field) : null;
