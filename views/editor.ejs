        else if (e.key === 'ArrowUp') { e.preventDefault(); select(pick - 1); }
        else if (e.key === 'Enter') { e.preventDefault(); run(pick); }
        else if (e.key === 'Escape') { e.preventDefault(); close(); }
        else if (e.key === 'Tab') e.preventDefault();
      });
      list.addEventListener('click', (e) => { const li = e.target.closest('li[role=option]'); if (li) run(+li.id.slice(5)); });
