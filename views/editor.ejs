    // ---- quick search (Ctrl+K): every page section, labelled box, settings group and tool, by name ----
    (function () {
      const dlg = document.getElementById('cmdk'), input = document.getElementById('cmdkInput'), list = document.getElementById('cmdkList');
      let items = [], shown = [], pick = 0, lastFocus = null;
      const clean = (t) => String(t || '').replace(/\s+/g, ' ').trim();
      const tabOf = (el) => { const h = el.closest('[data-tab]'); return h ? h.dataset.tab : ''; };
      const TAB = { content: 'Content', design: 'Design', features: 'Features', settings: 'Settings' };
      function where(el) {
        const sec = el.closest('.draggable-section'), h = sec && sec.querySelector(':scope > h3');
        const det = el.closest('details'), sum = det && det.querySelector(':scope > summary');
        return [TAB[tabOf(el)], h ? clean(h.dataset.name || h.textContent) : '', sum ? clean(sum.textContent) : ''].filter(Boolean).join(' › ');
      }
      function fieldFor(label) {
        if (label.htmlFor) return document.getElementById(label.htmlFor);
        const inside = label.querySelector('input, select, textarea'); if (inside) return inside;
        for (let n = label.nextElementSibling, i = 0; n && i < 3; n = n.nextElementSibling, i++) {
          if (n.matches('input, select, textarea')) return n;
          const deep = n.querySelector && n.querySelector('input, select, textarea'); if (deep) return deep;
          if (n.tagName === 'LABEL') break;
        }
        return null;
      }
      function build() {
        const seen = new Set(), out = [];
        const add = (text, hint, run) => { text = clean(text); const k = text + '|' + hint; if (!text || text.length > 90 || seen.has(k)) return; seen.add(k); out.push({ text, hint, run, hay: (text + ' ' + hint).toLowerCase() }); };
        document.querySelectorAll('#sectionsContainer .draggable-section').forEach(b => {
          const h = b.querySelector(':scope > h3');
          add(h ? (h.dataset.name || h.textContent) : b.dataset.key, 'Page section', () => { setTab('content', true); window.sgOpenSection && window.sgOpenSection(b); b.scrollIntoView({ block: 'start', behavior: 'smooth' }); });
        });
        form.querySelectorAll('details > summary').forEach(sm => {
          if (sm.closest('template')) return;
          const det = sm.parentElement;
          add(sm.textContent, where(det.parentElement) || TAB[tabOf(det)] || '', () => { revealField(sm); det.open = true; });
        });
        form.querySelectorAll('label').forEach(l => {
          if (l.closest('template')) return;
          const f = fieldFor(l); if (!f || f.type === 'hidden') return;
          add(l.textContent, where(l), () => revealField(f));
        });
        document.querySelectorAll('.ed-top a[href]').forEach(a => { const t = a.querySelector('strong'), d = t && t.nextElementSibling; if (a.getAttribute('href') !== '#') add(t ? t.textContent : a.textContent, d ? d.textContent : 'Open', () => { location.href = a.href; }); });
        add('Undo', 'Ctrl+Z', () => undoBtn.click());
        add('Redo', 'Ctrl+Shift+Z', () => redoBtn.click());
        return out;
      }
      function render() {
        const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
        shown = (words.length ? items.filter(i => words.every(w => i.hay.includes(w))) : items.filter(i => i.hint === 'Page section'))
          .sort((a, b) => words.length ? (b.text.toLowerCase().startsWith(words[0]) - a.text.toLowerCase().startsWith(words[0])) : 0).slice(0, 14);
        pick = 0;
        list.innerHTML = shown.length ? shown.map((i, n) => '<li role="option" id="cmdk-' + n + '" aria-selected="' + (n === 0) + '"><span></span><small></small></li>').join('') : '<li class="cmdk-empty">Nothing matches. Try another word.</li>';
        list.querySelectorAll('li[role=option]').forEach((li, n) => { li.querySelector('span').textContent = shown[n].text; li.querySelector('small').textContent = shown[n].hint; });
        input.setAttribute('aria-activedescendant', shown.length ? 'cmdk-0' : '');
      }
      function select(n) {
        if (!shown.length) return;
        pick = (n + shown.length) % shown.length;
        list.querySelectorAll('li[role=option]').forEach((li, i) => li.setAttribute('aria-selected', String(i === pick)));
        const li = document.getElementById('cmdk-' + pick); li.scrollIntoView({ block: 'nearest' });
        input.setAttribute('aria-activedescendant', li.id);
      }
      function open() { lastFocus = document.activeElement; items = build(); input.value = ''; dlg.hidden = false; render(); input.focus(); }
      function close() { dlg.hidden = true; if (lastFocus && lastFocus.focus) lastFocus.focus(); }
      function run(n) { const it = shown[n]; if (!it) return; close(); it.run(); }
      document.getElementById('cmdkOpen').addEventListener('click', open);
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && !e.altKey && e.key.toLowerCase() === 'k') { e.preventDefault(); if (dlg.hidden) open(); else close(); }
      });
      window.sgOpenSearch = open;
      input.addEventListener('input', render);
      input.addEventListener('keydown', (e) => {
