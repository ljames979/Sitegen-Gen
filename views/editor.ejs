    // ---- undo / redo: one step back or forward on the server, then the editor reloads where you were ----
    const undoBtn = document.getElementById('undoBtn'), redoBtn = document.getElementById('redoBtn');
    function setUndo(u, r) {
      if (typeof u === 'number') undoBtn.disabled = !u;
      if (typeof r === 'number') redoBtn.disabled = !r;
    }
    <% const us = typeof undoState !== 'undefined' ? undoState : { undo: 0, redo: 0 }; %>setUndo(<%= us.undo %>, <%= us.redo %>);
    const viewKey = 'sg-editor-view-' + siteId;
    async function stepUndo(dir) {
      await flushSave();
      statusEl.textContent = dir === 'undo' ? 'Undoing…' : 'Redoing…';
      try {
        const res = await fetch(`/sites/${siteId}/${dir}`, { method: 'POST', headers: { 'Accept': 'application/json' } });
        const data = await res.json();
        if (!data.ok) { statusEl.textContent = data.error || 'Could not ' + dir; setUndo(data.undo, data.redo); return; }
        let y = 0; try { y = preview.contentWindow.scrollY; } catch (e) { /* not loaded */ }
        const open = [...form.querySelectorAll('details')].map((d, i) => d.open ? i : -1).filter(i => i >= 0);
        try { sessionStorage.setItem(viewKey, JSON.stringify({ panel: document.getElementById('editorPanel').scrollTop, preview: y, open, done: dir })); } catch (e) { /* storage blocked */ }
        location.reload();
      } catch (e) { statusEl.textContent = 'Could not ' + dir + ' (offline?)'; }
    }
    undoBtn.addEventListener('click', () => stepUndo('undo'));
    redoBtn.addEventListener('click', () => stepUndo('redo'));
    // Ctrl+Z / Ctrl+Shift+Z / Ctrl+Y. Inside a text box the browser's own undo for that box comes first.
    document.addEventListener('keydown', (e) => {
      if (!(e.ctrlKey || e.metaKey) || e.altKey) return;
      const k = e.key.toLowerCase();
      if (k !== 'z' && k !== 'y') return;
      const t = e.target;
      if (t && (t.isContentEditable || (/^(INPUT|TEXTAREA)$/.test(t.tagName) && !/^(checkbox|radio|range|color|file|button|submit)$/.test(t.type)))) return;
      e.preventDefault();
      stepUndo(k === 'y' || e.shiftKey ? 'redo' : 'undo');
    });
    // back where you were after an undo or redo
    (function () {
      let v; try { v = JSON.parse(sessionStorage.getItem(viewKey) || 'null'); sessionStorage.removeItem(viewKey); } catch (e) { v = null; }
      if (!v) return;
      const all = form.querySelectorAll('details');
      (v.open || []).forEach(i => { if (all[i]) all[i].open = true; });
