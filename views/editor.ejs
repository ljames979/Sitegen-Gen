    // one save at a time; a change made while a save is on its way is saved right after it
    let saving = null, saveAgain = false;
    function doAutosave() {
      autosaveTimer = null;
      if (saving) { saveAgain = true; return saving; }
      saving = sendSave().finally(() => { saving = null; if (saveAgain) { saveAgain = false; doAutosave(); } });
      return saving;
