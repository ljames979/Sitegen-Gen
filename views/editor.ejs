    async function pickerLoad(reset) {
      if (reset) { pickerPage = 1; pickerGrid.innerHTML = ''; }
      pickerNote.textContent = 'Searching…';
      try {
        const res = await fetch(`/sites/${siteId}/photos?q=${encodeURIComponent(pickerQuery.value)}&page=${pickerPage}${pickerSource ? '&source=' + pickerSource : ''}`);
        const data = await res.json();
        if (!data.configured) {
          pickerNote.textContent = 'Photo search needs a free Pexels or Unsplash key in the .env file (see the README).';
          pickerMore.hidden = true;
          return;
        }
        pickerSource = data.source;
        pickerSrc.hidden = (data.sources || []).length < 2;
        pickerSrc.querySelectorAll('button').forEach(b => b.setAttribute('aria-pressed', b.dataset.src === data.source ? 'true' : 'false'));
        if (!data.photos.length && reset) { pickerNote.textContent = 'No photos found — try different words.'; pickerMore.hidden = true; return; }
        const un = data.source === 'unsplash';
        data.photos.forEach(p => {
          const b = document.createElement('button');
          b.type = 'button';
          b.title = 'Photo by ' + p.photographer + (un ? ' on Unsplash' : ' on Pexels');
          const img = document.createElement('img');
          img.src = p.thumb; img.alt = p.alt || '';
          b.appendChild(img);
          if (un) { const by = document.createElement('span'); by.className = 'pk-by'; by.textContent = p.photographer; b.appendChild(by); }
          b.addEventListener('click', async () => {
            if (!un) return usePick(p.url);
            // Unsplash: tell it the photo is used and keep the photographer's credit for the site's footer
            try {
              const r = await fetch(`/sites/${siteId}/photos/use`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ id: p.id }) });
              const d = await r.json();
              if (d.ok) return usePick(d.url);
              pickerNote.textContent = d.error || 'Could not use that photo.';
            } catch (e) { pickerNote.textContent = 'Could not use that photo (offline?)'; }
          });
          pickerGrid.appendChild(b);
        });
        if (un) pickerNote.innerHTML = 'Free photos from <a href="https://unsplash.com/?utm_source=sitegen&amp;utm_medium=referral" target="_blank" rel="noopener">Unsplash</a>. The photographer is credited in the site\'s footer.';
        else pickerNote.textContent = 'Free photos from Pexels. Click one to use it.';
