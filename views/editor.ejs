<%# Word styling: pick words in any text box and make them bigger, another font, a color, bold or italic (wordstyle.js) %>
<div id="wsBar" class="ws-bar" hidden role="dialog" aria-label="Style the chosen words">
  <div class="ws-hd"><strong>Style these words</strong> <span id="wsWords"></span></div>
  <div class="ws-row">
    <select id="wsSize" aria-label="Size"><% wordStyle.SIZE_LABELS.forEach(o => { %><option value="<%= o[0] %>"><%= o[1] %></option><% }) %></select>
    <select id="wsFont" aria-label="Font"><option value="">Same font</option><% [...new Set(fonts.FONTS.map(f => f.group))].forEach(g => { %><optgroup label="<%= g %>"><% fonts.FONTS.filter(f => f.group === g).forEach(f => { %><option value="<%= f.name %>"><%= f.name %></option><% }) %></optgroup><% }) %></select>
  </div>
  <div class="ws-row" title="Drag or type an exact size in pixels (8 to 200)">
    <span>Exact size</span><input type="range" id="wsRange" min="8" max="200" value="32" aria-label="Exact size" style="flex:1;min-width:0;margin:0">
    <input type="number" id="wsPx" min="8" max="200" value="32" aria-label="Size in pixels" style="width:64px;margin:0"><span>px</span>
  </div>
  <div class="ws-row">
    <select id="wsColor" aria-label="Color"><option value="">Same color</option><option value="brand">Brand color</option><option value="accent">Accent color</option><option value="pick">A color I pick</option></select>
    <input type="color" id="wsPick" value="<%= site.theme.primaryColor || '#2563eb' %>" aria-label="Pick a color" hidden>
    <label><input type="checkbox" id="wsBold"> Bold</label>
    <label><input type="checkbox" id="wsItalic"> Italic</label>
  </div>
  <div class="ws-row">
    <button type="button" id="wsApply">Apply</button>
    <button type="button" class="btn-secondary" id="wsClear">Remove styling</button>
    <button type="button" class="btn-secondary" id="wsClose">Close</button>
  </div>
  <p class="ws-note">Shows on the site and in the preview. In the box the words look like {{words|bigger}}, which you can also type yourself.</p>
</div>
<style>
  .ws-bar { position: fixed; z-index: 9999; width: 330px; background: #fff; border: 1px solid #cbd5e1; border-radius: 12px; box-shadow: 0 12px 40px rgba(15,23,42,.18); padding: 10px 12px; font-size: 13px; }
  .ws-hd { margin-bottom: 6px; } .ws-hd span { color: #64748b; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ws-row { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-top: 6px; }
  .ws-row select { flex: 1; min-width: 0; margin: 0; padding: 5px 6px; font-size: 13px; }
  .ws-row label { display: inline-flex; gap: 4px; align-items: center; font-weight: 400; margin: 0; }
  .ws-row input[type=color] { width: 36px; height: 28px; padding: 0 2px; margin: 0; }
  .ws-row button { padding: 6px 12px; font-size: 13px; min-height: 0; }
  .ws-note { margin: 8px 0 0; color: #64748b; font-size: 12px; }
  .ws-tip { position: fixed; z-index: 9998; padding: 5px 10px; font-size: 12.5px; border-radius: 999px; background: #0f172a; color: #fff; border: 0; cursor: pointer; box-shadow: 0 4px 14px rgba(15,23,42,.25); }
</style>
<script>
(function () {
  var form = document.getElementById('editorForm'), bar = document.getElementById('wsBar'); if (!form || !bar) return;
  var tip = document.createElement('button'); tip.type = 'button'; tip.className = 'ws-tip'; tip.textContent = 'Aa Style words'; tip.hidden = true; document.body.appendChild(tip);
  var $ = function (id) { return document.getElementById(id); };
  var field = null, a = 0, b = 0;
  var MARK = /\{\{([^{}|<>]{1,300}?)((?:\|[^{}|<>]{0,40}){1,6})\}\}/g;
  var styleable = function (el) { return el && form.contains(el) && (el.tagName === 'TEXTAREA' || (el.tagName === 'INPUT' && el.type === 'text')) && !/url|image|email|phone|color|slug|domain/i.test(el.name || ''); };
  // the marker the selection sits in, if any
  function around(v, s, e) {
    MARK.lastIndex = 0; var m;
    while ((m = MARK.exec(v))) { var st = m.index, en = st + m[0].length; if (s >= st && e <= en) return { st: st, en: en, words: m[1], opts: m[2].split('|').filter(Boolean) }; }
    return null;
  }
  function place(el, box) {
    var r = el.getBoundingClientRect(), w = box.offsetWidth || 330, h = box.offsetHeight || 40;
    var top = r.bottom + 6; if (top + h > innerHeight - 8) top = Math.max(8, r.top - h - 6);
    box.style.top = top + 'px'; box.style.left = Math.max(8, Math.min(innerWidth - w - 8, r.left)) + 'px';
  }
  function check(e) {
    var el = e.target;
    if (!styleable(el)) return;
    var s = el.selectionStart, en = el.selectionEnd;
    if (s == null || s === en || !el.value.slice(s, en).trim()) { if (!around(el.value, s, en)) { tip.hidden = true; return; } }
    field = el; a = s; b = en;
    tip.hidden = false; place(el, tip);
  }
  ['mouseup', 'keyup', 'select'].forEach(function (t) { form.addEventListener(t, check); });
  form.addEventListener('focusout', function () { setTimeout(function () { if (document.activeElement !== tip && !bar.contains(document.activeElement)) tip.hidden = true; }, 150); });
  function open() {
    tip.hidden = true;
    var v = field.value, m = around(v, a, b);
    if (m) { a = m.st; b = m.en; }
    var opts = m ? m.opts.map(function (o) { return o.trim(); }) : [], low = opts.map(function (o) { return o.toLowerCase(); });
    $('wsWords').textContent = '"' + (m ? m.words : v.slice(a, b)) + '"';
    var px = low.filter(function (x) { return /^\d{1,3}px$/.test(x); })[0];
    $('wsSize').value = px ? 'px' : ['smaller', 'big', 'bigger', 'huge'].filter(function (x) { return low.indexOf(x) >= 0; })[0] || '';
    if (px) $('wsPx').value = $('wsRange').value = parseInt(px, 10);
    var hex = opts.filter(function (o) { return /^#[0-9a-f]{6}$/i.test(o); })[0];
    $('wsColor').value = hex ? 'pick' : (low.indexOf('brand') >= 0 ? 'brand' : low.indexOf('accent') >= 0 ? 'accent' : '');
    if (hex) $('wsPick').value = hex; $('wsPick').hidden = $('wsColor').value !== 'pick';
    $('wsBold').checked = low.indexOf('bold') >= 0; $('wsItalic').checked = low.indexOf('italic') >= 0;
    var known = Array.prototype.map.call($('wsFont').options, function (o) { return o.value; });
    $('wsFont').value = opts.filter(function (o) { return known.indexOf(o) > 0; })[0] || '';
    bar.hidden = false; place(field, bar);
  }
  tip.addEventListener('mousedown', function (e) { e.preventDefault(); });
  tip.addEventListener('click', open);
  $('wsColor').addEventListener('change', function () { $('wsPick').hidden = this.value !== 'pick'; });
  // the slider and the number are one exact size: touching either picks "Exact size"
  $('wsRange').addEventListener('input', function () { $('wsPx').value = this.value; $('wsSize').value = 'px'; });
  $('wsPx').addEventListener('input', function () { var n = Math.round(+this.value); if (n >= 8 && n <= 200) $('wsRange').value = n; $('wsSize').value = 'px'; });
  // from words picked on the page (the preview's typing bar): style those words of that box, with the bar by them
  window.sgStyleWords = function (el, s, e, at) {
    field = el; a = s; b = e; open();
    if (at) { bar.style.top = Math.max(8, Math.min(innerHeight - bar.offsetHeight - 8, at.top)) + 'px'; bar.style.left = Math.max(8, Math.min(innerWidth - bar.offsetWidth - 8, at.left)) + 'px'; }
  };
  function put(text, selStart, selEnd) {
    field.value = text; field.focus(); field.setSelectionRange(selStart, selEnd);
    field.dispatchEvent(new Event('input', { bubbles: true })); field.dispatchEvent(new Event('change', { bubbles: true }));
    bar.hidden = true;
  }
  $('wsApply').addEventListener('click', function () {
    if (!field) return;
    var v = field.value, m = around(v, a, b), words = m ? m.words : v.slice(a, b);
    var lead = words.match(/^\s*/)[0], trail = words.match(/\s*$/)[0]; words = words.trim();
    var o = [];
    if ($('wsSize').value === 'px') { var n = Math.round(+$('wsPx').value); if (n >= 8 && n <= 200) o.push(n + 'px'); }
    else if ($('wsSize').value) o.push($('wsSize').value);
    if ($('wsFont').value) o.push($('wsFont').value);
    var c = $('wsColor').value; if (c === 'pick') o.push($('wsPick').value); else if (c) o.push(c);
    if ($('wsBold').checked) o.push('bold'); if ($('wsItalic').checked) o.push('italic');
    var mark = o.length ? '{{' + words + '|' + o.join('|') + '}}' : words;
    var start = m ? m.st : a, end = m ? m.en : b;
    put(v.slice(0, start) + lead + mark + trail + v.slice(end), start + lead.length, start + lead.length + mark.length);
  });
  $('wsClear').addEventListener('click', function () {
    if (!field) return;
    var v = field.value, m = around(v, a, b); if (!m) { bar.hidden = true; return; }
    put(v.slice(0, m.st) + m.words + v.slice(m.en), m.st, m.st + m.words.length);
  });
  $('wsClose').addEventListener('click', function () { bar.hidden = true; });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { bar.hidden = true; tip.hidden = true; } });
  addEventListener('scroll', function () { tip.hidden = true; }, true);
})();
</script>
</body>
</html>
