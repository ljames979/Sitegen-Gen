<!DOCTYPE html>
<html>
<head>
  <title><%= d.bizName || 'Answers' %> — Client answers — SiteGen</title>
  <%- include('partials-head') %>
  <style>
    .ans dt { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; margin-top: 12px; }
    .ans dd { margin: 2px 0 0; white-space: pre-wrap; }
    .thumbs { display: flex; gap: 8px; flex-wrap: wrap; } .thumbs img { height: 80px; border-radius: 8px; border: 1px solid #e2e8f0; }
    .warn { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; padding: 12px 14px; border-radius: 10px; margin-bottom: 16px; }
    .warn.bad { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
    .design-opts { display: grid; gap: 8px; margin-bottom: 12px; }
    .design-opt { display: flex; gap: 10px; align-items: flex-start; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; cursor: pointer; background: #fff; }
    .design-opt input { margin-top: 4px; width: auto; }
    .design-opt:has(input:checked) { border-color: var(--primary); box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary) 25%, transparent); }
    .do-dots { display: inline-flex; gap: 3px; margin-left: 8px; vertical-align: middle; } .do-dots i { width: 14px; height: 14px; border-radius: 50%; border: 1px solid #0002; display: inline-block; }
    .warn ul { margin: 6px 0 0 18px; padding: 0; }
  </style>
</head>
<body>
  <nav><div class="row"><a href="/intake" class="muted">&larr; Questionnaires</a><strong><%= d.bizName %></strong></div></nav>
  <div class="container">
    <% if (error) { %><div class="warn bad">Something went wrong building the site. Nothing was lost. Try again in a moment.</div><% } %>
    <% if (/^pdf-/.test(s.source || '')) { %>
      <div class="warn"><strong>From an uploaded PDF.</strong>
        <%= s.source === 'pdf-ai' ? 'The AI read this from the PDF (a scan, handwriting or another layout). Check every answer against the PDF before you build: a misread phone number or price would go on the site.' : 'Read from the questionnaire PDF\'s form fields, exactly as the client typed them.' %>
        <% if (s.pdf_file) { %> <a href="/intake/submissions/<%= s.id %>/pdf" target="_blank" rel="noopener">Open the original PDF</a><% } %>
        <% if (!d.bizType) { %><br>The kind of business was left empty, so a general template will be used.<% } %>
      </div>
    <% } %>

    <div class="card" style="margin-bottom:20px;">
      <% if (site) { %>
        <p style="margin:0 0 10px;">A site was built from these answers.</p>
        <a class="btn" href="/sites/<%= site.id %>/edit">Open the site</a>
      <% } else { %>
        <p style="margin:0 0 10px;">Read the answers below, then build. The site will use only what the client wrote. You can edit everything afterwards.</p>
        <form method="POST" action="/intake/submissions/<%= s.id %>/build" onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').textContent='Building…';">
          <label style="display:flex;gap:8px;align-items:center;font-weight:400;margin:0 0 10px;"><input type="checkbox" name="auto_blocks" value="1" checked style="width:auto;"> Add the new design blocks that suit this kind of business (About us, photo, social and contact blocks), filled with the client's own words<% if (s.d && s.d.logo) { %>; the colors come from the client's logo, matched to our closest palette<% } %></label>
          <% if (designChoices && designChoices.options.length) { %>
          <h3 style="margin:14px 0 4px;font-size:15px;">Pick a design<%= designChoices.industry ? ' for ' + designChoices.industry.toLowerCase() : '' %></h3>
          <p class="muted" style="margin:0 0 8px;font-size:13px;">Based on the type of business and the look and words the client gave. You can change everything afterwards.</p>
          <div class="design-opts">
            <% designChoices.options.forEach((o, i) => { %>
            <label class="design-opt">
              <input type="radio" name="option" value="<%= o.index %>" <%= i === 0 ? 'checked' : '' %>>
              <span class="do-body">
                <strong><%= o.title %>: <%= o.style %></strong> <span class="muted">(<%= o.description %>)</span>
                <% if (o.primaryColor) { %><span class="do-dots"><i style="background:<%= o.primaryColor %>"></i><i style="background:<%= o.accentColor %>"></i></span><% } %>
                <small class="muted" style="display:block;"><%= o.why %><%= o.headingFont ? ' · ' + o.headingFont + (o.bodyFont ? ' + ' + o.bodyFont : '') : '' %></small>
                <% if (o.cautions) { %><small style="display:block;color:#92400e;"><%= o.cautions %></small><% } %>
              </span>
            </label>
            <% }) %>
          </div>
          <% } %>
          <button type="submit">Build the website</button>
        </form>
      <% } %>
    </div>

    <% if (claims.length) { %><div class="warn"><strong>Check these before you publish.</strong> They appear on the site exactly as the client wrote them.<ul><% claims.forEach(c => { %><li><%= c %></li><% }) %></ul></div><% } %>
    <% if (todo.length) { %><div class="warn"><strong><%= site ? 'Still to do' : 'You will need to' %></strong><ul><% todo.forEach(t => { %><li><%= t %></li><% }) %></ul></div><% } %>

    <div class="card">
      <dl class="ans">
        <% const row = (k, v) => { if (v) { %><dt><%= k %></dt><dd><%= v %></dd><% } }; %>
        <% row('Business', d.bizName); row('Type', d.bizType); row('City', d.city); row('Years in business', d.years); row('Tagline', d.tagline); %>
        <% if (d.services.length) { %><dt>Services</dt><dd><% d.services.forEach(x => { %>• <%= x.name %><%= x.price ? ' (' + x.price + ')' : '' %><%= x.desc ? ': ' + x.desc : '' %>
<% }) %></dd><% } %>
        <% row('What makes them different', (d.diffs || []).join('\n') || d.diff); row('Preferred tone', (intakeLib.TONES.find(t => t[0] === d.tone) || [])[1] === 'No preference' ? '' : (intakeLib.TONES.find(t => t[0] === d.tone) || [])[1]); row('Areas served', d.areas); row('Their story', d.about); row('Credentials', d.badges); %>
        <% row('Phone', d.phone); row('Email', d.email); row('Address', d.address); row('Hours Mon-Fri', d.hrsWeekday); row('Hours Sat', d.hrsSat); row('Hours Sun', d.hrsSun); %>
        <% row('Facebook', d.facebook); row('Instagram', d.instagram); row('Other link', d.otherLink); %>
        <% const mood = intakeLib.MOODS.find(m => m[0] === d.mood); row('Look and feel', mood ? mood[1] : ''); row('Brand color', d.brandColor); row('Sites they like', d.inspo); row('What they like about them', d.inspoLike); %>
        <% const goal = intakeLib.GOALS.find(g => g[0] === d.goal); row('Main goal', goal ? goal[1] : ''); %>
        <% if (d.features.length) { %><dt>Wants</dt><dd><%= d.features.map(f => (intakeLib.FEATURES.find(x => x[0] === f) || [0, f])[1]).join('\n') %></dd><% } %>
        <% if (d.faq.length) { %><dt>Common questions</dt><dd><% d.faq.forEach(x => { %>Q: <%= x.q %>
A: <%= x.a %>

<% }) %></dd><% } %>
        <% row('Stock photos OK', d.stockOk ? 'Yes' : 'No'); row('Package they want', d.pkg); row('Notes', d.notes); %>
        <% if (d.logo) { %><dt>Logo</dt><dd class="thumbs"><img src="<%= d.logo %>" alt="Logo"></dd><% } %>
        <% if (d.photos.length) { %><dt>Photos</dt><dd class="thumbs"><% d.photos.forEach(p => { %><img src="<%= p %>" alt=""><% }) %></dd><% } %>
        <% row('Contact name', d.contactName); row('Contact email', d.contactEmail); row('Contact phone', d.contactPhone); %>
      </dl>
    </div>

    <form method="POST" action="/intake/submissions/<%= s.id %>/delete" onsubmit="return confirm('Delete these answers? A site already built from them is kept.');" style="margin-top:16px;"><button type="submit" class="btn-secondary">Delete these answers</button></form>
  </div>
</body>
</html>
