<!DOCTYPE html>
<html>
<head>
  <title>Preview — <%= d.name %> — SiteGen</title>
  <%- include('partials-head') %>
  <style>
    html, body { height: 100%; } body { display: flex; flex-direction: column; background: #eef1f5; }
    .bar { display: flex; align-items: center; gap: 14px; padding: 10px 16px; background: #fff; border-bottom: 1px solid #e2e8f0; flex-wrap: wrap; }
    .bar h1 { font-size: 16px; margin: 0; } .bar .sp { flex: 1; }
    .looks { display: flex; gap: 6px; overflow-x: auto; padding: 8px 16px; background: #fff; border-bottom: 1px solid #e2e8f0; }
    .looks form { margin: 0; }
    .look { display: flex; align-items: center; gap: 7px; white-space: nowrap; background: #f1f5f9; color: #0f172a; border: 2px solid transparent; border-radius: 999px; padding: 6px 14px; font-size: 13.5px; font-weight: 600; cursor: pointer; }
    .look i { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
    .look.on { border-color: #4f46e5; background: #eef2ff; }
    .stage { flex: 1; display: flex; justify-content: center; padding: 16px; min-height: 0; }
    .stage iframe { width: 100%; height: 100%; border: 0; background: #fff; border-radius: 14px; box-shadow: 0 8px 30px rgba(15,23,42,.12); transition: max-width .2s; max-width: 1400px; }
    .stage.phone iframe { max-width: 390px; }
    .seg button { padding: 6px 12px; font-size: 13px; } .seg button.on { background: #0f172a; color: #fff; }
    .note { font-size: 13px; color: var(--muted); margin: 0; padding: 0 16px 8px; background: #fff; }
    .bar form { margin: 0; }
    .picks { display: flex; gap: 10px 18px; align-items: center; flex-wrap: wrap; padding: 8px 16px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; font-size: 13.5px; }
    .picks form { margin: 0; display: inline; } .picks b { font-weight: 600; }
    .pal { display: inline-flex; align-items: center; gap: 6px; background: #fff; color: #0f172a; border: 2px solid #e2e8f0; border-radius: 999px; padding: 4px 10px; font-size: 13px; cursor: pointer; }
    .pal.on { border-color: #4f46e5; background: #eef2ff; }
    .pal i, .sw { width: 14px; height: 14px; border-radius: 50%; display: inline-block; border: 1px solid rgba(15,23,42,.15); }
    .linkbtn { background: none; border: 0; color: #4f46e5; text-decoration: underline; padding: 0; font-size: 13px; cursor: pointer; }
  </style>
</head>
<body>
  <div class="bar">
    <a href="/" class="muted">&larr; Your sites</a>
    <h1><%= d.name %></h1>
    <span class="muted" style="font-size:13px;">Preview only: nothing is saved yet</span>
    <span class="sp"></span>
    <span class="seg"><button type="button" class="btn-secondary on" data-w="desktop">Desktop</button> <button type="button" class="btn-secondary" data-w="phone">Phone</button></span>
    <form method="POST" action="/sites/draft/<%= token %>/discard"><button type="submit" class="btn-secondary">Discard</button></form>
    <form method="POST" action="/sites/draft/<%= token %>/create"><button type="submit">Create this site</button></form>
  </div>
  <div class="looks" role="group" aria-label="Choose a look">
    <% looks.forEach(l => { %>
      <form method="POST" action="/sites/draft/<%= token %>/look"><input type="hidden" name="look" value="<%= l[0] %>"><button type="submit" class="look <%= current === l[0] ? 'on' : '' %>" title="<%= l[2] %>"><i style="background:<%= l[3] %>"></i><%= l[1] %></button></form>
    <% }) %>
  </div>
  <% if (auto) { %>
  <div class="picks" aria-label="What the generator picked">
    <span><b>Industry:</b> <%= auto.industry && auto.industry.id !== 'generic' ? auto.industry.label : 'General (no close match)' %><% if (auto.industry && auto.industry.how === 'ai') { %> <span class="muted">(picked by AI)</span><% } %> <a href="/dashboard" class="muted" title="Generate again with a clearer type of business">wrong?</a></span>
    <% if (auto.logo) { %><span><b>Logo colors:</b> <% auto.logo.colors.forEach(c => { %><i class="sw" style="background:<%= c %>" title="<%= c %>"></i> <% }) %><span class="muted"><%= auto.logo.applied ? auto.logo.why : 'Your typed brand color is used instead.' %></span></span><% } %>
    <% if ((auto.blocks || []).length) { %><span><b>New blocks:</b> <%= auto.blocks.join(', ') %> <form method="POST" action="/sites/draft/<%= token %>/noblocks"><button type="submit" class="linkbtn">take them out</button></form></span><% } %>
    <% if ((auto.choices || []).length) { %><span role="group" aria-label="Colors"><b>Colors:</b>
      <% auto.choices.forEach(c => { const on = c.primary === colorsNow.primary && c.accent === colorsNow.accent; %><form method="POST" action="/sites/draft/<%= token %>/colors"><input type="hidden" name="pal" value="<%= c.id %>"><button type="submit" class="pal <%= on ? 'on' : '' %>" aria-pressed="<%= on %>"><i style="background:<%= c.primary %>"></i><i style="background:<%= c.accent %>"></i><%= c.name %></button></form> <% }) %>
    </span><% } %>
  </div>
  <% } %>
  <p class="note"><%= ai ? 'The text was written with AI from the details you gave. ' : 'The text is built-in starter copy. ' %>Switching the look keeps the same words and photos. You can change everything after creating.</p>
  <div class="stage" id="stage"><iframe src="/sites/draft/<%= token %>/frame" title="Site preview"></iframe></div>
  <script>
    document.querySelectorAll('.seg button').forEach(function (b) {
      b.addEventListener('click', function () {
        document.getElementById('stage').classList.toggle('phone', b.dataset.w === 'phone');
        document.querySelectorAll('.seg button').forEach(function (x) { x.classList.toggle('on', x === b); });
      });
    });
  </script>
</body>
</html>
