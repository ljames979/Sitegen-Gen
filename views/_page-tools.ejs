<%# The page tools (Leo, 2026-11-06: the same tools in the editor and on the Blocks screen's Edit mode):
    + Add text, + Add picture / paws / shapes / stamps, Style text and Move & size. Plain script, included inside a
    <script>. The page that includes it provides: preview (the current preview iframe), onPreviewLoad(fn), statusEl,
    scheduleAutosave(), flushSave(), freshPreview(), siteId, inlineEditing / pvStale (let), isCut, cutOrig, cutPhoto,
    pickPhotoFor (a photo search, or null), and the hidden boxes #textsJson, #tstylesJson, #estylesJson, #picsJson. %>
    // ---- your own text, anywhere (textboxes.js): "+ Add text", then click a spot on the page; click a text box to
    // type in it, drag it by its handle, widen it from its corner, and set its size, font, color, bold, italic and
    // alignment from the bar above it. The list rides along with every save in the hidden texts_json box. ----
    (function () {
      const input = document.getElementById('textsJson'), addBtn = document.getElementById('addTextBtn');
      if (!input || !addBtn) return;
      const FONTS = <%- JSON.stringify(fonts.FONTS.map(f => [f.name, f.group])) %>;
      const COLORS = { brand: 'var(--primary)', accent: 'var(--accent)', white: '#ffffff', dark: '#111827' };
      let list = []; try { list = JSON.parse(input.value) || []; } catch (e) { list = []; }
      let adding = false, cur = null;
      const save = () => { input.value = JSON.stringify(list); scheduleAutosave(); };
      const newId = () => 't' + Array.from({ length: 7 }, () => 'abcdefghijklmnopqrstuvwxyz0123456789'[Math.floor(Math.random() * 36)]).join('');
      const pdoc = () => { try { const d = preview.contentDocument; return d && d.body ? d : null; } catch (e) { return null; } };
      function styleBox(el, t) {
        const st = el.style;
        st.setProperty('--x', t.x + '%'); st.setProperty('--y', t.y + '%'); st.setProperty('--w', t.w + '%'); st.setProperty('--fs', t.size);
        st.fontFamily = t.font ? "'" + t.font + "', var(--heading-font, inherit)" : '';
        st.color = t.color ? (COLORS[t.color] || t.color) : '';
        st.fontWeight = t.bold ? '700' : '400'; st.fontStyle = t.italic ? 'italic' : 'normal'; st.textAlign = t.align || 'left';
      }
      function loadFont(d, name) {
        if (!name || d.querySelector('link[data-sg-txf="' + name + '"]')) return;
        const l = d.createElement('link'); l.rel = 'stylesheet'; l.dataset.sgTxf = name;
        l.href = 'https://fonts.googleapis.com/css2?family=' + encodeURIComponent(name).replace(/%20/g, '+') + '&display=swap';
        d.head.appendChild(l);
      }
      function setAdding(on) {
        adding = on; addBtn.setAttribute('aria-pressed', String(on)); addBtn.classList.toggle('on', on);
        const d = pdoc(); if (d) d.documentElement.classList.toggle('sg-tx-adding', on);
        if (on) { statusEl.textContent = 'Click the spot on the page where your text should go (Esc to stop)'; }
      }
      addBtn.addEventListener('click', () => { endBox(); setAdding(!adding); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && adding) setAdding(false); });

      function css(d) {
        if (d.getElementById('sg-tx-ed')) return;
        const st = d.createElement('style'); st.id = 'sg-tx-ed';
        st.textContent = '.sg-tx-adding, .sg-tx-adding *{cursor:crosshair !important}' +
          '.sg-tx{cursor:pointer}.sg-tx:hover{outline:1px dashed #2563eb;outline-offset:3px}' +
          '.sg-tx.sg-tx-on{outline:2px solid #2563eb !important;outline-offset:3px;cursor:text;caret-color:#2563eb}' +
          '.sg-tx-grip,.sg-tx-size{position:absolute;z-index:2147483002;width:22px;height:22px;border-radius:6px;background:#2563eb;color:#fff;display:grid;place-items:center;font:700 13px/1 system-ui,sans-serif;box-shadow:0 2px 8px rgba(0,0,0,.25);touch-action:none;user-select:none}' +
          '.sg-tx-grip{cursor:move}.sg-tx-size{cursor:ew-resize}' +
          '.sg-txbar{position:absolute;z-index:2147483003;display:flex;flex-wrap:wrap;gap:4px;align-items:center;max-width:min(640px,calc(100vw - 16px));padding:6px;background:#0f172a;color:#fff;border-radius:10px;box-shadow:0 6px 20px rgba(0,0,0,.3);font:600 12.5px/1.2 system-ui,sans-serif}' +
          '.sg-txbar label{display:inline-flex;align-items:center;gap:4px;color:#cbd5e1;font-weight:500}' +
          '.sg-txbar select,.sg-txbar input[type=number]{all:revert;font:500 12.5px system-ui,sans-serif;padding:3px 4px;border-radius:6px;border:0;max-width:150px}' +
          '.sg-txbar input[type=number]{width:52px}.sg-txbar input[type=range]{width:90px}.sg-txbar input[type=color]{width:28px;height:24px;padding:0;border:0;background:none}' +
          '.sg-txbar button{all:unset;cursor:pointer;color:#fff;padding:5px 8px;border-radius:6px;line-height:1}.sg-txbar button:hover,.sg-txbar button:focus-visible,.sg-txbar button[aria-pressed=true]{background:#334155}' +
          '.sg-txbar .del{color:#fca5a5}';
        d.head.appendChild(st);
      }
      // the part of the page (a child of <main>, or the footer) a point sits in
      function partAt(d, el) {
        const parts = d.defaultView.sgText ? d.defaultView.sgText.parts() : [];
        for (let n = el; n && n !== d.body; n = n.parentElement) if (parts.includes(n)) return n;
        return null;
      }
      function addAt(d, e) {
        const part = partAt(d, e.target), T = d.defaultView.sgText, holder = d.querySelector('[data-sg-txpage]');
        if (!part || !T || !holder) { statusEl.textContent = 'Click inside a section of the page (not the top menu)'; return; }
        if (list.length >= <%= textBoxes.MAX %>) { statusEl.textContent = 'A site can have up to <%= textBoxes.MAX %> text boxes'; setAdding(false); return; }
        const r = part.getBoundingClientRect();
        const t = { id: newId(), page: holder.dataset.sgTxpage, at: T.key(part), x: Math.round(Math.max(0, Math.min(90, (e.clientX - r.left) / r.width * 100)) * 10) / 10,
          y: Math.round(Math.max(0, Math.min(95, (e.clientY - r.top) / r.height * 100)) * 10) / 10, w: 36, text: 'Your words here', size: 36, font: '', color: '', bold: true, italic: false, align: 'left' };
        list.push(t); save(); setAdding(false);
        const el = d.createElement('div'); el.className = 'sg-tx'; el.dataset.sgTx = t.id; el.dataset.at = t.at; el.textContent = t.text; styleBox(el, t);
        T.place(el);
        startBox(d, el, true);
      }
      function startBox(d, el, fresh) {
        endBox();
        const t = list.find(x => x.id === el.dataset.sgTx); if (!t) return;
        inlineEditing = true;
        el.contentEditable = 'plaintext-only'; if (el.contentEditable !== 'plaintext-only') el.contentEditable = 'true';
        el.classList.add('sg-tx-on');
        const grip = d.createElement('div'); grip.className = 'sg-tx-grip'; grip.title = 'Drag to move'; grip.textContent = '✥';
        const size = d.createElement('div'); size.className = 'sg-tx-size'; size.title = 'Drag to make the box wider or narrower'; size.textContent = '↔';
        const bar = d.createElement('div'); bar.className = 'sg-txbar';
        const fontOpts = '<option value="">Page font</option>' + [...new Set(FONTS.map(f => f[1]))].map(g => '<optgroup label="' + g + '">' + FONTS.filter(f => f[1] === g).map(f => '<option>' + f[0] + '</option>').join('') + '</optgroup>').join('');
        const hex = /^#[0-9a-f]{6}$/i.test(t.color) ? t.color : '<%= site.theme.primaryColor || '#2563eb' %>';
        bar.innerHTML = '<label>Size <input type="range" min="10" max="200" data-k="sizeR"><input type="number" min="10" max="200" data-k="size" aria-label="Size in pixels"></label>' +
          '<select data-k="font" aria-label="Font">' + fontOpts + '</select>' +
          '<select data-k="color" aria-label="Color"><option value="">Page color</option><option value="brand">Brand color</option><option value="accent">Accent color</option><option value="white">White</option><option value="dark">Near black</option><option value="pick">A color I pick</option></select>' +
          '<input type="color" data-k="hex" aria-label="Pick a color" value="' + hex + '">' +
          '<button type="button" data-a="bold" title="Bold"><b>B</b></button><button type="button" data-a="italic" title="Italic"><i>I</i></button>' +
          '<button type="button" data-a="left" title="Line up on the left">Left</button><button type="button" data-a="center" title="Center">Center</button><button type="button" data-a="right" title="Line up on the right">Right</button>' +
          '<button type="button" data-a="del" class="del">Delete</button><button type="button" data-a="done">Done</button>';
        d.body.appendChild(grip); d.body.appendChild(size); d.body.appendChild(bar);
        const q = (k) => bar.querySelector('[data-k="' + k + '"]');
        const sync = () => {
          q('size').value = t.size; q('sizeR').value = t.size; q('font').value = t.font || '';
          q('color').value = /^#/.test(t.color) ? 'pick' : (t.color || ''); q('hex').hidden = !/^#/.test(t.color);
          bar.querySelectorAll('[data-a]').forEach(b => { const a = b.dataset.a; if (a === 'bold' || a === 'italic') b.setAttribute('aria-pressed', String(!!t[a])); if (a === 'left' || a === 'center' || a === 'right') b.setAttribute('aria-pressed', String(t.align === a)); });
        };
        const win = d.defaultView;
        const placeUi = () => {
          const r = el.getBoundingClientRect(), sx = win.scrollX, sy = win.scrollY;
          grip.style.left = (r.left + sx - 26) + 'px'; grip.style.top = (r.top + sy - 2) + 'px';
          size.style.left = (r.right + sx + 4) + 'px'; size.style.top = (r.bottom + sy - 22) + 'px';
          bar.style.left = Math.max(sx + 4, Math.min(r.left + sx, sx + win.innerWidth - bar.offsetWidth - 8)) + 'px';
          bar.style.top = Math.max(sy + 4, r.top + sy - bar.offsetHeight - 10) + 'px';
        };
        const changed = () => { styleBox(el, t); loadFont(d, t.font); sync(); placeUi(); save(); };
        sync(); placeUi();
        bar.addEventListener('mousedown', (ev) => { if (!ev.target.matches('select, input')) ev.preventDefault(); });
        bar.addEventListener('input', (ev) => {
          const k = ev.target.dataset.k;
          if (k === 'size' || k === 'sizeR') { const v = Math.max(10, Math.min(200, Math.round(+ev.target.value || 0))); if (v >= 10) { t.size = v; changed(); } }
          else if (k === 'font') { t.font = ev.target.value; changed(); }
          else if (k === 'color') { t.color = ev.target.value === 'pick' ? q('hex').value : ev.target.value; changed(); }
          else if (k === 'hex') { t.color = ev.target.value; changed(); }
        });
        bar.addEventListener('click', (ev) => {
          const b = ev.target.closest('[data-a]'); if (!b) return;
          ev.preventDefault(); ev.stopPropagation();
          const a = b.dataset.a;
          if (a === 'bold' || a === 'italic') { t[a] = !t[a]; changed(); }
          else if (a === 'left' || a === 'center' || a === 'right') { t.align = a; changed(); }
          else if (a === 'del') { list = list.filter(x => x !== t); save(); endBox(); el.remove(); statusEl.textContent = 'Text box deleted. Ctrl+Z brings it back'; }
          else endBox();
        });
        // drag by the handle: the box moves within its part of the page; drag the corner to set its width
        const drag = (kind) => (ev) => {
          ev.preventDefault(); ev.stopPropagation();
          const part = el.offsetParent || el.parentElement, pr = part.getBoundingClientRect(), x0 = ev.clientX, y0 = ev.clientY, t0 = { x: t.x, y: t.y, w: t.w };
          const move = (m) => {
            const dx = (m.clientX - x0) / pr.width * 100, dy = (m.clientY - y0) / pr.height * 100;
            if (kind === 'move') { t.x = Math.round(Math.max(0, Math.min(98, t0.x + dx)) * 10) / 10; t.y = Math.round(Math.max(0, Math.min(98, t0.y + dy)) * 10) / 10; }
            else t.w = Math.round(Math.max(4, Math.min(100, t0.w + dx)) * 10) / 10;
            styleBox(el, t); placeUi();
          };
          const up = () => { d.removeEventListener('pointermove', move); d.removeEventListener('pointerup', up); save(); };
          d.addEventListener('pointermove', move); d.addEventListener('pointerup', up);
        };
        grip.addEventListener('pointerdown', drag('move')); size.addEventListener('pointerdown', drag('size'));
        const onInput = () => { t.text = el.innerText.replace(/ /g, ' ').replace(/\n$/, '').slice(0, 600); placeUi(); save(); };
        el.addEventListener('input', onInput);
        const onScroll = () => placeUi(); win.addEventListener('scroll', onScroll); win.addEventListener('resize', onScroll);
        cur = { el, t, grip, size, bar, d, onInput, onScroll };
        el.focus();
        if (fresh) { const r = d.createRange(); r.selectNodeContents(el); const sel = win.getSelection(); sel.removeAllRanges(); sel.addRange(r); }
        statusEl.textContent = fresh ? 'Type your words, then drag the blue handle to move them' : 'Editing your text box';
      }
      function endBox() {
        if (!cur) return;
        const { el, grip, size, bar, d, onInput, onScroll } = cur; cur = null;
        el.removeEventListener('input', onInput); d.defaultView.removeEventListener('scroll', onScroll); d.defaultView.removeEventListener('resize', onScroll);
        el.removeAttribute('contenteditable'); el.classList.remove('sg-tx-on'); grip.remove(); size.remove(); bar.remove();
        // an emptied box goes away
        const t = list.find(x => x.id === el.dataset.sgTx); if (t && !t.text.trim()) { list = list.filter(x => x !== t); el.remove(); save(); }
        inlineEditing = false;
        if (pvStale) { pvStale = false; flushSave().then(() => freshPreview()); }
      }
      function hook() {
        const d = pdoc(); if (!d) return;
        css(d);
        if (adding) d.documentElement.classList.add('sg-tx-adding');
        // a frame's first blank page hands its window on to the real page, so the window is hooked once and each
        // click works on the page it lands in
        const win = d.defaultView; if (!win || win.__sgTxHooked) return; win.__sgTxHooked = true;
        // the window hears the click before the page does, so adding or opening a text box comes before click-to-edit
        win.addEventListener('click', (e) => {
          const dd = e.target.ownerDocument || win.document; css(dd);
          if (cur && (cur.bar.contains(e.target) || e.target === cur.grip || e.target === cur.size)) return;
          const box = e.target.closest && e.target.closest('.sg-tx');
          if (adding) { e.preventDefault(); e.stopImmediatePropagation(); addAt(dd, e); return; }
          if (box) { e.preventDefault(); e.stopImmediatePropagation(); if (!cur || cur.el !== box) startBox(dd, box, false); return; }
          if (cur) endBox();
        }, true);
        win.addEventListener('keydown', (e) => { if (e.key === 'Escape') { if (adding) setAdding(false); else if (cur) endBox(); } });
      }
      onPreviewLoad(hook);
      hook();
    })();

    // ---- your own pictures, anywhere (picboxes.js): "+ Add picture", then click a spot on any block; click a picture
    // to drag it by its handle, pull its corner to set its width and height, and pick what it shows (peeking cats,
    // dogs, both, cats and dogs taking turns, or your own pictures) from the bar above it. Saved in pics_json. ----
    (function () {
      const input = document.getElementById('picsJson'), addBtn = document.getElementById('addPicBtn');
      if (!input || !addBtn) return;
      const PETS = <%- JSON.stringify(Object.fromEntries(petArt.KINDS.map(k => [k, petArt.svg(k, 'fit')]))).replace(/</g, '\\u003c') %>;
      const ARTS = <%- JSON.stringify(picBoxes.ARTS) %>, FITS = <%- JSON.stringify(picBoxes.FITS) %>;
      const PAWS = <%- JSON.stringify({ paw: petArt.paw(false, 'fit'), pawline: petArt.paw(true, 'fit'), catpaw: petArt.paw(false, 'fit', 'cat'), catpawline: petArt.paw(true, 'fit', 'cat'), cattrail: petArt.trail(false, 'fit', 'cat'), cattrailline: petArt.trail(true, 'fit', 'cat'), pawtrail: petArt.trail(false, 'fit'), pawtrailline: petArt.trail(true, 'fit') }).replace(/</g, '\\u003c') %>;
      const PCOL = { brand: 'var(--primary)', accent: 'var(--accent)', white: '#ffffff', dark: '#111827' }, BRAND = '<%= site.theme.primaryColor || '#2563eb' %>';
      const isPaw = (p) => Object.prototype.hasOwnProperty.call(PAWS, p.art);
      // odd shapes and stamps (public/shapeart.js): one color like the paws
      const SA = window.ShapeArt, isShape = (p) => !!(SA && SA.isArt(p.art)), isStamp = (p) => /^stamp-/.test(p.art || '') && isShape(p), isInk = (p) => isPaw(p) || isShape(p);
      const PET1 = <%- JSON.stringify(Array.from({ length: 7 }, (_, i) => petArt.single(i))).replace(/</g, '\\u003c') %>, MAXPEEK = <%= picBoxes.MAX_PEEK %>;
      const escA = (t) => String(t).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
      // the peeking row, with the same numbers as the page (picboxes.peekPets)
      function peekHtml(p) {
        const list = p.photos.length ? p.photos : PET1.map((_, i) => i);
        return '<div class="sg-peek on' + (p.photos.length ? '' : ' sg-peek-drawn') + '">' + list.map((u, i) => {
          const pose = i % 3 === 1, t = 7 + ((i * 37) % 5), d = -((i * 2.3) % t).toFixed(1), h = 84 + ((i * 29) % 17);
          return '<span class="sg-peek-pet' + (pose ? ' sg-peek-pose' : '') + '" style="--t:' + t + 's;--d:' + d + 's;--ph:' + h + '%">' + (typeof u === 'number' ? PET1[u] : '<img src="' + escA(u) + '" alt="">') + '</span>';
        }).join('') + '</div>';
      }
      const pawBtn = document.getElementById('addPawBtn'), catPawBtn = document.getElementById('addCatPawBtn'), trailBtn = document.getElementById('addTrailBtn');
      // which paw the clicks stamp: a dog's (+ Paw print), a cat's (+ Cat paw) or a whole trail (+ Paw trail)
      let stamping = false, stampCat = false, stampTrail = false, stampArt = '';
      let list = []; try { list = JSON.parse(input.value) || []; } catch (e) { list = []; }
      let adding = false, cur = null, clipping = false;
      const cutBtn = document.getElementById('addCutBtn');
      const save = () => { input.value = JSON.stringify(list); scheduleAutosave(); };
      const newId = () => 'p' + Array.from({ length: 7 }, () => 'abcdefghijklmnopqrstuvwxyz0123456789'[Math.floor(Math.random() * 36)]).join('');
      const pdoc = () => { try { const d = preview.contentDocument; return d && d.body ? d : null; } catch (e) { return null; } };
      const r1 = (n) => Math.round(n * 10) / 10;
      const pet = (k, fit, on) => PETS[k].replace('xMidYMax meet', fit === 'stretch' ? 'none' : 'xMidYMax meet').replace('<svg class="sg-pets"', '<svg class="sg-pets' + (on ? ' on' : '') + '"');
      // the same box the page draws (picboxes.html)
      function draw(el, p) {
        el.className = 'sg-pic sg-pic-' + p.fit + (cur && cur.el === el ? ' sg-pic-on' : '');
        ['x', 'y', 'w', 'h'].forEach(k => el.style.setProperty('--' + k, p[k] + '%'));
        el.style.setProperty('--r', (p.turn || 0) + 'deg'); el.style.color = isInk(p) ? (PCOL[p.color] || p.color || PCOL.brand) : '';
        const turns = p.art === 'turns' || (!p.art && p.photos.length > 1);
        if (turns) el.setAttribute('data-sg-tb-turns', ''); else el.removeAttribute('data-sg-tb-turns');
        let inner = el.querySelector('.sg-pic-in'); if (!inner) { inner = el.ownerDocument.createElement('div'); inner.className = 'sg-pic-in sg-tb-pic'; el.appendChild(inner); }
        inner.innerHTML = isShape(p) ? SA.svg(p.art, { fit: p.fit, on: true, uid: p.id, text: p.text, sub: p.sub }) : p.art === 'peek' ? peekHtml(p) : isPaw(p) ? PAWS[p.art].replace('xMidYMid meet', p.fit === 'stretch' ? 'none' : 'xMidYMid meet').replace('<svg class="sg-pets', '<svg class="on sg-pets')
          : p.art === 'turns' ? pet('cats', p.fit, true) + pet('dogs', p.fit, false) : p.art ? pet(p.art, p.fit, true) : '';
        if (!p.art && p.photos) p.photos.forEach((u, i) => { const im = el.ownerDocument.createElement('img'); im.src = u; im.alt = ''; if (i === 0) im.className = 'on'; inner.appendChild(im); });
        // in the editor the turns run here (the page's own timer only starts on load)
        clearInterval(el.__sgTurn); const kids = inner.children;
        if (kids.length > 1) { let i = 0; el.__sgTurn = setInterval(() => { if (!el.isConnected) return clearInterval(el.__sgTurn); kids[i].classList.remove('on'); i = (i + 1) % kids.length; kids[i].classList.add('on'); }, 3000); }
      }
      function setAdding(on, clip) {
        adding = on; clipping = !!(on && clip);
        addBtn.setAttribute('aria-pressed', String(on && !clipping)); addBtn.classList.toggle('on', on && !clipping);
        if (cutBtn) { cutBtn.setAttribute('aria-pressed', String(clipping)); cutBtn.classList.toggle('on', clipping); }
        const d = pdoc(); if (d) d.documentElement.classList.toggle('sg-pic-adding', on);
        if (on) statusEl.textContent = clipping ? 'Click the spot on a block where the cut-out should go, then pick the photo (Esc to stop)' : 'Click the block where your picture should go (Esc to stop)';
      }
      addBtn.addEventListener('click', () => { endBox(); setStamping(false); setAdding(!(adding && !clipping)); });
      if (cutBtn) cutBtn.addEventListener('click', () => { endBox(); setStamping(false); setAdding(!(adding && clipping), true); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && adding) setAdding(false); if (e.key === 'Escape' && stamping) setStamping(false); });
      // paw prints: every click stamps one more, until Esc or the button again
      function setStamping(on, cat, trail, art) {
        stamping = on; stampCat = !!cat; stampTrail = !!trail; stampArt = on && art ? art : '';
        shapeBtnsOn();
        [[pawBtn, false, false], [catPawBtn, true, false], [trailBtn, true, true]].forEach(([b, c, t]) => { if (b) { const o = on && !stampArt && stampCat === c && stampTrail === t; b.setAttribute('aria-pressed', String(o)); b.classList.toggle('on', o); } });
        const d = pdoc(); if (d) d.documentElement.classList.toggle('sg-pic-adding', on || adding);
        if (on && stampArt) statusEl.textContent = 'Click anywhere on a block to place the ' + (shapeLabel(stampArt) || 'shape').toLowerCase() + '. Keep clicking for more (Esc to stop)';
        else if (on) statusEl.textContent = stampTrail ? 'Click where the paw trail should go: it lays a whole trail there (Esc to stop)' : 'Click anywhere on a block to stamp a ' + (stampCat ? 'cat ' : '') + 'paw print. Keep clicking for more (Esc to stop)';
      }
      if (pawBtn) pawBtn.addEventListener('click', () => { endBox(); setAdding(false); setStamping(!(stamping && !stampCat && !stampTrail), false); });
      if (catPawBtn) catPawBtn.addEventListener('click', () => { endBox(); setAdding(false); setStamping(!(stamping && stampCat && !stampTrail), true); });
      if (trailBtn) trailBtn.addEventListener('click', () => { endBox(); setAdding(false); setStamping(!(stamping && stampTrail), true, true); });
      // + Shape and + Stamp: a picker under the preview bar (shapes in their sections, stamps with their words); picking
      // one makes each click on the page place it, like the paw prints
      const shapeBtn = document.getElementById('addShapeBtn'), stampBtn = document.getElementById('addStampBtn'), pick = document.getElementById('shapePick');
      let pickKind = '';
